using System;
using Gui;
using Gui.Widget;
using Gui.Backend;

namespace Gui.Component.DataTable;

/// DataTable 模块：浮动浮层——右键行上下文菜单、
/// 选区生成图表浮层和列表头上下文菜单。
partial class DataTable {
    // ---------- 右键上下文菜单 ----------

    /// 绘制一个菜单项并注册其命中矩形；accel 为右侧快捷键/勾选文本。
    static void CtxItem(App app, int mx, int my, int mw, int ih, string label, string accel) {
        int id = app.focus.AllocId();
        ContextMenu.PaintItem(app, mx, my, mw, ih, label, accel,
                              app.focus.IsHovered(id));
        app.hitTester.RegisterRect(id, mx, my, mw, ih, 0);
    }

    /// 表头菜单的聚合行：在活动模式旁显示勾选，
    /// 点击应用并关闭菜单。返回下一项的 y。
    static int AggItem(App app, int mx, int iy, int mw, int ih,
                       DataTableState st, int col, int mode, string label, int curAgg) {
        string mark = "";
        if (mode == curAgg) { mark = "✓"; }
        DataTable.CtxItem(app, mx, iy, mw, ih, label, mark);
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            DataTable.SetAggregate(st, col, mode);
            st.hitCol = col; st.ColumnResize.Raise();
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        return iy + ih;
    }

    /// (mx,my,mw,ih) 区域是否刚被左键点击？按几何与当前鼠标事件判断。
    static bool CtxHit(App app, int mx, int my, int mw, int ih) {
        // 覆盖 (mx,my,mw,ih) 的行是否刚被点击？基于几何判断，
        // id 保持简单；菜单近似模态（最后绘制，命中测试优先）。
        return app.ClickAvailable() && app.window.EventButton() == 0
               && app.mouseX >= mx && app.mouseX < mx + mw
               && app.mouseY >= my && app.mouseY < my + ih;
    }

    /// 在表格上显示一条短暂提示消息（toastFrames=90）。
    static void Flash(DataTableState st, string msg) {
        st.toast = msg;
        st.toastFrames = 90;
    }

    /// 行右键菜单：复制/带表头复制/粘贴/清空/导出 CSV/选区图表；
    /// 数据源可增删行时追加插入行、删除行、撤销组，末尾恒有
    /// 全选与清除选择。点击菜单外或窗口失焦时关闭。
    static void RenderContextMenu(App app, int x, int y, int viewW, int viewH,
                                  List<DataColumn> cols, DataSource src, DataTableState st) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox sMenu = Style.Part(app, "datatable", "menu", "", "", "",
                                    Style.SNormal());
        StyleBox sGrid = Style.Part(app, "datatable", "grid", "", "", "",
                                    Style.SNormal());
        int mw = app.Scale(230);
        int ih = t.heightMedium;
        int sepH = app.Scale(9);

        // 菜单项：标签、快捷键、类型（0 项，1 分隔符）
        // 0 复制，1 带表头复制，2 粘贴，3 清空单元格，4 导出 csv，
        // 5 选区生成图表，[分隔符，插入行，删除行，撤销，]
        // 分隔符，全选，分隔符，清除选区
        // 行编辑组仅在数据源能真正增删行时出现，
        // 只读网格不会显示任何会被拒绝的命令。
        bool canRows = src.CanInsert();
        int nItems = 8;
        int nSeps = 2;
        if (canRows) { nItems = nItems + 3; nSeps = nSeps + 1; }
        int mh = ih * nItems + sepH * nSeps + app.Scale(8);

        int mx = st.ctxX;
        int my = st.ctxY;
        if (mx + mw > x + viewW) { mx = x + viewW - mw - app.Scale(2); }
        if (my + mh > y + viewH) { my = y + viewH - mh - app.Scale(2); }
        if (mx < x) { mx = x; }
        if (my < y) { my = y; }

        // 接管滚轮；菜单矩形吞掉自身区域的点击。菜单外的表格
        // 空隙/页面由全视口遮罩挡住，点击外部只关闭菜单，
        // 不会同时穿透到菜单后面的单元格（选区/编辑误触发）。
        app.CaptureWheel(mx, my, mw, mh);
        app.BlockHitsRect(x, y, viewW, viewH);
        app.BlockHitsRect(mx, my, mw, mh);
        c.FillRoundRect(mx, my, mw, mh, t.borderRadiusMedium, sMenu.BgOr(0));
        c.DrawRoundRect(mx, my, mw, mh, t.borderRadiusMedium, sMenu.BorderOr(0), 1);

        int iy = my + app.Scale(4);
        DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Copy", "复制"), "Ctrl+C");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            Clipboard.SetText(DataTable.BuildText(st, cols, src, false, false));
            DataTable.Flash(st, DataTable.T("Copied to clipboard", "已复制到剪贴板"));
            st.ctxOpen = false;
            app.RequestRedraw();
        }
        iy = iy + ih;
        DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Copy with headers", "复制（含表头）"), "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            Clipboard.SetText(DataTable.BuildText(st, cols, src, false, true));
            DataTable.Flash(st, DataTable.T("Copied with headers", "已复制（含表头）"));
            st.ctxOpen = false;
            app.RequestRedraw();
        }
        iy = iy + ih;
        DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Paste", "粘贴"), "Ctrl+V");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            int pn = DataTable.PasteText(st, cols, src, Clipboard.GetText());
            if (pn > 0) { DataTable.Flash(st, DataTable.TN("Pasted {n} cells", pn, "已粘贴 {n} 个单元格")); }
            else { DataTable.Flash(st, DataTable.T("No pasteable editable cells", "无可粘贴的可编辑单元格")); }
            st.ctxOpen = false;
            app.RequestRedraw();
        }
        iy = iy + ih;
        DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Clear selected cells", "清空所选单元格"), "Delete");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            int dn = DataTable.ClearRangeCells(st, cols, src);
            if (dn > 0) { DataTable.Flash(st, DataTable.TN("Cleared {n} cells", dn, "已清空 {n} 个单元格")); }
            else { DataTable.Flash(st, DataTable.T("No editable cells in selection", "所选区域没有可编辑单元格")); }
            st.ctxOpen = false;
            app.RequestRedraw();
        }
        iy = iy + ih;
        DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Export CSV", "导出 CSV"), "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            bool ok = SysFile.Write("datatable_export.csv", DataTable.BuildText(st, cols, src, true, true));
            if (ok) { DataTable.Flash(st, DataTable.T("Exported datatable_export.csv", "已导出 datatable_export.csv")); }
            else { DataTable.Flash(st, DataTable.T("Export failed", "导出失败")); }
            st.ctxOpen = false;
            app.RequestRedraw();
        }
        iy = iy + ih;
        DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Chart from selection", "从选区生成图表"), "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            if (DataTable.BuildChartFromRange(st, cols, src)) {
                st.chartOpen = true;
            } else {
                DataTable.Flash(st, DataTable.T("Select a range with numeric columns first", "请先框选含数值列的区域"));
            }
            st.ctxOpen = false;
            app.RequestRedraw();
        }
        iy = iy + ih;
        if (st.pivotView) {
            DataTable.CtxItem(app, mx, iy, mw, ih,
                              DataTable.T("Exit pivot view", "退出透视视图"), "");
            if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
                DataTable.ExitPivot(st);
                DataTable.Flash(st, DataTable.T("Exited pivot view", "已退出透视视图"));
                st.ctxOpen = false;
                app.RequestRedraw();
            }
        } else {
            DataTable.CtxItem(app, mx, iy, mw, ih,
                              DataTable.T("Pivot from selection", "从选区生成透视表"), "");
            if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
                if (DataTable.PivotFromSelection(st, cols, src)) {
                    DataTable.Flash(st, DataTable.T("Switched to pivot view", "已切换为透视视图"));
                } else {
                    DataTable.Flash(st, DataTable.T("Select a range with a value column and two category columns", "请先框选含数值列与两个维度列的区域"));
                }
                st.ctxOpen = false;
                app.RequestRedraw();
            }
        }
        iy = iy + ih;
        if (canRows) {
            c.FillRect(mx + app.Scale(8), iy + sepH / 2, mw - app.Scale(16), 1, sGrid.BgOr(0));
            iy = iy + sepH;
            DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Insert row", "插入行"), "Ctrl+Ins");
            if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
                // 在被点击行的*下方*插入，这是读者
                // 期望新条目出现的位置；锚点行保持原位。
                int at = src.RowCount();
                if (st.hitRow >= 0) { at = st.hitRow + 1; }
                int nr = DataTable.InsertRow(st, cols, src, at);
                if (nr >= 0) {
                    DataTable.Recompute(st, cols, src);
                    DataTable.FocusRow(st, cols, src, nr);
                }
                st.ctxOpen = false;
                app.RequestRedraw();
            }
            iy = iy + ih;
            DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Delete rows", "删除行"), "Ctrl+Del");
            if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
                int killed = DataTable.DeleteSelectedRows(st, cols, src);
                if (killed == 0 && st.hitRow >= 0) {
                    if (DataTable.DeleteRow(st, cols, src, st.hitRow)) { killed = 1; }
                }
                if (killed > 0) {
                    DataTable.Recompute(st, cols, src);
                    DataTable.Flash(st, DataTable.TN("Deleted {n} rows (Ctrl+Z to undo)", killed, "已删除 {n} 行（Ctrl+Z 撤销）"));
                }
                st.ctxOpen = false;
                app.RequestRedraw();
            }
            iy = iy + ih;
            int undoN = DataTable.UndoDepth(st);
            string undoLbl = DataTable.T("Undo", "撤销");
            if (undoN > 0) { undoLbl = undoLbl + "  (" + Convert.ToString(undoN) + ")"; }
            DataTable.CtxItem(app, mx, iy, mw, ih, undoLbl, "Ctrl+Z");
            if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
                if (DataTable.Undo(st, cols, src)) {
                    DataTable.Recompute(st, cols, src);
                    DataTable.Flash(st, DataTable.T("Undone", "已撤销"));
                } else {
                    DataTable.Flash(st, DataTable.T("Nothing to undo", "没有可撤销的操作"));
                }
                st.ctxOpen = false;
                app.RequestRedraw();
            }
            iy = iy + ih;
        }
        c.FillRect(mx + app.Scale(8), iy + sepH / 2, mw - app.Scale(16), 1, sGrid.BgOr(0));
        iy = iy + sepH;
        DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Select all", "全选"), "Ctrl+A");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            DataTable.SelectAllRows(st, src, true);
            DataTable.ClearRange(st);
            st.ctxOpen = false;
            app.RequestRedraw();
        }
        iy = iy + ih;
        c.FillRect(mx + app.Scale(8), iy + sepH / 2, mw - app.Scale(16), 1, sGrid.BgOr(0));
        iy = iy + sepH;
        DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Clear selection", "清除选择"), "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            DataTable.SelectAllRows(st, src, false);
            DataTable.ClearRange(st);
            st.ctxOpen = false;
            app.RequestRedraw();
        }

        // 点击外部关闭菜单。终结长按的那次手指抬起
        // （app.LongPressFired，标志下次按下才复位）不算
        // "外部点击"——否则触摸长按刚打开菜单就被松手关掉。
        if (app.EventKind() == 3 && !app.LongPressFired()
            && !(app.mouseX >= mx && app.mouseX < mx + mw && app.mouseY >= my && app.mouseY < my + mh)) {
            st.ctxOpen = false;
            app.RequestRedraw();
        }
        // 窗口失焦时同样关闭，菜单不悬在非活动窗口上。
        if (app.EventKind() == 9 || !app.window.IsFocused()) {
            st.ctxOpen = false;
            app.RequestRedraw();
        }
    }

    // ---------- 选区生成图表浮层 ----------
    /// 由选中范围构建的模态柱状图（见 BuildChartFromRange）。
    /// 点击 [x] 按钮、面板外部或 Escape 关闭。
    static void RenderChart(App app, int x, int y, int viewW, int viewH,
                            DataTableState st) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox sMenu = Style.Part(app, "datatable", "menu", "", "", "",
                                    Style.SNormal());
        StyleBox sGrid = Style.Part(app, "datatable", "grid", "", "", "",
                                    Style.SNormal());
        StyleBox sHeader = Style.Part(app, "datatable", "header", "", "", "",
                                      Style.SNormal());
        StyleBox sHint = Style.Part(app, "datatable", "hint", "", "", "",
                                    Style.SNormal());
        StyleBox sLabel = Style.Part(app, "datatable", "label", "", "", "",
                                     Style.SNormal());
        StyleBox sAccent = Style.Part(app, "datatable", "accent", "", "", "",
                                      Style.SNormal());
        StyleBox sRowHover = Style.Part(app, "datatable", "row", "", "", "",
                                        Style.SHover());

        int m = app.Scale(20);
        int px = x + m;
        int py = y + m;
        int pw = viewW - m * 2;
        int ph = viewH - m * 2;
        if (pw < app.Scale(120) || ph < app.Scale(100)) { st.chartOpen = false; return; }

        // 遮罩 + 面板
        c.FillRect(x, y, viewW, viewH, t.overlay);
        // 模态：接管滚轮并屏蔽图表浮层下的所有命中
        app.CaptureWheel(x, y, viewW, viewH);
        app.BlockHitsRect(x, y, viewW, viewH);
        c.FillRoundRect(px, py, pw, ph, t.borderRadiusMedium, sMenu.BgOr(0));
        c.DrawRoundRect(px, py, pw, ph, t.borderRadiusMedium, sMenu.BorderOr(0), 1);

        // 标题栏
        int th = t.heightLarge;
        c.FillRect(px + 1, py + 1, pw - 2, th, sHeader.BgOr(0));
        c.FillRect(px + 1, py + th, pw - 2, 1, sGrid.BgOr(0));
        c.DrawText(px + app.Scale(14), Canvas.CenterTextY(py, th, Style.FontFallback(app, "medium")),
                   DataTable.T("Chart", "图表") + " · " + st.chartTitle, sMenu.FgOr(0), Style.FontFallback(app, "medium"));

        // 关闭按钮
        int cbs = app.Scale(22);
        int cbx = px + pw - cbs - app.Scale(8);
        int cby = py + (th - cbs) / 2;
        bool cbHot = app.mouseX >= cbx && app.mouseX < cbx + cbs
                     && app.mouseY >= cby && app.mouseY < cby + cbs;
        if (cbHot) { c.FillRoundRect(cbx, cby, cbs, cbs, app.Scale(4), sRowHover.BgOr(0)); }
        c.DrawTextCentered(cbx, cby, cbs, cbs, "×", sMenu.FgOr(0), Style.FontFallback(app, "large"));

        // 绘图区
        int axisW = app.Scale(44);
        int plotX = px + axisW;
        int plotTop = py + th + app.Scale(14);
        int plotBottom = py + ph - app.Scale(30);
        int plotRight = px + pw - app.Scale(16);
        int plotW = plotRight - plotX;
        int plotH = plotBottom - plotTop;
        int n = st.chartBars.Count;
        if (plotH < app.Scale(20) || plotW < app.Scale(20) || n <= 0) {
            // 即使小到无法绘图也仍允许关闭
        } else {
            int mx = st.chartMax;
            if (mx < 1) { mx = 1; }

            // 基线 + 最大/零轴标签 + 一条淡中线
            c.FillRect(plotX, plotBottom, plotW, 1, sMenu.BorderOr(0));
            c.DrawText(px + app.Scale(8), Canvas.CenterTextYAt(plotTop, Style.FontFallback(app, "small")),
                       Convert.ToString(mx), sHint.FgOr(0), Style.FontFallback(app, "small"));
            c.DrawText(px + app.Scale(8), Canvas.CenterTextYAt(plotBottom, Style.FontFallback(app, "small")),
                       "0", sHint.FgOr(0), Style.FontFallback(app, "small"));
            int midY = plotTop + plotH / 2;
            c.FillRect(plotX, midY, plotW, 1, sGrid.BgOr(0));

            int slotW = plotW / n;
            int barW = slotW * 3 / 5;
            if (barW < app.Scale(4)) { barW = app.Scale(4); }
            for (int i = 0; i < n; i = i + 1) {
                ChartBar bar = st.chartBars[i];
                int av = bar.val;
                if (av < 0) { av = 0 - av; }
                int bh = av * plotH / mx;
                if (bh < 1 && av > 0) { bh = 1; }
                int slotL = plotX + slotW * i;
                int bx = slotL + (slotW - barW) / 2;
                int byy = plotBottom - bh;
                c.FillRect(bx, byy, barW, bh, sAccent.BgOr(0));

                // 柱上方的数值标签
                string vlab = Convert.ToString(bar.val);
                int vlw = Canvas.MeasureText(vlab, Style.FontFallback(app, "small"));
                int vlx = slotL + (slotW - vlw) / 2;
                int vly = byy - Canvas.FontHeight(Style.FontFallback(app, "small")) - app.Scale(2);
                if (vly < plotTop) { vly = plotTop; }
                c.DrawText(vlx, vly, vlab, sLabel.FgOr(0), Style.FontFallback(app, "small"));

                // 基线下的分类标签（按槽位裁剪）
                c.PushClip(slotL, plotBottom + app.Scale(4), slotW, app.Scale(20));
                c.DrawTextCentered(slotL, plotBottom + app.Scale(4), slotW,
                                   Canvas.FontHeight(Style.FontFallback(app, "small")),
                                   bar.label, sHint.FgOr(0), Style.FontFallback(app, "small"));
                c.PopClip();
            }
        }

        // 关闭交互：[x]、点击面板外部或 Escape
        bool clicked = app.EventKind() == 3 && app.window.EventButton() == 0;
        bool inside = app.mouseX >= px && app.mouseX < px + pw
                      && app.mouseY >= py && app.mouseY < py + ph;
        if ((clicked && (cbHot || !inside))
            || (app.EventKind() == 4 && app.window.EventKeyCode() == 27)) {
            st.chartOpen = false;
            app.RequestRedraw();
        }
    }

    // 选区数据透视浮层已移除：透视升级为表格自身的视图
    // 形态（DataTable.PivotView.zan）——右键菜单直接把整表
    // 切换为交叉投影，不再需要独立的透视浮层。

    // ---------- 导出进度弹层（居中模态） ----------

    /// 进度弹层卡片矩形：水平居中，垂直置于视口约 40% 高处
    /// （视觉重心比正中略稳）。高度由内容令牌推出，纯几何，
    /// conformance 直接断言。
    static void ExportUiRect(App app, int x, int y, int viewW, int viewH,
                             out int px, out int py, out int pw, out int ph) {
        Theme t = app.theme;
        int fSmall = Style.FontFallback(app, "small");
        pw = app.Scale(340);
        int maxW = viewW - app.Scale(24);
        if (pw > maxW) { pw = maxW; }
        if (pw < app.Scale(180)) { pw = app.Scale(180); }
        ph = app.Scale(16) + t.heightMedium + app.Scale(14) + app.Scale(10)
            + app.Scale(12) + fSmall + app.Scale(10) + t.heightSmall + app.Scale(16);
        px = x + (viewW - pw) / 2;
        if (px < x) { px = x; }
        py = y + (viewH - ph) * 2 / 5;
        if (py < y + app.Scale(8)) { py = y + app.Scale(8); }
        if (py + ph > y + viewH) { py = y + viewH - ph - app.Scale(8); }
        if (py < y) { py = y; }
    }

    /// 导出进度模态：遮罩压暗表格，卡片给出进度条、百分比与
    /// 行数计数；运行中可取消（Escape 等效），结束给出结果与
    /// 关闭按钮。模态机制与图表浮层一致：CaptureWheel +
    /// BlockHitsRect 盖住整个表格视口，弹层最后绘制。
    static void RenderExportUi(App app, int x, int y, int viewW, int viewH,
                               DataTableState st) {
        DataTableExportUi ui = st.exportUi;
        if (ui == null || !ui.visible) { return; }
        // 后台进度暂存 -> 弹层状态（UI 线程每帧拉取）
        DataTableUiExportProgress.SyncUi();
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox sMenu = Style.Part(app, "datatable", "menu", "", "", "",
                                    Style.SNormal());
        StyleBox sHint = Style.Part(app, "datatable", "hint", "", "", "",
                                    Style.SNormal());
        StyleBox sTrack = Style.Part(app, "datatable", "progress-track", "", "", "",
                                     Style.SNormal());
        StyleBox sFill = Style.Part(app, "datatable", "progress-fill", "", "", "",
                                    Style.SNormal());
        int fMed = Style.FontFallback(app, "medium");
        int fSmall = Style.FontFallback(app, "small");

        int px; int py; int pw; int ph;
        DataTable.ExportUiRect(app, x, y, viewW, viewH, out px, out py, out pw, out ph);

        // 遮罩 + 模态
        c.FillRect(x, y, viewW, viewH, t.overlay);
        app.CaptureWheel(x, y, viewW, viewH);
        app.BlockHitsRect(x, y, viewW, viewH);
        c.FillRoundRect(px, py, pw, ph, t.borderRadiusMedium, sMenu.BgOr(0));
        c.DrawRoundRect(px, py, pw, ph, t.borderRadiusMedium, sMenu.BorderOr(0), 1);

        int pad = app.Scale(16);
        int tx = px + pad;

        // 标题 + 右上角状态词（百分比 / 已完成 / 失败）
        int ty = py + pad;
        c.DrawText(tx, ty, DataTable.T("Export Excel", "导出 Excel"), sMenu.FgOr(0), fMed);
        int pct = 0;
        if (ui.total > 0) {
            pct = ui.done * 100 / ui.total;
            if (pct > 100) { pct = 100; }
        }
        string state = DataTable.TN("Exporting… {n}%", pct, "正在导出… {n}%");
        if (ui.finished) {
            state = ui.ok ? DataTable.T("Done", "已完成") : DataTable.T("Failed", "失败");
        }
        int stateW = Canvas.MeasureText(state, fMed);
        c.DrawText(px + pw - pad - stateW, ty, state, sHint.FgOr(0), fMed);
        ty = ty + t.heightMedium + app.Scale(14);

        // 进度条：完成后满条（失败空条），运行中随行数推进
        int barW = pw - pad * 2;
        int barH = app.Scale(10);
        c.FillRect(tx, ty, barW, barH, sTrack.BgOr(0));
        int fillW = ui.finished ? (ui.ok ? barW : 0) : barW * pct / 100;
        if (fillW > 0) {
            c.FillRoundRect(tx, ty, fillW, barH, barH / 2, sFill.BgOr(0));
        }
        ty = ty + barH + app.Scale(12);

        // 明细：运行中给行数计数，结束给结果（路径或失败原因）
        string detail;
        if (ui.finished) {
            detail = ui.ok
                ? DataTable.T("Exported: ", "已导出：") + ui.path
                : DataTable.T("Export failed: ", "导出失败：") + ui.message;
        } else {
            detail = Convert.ToString(ui.done) + " / " + Convert.ToString(ui.total)
                + " " + DataTable.T("rows", "行");
        }
        c.DrawText(tx, ty, detail, sHint.FgOr(0), fSmall);

        // 按钮行：运行中=取消，结束=关闭
        string label = ui.finished ? DataTable.T("Close", "关闭")
                                   : DataTable.T("Cancel", "取消");
        string cls = ui.finished ? "small primary" : "small text";
        int bh = t.heightSmall;
        int bw = Canvas.MeasureText(label, fSmall) + app.Scale(24);
        int bxc = px + pw - pad - bw;
        int byc = py + ph - pad - bh;
        bool hot = app.mouseX >= bxc && app.mouseX < bxc + bw
                   && app.mouseY >= byc && app.mouseY < byc + bh;
        StyleBox bs = Style.Part(app, "datatable", "button", "", cls, "",
                                 Style.SNormal());
        if (hot) {
            bs = Style.Part(app, "datatable", "button", "", cls, "",
                            Style.SHover());
        }
        c.FillRoundRect(bxc, byc, bw, bh, bs.RadiusOr(t.borderRadiusSmall), bs.BgOr(0));
        c.DrawTextCentered(bxc, byc, bw, bh, label, bs.FgOr(0), fSmall);

        bool clicked = app.EventKind() == 3 && app.window.EventButton() == 0
                       && app.mouseX >= bxc && app.mouseX < bxc + bw
                       && app.mouseY >= byc && app.mouseY < byc + bh;
        if (clicked
            || (app.EventKind() == 4 && app.window.EventKeyCode() == 27)) {
            // 运行中：取消/Escape 请求中止（弹层保留到 OnDone 回来
            // 给出"已取消"）；结束后：关闭/Escape 收起弹层。
            if (ui.finished) {
                st.exportUi = null;
            } else {
                ui.cancel.Store(1);
            }
            app.RequestRedraw();
            return;
        }
        // 运行中自驱重绘：进度条随后台写盘推进（完成后静止，
        // 等用户关闭）。
        if (!ui.finished) { app.RequestRedraw(); }
    }

    // ---------- 表头（列）上下文菜单 ----------
    /// 右键点击列表头打开 DevExpress/ag-Grid 风格菜单：
    /// 排序、自动适配宽度、隐藏列、恢复所有列，以及跳转到
    /// 集合筛选弹窗。布局镜像 RenderContextMenu（游动 iy）。
    /// 条件格式预设色板（DevExpress 风格渐变/纯色数据条与色阶）：
    /// 12 组渐变色 + 8 组纯色，仅用于头菜单的色板与套用默认值。
    static int[] CfPresetColors() {
        int[] ps = new int[20];
        ps[0] = DataTable.Rgb(46, 106, 219);     // blue
        ps[1] = DataTable.Rgb(64, 158, 255);     // light blue
        ps[2] = DataTable.Rgb(46, 168, 106);     // green
        ps[3] = DataTable.Rgb(230, 190, 44);     // yellow
        ps[4] = DataTable.Rgb(235, 140, 40);     // orange
        ps[5] = DataTable.Rgb(58, 186, 156);     // mint
        ps[6] = DataTable.Rgb(142, 96, 214);     // violet
        ps[7] = DataTable.Rgb(206, 68, 126);     // raspberry
        ps[8] = DataTable.Rgb(240, 110, 92);     // coral
        ps[9] = DataTable.Rgb(214, 62, 58);      // red
        ps[10] = DataTable.Rgb(88, 96, 110);     // gray
        ps[11] = DataTable.Rgb(84, 62, 168);     // indigo
        ps[12] = ps[0];
        ps[13] = ps[1];
        ps[14] = ps[2];
        ps[15] = ps[3];
        ps[16] = ps[4];
        ps[17] = ps[5];
        ps[18] = ps[6];
        ps[19] = ps[7];
        return ps;
    }

    /// 数据条菜单项：行左侧画该颜色的条形图标。
    static int CfBarItem(App app, int mx, int iy, int mw, int ih, int color,
                         string label) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int id = app.focus.AllocId();
        bool hov = app.focus.IsHovered(id);
        ContextMenu.PaintItem(app, mx, iy, mw, ih, label, "", hov);
        int sw = app.Scale(30);
        int sh = ih - app.Scale(12);
        int sx = mx + app.Scale(10);
        int sy = iy + app.Scale(6);
        c.FillRoundRect(sx, sy, sw, sh, app.Scale(2), DataTable.ColorAlpha(color, 210));
        app.hitTester.RegisterRect(id, mx, iy, mw, ih, 0);
        return iy + ih;
    }

    /// 色阶菜单项：行左侧画该颜色对的双色渐变小条。
    static int CfScaleItem(App app, int mx, int iy, int mw, int ih, int c0,
                           int c1, string label) {
        Canvas c = app.canvas;
        int id = app.focus.AllocId();
        bool hov = app.focus.IsHovered(id);
        ContextMenu.PaintItem(app, mx, iy, mw, ih, label, "", hov);
        int sw = app.Scale(30);
        int sh = ih - app.Scale(12);
        int sx = mx + app.Scale(10);
        int sy = iy + app.Scale(6);
        int steps = 6;
        for (int i = 0; i < steps; i = i + 1) {
            int seg = sw / steps;
            c.FillRect(sx + i * seg, sy, seg + 1, sh,
                       DataTable.LerpColor(c0, c1, i, steps - 1));
        }
        app.hitTester.RegisterRect(id, mx, iy, mw, ih, 0);
        return iy + ih;
    }

    /// 条件格式子面板：mode 1 数据条 / 2 色阶 / 3 大于 / 4 小于。
    /// 在锚点右侧绘制预设列表并处理点击；命中应用该列 cf 配置。
    /// 返回 true 表示面板本帧吞掉了点击（主菜单保持打开）。
    static bool RenderCfPanel(App app, int ax, int ay, int mw, int ih, int sepH,
                              StyleBox sMenu, DataTableState st, int col, int mode,
                              List<DataColumn> cols, DataSource src) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int[] ps = DataTable.CfPresetColors();
        int n;
        if (mode == 1 || mode == 2) { n = 8; }
        else { n = 4; }
        int panelW = app.Scale(210);
        int panelH = ih * n + sepH + app.Scale(8);
        int px = ax + mw + app.Scale(2);
        int py = ay;
        if (py + panelH > app.window.GetHeight()) { py = app.window.GetHeight() - panelH - app.Scale(2); }
        if (py < 0) { py = 0; }
        app.CaptureWheel(px, py, panelW, panelH);
        c.FillRoundRect(px, py, panelW, panelH, t.borderRadiusMedium, sMenu.BgOr(0));
        c.DrawRoundRect(px, py, panelW, panelH, t.borderRadiusMedium, sMenu.BorderOr(0), 1);

        int iy = py + app.Scale(4);
        bool hit = false;
        for (int i = 0; i < n; i = i + 1) {
            if (i == 4) {
                c.FillRect(px + app.Scale(8), iy + sepH / 2, panelW - app.Scale(16), 1, sMenu.BgOr(0));
                iy = iy + sepH;
            }
            // 数据条：上 4 组渐变（双端同色由渲染层做 alpha 梯度），
            // 下 4 组纯色；色阶/高亮：全部用预设对。
            int ci = i < 4 ? i : i + 4;
            int c0 = ps[ci];
            int c1 = ps[ci + 4 > 11 ? ci - 4 : ci + 4];
            if (mode == 1) {
                if (i < 4) { c1 = c0; }
                iy = DataTable.CfBarItem(app, px, iy, panelW, ih, c0,
                    DataTable.T(i < 4 ? "Gradient Fill" : "Solid Fill",
                                i < 4 ? "渐变" : "纯色")
                    + " " + DataTable.SwatchName(ci));
            } else if (mode == 2) {
                iy = DataTable.CfScaleItem(app, px, iy, panelW, ih, c0, c1,
                    DataTable.SwatchName(ci));
            } else {
                iy = DataTable.CfBarItem(app, px, iy, panelW, ih, c0,
                    DataTable.SwatchName(ci));
            }
            int ri = i;
            if (DataTable.CtxHit(app, px, iy - ih, panelW, ih)) {
                hit = true;
                if (mode == 1) {
                    cols[col].cfMode = 1;
                    cols[col].cfColor = c0;
                } else if (mode == 2) {
                    cols[col].cfMode = 2;
                    cols[col].cfColor = c0;
                    cols[col].cfColor2 = c1;
                } else if (mode == 3) {
                    cols[col].cfMode = 3;
                    cols[col].cfThreshold = DataTable.MedianThreshold(app, st, cols, src, col);
                    cols[col].cfColor = c0;
                } else {
                    cols[col].cfMode = 4;
                    cols[col].cfThreshold = DataTable.MedianThreshold(app, st, cols, src, col);
                    cols[col].cfColor = c0;
                }
            }
        }
        if (hit) {
            st.hdrCtxOpen = false;
            st.cfSubOpen = 0;
            app.RequestRedraw();
        }
        // 面板外点击关闭子面板（主菜单保留）
        if (app.EventKind() == 3 && !app.LongPressFired()
            && !(app.mouseX >= px && app.mouseX < px + panelW
                 && app.mouseY >= py && app.mouseY < py + panelH)) {
            st.cfSubOpen = 0;
            app.RequestRedraw();
        }
        return hit;
    }

    /// 高亮规则的默认阈值：列数值的平均值（空列回退 0）。
    static int MedianThreshold(App app, DataTableState st, List<DataColumn> cols,
                               DataSource src, int col) {
        double sum = 0.0;
        int n = 0;
        for (int oi = 0; oi < st.order.Count; oi = oi + 1) {
            double v = src.CellReal(st.order[oi], col);
            sum = sum + v;
            n = n + 1;
        }
        if (n == 0) { return 0; }
        return (int)(sum / (double)n + 0.5);
    }

    /// 预设色的显示名（蓝/浅蓝/绿/…）。
    static string SwatchName(int i) {
        if (i == 0) { return DataTable.T("Blue", "蓝"); }
        if (i == 1) { return DataTable.T("Light Blue", "浅蓝"); }
        if (i == 2) { return DataTable.T("Green", "绿"); }
        if (i == 3) { return DataTable.T("Yellow", "黄"); }
        if (i == 4) { return DataTable.T("Orange", "橙"); }
        if (i == 5) { return DataTable.T("Mint", "薄荷"); }
        if (i == 6) { return DataTable.T("Violet", "紫"); }
        if (i == 7) { return DataTable.T("Raspberry", "梅红"); }
        if (i == 8) { return DataTable.T("Coral", "珊瑚"); }
        if (i == 9) { return DataTable.T("Red", "红"); }
        if (i == 10) { return DataTable.T("Gray", "灰"); }
        return DataTable.T("Indigo", "靛");
    }

    static void RenderHeaderMenu(App app, int x, int y, int viewW, int viewH,
                                 List<DataColumn> cols, DataSource src, DataTableState st) {
        int col = st.hdrCtxCol;
        if (col < 0 || col >= cols.Count) { st.hdrCtxOpen = false; return; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox sMenu = Style.Part(app, "datatable", "menu", "", "", "",
                                    Style.SNormal());
        StyleBox sGrid = Style.Part(app, "datatable", "grid", "", "", "",
                                    Style.SNormal());
        int mw = app.Scale(230);
        int ih = t.heightMedium;
        int sepH = app.Scale(9);

        bool canClear = DataTable.SortIndexOf(st, col) >= 0;
        bool anyHidden = DataTable.HiddenCount(st) > 0;
        bool canFilter = cols[col].filterable;
        bool canAgg = cols[col].numeric;

        int nItems = 4;                       // 升序、降序、自动适配、全部自动适配
        if (canClear) { nItems = nItems + 1; }
        nItems = nItems + 1;                  // 按此列分组
        if (st.groupCols.Count > 0) { nItems = nItems + 1; }  // 取消全部分组
        nItems = nItems + 2;                  // 冻结左侧 / 冻结右侧
        nItems = nItems + 1;                  // 隐藏列
        if (anyHidden) { nItems = nItems + 1; }
        nItems = nItems + 1;                  // 列选择器
        if (canAgg) { nItems = nItems + 6; }  // 合计：求和/平均/最小/最大/计数/无
        if (canFilter) { nItems = nItems + 1; }
        int nSep = 3;                         // 排序后、自动适配后、分组后
        if (canAgg) { nSep = nSep + 1; }      // 聚合项之前
        if (canFilter) { nSep = nSep + 1; }   // 筛选项之前
        int mh = ih * nItems + sepH * nSep + app.Scale(8);

        int mx = st.hdrCtxX;
        int my = st.hdrCtxY;
        if (mx + mw > x + viewW) { mx = x + viewW - mw - app.Scale(2); }
        if (my + mh > y + viewH) { my = y + viewH - mh - app.Scale(2); }
        if (mx < x) { mx = x; }
        if (my < y) { my = y; }

        // 接管滚轮；菜单矩形吞掉自身区域的点击。菜单外的表头
        // 空隙/页面由全视口遮罩挡住，点击外部只关闭菜单，
        // 不会同时穿透到菜单后面的表头/单元格。
        app.CaptureWheel(mx, my, mw, mh);
        app.BlockHitsRect(x, y, viewW, viewH);
        app.BlockHitsRect(mx, my, mw, mh);
        c.FillRoundRect(mx, my, mw, mh, t.borderRadiusMedium, sMenu.BgOr(0));
        c.DrawRoundRect(mx, my, mw, mh, t.borderRadiusMedium, sMenu.BorderOr(0), 1);

        int iy = my + app.Scale(4);
        DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Sort Ascending", "升序排序"), "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            DataTable.SortBy(st, col, 1);
            st.hitCol = col; st.Sort.Raise();
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        iy = iy + ih;
        DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Sort Descending", "降序排序"), "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            DataTable.SortBy(st, col, 2);
            st.hitCol = col; st.Sort.Raise();
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        iy = iy + ih;
        if (canClear) {
            DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Clear Sort", "清除排序"), "");
            if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
                DataTable.ClearSort(st);
                st.Sort.Raise();
                st.hdrCtxOpen = false; app.RequestRedraw();
            }
            iy = iy + ih;
        }

        c.FillRect(mx + app.Scale(8), iy + sepH / 2, mw - app.Scale(16), 1, sGrid.BgOr(0));
        iy = iy + sepH;
        DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Auto-fit Column", "自动列宽"), "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            DataTable.AutoFitColumn(app, cols, src, st, col);
            st.hitCol = col; st.ColumnResize.Raise();
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        iy = iy + ih;
        DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Auto-fit All", "自动全部列宽"), "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            DataTable.AutoFitAll(app, cols, src, st);
            st.ColumnResize.Raise();
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        iy = iy + ih;

        c.FillRect(mx + app.Scale(8), iy + sepH / 2, mw - app.Scale(16), 1, sGrid.BgOr(0));
        iy = iy + sepH;
        DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Group by This", "按此列分组"), "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            DataTable.GroupBy(st, col);
            st.hitCol = col; st.GroupChanged.Raise();
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        iy = iy + ih;
        if (st.groupCols.Count > 0) {
            DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Ungroup All", "取消分组"), "");
            if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
                DataTable.Ungroup(st);
                st.GroupChanged.Raise();
                st.hdrCtxOpen = false; app.RequestRedraw();
            }
            iy = iy + ih;
        }

        c.FillRect(mx + app.Scale(8), iy + sepH / 2, mw - app.Scale(16), 1, sGrid.BgOr(0));
        iy = iy + sepH;
        // 用两个明确条目而非单个循环开关：列固定到哪侧
        // 是用户的选择，让用户连点两次
        // 摸索正确项，不如两项都显示。
        int frz = DataTable.FreezeOf(st, col);
        string pinLbl = DataTable.T("Freeze Left", "冻结到左侧");
        if (frz == 1) { pinLbl = DataTable.T("Unfreeze", "取消冻结"); }
        DataTable.CtxItem(app, mx, iy, mw, ih, pinLbl, "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            if (frz == 1) { DataTable.UnpinColumn(st, col); }
            else { DataTable.PinColumn(st, col); }
            st.hitCol = col; st.ColumnResize.Raise();
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        iy = iy + ih;
        string pinRLbl = DataTable.T("Freeze Right", "冻结到右侧");
        if (frz == 2) { pinRLbl = DataTable.T("Unfreeze", "取消冻结"); }
        DataTable.CtxItem(app, mx, iy, mw, ih, pinRLbl, "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            if (frz == 2) { DataTable.UnpinColumn(st, col); }
            else { DataTable.PinColumnRight(st, col); }
            st.hitCol = col; st.ColumnResize.Raise();
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        iy = iy + ih;
        DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Hide Column", "隐藏此列"), "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            st.colHidden[col] = true;
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        iy = iy + ih;
        if (anyHidden) {
            DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Show All Columns", "显示所有列"), "");
            if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
                DataTable.ShowAllColumns(st);
                st.hdrCtxOpen = false; app.RequestRedraw();
            }
            iy = iy + ih;
        }
        DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Column Chooser…", "列选择器…"), "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            DataTable.SetColumnChooser(st, true);
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        iy = iy + ih;

        if (canAgg) {
            c.FillRect(mx + app.Scale(8), iy + sepH / 2, mw - app.Scale(16), 1, sGrid.BgOr(0));
            iy = iy + sepH;
            int curAgg = 0;
            if (col < st.aggMode.Count) { curAgg = st.aggMode[col]; }
            iy = DataTable.AggItem(app, mx, iy, mw, ih, st, col, 1, DataTable.T("Sum", "合计"), curAgg);
            iy = DataTable.AggItem(app, mx, iy, mw, ih, st, col, 2, DataTable.T("Average", "平均"), curAgg);
            iy = DataTable.AggItem(app, mx, iy, mw, ih, st, col, 3, DataTable.T("Min", "最小"), curAgg);
            iy = DataTable.AggItem(app, mx, iy, mw, ih, st, col, 4, DataTable.T("Max", "最大"), curAgg);
            iy = DataTable.AggItem(app, mx, iy, mw, ih, st, col, 5, DataTable.T("Count", "计数"), curAgg);
            iy = DataTable.AggItem(app, mx, iy, mw, ih, st, col, 0, DataTable.T("No Total", "无汇总"), curAgg);
        }

        if (canFilter) {
            c.FillRect(mx + app.Scale(8), iy + sepH / 2, mw - app.Scale(16), 1, sGrid.BgOr(0));
            iy = iy + sepH;
            DataTable.CtxItem(app, mx, iy, mw, ih, DataTable.T("Filter", "筛选…"), "");
            if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
                DataTable.OpenFilterMenu(st, cols, src, col);
                st.hdrCtxOpen = false; app.RequestRedraw();
            }
            iy = iy + ih;
        }

        // ---- 条件格式（仅数值列）：主项点击展开子面板，再点收起 ----
        if (canAgg) {
            c.FillRect(mx + app.Scale(8), iy + sepH / 2, mw - app.Scale(16), 1, sGrid.BgOr(0));
            iy = iy + sepH;
            int cfY = iy;
            int cfH = ih;
            int cfMark = 0;
            if (cols[col].cfMode == 1) { cfMark = 1; }
            else if (cols[col].cfMode == 2) { cfMark = 2; }
            else if (cols[col].cfMode >= 3) { cfMark = 3; }
            string cfLbl = DataTable.T("Conditional Formatting", "条件格式");
            if (cfMark == 1) { cfLbl = cfLbl + " · " + DataTable.T("Data Bars", "数据条"); }
            else if (cfMark == 2) { cfLbl = cfLbl + " · " + DataTable.T("Color Scales", "色阶"); }
            else if (cfMark == 3) { cfLbl = cfLbl + " · " + DataTable.T("Highlight Rules", "高亮规则"); }
            int idCf = app.focus.AllocId();
            ContextMenu.PaintItem(app, mx, cfY, mw, cfH, cfLbl, "▶", app.focus.IsHovered(idCf));
            app.hitTester.RegisterRect(idCf, mx, cfY, mw, cfH, 0);
            // 点击主项：无子面板则展开对应组，已有子面板再点同组则收起
            if (DataTable.CtxHit(app, mx, cfY, mw, cfH)) {
                int want = 0;
                if (st.cfSubOpen == 0) {
                    want = cols[col].cfMode;
                    if (want == 0) { want = 1; }
                }
                st.cfSubOpen = want;
                app.RequestRedraw();
            }
            iy = iy + cfH;
            if (st.cfSubOpen != 0) {
                DataTable.RenderCfPanel(app, mx, cfY, mw, ih, sepH, sMenu, st, col,
                                        st.cfSubOpen, cols, src);
            }
        }

        // 点击外部关闭菜单。终结长按的那次手指抬起
        // （app.LongPressFired，标志下次按下才复位）不算
        // "外部点击"——否则触摸长按刚打开菜单就被松手关掉。
        // 子面板打开时：面板自己管理其区域外的点击（点击主菜单
        // 或面板外只收起子面板，不闪没整个菜单）。
        bool insideAny = app.mouseX >= mx && app.mouseX < mx + mw
            && app.mouseY >= my && app.mouseY < my + mh;
        if (app.EventKind() == 3 && !app.LongPressFired() && !insideAny) {
            if (st.cfSubOpen != 0) {
                st.cfSubOpen = 0;
                app.RequestRedraw();
            } else {
                st.hdrCtxOpen = false;
                app.RequestRedraw();
            }
        }
    }

}
