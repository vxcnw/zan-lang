using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

partial class ChartView {
    /// 可见散点在闭区间窗口内的原始值域；无有效点时四端均为 0。
    /// 绘制主体与悬停命中共用此 seam，避免两套域推导漂移。
    static void ScatterSpan(List<ChartSeries> series, int i0, int i1,
                            out int minX, out int maxX, out int minY, out int maxY) {
        minX = 0; maxX = 0; minY = 0; maxY = 0;
        bool seen = false;
        if (series == null) { return; }
        for (int si = 0; si < series.Count; si = si + 1) {
            ChartSeries s = series[si];
            if (s == null || s.hidden || s.points == null) { continue; }
            int j = i0;
            if (j < 0) { j = 0; }
            while (j <= i1 && j < s.points.Count) {
                int pxv = Chart.PointV(s.points[j].x, s.pointG);
                int pyv = Chart.PointV(s.points[j].y, s.pointG);
                if (!seen) {
                    minX = pxv; maxX = pxv; minY = pyv; maxY = pyv; seen = true;
                } else {
                    if (pxv < minX) { minX = pxv; }
                    if (pxv > maxX) { maxX = pxv; }
                    if (pyv < minY) { minY = pyv; }
                    if (pyv > maxY) { maxY = pyv; }
                }
                j = j + 1;
            }
        }
    }

    // ---- 散点图（双数值轴） ----

    /// 散点图入口：同帧先画主体 DrawScatterCore，再画悬停
    /// 覆盖层 ScatterHover（Core 可被缓存，命中提示始终实时）。
    static void DrawScatter(App app, int x, int y, int w, int h,
                            ChartOption o, int g) {
        ChartView.DrawScatterCore(app, x, y, w, h, o, g);
        ChartView.ScatterHover(app, x, y, w, h, o);
    }

    /// 仅散点图主体（面板、坐标轴、点）—— 不含悬停覆盖层，
    /// 可由 RenderCached 缓存（2000 点的散点云每帧只需一次像素
    /// 拷贝），命中后指针反馈再绘制于其上。
    static void DrawScatterCore(App app, int x, int y, int w, int h,
                                ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int axisFs = Style.FontFallback(app, "small");

        // 面板头走 DrawPanelI：与柱状/极坐标同一条路——标题 +
        // 图例色块（可点击切换系列显隐，放不下自动换行避让标题）。
        int top = Chart.DrawPanelI(app, x, y, w, h, o.title, o.series,
                                   o.iwid, o.showLegend);

        // dataZoom：窗口索引 [i0,i1]（含端点）；范围与点绘制
        // 都只在窗口内。点下标是各系列 points 列表的全局下标。
        int zoomH = 0;
        int fullN = 0;
        for (int si0 = 0; si0 < o.series.Count; si0 = si0 + 1) {
            if (o.series[si0].points.Count > fullN) { fullN = o.series[si0].points.Count; }
        }
        int i0 = 0;
        int i1 = fullN - 1;
        if (o.zoom && o.iwid != 0 && fullN > 1) {
            i0 = Chart.ZoomI0(app, o, o.iwid, fullN);
            i1 = Chart.ZoomI1(app, o, o.iwid, fullN);
            zoomH = app.Scale(24);
        }

        int minX = 0; int maxX = 0; int minY = 0; int maxY = 0;
        ChartView.ScatterSpan(o.series, i0, i1, out minX, out maxX, out minY, out maxY);
        // ECharts2 双 value 轴缺省 scale:true：不强制含 0，数据域走
        // nice 步长的紧致包络；显式 min/max（下方覆盖）仍固定定义域。
        ChartSpan xsp = Chart.ScatterAutoRange(minX, maxX);
        ChartSpan ysp = Chart.ScatterAutoRange(minY, maxY);
        int xLo = xsp.lo;
        int yLo = ysp.lo;
        int maxXN = xsp.hi;
        int maxYN = ysp.hi;
        int xTicksAuto = xsp.ticks;
        int yTicksAuto = ysp.ticks;
        bool xTime = o.xAxes.Count > 0 && o.xAxes[0].type == ChartAxisType.Time;
        if (xTime) {
            // 时间轴不做 nice 包络：数据域即定义域，刻度交给 TimeTicks
            // （整数天数，与折线时间轴同一套）。
            xLo = minX;
            maxXN = maxX;
            xTicksAuto = 0;
        }
        // 显式数值轴范围（ECharts xAxis/yAxis.min/max）：设了就固定
        // 定义域，数据不再参与推导——身高体重这类有自然域的散点
        // 靠它贴合原例的坐标格。
        if (o.xAxes.Count > 0 && o.xAxes[0].min != ChartOption.Auto()) {
            xLo = o.xAxes[0].min;
        }
        if (o.yAxes.Count > 0 && o.yAxes[0].min != ChartOption.Auto()) {
            yLo = o.yAxes[0].min;
        }
        if (o.xAxes.Count > 0 && o.xAxes[0].max != ChartOption.Auto()) {
            maxXN = o.xAxes[0].max;
        }
        if (o.yAxes.Count > 0 && o.yAxes[0].max != ChartOption.Auto()) {
            maxYN = o.yAxes[0].max;
        }
        // visualMap 色带：Y 值映射到颜色（与热力图同语义，通用值→色）。
        bool ramp = o.rampColors != null && o.rampColors.Count >= 2;
        // 值域数据窗：色带映射与 dataRange 过滤共用（无 ramp 时
        // 过滤仍要有定义域，否则全部点被误判为界外）。
        int dLo = yLo;
        int dHi = maxYN;
        if (o.rampLo != ChartOption.Auto()) { dLo = o.rampLo; }
        if (o.rampHi != ChartOption.Auto()) { dHi = o.rampHi; }
        int dSpan = dHi - dLo;
        if (dSpan < 1) { dSpan = 1; }
        int xSpan = maxXN - xLo;
        int ySpan = maxYN - yLo;
        if (xSpan < 1) { xSpan = 1; }
        if (ySpan < 1) { ySpan = 1; }
        int leftGut = Canvas.MeasureText(Convert.ToString(maxYN), axisFs) + app.Scale(12);
        int botGut = Canvas.FontHeight(axisFs) + app.Scale(8);
        int plotX = x + pad + leftGut;
        int plotY = top;
        int plotW = (x + w - pad) - plotX;
        int plotH = (y + h - zoomH - pad - botGut) - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        StyleBox sGrid = Style.Part(app, "chart", "grid", "", "", "",
                                    Style.SNormal());
        StyleBox sAxis = Style.Part(app, "chart", "axis", "", "", "",
                                    Style.SNormal());
        // ECharts xAxis/yAxis.splitNumber：轴显式给 ticks 就用；自动
        // 量程时用 smartSteps 的步长数（scale:true 紧致包络）。
        int yTicks = yTicksAuto;
        if (o.yAxes.Count > 0 && o.yAxes[0].ticks > 0) { yTicks = o.yAxes[0].ticks; }
        int xTicks = xTicksAuto;
        if (o.xAxes.Count > 0 && o.xAxes[0].ticks > 0) { xTicks = o.xAxes[0].ticks; }
        for (int k = 0; k <= yTicks; k = k + 1) {
            int gy = plotY + plotH - (k * plotH / yTicks);
            c.FillRect(plotX, gy, plotW, 1, sGrid.BgOr(0));
            string vs = Convert.ToString(yLo + ySpan * k / yTicks);
            if (o.yAxes.Count > 0 && o.yAxes[0].labelFormatter.Length > 0) {
                vs = o.yAxes[0].labelFormatter.Replace("{value}", vs);
            }
            int vw = Canvas.MeasureText(vs, axisFs);
            c.DrawText(plotX - app.Scale(6) - vw, Canvas.CenterTextYAt(gy, axisFs), vs, sAxis.FgOr(0), axisFs);
        }
        int xDiv = maxXN - xLo;
        if (xDiv < 1) { xDiv = 1; }
        if (xTime) {
            // 时间 X 轴：刻度/标签走 TimeTicks+TimeLabel（整数天数，
            // 与折线时间轴同一套）；数据域保持紧致包络不 nice 化。
            List<int> tts = Chart.TimeTicks(xLo, maxXN, 7);
            for (int ti = 0; ti < tts.Count; ti = ti + 1) {
                int gx = plotX + (tts[ti] - xLo) * plotW / xDiv;
                string xs = Chart.TimeLabel(tts[ti]);
                int xw = Canvas.MeasureText(xs, axisFs) + app.Scale(8);
                if (xw < app.Scale(40)) { xw = app.Scale(40); }
                // 末刻度若是 TimeTicks 补的域端点（正好压在绘图区右
                // 缘），居中标签会被窗口裁半——ECharts 只标整步刻度。
                if (ti == tts.Count - 1 && gx + xw / 2 > plotX + plotW) { continue; }
                // ECharts splitLine 横竖两向都有。
                c.FillRect(gx, plotY, 1, plotH, sGrid.BgOr(0));
                c.DrawTextCentered(gx - xw / 2, plotY + plotH + app.Scale(4), xw, botGut, xs, sAxis.FgOr(0), axisFs);
            }
        } else {
            for (int k = 0; k <= xTicks; k = k + 1) {
                int gx = plotX + k * plotW / xTicks;
                // ECharts splitLine 横竖两向都有。
                c.FillRect(gx, plotY, 1, plotH, sGrid.BgOr(0));
                string xs = Convert.ToString(xLo + xSpan * k / xTicks);
                if (o.xAxes.Count > 0 && o.xAxes[0].labelFormatter.Length > 0) {
                    xs = o.xAxes[0].labelFormatter.Replace("{value}", xs);
                }
                // 长标签（formatter 加了「类目」前缀之类）加宽居中框，
                // 短标签维持原 40px 几何。
                int xw = Canvas.MeasureText(xs, axisFs) + app.Scale(8);
                if (xw < app.Scale(40)) { xw = app.Scale(40); }
                c.DrawTextCentered(gx - xw / 2, plotY + plotH + app.Scale(4), xw, botGut, xs, sAxis.FgOr(0), axisFs);
            }
        }
        c.FillRect(plotX, plotY, app.Scale(2), plotH, sAxis.BgOr(0));
        c.FillRect(plotX, plotY + plotH, plotW, app.Scale(2), sAxis.BgOr(0));
        if (zoomH > 0) {
            Chart.DrawZoomBar(app, plotX, plotW, y + h - app.Scale(18),
                app.Scale(12), o.iwid, fullN);
        }

        int rad = app.Scale(4);
        ChartView.PushPlotClip(app, plotX, plotY, plotW, plotH);
        for (int r = 0; r < o.series.Count; r = r + 1) {
            ChartSeries s = o.series[r];
            if (!s.hidden) {
                // 形状族 / 尺寸 / 描边按系列声明；逐点 color/size 优先。
                string shape = s.symbol;
                int sRad = Chart.SymbolRadius(s.symbolSize, rad);
                int bCol = s.itemStyle.normal.borderColor;
                int bW = s.itemStyle.normal.borderWidth > 0 ? app.Scale(s.itemStyle.normal.borderWidth) : 0;
                // 散点空间中的 Line 序列绘制为连接的
                // 折线（如穿过点云的回归拟合线）；
                // 其余序列均以点绘制。
                if (s.type == ChartType.Line && s.points.Count > 1) {
                    List<int> lx = new List<int>();
                    List<int> ly = new List<int>();
                    int j0 = i0;
                    while (j0 <= i1 && j0 < s.points.Count) {
                        lx.Add(Chart.ValueXF(plotX, plotW, xLo, maxXN,
                            s.points[j0].x, s.pointG));
                        ly.Add(Chart.ValueYF(plotY, plotH, yLo, maxYN,
                            s.points[j0].y, s.pointG));
                        j0 = j0 + 1;
                    }
                    c.DrawPolyline(lx, ly, s.color, app.Scale(2));
                } else {
                    int j = i0;
                    while (j <= i1 && j < s.points.Count) {
                        int px = Chart.ValueXF(plotX, plotW, xLo, maxXN,
                            s.points[j].x, s.pointG);
                        int py = Chart.ValueYF(plotY, plotH, yLo, maxYN,
                            s.points[j].y, s.pointG);
                        int col = s.color;
                        if (s.points[j].color != 0) { col = s.points[j].color; }
                        if (ramp) {
                            int dv = Chart.PointV(s.points[j].y, s.pointG);
                            if (dv < dLo) { dv = dLo; }
                            if (dv > dHi) { dv = dHi; }
                            col = Chart.RampAt(o.rampColors, (dv - dLo) * 1000 / dSpan);
                            if (s.points[j].color != 0) { col = s.points[j].color; }
                        }
                        int jr = sRad;
                        if (s.points[j].sizeSet && s.points[j].size > 0) {
                            jr = s.points[j].size / 2;
                        } else if (s.symbolSizeFn.Length > 0) {
                            // symbolSize 回调的公式化替代：半径随该点的
                            // 坐标值（真实值）变化（面积∝值用 Sqrt 形）。
                            int v = (s.symbolSizeFn == "y" || s.symbolSizeFn == "ySqrt")
                                ? Chart.PointV(s.points[j].y, s.pointG)
                                : Chart.PointV(s.points[j].x, s.pointG);
                            if (v < 0) { v = 0 - v; }
                            if (s.symbolSizeFn == "ySqrt" || s.symbolSizeFn == "xSqrt") {
                                v = ChartView.ISqrt(v);
                            }
                            if (v > 0) { jr = v; }
                        }
                        if (!Chart.DRangeOk(app, o, o.iwid, dLo, dHi,
                                Chart.PointV(s.points[j].y, s.pointG))) {
                            col = Chart.Rgb(204, 204, 204);
                        }
                        Chart.DrawSymbol(c, px, py, jr, shape, col, bCol, bW);
                        j = j + 1;
                    }
                }
            }
        }
        c.PopClip();

        // 系列 markPoint/markLine（scatter1 的 Max/Min 标注 +
        // Average 标线）：复用值对折线的 marks 通道，把散点映射
        // 包成临时 ChartFrame；XOfValue/YOf 走与点绘制相同的
        // lo/hi 包络，命中坐标逐像素一致。
        bool anyMarks = false;
        for (int r2 = 0; r2 < o.series.Count; r2 = r2 + 1) {
            if (o.series[r2].marks.Count > 0 || o.series[r2].markLines.Count > 0) {
                anyMarks = true;
                break;
            }
        }
        if (anyMarks) {
            ChartFrame f = new ChartFrame();
            f.plotX = plotX;
            f.plotY = plotY;
            f.plotW = plotW;
            f.plotH = plotH;
            f.leftMin = yLo;
            f.leftMax = maxYN;
            f.xLo = xLo;
            f.xHi = maxXN;
            for (int r3 = 0; r3 < o.series.Count; r3 = r3 + 1) {
                ChartSeries s2 = o.series[r3];
                if (s2.hidden) { continue; }
                if (s2.marks.Count > 0) { ChartView.DrawPointsMarkPoints(app, f, s2, i0, i1); }
                if (s2.markLines.Count > 0) { ChartView.DrawSeriesMarkLines(app, f, s2, i0, i1, o); }
            }
        }
    }

    /// 散点图悬停覆盖层：在命中半径内查找最近点
    /// 并显示其坐标。在 DrawScatterCore（或
    /// RenderCached 恢复）之后绘制，使缓存的密集点云仍有实时提示。
    /// 窗口与 DrawScatterCore 锁定同一 [i0,i1]。
    static void ScatterHover(App app, int x, int y, int w, int h, ChartOption o) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int axisFs = Style.FontFallback(app, "small");

        // 仅做布局：这里绝不调用 DrawPanelI / PanelHead（它们会重绘
        // 整个面板背景盖住点）。主体已由 Core 绘制；top 用
        // PanelTopI 与 DrawPanelI 的返回值逐像素对齐（含图例换行）。
        int top = Chart.PanelTopI(app, x, y, w, o.title, o.series, o.showLegend);

        int zoomH = 0;
        int fullN = 0;
        for (int si0 = 0; si0 < o.series.Count; si0 = si0 + 1) {
            if (o.series[si0].points.Count > fullN) { fullN = o.series[si0].points.Count; }
        }
        int i0 = 0;
        int i1 = fullN - 1;
        if (o.zoom && o.iwid != 0 && fullN > 1) {
            i0 = Chart.ZoomI0(app, o, o.iwid, fullN);
            i1 = Chart.ZoomI1(app, o, o.iwid, fullN);
            zoomH = app.Scale(24);
        }

        int minX = 0; int maxX = 0; int minY = 0; int maxY = 0;
        ChartView.ScatterSpan(o.series, i0, i1, out minX, out maxX, out minY, out maxY);
        // 与 DrawScatterCore 相同的 scale:true 自动范围、显式轴范围
        // 与映射，命中检测才能落在真实的点上。
        ChartSpan xsp = Chart.ScatterAutoRange(minX, maxX);
        ChartSpan ysp = Chart.ScatterAutoRange(minY, maxY);
        int xLo = xsp.lo;
        int yLo = ysp.lo;
        int maxXN = xsp.hi;
        int maxYN = ysp.hi;
        if (o.xAxes.Count > 0 && o.xAxes[0].type == ChartAxisType.Time) {
            // 时间轴与 DrawScatterCore 相同：数据域即定义域。
            xLo = minX;
            maxXN = maxX;
        }
        if (o.xAxes.Count > 0 && o.xAxes[0].min != ChartOption.Auto()) {
            xLo = o.xAxes[0].min;
        }
        if (o.yAxes.Count > 0 && o.yAxes[0].min != ChartOption.Auto()) {
            yLo = o.yAxes[0].min;
        }
        if (o.xAxes.Count > 0 && o.xAxes[0].max != ChartOption.Auto()) {
            maxXN = o.xAxes[0].max;
        }
        if (o.yAxes.Count > 0 && o.yAxes[0].max != ChartOption.Auto()) {
            maxYN = o.yAxes[0].max;
        }
        int xSpan = maxXN - xLo;
        int ySpan = maxYN - yLo;
        if (xSpan < 1) { xSpan = 1; }
        if (ySpan < 1) { ySpan = 1; }
        int leftGut = Canvas.MeasureText(Convert.ToString(maxYN), axisFs) + app.Scale(12);
        int botGut = Canvas.FontHeight(axisFs) + app.Scale(8);
        int plotX = x + pad + leftGut;
        int plotY = top;
        int plotW = (x + w - pad) - plotX;
        int plotH = (y + h - zoomH - pad - botGut) - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        int mx = app.mouseX;
        int my = app.mouseY;
        if (mx >= plotX && mx < plotX + plotW
            && my >= plotY && my < plotY + plotH) {
            int bestS = 0 - 1;
            int bestJ = 0;
            int bestD = 0;
            for (int r2 = 0; r2 < o.series.Count; r2 = r2 + 1) {
                ChartSeries s2 = o.series[r2];
                if (!s2.hidden) {
                    int j2 = i0;
                    while (j2 <= i1 && j2 < s2.points.Count) {
                        int px2 = Chart.ValueXF(plotX, plotW, xLo, maxXN,
                            s2.points[j2].x, s2.pointG);
                        int py2 = Chart.ValueYF(plotY, plotH, yLo, maxYN,
                            s2.points[j2].y, s2.pointG);
                        int ddx = mx - px2;
                        int ddy = my - py2;
                        int d2 = ddx * ddx + ddy * ddy;
                        if (bestS < 0 || d2 < bestD) { bestS = r2; bestJ = j2; bestD = d2; }
                        j2 = j2 + 1;
                    }
                }
            }
            int hitR = app.Scale(8);
            if (bestS >= 0) {
                ChartSeries bs0 = o.series[bestS];
                ChartPoint bp0 = bs0.points[bestJ];
                hitR = Chart.SymbolRadius(bs0.symbolSize, app.Scale(4));
                if (bp0.sizeSet && bp0.size > 0) { hitR = bp0.size / 2; }
                if (bs0.symbolSizeFn.Length > 0) {
                    int sv = (bs0.symbolSizeFn == "y" || bs0.symbolSizeFn == "ySqrt")
                        ? Chart.PointV(bp0.y, bs0.pointG)
                        : Chart.PointV(bp0.x, bs0.pointG);
                    if (sv < 0) { sv = 0 - sv; }
                    if (bs0.symbolSizeFn == "ySqrt" || bs0.symbolSizeFn == "xSqrt") {
                        sv = ChartView.ISqrt(sv);
                    }
                    if (sv > 0) { hitR = sv; }
                }
                hitR = hitR + app.Scale(2);
                if (bestD > hitR * hitR) { bestS = 0 - 1; }
            }
                if (bestS >= 0) {
                    ChartSeries bs = o.series[bestS];
                ChartPoint bp = bs.points[bestJ];
                int pxHit = Chart.ValueXF(plotX, plotW, xLo, maxXN,
                    bp.x, bs.pointG);
                int pyHit = Chart.ValueYF(plotY, plotH, yLo, maxYN,
                    bp.y, bs.pointG);
                ChartElementType pointType = bs.type == ChartType.Line
                    ? ChartElementType.LinePoint : ChartElementType.ScatterPoint;
                string pointName = "#" + Convert.ToString(bestJ + 1);
                ChartHit sh = ChartHit.Of(pointType,
                    bestS, bs.name, bestJ, pointName,
                    Chart.PointV(bp.y, bs.pointG), pxHit, pyHit);
                sh.xValueSet = true;
                sh.xValue = (double)Chart.PointV(bp.x, bs.pointG);
                sh.yValueSet = true;
                sh.yValue = (double)Chart.PointV(bp.y, bs.pointG);
                sh.axisIndex = bs.axisIndex;
                ChartView.OfferActiveHit(sh);
                if (o.showTooltip) {
                    List<TooltipRow> rows = new List<TooltipRow>{
                        TooltipRow.Of(bs.color, bs.name),
                        TooltipRow.Of(bs.color,
                            "x  " + Chart.PointText(bp.x, bs.pointG)
                            + "   y  " + Chart.PointText(bp.y, bs.pointG)) };
                    ChartView.TooltipCard(app, mx, my, plotX + plotW, rows);
                }
            }
        }
    }
}
