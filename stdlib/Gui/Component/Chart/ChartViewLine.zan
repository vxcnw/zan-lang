using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

partial class ChartView {
    // ---- 折线（直线或 Catmull-Rom 平滑） ----

    /// 把原始点展开为密集折线（直线穿过，或
    /// Catmull-Rom 曲线）。填充与描边共用同一路径，
    /// 使填充区域的顶边与轮廓走完全相同的曲线
    /// （平滑描边与直线段填充之间无缝隙）。
    static void BuildPath(List<int> px, List<int> py, bool smooth,
                          List<int> ox, List<int> oy) {
        int n = px.Count;
        if (n < 1) { return; }
        if (!smooth || n < 3) {
            for (int i = 0; i < n; i = i + 1) { ox.Add(px[i]); oy.Add(py[i]); }
            return;
        }
        // 与定点路径（BuildPathFxEx，单调三次 Hermite）同一几何：
        // 面积填充（FillUnder）和虚线描边消费这里的整数路径，实线
        // 描边消费定点路径——两条路径必须逐像素一致，否则面积顶边
        // 和曲线错位、峰顶出毛刺（Catmull-Rom 过冲被钳平时尤其
        // 明显）。
        List<int> fxp = new List<int>();
        List<int> fyp = new List<int>();
        BuildPathFxEx(px, py, smooth, false, fxp, fyp);
        for (int i = 0; i < fxp.Count; i = i + 1) {
            ox.Add(fxp[i] / 256);
            oy.Add(fyp[i] / 256);
        }
    }

    /// 同一条平滑曲线（单调三次 Hermite，见 BuildPathFxEx），但
    /// 输出顶点为 16.8 定点数（1/256 px）。整数运算会把每个顶点
    /// 截断到像素网格；平缓曲线上相邻顶点会相差 0 或 1 行，
    /// 使曲线退化为平直段 + 单像素跳变，任何抗锯齿渐变都掩盖不了
    /// （这就是按真实几何采样的圆看起来平滑、
    /// 而折线曲线呈阶梯状的原因）。亚像素顶点
    /// 让描边光栅化器能采样到真实曲线的距离。
    /// 输入顶点既可以是整数像素（x 常规情形），也可以是已经
    /// 16.8 定点的坐标（堆叠面积带边界 y 来自 YOfFx）——
    /// 直线透传分支统一 ×256 会把定点输入放大 256 倍，因此
    /// 用 inFx 标志区分：定点输入直线段原样透传，曲线插值
    /// 本来就在 1/256 域内进行，两种输入自然一致。
    static void BuildPathFx(List<int> px, List<int> py, bool smooth,
                            List<int> ox, List<int> oy) {
        BuildPathFxEx(px, py, smooth, false, ox, oy);
    }

    /// BuildPathFx 的显式输入精度版本：inFx=true 时输入顶点已是
    /// 16.8 定点数，输出不再二次 ×256。
    static void BuildPathFxEx(List<int> px, List<int> py, bool smooth,
                              bool inFx, List<int> ox, List<int> oy) {
        int n = px.Count;
        if (n < 1) { return; }
        // 统一升 16.8 定点：inFx 输入已是定点（堆积路径的 x/y 都按
        // 16.8 传入），整数输入在此乘 256。平滑分支必须用同一基准，
        // 否则定点输入再乘 256 会把曲线放大 256 倍甩出绘图区。
        List<int> fx = px;
        List<int> fy = py;
        if (!inFx) {
            fx = new List<int>();
            fy = new List<int>();
            for (int i = 0; i < n; i = i + 1) {
                fx.Add(px[i] * 256);
                fy.Add(py[i] * 256);
            }
        }
        if (!smooth || n < 3) {
            for (int i = 0; i < n; i = i + 1) { ox.Add(fx[i]); oy.Add(fy[i]); }
            return;
        }
        // 单调三次 Hermite（Fritsch–Carlson）：切线取相邻割线的平均，
        // 割线变号（局部极值点）处切线归零、并限幅到两侧割线的
        // 3 倍以内。曲线因此永远落在相邻两点的包络内——极值圆滑地
        // 掠过真实数据点，既不像 Catmull-Rom 那样冲出假极值（数据
        // 顶格时越过最高格线），也不会像"过冲后钳平"那样把峰顶
        // 削成搁架。x/y 两轴独立套用，值对/轴互换模式同样成立。
        long[] mx = ChartView.MonoTangents(fx, n);
        long[] my = ChartView.MonoTangents(fy, n);
        ox.Add(fx[0]); oy.Add(fy[0]);
        for (int seg = 0; seg + 1 < n; seg = seg + 1) {
            long x1 = fx[seg]; long y1 = fy[seg];
            long x2 = fx[seg + 1]; long y2 = fy[seg + 1];
            // 包络钳制兜底：正常切限下永不触发。
            long xlo = x1 < x2 ? x1 : x2;
            long xhi = x1 < x2 ? x2 : x1;
            long ylo = y1 < y2 ? y1 : y2;
            long yhi = y1 < y2 ? y2 : y1;
            int steps = 48;
            int s = 1;
            while (s <= steps) {
                int tt = s * 1000 / steps;
                int tt2 = tt * tt / 1000;
                int tt3 = tt2 * tt / 1000;
                // Hermite 基（t 已归一化到本段）：
                // h00 = 2t³-3t²+1  h10 = t³-2t²+t
                // h01 = -2t³+3t²   h11 = t³-t²
                // 64 位中间值全程保持 1/256 精度。
                long qx = ((2 * tt3 - 3 * tt2 + 1000) * x1
                    + (tt3 - 2 * tt2 + tt) * mx[seg]
                    + (0 - 2 * tt3 + 3 * tt2) * x2
                    + (tt3 - tt2) * mx[seg + 1]) / 1000;
                long qy = ((2 * tt3 - 3 * tt2 + 1000) * y1
                    + (tt3 - 2 * tt2 + tt) * my[seg]
                    + (0 - 2 * tt3 + 3 * tt2) * y2
                    + (tt3 - tt2) * my[seg + 1]) / 1000;
                if (qx < xlo) { qx = xlo; } else if (qx > xhi) { qx = xhi; }
                if (qy < ylo) { qy = ylo; } else if (qy > yhi) { qy = yhi; }
                ox.Add((int)qx); oy.Add((int)qy);
                s = s + 1;
            }
        }
    }

    /// Fritsch–Carlson 切线（16.8 定点输入，返回 n 条切线）：
    /// 端点取单侧割线；内部割线变号（该点是局部极值）时取 0，
    /// 否则取两侧割线平均并限幅到任一侧割线的 3 倍以内——
    /// 保证每个段内不产生越出两端点的假振荡。
    static long[] MonoTangents(List<int> v, int n) {
        long[] m = new long[n];
        if (n < 2) { return m; }
        long d0 = v[1] - v[0];
        long d1 = 0;
        m[0] = d0;
        for (int i = 1; i + 1 < n; i = i + 1) {
            d0 = v[i] - v[i - 1];
            d1 = v[i + 1] - v[i];
            if (d0 * d1 <= 0) {
                m[i] = 0;
            } else {
                long avg = (d0 + d1) / 2;
                long lim = 3 * (d0 < 0 ? 0 - d0 : d0);
                long lim2 = 3 * (d1 < 0 ? 0 - d1 : d1);
                if (lim2 < lim) { lim = lim2; }
                if (avg > lim) { avg = lim; } else if (avg < 0 - lim) {
                    avg = 0 - lim;
                }
                m[i] = avg;
            }
        }
        m[n - 1] = v[n - 1] - v[n - 2];
        return m;
    }

    /// 填充密集（从左到右）路径与 baseY 之间的区域，使
    /// 顶边获得亚像素抗锯齿覆盖率。内部以
    /// 实心 1px 列填充；每列唯一的边界行按
    /// 小数覆盖率混合，使顶部呈现平滑曲线而非阶梯。
    /// ox/oy 来自 BuildPath 的整数像素路径。平滑路径细分后
    /// 相邻子步可小于 1px，逐子步只画起点列会在跨像素处成片
    /// 跳列（百叶窗条纹）。按像素列双指针推进：每列在路径上
    /// 找到覆盖该列的子步再插值顶边。
    static void FillUnder(Canvas c, List<int> ox, List<int> oy, int baseY,
                          int color, bool gradient, int topA, int botA) {
        int cnt = ox.Count;
        if (cnt < 2) { return; }
        int ii = 0;
        for (int pxc = ox[0]; pxc <= ox[cnt - 1]; pxc = pxc + 1) {
            while (ii + 2 < cnt) {
                if (ox[ii + 1] > pxc) { break; }
                ii = ii + 1;
            }
            int ax0 = ox[ii];
            int ax1 = ox[ii + 1];
            int yyF = oy[ii] * 256;
            if (ax1 > ax0 && pxc > ax0 && pxc < ax1) {
                yyF = oy[ii] * 256 + (oy[ii + 1] - oy[ii])
                    * (pxc - ax0) * 256 / (ax1 - ax0);
            }
            ChartView.FillColumnAA(c, pxc, yyF, baseY, color, gradient, topA, botA, 56);
        }
    }

    /// 单个抗锯齿填充列。yyF 是以 1/256 px 表示的小数顶部；
    /// solidA 是平铺（非渐变）填充的 alpha。
    static void FillColumnAA(Canvas c, int px, int yyF, int baseY,
                             int color, bool gradient, int topA, int botA, int solidA) {
        int iy = yyF / 256;
        int frac = yyF - iy * 256;      // 0..255：行 iy 位于路径上方的部分
        if (baseY > iy) {
            // 常规（基线在路径下方）：填 [iy+1, baseY)，边界行 iy
            // 只覆盖路径以下的部分。渐变强端贴数据线。
            int cover = 256 - frac;     // 填充对边界行 iy 的覆盖率
            int solidTop = iy + 1;
            if (gradient) {
                c.FillVGrad(px, solidTop, 1, baseY - solidTop,
                    Chart.WithAlpha(color, topA), Chart.WithAlpha(color, botA));
            } else {
                c.FillRect(px, solidTop, 1, baseY - solidTop, Chart.WithAlpha(color, solidA));
            }
            int edgeA = solidA;
            if (gradient) { edgeA = topA; }
            c.FillRect(px, iy, 1, 1, Chart.WithAlpha(color, edgeA * cover / 256));
        } else if (baseY < iy) {
            // 反向轴悬挂面积（基线在路径上方，雨量图右轴）：填
            // [baseY, iy)，边界行 iy 只覆盖路径以上的部分。渐变
            // 强端依旧贴数据线（此时在列底部）。
            if (gradient) {
                c.FillVGrad(px, baseY, 1, iy - baseY,
                    Chart.WithAlpha(color, botA), Chart.WithAlpha(color, topA));
            } else {
                c.FillRect(px, baseY, 1, iy - baseY, Chart.WithAlpha(color, solidA));
            }
            c.FillRect(px, iy, 1, 1, Chart.WithAlpha(color, topA * frac / 256));
        }
    }

    /// 堆叠色带的单个抗锯齿列：顶部和底部
    /// 边界都带小数覆盖率。底部被吸附到整像素的色带
    /// 会与下方色带（其顶部自带小数部分）形成阶梯状接缝，
    /// 使两个堆叠颜色之间的接缝参差不齐，
    /// 尽管各自顶边都平滑。对两条边都混合，
    /// 使共享行的两份覆盖率合计为一整行。
    static void FillBandColumnAA(Canvas c, int px, int topF, int botF,
                                 int color, bool gradient, int topA, int botA,
                                 int solidA) {
        if (botF <= topF) { return; }
        int iyTop = topF / 256;
        int iyBot = botF / 256;
        int edgeA = solidA;
        if (gradient) { edgeA = topA; }
        if (iyTop == iyBot) {
            int cover = botF - topF;
            c.FillRect(px, iyTop, 1, 1, Chart.WithAlpha(color, edgeA * cover / 256));
            return;
        }
        int topCover = 256 - (topF - iyTop * 256);
        c.FillRect(px, iyTop, 1, 1, Chart.WithAlpha(color, edgeA * topCover / 256));
        int solidTop = iyTop + 1;
        if (iyBot > solidTop) {
            if (gradient) {
                c.FillVGrad(px, solidTop, 1, iyBot - solidTop,
                    Chart.WithAlpha(color, topA), Chart.WithAlpha(color, botA));
            } else {
                c.FillRect(px, solidTop, 1, iyBot - solidTop,
                    Chart.WithAlpha(color, solidA));
            }
        }
        int botCover = botF - iyBot * 256;
        int bottomEdgeA = solidA;
        if (gradient) { bottomEdgeA = botA; }
        if (botCover > 0) {
            c.FillRect(px, iyBot, 1, 1,
                Chart.WithAlpha(color, bottomEdgeA * botCover / 256));
        }
    }

    /// 平滑路径经 BuildPathFx 细分成 48 步/段，相邻子步往往不足 1px——
    /// 按子步的半开像素区间 [ceil(ax0/256), ax1/256) 逐段填会整段落空
    /// （区间为空），表现为平滑堆叠面积只剩描边、带间露出大片背景。
    /// 这里改为双指针整列推进：每个像素列在两条边界路径上各找到
    /// 覆盖该列起点的子步，按列起点插值上下边界，一列不漏。
    /// solidA 是实色区 alpha：堆叠带用 255（ECharts 2 实色）；
    /// 渐变带传 <255 做半透明衰减。
    static void FillBandFx(Canvas c, List<int> topX, List<int> topY,
                           List<int> botX, List<int> botY, int color,
                           bool gradient, int topA, int botA, int solidA) {
        int cnt = topX.Count;
        if (cnt < 2) { return; }
        int bcnt = botX.Count;
        if (bcnt < 2) { return; }
        int px = (topX[0] + 255) / 256;
        int pxEnd = topX[cnt - 1] / 256;
        if (pxEnd * 256 >= topX[cnt - 1]) { pxEnd = pxEnd - 1; }
        int ti = 0;
        int bi = 0;
        while (px <= pxEnd) {
            int xF = px * 256;
            while (ti + 2 < cnt) {
                if (topX[ti + 1] > xF) { break; }
                ti = ti + 1;
            }
            while (bi + 2 < bcnt) {
                if (botX[bi + 1] > xF) { break; }
                bi = bi + 1;
            }
            int tAx0 = topX[ti];
            int tAx1 = topX[ti + 1];
            int topF = topY[ti];
            if (tAx1 > tAx0) {
                topF = topY[ti] + (topY[ti + 1] - topY[ti]) * (xF - tAx0)
                    / (tAx1 - tAx0);
            }
            int bAx0 = botX[bi];
            int bAx1 = botX[bi + 1];
            int bottomF = botY[bi];
            if (bAx1 > bAx0) {
                bottomF = botY[bi] + (botY[bi + 1] - botY[bi]) * (xF - bAx0)
                    / (bAx1 - bAx0);
            }
            ChartView.FillBandColumnAA(c, px, topF, bottomF,
                color, gradient, topA, botA, solidA);
            px = px + 1;
        }
    }

    /// 折线描边入口：BuildPathFx 亚像素路径交给 DrawPolylineFx。
    static void PolyLine(Canvas c, List<int> px, List<int> py,
                         bool smooth, int color, int th) {
        List<int> ox = new List<int>();
        List<int> oy = new List<int>();
        ChartView.BuildPathFx(px, py, smooth, ox, oy);
        c.DrawPolylineFx(ox, oy, color, th);
    }

    // ---- 折线 / 面积 / 阶梯线（可叠加柱状 + 散点） ----

    /// 混合折线图中的柱/散点覆盖层不经过各自主渲染器，
    /// 因此在同一分类槽位复算实际矩形/圆点几何，避免视觉上
    /// 可见却只能收到整图 Click 的错位。
    static void OfferCategoryOverlayHits(App app, ChartFrame f,
                                         List<string> labels,
                                         List<ChartSeries> series, int baseIdx,
                                         int g) {
        if (f == null || labels == null || labels.Count < 1 || series == null) { return; }
        if (ChartView.HoverBlocked(app)) { return; }
        int mx = app.mouseX;
        int my = app.mouseY;
        if (mx < f.plotX || mx >= f.plotX + f.plotW
            || my < f.plotY || my >= f.plotY + f.plotH) { return; }
        int n = labels.Count;
        int baseY = f.plotY + f.plotH;
        int bestD = 0;
        ChartHit best = null;
        for (int si = 0; si < series.Count; si = si + 1) {
            ChartSeries s = series[si];
            if (s == null || s.hidden || s.type == ChartType.Line) { continue; }
            int ax = s.axisIndex;
            for (int vi = 0; vi < n; vi = vi + 1) {
                int oi = baseIdx + vi;
                if (oi < 0 || oi >= s.Count()) { continue; }
                int val = s.Value(oi);
                int px = s.type == ChartType.Bar ? f.CatMid(vi, n)
                    : f.CatX(vi, n);
                int py = f.YOf(val * g / 1000, ax);
                bool inside = false;
                int d2 = 0;
                ChartElementType et = ChartElementType.ScatterPoint;
                if (s.type == ChartType.Bar) {
                    int cellW = f.CatWidth(vi, n);
                    int bw = cellW / 2;
                    int bx0 = (cellW - bw) / 2;
                    int by = py;
                    int bh = baseY - by;
                    if (bh < 0) { bh = 0; }
                    int bx = f.CatLeft(vi, n) + bx0;
                    inside = mx >= bx && mx < bx + bw
                        && my >= by && my < by + bh && bw > 0;
                    d2 = (mx - px) * (mx - px);
                    et = ChartElementType.Bar;
                } else if (s.type == ChartType.Scatter) {
                    int rr = Chart.SymbolRadius(s.symbolSize, app.Scale(3));
                    if (oi < s.data.Count && s.data[oi].sizeSet && s.data[oi].size > 0) {
                        rr = s.data[oi].size / 2;
                    }
                    rr = rr + app.Scale(2);
                    int dx = mx - px;
                    int dy = my - py;
                    d2 = dx * dx + dy * dy;
                    inside = d2 <= rr * rr;
                    et = ChartElementType.ScatterPoint;
                }
                if (inside && (best == null || d2 < bestD)) {
                    bestD = d2;
                    best = ChartView.MakeDataHit(s, si, oi, labels[vi], et,
                        px, py, val);
                }
            }
        }
        if (best != null) {
            best.pixelX = mx;
            best.pixelY = my;
            ChartView.OfferTopmostCategoryHit(best);
        }
    }

    /// 折线/面积/阶梯线渲染入口：折线族可平滑/渐变/虚线，可
    /// 混入柱状与散点覆盖层；带 dataZoom 窗口、markPoint/markLine、
    /// typed 命中与笛卡尔十字线 tooltip。
    static void DrawLines(App app, int x, int y, int w, int h,
                          ChartOption o, int g) {
        Canvas c = app.canvas;
        List<ChartSeries> series = o.series;
        List<string> labels = o.XCategories();

        // 无类目 X 轴（轴互换 yAxis=category 或 xAxis=value 的值对
        // 折线）时没有类目标签，数据窗口改取最长序列长度。
        bool noCatX = o.YAxis0().type == ChartAxisType.Category
            || o.XAxis0().type == ChartAxisType.Value;
        int axisN = 0;
        if (noCatX) {
            for (int ani = 0; ani < series.Count; ani = ani + 1) {
                ChartSeries ans = series[ani];
                if (ans.hidden) { continue; }
                if (ans.points.Count > axisN) { axisN = ans.points.Count; }
                if (ans.data.Count > axisN) { axisN = ans.data.Count; }
            }
        }
        int zoomH = 0;
        int fullN = labels.Count;
        if (axisN > fullN) { fullN = axisN; }
        int i0 = 0;
        int i1 = fullN - 1;
        if (o.zoom && o.iwid != 0 && fullN > 1) {
            i0 = Chart.ZoomI0(app, o, o.iwid, fullN);
            i1 = Chart.ZoomI1(app, o, o.iwid, fullN);
            zoomH = app.Scale(24);
        }
        List<string> winLabels = Chart.WindowLabels(labels, i0, i1);

        int maxV = Chart.NiceMax(Chart.MaxOfWindow(series, i0, i1));
        int plotTop = Chart.DrawPanelI(app, x, y, w, h, o.title, series, o.iwid, o.showLegend);
        ChartFrame f = Chart.BuildAxes(app, x, y, w, h - zoomH, plotTop, winLabels, o, series);
        if (zoomH > 0) {
            Chart.DrawZoomBar(app, f.plotX, f.plotW, y + h - app.Scale(18),
                app.Scale(12), o.iwid, fullN);
        }
        Chart.DrawMarkArea(app, f, o);

        int n = winLabels.Count;
        if (n < 1 && axisN > 0) { n = i1 - i0 + 1; }
        if (n < 1) { return; }
        int step = f.plotW / n;
        int half = step / 2;
        int th = app.Scale(2);
        int rad = app.Scale(3);
        // 拐点符号 auto 抽稀（ECharts2 showAllSymbol 缺省 false，符号
        // 只落在显示标签的主刻度上）：仅类目 X 有标签时生效，雨量图
        // 这类 3079 点密集线不再满线小圆点。showSymbol=1 全显、=0 隐藏。
        List<int> symTicks = null;
        if (n == winLabels.Count && o.XAxis0().type == ChartAxisType.Category) {
            symTicks = Chart.CategoryTicks(f, winLabels,
                Style.FontFallback(app, "small"), f.plotX, app.Scale(6),
                o.XAxis0());
        }

        ChartView.PushPlotClip(app, f.plotX, f.plotY, f.plotW, f.plotH);
        // 折线面板里柱状族系列的堆叠累计（ECharts stack 分组）：
        // 共享 stackName 的柱系列同槽叠置，transparent 底 + 变化顶的
        // 浮动柱（mix6 销售数据）靠它成立。下标 = 类目槽位。
        List<long> barStackAcc = new List<long>();
        List<string> barStackNames = new List<string>();
        for (int bz = 0; bz < n; bz = bz + 1) { barStackAcc.Add(0); }
        for (int si = 0; si < series.Count; si = si + 1) {
            ChartSeries s = series[si];
            if (!s.hidden) {
                int ax = s.axisIndex;
                int drawColor = s.color;
                if (s.itemStyle.normal.lineStyle.color != 0) {
                    drawColor = s.itemStyle.normal.lineStyle.color;
                }
                int drawWidth = s.itemStyle.normal.lineStyle.width;
                if (drawWidth <= 0) { drawWidth = 2; }
                drawWidth = app.Scale(drawWidth);
                bool showSeriesValues = o.showValues || s.labelShow;
                int labelColor = Style.Part(app, "chart", "label", "", "",
                    "", Style.SNormal()).FgOr(0);
                // 数据标签与柱状渲染器同用 medium 档（比轴标签醒目）。
                int labelFs = Style.FontFallback(app, "medium");
                if (s.label.color != 0) { labelColor = s.label.color; }
                if (s.label.fontSize > 0) { labelFs = s.label.fontSize; }

                // 折线图中的柱状族序列在折线下方绘制柱条
                // （柱线混合），类似 ECharts 的系列类型混用。
                // stackName 分组堆叠：同组柱从累计基线升起（barWidth
                // 系列级覆盖；mix6 上周2 透明柱 + 变化 柱）。
                if (ChartView.IsBarFamily(s.type)) {
                    int gi = -1;
                    if (s.stackName.Length > 0) {
                        gi = ChartView.GroupIndex(barStackNames, s.stackName);
                        if (gi < 0) {
                            barStackNames.Add(s.stackName);
                            gi = barStackNames.Count - 1;
                        }
                    }
                    for (int bi = 0; bi < n; bi = bi + 1) {
                        int cellW = f.CatWidth(bi, n);
                        int bw = cellW / 2;
                        if (s.barWidth > 0) {
                            bw = app.Scale(s.barWidth);
                            if (bw > cellW) { bw = cellW; }
                        }
                        int bx0 = (cellW - bw) / 2;
                        int oi = i0 + bi;
                        if (oi >= s.Count()) { continue; }
                        int v = s.Value(oi) * g / 1000;
                        int col = s.color;
                        if (oi < s.data.Count && s.data[oi].color != 0) { col = s.data[oi].color; }
                        if (gi < 0) {
                            int by = f.YOf(v, ax);
                            int bh = f.ZeroBase(ax) - by;
                            if (bh < 0) { bh = 0; }
                            ChartView.BarCell(c, f.CatLeft(bi, n) + bx0, by, bw, bh, app.Scale(2), col, o.gradient);
                        } else {
                            long baseV = barStackAcc[bi];
                            barStackAcc[bi] = baseV + v;
                            int by = f.YOf((int)(baseV + v), ax);
                            int bbot = f.YOf((int)baseV, ax);
                            int bh = bbot - by;
                            if (bh < 0) { bh = 0; }
                            ChartView.BarCell(c, f.CatLeft(bi, n) + bx0, by, bw, bh, app.Scale(2), col, o.gradient);
                        }
                    }
                } else if (s.type == ChartType.Scatter) {
                    // 散点覆盖层：每个类别槽位一个点
                    for (int sp = 0; sp < n; sp = sp + 1) {
                        int oi = i0 + sp;
                        if (oi >= s.Count()) { continue; }
                        int v = s.Value(oi) * g / 1000;
                        int px2 = f.CatX(sp, n);
                        int py2 = f.YOf(v, ax);
                        int scol = drawColor;
                        if (oi < s.data.Count && s.data[oi].color != 0) { scol = s.data[oi].color; }
                        Chart.DrawSymbol(c, px2, py2,
                            Chart.SymbolRadius(s.symbolSize, rad), s.symbol,
                            scol, s.itemStyle.normal.borderColor,
                            s.itemStyle.normal.borderWidth);
                    }
                } else if (ChartView.IsLineFamily(s.type)) {
                    // 一次性收集（增长后的）绘图点，填充与描边复用。
                    // 坐标模式：0 = 类目 X（默认）；1 = 值对 points（X 按
                    // 数值轴映射）；2 = 轴互换（类目在 Y，值在 X）。
                    // '-' 缺数据项断线：不进路径、不画符号、不进极值。
                    int geoMode = 0;
                    if (s.points.Count > 0) { geoMode = 1; }
                    else if (f.catY) { geoMode = 2; }
                    List<int> pxs = new List<int>();
                    List<int> pys = new List<int>();
                    List<bool> gaps = new List<bool>();
                    for (int j = 0; j < n; j = j + 1) {
                        int oi = i0 + j;
                        if (geoMode == 1) {
                            if (oi >= s.points.Count) { continue; }
                            pxs.Add(f.XOfValue(s.points[oi].x));
                            pys.Add(f.YOf(s.points[oi].y, ax));
                            gaps.Add(false);
                            continue;
                        }
                        if (oi >= s.Count()) { continue; }
                        if (geoMode == 2) {
                            pxs.Add(f.XOfValue(s.Value(oi) * g / 1000));
                            pys.Add(f.CatMidY(j, n));
                        } else {
                            pxs.Add(f.CatX(j, n));
                            pys.Add(f.YOf(s.Value(oi) * g / 1000, ax));
                        }
                        gaps.Add(oi < s.data.Count && s.data[oi].gap);
                    }

                    bool smooth = o.smooth;
                    if (s.smooth == 1) { smooth = true; } else if (s.smooth == 0) { smooth = false; }
                    bool area = s.areaStyle;
                    bool stepped = (s.step.Length > 0);
                    // 线型：solid（默认）/ dashed / dotted。虚线沿
                    // 整数路径分段绘制（不参与平滑亚像素路径）。
                    string ltype = s.itemStyle.normal.lineStyle.type;
                    if (ltype.Length == 0) { ltype = "solid"; }
                    bool dashed = ltype != "solid";
                    int dashLen = app.Scale(5);
                    int gapLen = app.Scale(3);
                    if (ltype == "dotted") { dashLen = app.Scale(2); gapLen = app.Scale(2); }

                    // 面积/柱的填充基线取所在轴的零线（ECharts
                    // 语义：负值区域的填充停在零线上方），0 不在
                    // 轴范围内时落到绘图区边。轴互换面积横向填充
                    // 暂不支持（ECharts 轴互换示例不配 areaStyle）。
                    int fillBase = geoMode == 2 ? f.plotX : f.ZeroBase(ax);

                    // '-' 断线把序列切成连续段：逐段构建（可选平滑）
                    // 路径，填充与描边共享同一曲线；描边使用亚像素
                    // (16.8) 版本使曲线轮廓按真实几何采样，填充插值
                    // 整数路径（FillUnder 已按 1/256 工作）。
                    int r0 = 0;
                    while (r0 < pxs.Count) {
                        if (gaps[r0]) { r0 = r0 + 1; continue; }
                        int r1 = r0;
                        while (r1 + 1 < pxs.Count && !gaps[r1 + 1]) { r1 = r1 + 1; }
                        List<int> rxs = new List<int>();
                        List<int> rys = new List<int>();
                        for (int rm = r0; rm <= r1; rm = rm + 1) {
                            rxs.Add(pxs[rm]); rys.Add(pys[rm]);
                        }
                        List<int> pathX = new List<int>();
                        List<int> pathY = new List<int>();
                        ChartView.BuildPath(rxs, rys, smooth, pathX, pathY);
                        List<int> fxX = new List<int>();
                        List<int> fxY = new List<int>();
                        ChartView.BuildPathFx(rxs, rys, smooth, fxX, fxY);

                        if (area && geoMode != 2) {
                            ChartView.FillUnder(c, pathX, pathY, fillBase,
                                drawColor, o.gradient, 150, 16);
                        }

                        if (stepped) {
                            // 阶梯线：水平步进 + 每点垂直跳变的连续
                            // 路径，单次描边拐角干净。
                            List<int> sx = new List<int>();
                            List<int> sy = new List<int>();
                            for (int sp = 0; sp + 1 < rxs.Count; sp = sp + 1) {
                                sx.Add(rxs[sp]); sy.Add(rys[sp]);
                                sx.Add(rxs[sp + 1]); sy.Add(rys[sp]);
                            }
                            if (rxs.Count > 0) {
                                sx.Add(rxs[rxs.Count - 1]); sy.Add(rys[rys.Count - 1]);
                            }
                            if (dashed) {
                                ChartView.DrawDashed(c, sx, sy, drawColor, drawWidth, dashLen, gapLen);
                            } else {
                                c.DrawPolyline(sx, sy, drawColor, drawWidth);
                            }
                        } else if (dashed) {
                            ChartView.DrawDashed(c, pathX, pathY, drawColor, drawWidth, dashLen, gapLen);
                        } else {
                            c.DrawPolylineFx(fxX, fxY, drawColor, drawWidth);
                        }
                        r0 = r1 + 1;
                    }

                    // 数据点符号（ECharts showSymbol/symbol/symbolSize）；
                    // 系列级/数据级 symbol:'none' 都跳过该点；showSymbol=0
                    // 只隐藏默认符号——数据级覆盖（droplet 等）仍画。
                    // 数值标签与符号解耦：无论符号画否都按 showSeriesValues
                    // 绘制（与原 if/else 两支行为一致）。
                    {
                        int nr = Chart.SymbolRadius(s.symbolSize, rad);
                        int tickCur2 = 0;
                        for (int m2 = 0; m2 < pxs.Count; m2 = m2 + 1) {
                            if (gaps[m2]) { continue; }
                            int oiN = i0 + m2;
                            int ncol = drawColor;
                            // ECharts 2.2.x 折线系列 symbol 默认 emptyCircle
                            // （空心环）；显式 symbol/showSymbol 仍按配置。
                            string sym2 = s.symbol;
                            if (sym2.Length == 0) { sym2 = "emptyCircle"; }
                            int pr = nr;
                            if (oiN < s.data.Count) {
                                if (s.data[oiN].color != 0) { ncol = s.data[oiN].color; }
                                if (s.data[oiN].symbol.Length > 0) { sym2 = s.data[oiN].symbol; }
                                if (s.data[oiN].sizeSet && s.data[oiN].size > 0) {
                                    pr = s.data[oiN].size / 2;
                                }
                            }
                            bool showSym = sym2 != "none" && sym2 != "pass"
                                && (s.symbol.Length > 0 || s.showSymbol != 0);
                            if (showSym && symTicks != null
                                && s.symbol.Length == 0 && s.showSymbol < 0) {
                                // auto（ECharts2 缺省）：符号只落在显示
                                // 标签的主刻度上（升序游标对齐）。
                                while (tickCur2 < symTicks.Count
                                    && symTicks[tickCur2] < m2) {
                                    tickCur2 = tickCur2 + 1;
                                }
                                showSym = tickCur2 < symTicks.Count
                                    && symTicks[tickCur2] == m2;
                            }
                            if (showSym) {
                                Chart.DrawSymbol(c, pxs[m2], pys[m2], pr, sym2,
                                    ncol, s.itemStyle.normal.borderColor,
                                    s.itemStyle.normal.borderWidth);
                            }
                            if (showSeriesValues) {
                                string lbl = geoMode == 1
                                    ? Convert.ToString(s.points[i0 + m2].y)
                                    : Convert.ToString(s.Value(i0 + m2));
                                int lw = Canvas.MeasureText(lbl, labelFs);
                                int lx = pxs[m2] - lw / 2;
                                if (lx < f.plotX) { lx = f.plotX; }
                                if (lx + lw > f.plotX + f.plotW) { lx = f.plotX + f.plotW - lw; }
                                // 数值底边离拐点留缝（按实测字高，替代固定
                                // 16px——字号缩放后不再压到数据点）；贴近
                                // 绘图区上缘（顶格点被 clip 裁掉）时翻到点下方。
                                int ly = pys[m2] - Canvas.FontHeight(labelFs) - app.Scale(2);
                                if (ly < f.plotY) { ly = pys[m2] + app.Scale(2); }
                                c.DrawText(lx, ly, lbl, labelColor, labelFs);
                            }
                        }
                    }
                }
            }
        }
        c.PopClip();

        // markPoint：自动 max/min + 显式 marks（仅折线族；points
        // 系列的标注走值对坐标，见下）。
        for (int msi = 0; msi < series.Count; msi = msi + 1) {
            ChartSeries ms = series[msi];
            if (!ms.hidden && ms.points.Count < 1 && !ChartView.IsBarFamily(ms.type)) {
                ChartView.DrawSeriesMarks(app, f, ms, i0, i1, step, half, o);
            }
        }
        // 系列级 markLine（average/min/max/阈值），画在系列之上。
        ChartView.PushPlotClip(app, f.plotX, f.plotY, f.plotW, f.plotH);
        for (int mli = 0; mli < series.Count; mli = mli + 1) {
            ChartSeries ml = series[mli];
            if (!ml.hidden) { ChartView.DrawSeriesMarkLines(app, f, ml, i0, i1, o); }
        }
        // 值对折线的 x 轴标注（ECharts valueIndex:0——竖直
        // max/min/average 线）与该系列的 markPoint（y/x 两轴）。
        for (int mxl = 0; mxl < series.Count; mxl = mxl + 1) {
            ChartSeries mxs = series[mxl];
            if (!mxs.hidden && mxs.points.Count > 0) {
                ChartView.DrawValueXMarkLines(app, f, mxs, i0, i1);
                ChartView.DrawPointsMarkPoints(app, f, mxs, i0, i1);
            }
        }
        c.PopClip();
        Chart.DrawMarkLine(app, f, o);
        if (axisN > 0) {
            // 值对/轴互换：无类目槽位，按最近点命中 + item tooltip。
            ChartView.PointsHover(app, f, series, i0, i1, g);
        } else {
            ChartView.OfferCategoryPointHits(app, f, winLabels, series, i0, g,
                ChartElementType.LinePoint, false);
            ChartView.OfferCategoryOverlayHits(app, f, winLabels, series, i0, g);
            if (o.showTooltip) {
                ChartView.CartesianTooltip(app, f, winLabels, series, maxV, step, half, i0);
            }
        }
    }

    // ---- 柱状图（分组 / 堆叠 / 水平） ----
    // ---- 堆叠面积图（按 stackName 分组的累计填充带） ----

    /// 堆叠面积的可视点位位于累计 top/bottom 带上，而不是原始值
    /// 的 Y。命中沿用绘制时相同的组/序列累加顺序，避免指针落在
    /// 色带上却把事件坐标解析到带外；事件 value 仍保留源项值。
    static void OfferStackedAreaHits(App app, ChartFrame f,
                                     List<string> labels,
                                     List<ChartSeries> series, int baseIdx,
                                     int g, int maxV) {
        if (f == null || labels == null || labels.Count < 1 || maxV < 1) { return; }
        if (ChartView.HoverBlocked(app)) { return; }
        int mx = app.mouseX;
        int my = app.mouseY;
        if (mx < f.plotX || mx >= f.plotX + f.plotW
            || my < f.plotY || my >= f.plotY + f.plotH) { return; }
        List<string> groups = new List<string>();
        for (int gi = 0; gi < series.Count; gi = gi + 1) {
            ChartSeries gs = series[gi];
            if (!gs.hidden && ChartView.GroupIndex(groups, gs.stackName) < 0) {
                groups.Add(gs.stackName);
            }
        }
        int bestD = 0;
        ChartHit best = null;
        int n = labels.Count;
        for (int si = 0; si < series.Count; si = si + 1) {
            ChartSeries s = series[si];
            if (s.hidden) { continue; }
            int group = ChartView.GroupIndex(groups, s.stackName);
            if (group < 0) { continue; }
            for (int vi = 0; vi < n; vi = vi + 1) {
                int oi = baseIdx + vi;
                if (oi < 0 || oi >= s.Count()) { continue; }
                int prev = 0;
                for (int pg = 0; pg < group; pg = pg + 1) {
                    for (int ps = 0; ps < series.Count; ps = ps + 1) {
                        ChartSeries psr = series[ps];
                        if (!psr.hidden && ChartView.GroupIndex(groups, psr.stackName) == pg
                            && oi < psr.Count()) { prev = prev + psr.Value(oi); }
                    }
                }
                for (int ps2 = 0; ps2 < si; ps2 = ps2 + 1) {
                    ChartSeries psr2 = series[ps2];
                    if (!psr2.hidden && psr2.stackName == s.stackName
                        && oi < psr2.Count()) { prev = prev + psr2.Value(oi); }
                }
                int val = s.Value(oi);
                int top = f.plotY + f.plotH - (prev + val) * g * f.plotH / 1000 / maxV;
                int bot = f.plotY + f.plotH - prev * g * f.plotH / 1000 / maxV;
                int lo = top < bot ? top : bot;
                int hi = top > bot ? top : bot;
                int px = f.CatX(vi, n);
                int dx = mx - px;
                int d2 = dx * dx;
                if (my >= lo && my <= hi && (best == null || d2 < bestD)) {
                    bestD = d2;
                    best = ChartView.MakeDataHit(s, si, oi, labels[vi],
                        ChartElementType.LinePoint, px, my, val);
                }
            }
        }
        int slotR = f.CatWidth(0, n);
        if (slotR < app.Scale(10)) { slotR = app.Scale(10); }
        if (best != null && bestD <= slotR * slotR) {
            best.pixelX = mx;
            best.pixelY = my;
            ChartView.OfferActiveHit(best);
        }
    }

    /// 堆叠面积图渲染入口：按 stackName 分组自下而上分层
    /// （组底 = 下方各组的逐类合计），色带亚像素填充 + 顶边
    /// 亚像素描边，可平滑/渐变；命中与 tooltip 与绘制同域。
    static void DrawStackedArea(App app, int x, int y, int w, int h,
                                ChartOption o, int g) {
        Canvas c = app.canvas;
        List<ChartSeries> series = o.series;
        List<string> labels = o.XCategories();

        // dataZoom：与折线/柱状一致，锁定窗口 [i0,i1]，
        // 渲染按窗口索引读原系列。
        int zoomH = 0;
        int fullN = labels.Count;
        int i0 = 0;
        int i1 = fullN - 1;
        if (o.zoom && o.iwid != 0 && fullN > 1) {
            i0 = Chart.ZoomI0(app, o, o.iwid, fullN);
            i1 = Chart.ZoomI1(app, o, o.iwid, fullN);
            zoomH = app.Scale(24);
        }
        List<string> winLabels = Chart.WindowLabels(labels, i0, i1);
        int n = winLabels.Count;
        // ECharts nice 量程：堆叠感知的组顶/绝对值最大取整到步长
        // 倍数（如 0..1320 → 0..1400 每 200）。
        ChartSpan sv = Chart.NiceRange(0, Chart.MaxStackGroupsW(series, n, i0));
        int maxV = sv.hi;
        int plotTop = Chart.DrawPanelI(app, x, y, w, h, o.title, series, o.iwid, o.showLegend);
        // 走 BuildAxesR（旧 DrawFrameT 硬编码 band 模式，不吃
        // boundaryGap/splitArea/类目竖网格）：堆叠顶经 leftDataMax
        // 显式传入（AxisMaxFor 不感知堆叠，只取单系列最大）。
        // 注意 maxV 已是 nice 值，AxisHi 还会对它再取整（3000→5000），
        // 线走 f.YOf 而带体走手工映射，两套量程会劈叉——期间把
        // y0.max 钉到 maxV（显式边界尊重不取整）、刻度数经
        // y0.ticks 带入，调用后一并恢复。demo 未声明 y 轴时
        // YAxis0() 每次返回临时新轴，钉不住——先实体化一根。
        if (o.yAxes.Count == 0) { o.Y(ChartAxis.Value()); }
        ChartAxis y0a = o.YAxis0();
        int savedTicks = y0a.ticks;
        int savedMax = y0a.max;
        if (sv.ticks > 0) { y0a.ticks = sv.ticks; }
        y0a.max = maxV;
        ChartFrame f = Chart.BuildAxesR(app, x, y, w, h - zoomH, plotTop,
            winLabels, o, series, maxV, 0 - 1);
        y0a.ticks = savedTicks;
        y0a.max = savedMax;
        if (zoomH > 0) {
            Chart.DrawZoomBar(app, f.plotX, f.plotW, y + h - app.Scale(18),
                app.Scale(12), o.iwid, fullN);
        }
        if (n < 1 || maxV < 1) { return; }
        int step = f.plotW / n;
        int half = step / 2;
        // 拐点符号 auto 抽稀：与 DrawLines 同语义（符号只落在显示
        // 标签的主刻度上）。
        List<int> symTicks = null;
        if (winLabels.Count > 0 && o.XAxis0().type == ChartAxisType.Category) {
            symTicks = Chart.CategoryTicks(f, winLabels,
                Style.FontFallback(app, "small"), f.plotX, app.Scale(6),
                o.XAxis0());
        }

        // 按 stackName 分组：共享名的序列叠成一个色带组，
        // 不同组自下而上分层（与堆叠柱一致）；无 stackName 的
        // 序列自成一组。每组底部 = 下方各组的逐类合计。
        List<string> grp = new List<string>();
        for (int gs = 0; gs < series.Count; gs = gs + 1) {
            ChartSeries sc = series[gs];
            if (!sc.hidden) {
                if (ChartView.GroupIndex(grp, sc.stackName) < 0) { grp.Add(sc.stackName); }
            }
        }
        int ng = grp.Count;
        if (ng < 1) { return; }
        ChartView.PushPlotClip(app, f.plotX, f.plotY, f.plotW, f.plotH);
        List<List<int>> grpBase = new List<List<int>>();
        for (int gi = 0; gi < ng; gi = gi + 1) {
            List<int> offs = new List<int>();
            for (int j = 0; j < n; j = j + 1) {
                int oi = i0 + j;
                int sum = 0;
                for (int lg = 0; lg < gi; lg = lg + 1) {
                    for (int ls = 0; ls < series.Count; ls = ls + 1) {
                        ChartSeries lsc = series[ls];
                        if (!lsc.hidden && lsc.stackName == grp[lg] && oi < lsc.Count()) {
                            sum = sum + lsc.Value(oi);
                        }
                    }
                }
                offs.Add(sum);
            }
            grpBase.Add(offs);
        }

        // 跨组共享的堆叠边界（下一带的底边 = 上一堆叠系列的顶边）
        // 记录其 smooth 标志；两侧各画各的会在极值处岔开漏白。
        int boundarySmooth = 0 - 1;
        for (int gi2 = 0; gi2 < ng; gi2 = gi2 + 1) {
            List<int> inCum = new List<int>();
            for (int j2 = 0; j2 < n; j2 = j2 + 1) { inCum.Add(grpBase[gi2][j2]); }
            for (int si = 0; si < series.Count; si = si + 1) {
                ChartSeries s = series[si];
                if (s.hidden || s.stackName != grp[gi2]) { continue; }
                // ECharts 语义：stack 非空才参与堆叠（顶 = 底组累计 +
                // 自值）；完全无堆叠声明的系列（多级控制的搜索引擎，
                // stack=0 且无 stackName）画绝对值，面积填到零线。
                // areaStyle 只决定填充——没配的系列只描边（此前一律
                // 填带，与 ECharts 不符）。
                bool stacked = s.stackName.Length > 0 || s.stack != 0;
                List<int> topY = new List<int>();
                List<int> botY = new List<int>();
                // 带边界的 16.8 定点 Y（YOfFx）：整数 Y 把边界量化到
                // 整行，斜坡上每列硬跳 1 行——面积边缘锯齿的根源。
                // 定点列表直接喂 FillBandFx（亚像素光栅化）；整数
                // topY 仍供符号与命中复用。
                List<int> topYFx = new List<int>();
                List<int> botYFx = new List<int>();
                for (int j = 0; j < n; j = j + 1) {
                    int oi = i0 + j;
                    int prev = inCum[j];
                    int val = 0;
                    if (oi < s.Count()) { val = s.Value(oi); }
                    if (stacked) {
                        int cumG = (prev + val) * g / 1000;
                        int prevG = prev * g / 1000;
                        topY.Add(f.plotY + f.plotH - (cumG * f.plotH / maxV));
                        botY.Add(f.plotY + f.plotH - (prevG * f.plotH / maxV));
                        topYFx.Add(f.YOfFx(cumG, 0));
                        botYFx.Add(f.YOfFx(prevG, 0));
                    } else {
                        int absG = val * g / 1000;
                        topY.Add(f.plotY + f.plotH - (absG * f.plotH / maxV));
                        botY.Add(f.plotY + f.plotH);
                        topYFx.Add(f.YOfFx(absG, 0));
                        botYFx.Add((f.plotY + f.plotH) * 256);
                    }
                }
                List<int> xs = new List<int>();
                for (int xi = 0; xi < n; xi = xi + 1) {
                    xs.Add(f.CatX(xi, n));
                }
                bool smooth = o.smooth;
                if (s.smooth == 1) { smooth = true; } else if (s.smooth == 0) { smooth = false; }
                // 底边沿用下方堆叠系列的 smooth（共享边界同一条折线）。
                bool botSmooth = smooth;
                if (stacked && boundarySmooth >= 0) {
                    botSmooth = boundarySmooth != 0;
                }
                // 系列级个性化线样式（多级控制 直接访问：红 + dashed）
                int strokeCol = s.color;
                if (s.itemStyle.normal.lineStyle.color != 0) {
                    strokeCol = s.itemStyle.normal.lineStyle.color;
                }
                int strokeW = s.itemStyle.normal.lineStyle.width;
                if (strokeW <= 0) { strokeW = 2; }
                strokeW = app.Scale(strokeW);
                string lt = s.itemStyle.normal.lineStyle.type;
                if (lt.Length == 0) { lt = "solid"; }
                // '-' 断线：连续非 gap 段各自成路径（gap 项不进路径，
                // 堆叠累计仍按 0 计）。
                int r0 = 0;
                while (r0 < n) {
                    if (i0 + r0 < s.data.Count && s.data[i0 + r0].gap) {
                        r0 = r0 + 1;
                        continue;
                    }
                    int r1 = r0;
                    while (r1 + 1 < n
                           && !(i0 + r1 + 1 < s.data.Count && s.data[i0 + r1 + 1].gap)) {
                        r1 = r1 + 1;
                    }
                    List<int> rxs = new List<int>();
                    List<int> rt = new List<int>();
                    List<int> rb = new List<int>();
                    List<int> rtFx = new List<int>();
                    List<int> rbFx = new List<int>();
                    // inFx=true 要求 x/y 同为 16.8 定点：y 来自 YOfFx，
                    // x 是整数像素，这里统一升定点——否则 x 落在定点域
                    // 1/256 处，整条描边/带体被压到绘图区左缘裁没
                    //（line2/line4 只剩拐点符号的根因）。
                    List<int> rxsFx = new List<int>();
                    for (int rm = r0; rm <= r1; rm = rm + 1) {
                        rxs.Add(xs[rm]); rt.Add(topY[rm]); rb.Add(botY[rm]);
                        rtFx.Add(topYFx[rm]); rbFx.Add(botYFx[rm]);
                        rxsFx.Add(xs[rm] * 256);
                    }
                    List<int> topFx = new List<int>();
                    List<int> topPath = new List<int>();
                    List<int> botFx = new List<int>();
                    List<int> botPath = new List<int>();
                    // 填充与描边共用定点路径（x/y 同域）；虚线分支仍走
                    // 整数 BuildPath（rt/rb）。
                    ChartView.BuildPathFxEx(rxsFx, rtFx, smooth, true, topFx, topPath);
                    ChartView.BuildPathFxEx(rxsFx, rbFx, botSmooth, true, botFx, botPath);
                    if (s.areaStyle) {
                        // ECharts 2 堆积面积 = 实色带（255）；o.gradient
                        // （邮件营销式纵向渐变）保留半透明衰减。
                        int fa = o.gradient ? 150 : 255;
                        int fb = o.gradient ? 40 : 255;
                        ChartView.FillBandFx(c, topFx, topPath, botFx, botPath,
                            s.color, o.gradient, fa, fb, o.gradient ? 90 : 255);
                    }
                    if (rt.Count > 1) {
                        List<int> grad = s.itemStyle.normal.lineStyle.gradStops;
                        if (grad != null && grad.Count >= 2) {
                            // 横向渐变描边（zrColor.getLinearGradient 语义）：
                            // 按密集路径 x 的相对位置逐段取色；与虚线型并存
                            // 时渐变优先（ECharts 多级控制 搜索引擎线）。
                            int x0f = topFx[0];
                            int spanF = topFx[topFx.Count - 1] - x0f;
                            if (spanF < 1) { spanF = 1; }
                            for (int gp = 0; gp + 1 < topFx.Count; gp = gp + 1) {
                                int midF = (topFx[gp] + topFx[gp + 1]) / 2;
                                int tt = (midF - x0f) * 1000 / spanF;
                                if (tt < 0) { tt = 0; }
                                if (tt > 1000) { tt = 1000; }
                                int segCol = Chart.RampAt(grad, tt);
                                List<int> sgx = new List<int>();
                                List<int> sgy = new List<int>();
                                sgx.Add(topFx[gp]); sgy.Add(topPath[gp]);
                                sgx.Add(topFx[gp + 1]); sgy.Add(topPath[gp + 1]);
                                c.DrawPolylineFx(sgx, sgy, segCol, strokeW);
                            }
                        } else if (lt == "solid") {
                            c.DrawPolylineFx(topFx, topPath, strokeCol, strokeW);
                        } else {
                            List<int> sx2 = new List<int>();
                            List<int> sy2 = new List<int>();
                            ChartView.BuildPath(rxs, rt, smooth, sx2, sy2);
                            int dash = lt == "dotted" ? app.Scale(2) : app.Scale(5);
                            int gap2 = lt == "dotted" ? app.Scale(2) : app.Scale(3);
                            ChartView.DrawDashed(c, sx2, sy2, strokeCol, strokeW,
                                dash, gap2);
                        }
                    }
                    r0 = r1 + 1;
                }
                // 拐点符号（ECharts symbol/symbolSize + 逐项覆盖）。系列级
                // symbol:'none'（sanitize 归 "" + showSymbol=0）只隐藏默认
                // 符号——数据级 symbol 覆盖（mail 的 droplet）仍要画。
                {
                    int rad = app.Scale(3);
                    int nr = Chart.SymbolRadius(s.symbolSize, rad);
                    int tickCur3 = 0;
                    for (int u = 0; u < n; u = u + 1) {
                        int oi2 = i0 + u;
                        if (oi2 >= s.Count()) { continue; }
                        if (oi2 < s.data.Count && s.data[oi2].gap) { continue; }
                        string sym2 = s.symbol;
                        // ECharts 2.2.x 折线系列 symbol 默认 emptyCircle。
                        if (sym2.Length == 0) { sym2 = "emptyCircle"; }
                        int scol = strokeCol;
                        int pr = nr;
                        if (oi2 < s.data.Count) {
                            if (s.data[oi2].symbol.Length > 0) { sym2 = s.data[oi2].symbol; }
                            if (s.data[oi2].color != 0) { scol = s.data[oi2].color; }
                            // ECharts 数据级 symbolSize 覆盖（star 15、
                            // emptypin 8、star6 20…）
                            if (s.data[oi2].sizeSet && s.data[oi2].size > 0) {
                                pr = s.data[oi2].size / 2;
                            }
                        }
                        if (sym2 == "none" || sym2 == "pass") { continue; }
                        if (s.symbol.Length == 0 && s.showSymbol == 0) { continue; }
                        if (symTicks != null && s.symbol.Length == 0
                            && s.showSymbol < 0) {
                            // auto：符号只落在显示标签的主刻度上。
                            while (tickCur3 < symTicks.Count
                                && symTicks[tickCur3] < u) {
                                tickCur3 = tickCur3 + 1;
                            }
                            if (tickCur3 >= symTicks.Count
                                || symTicks[tickCur3] != u) { continue; }
                        }
                        Chart.DrawSymbol(c, xs[u], topY[u], pr, sym2, scol,
                            s.itemStyle.normal.borderColor,
                            s.itemStyle.normal.borderWidth);
                    }
                }
                for (int u = 0; u < n; u = u + 1) {
                    int oi2 = i0 + u;
                    if (oi2 < s.Count()) { inCum[u] = inCum[u] + s.Value(oi2); }
                }
                if (stacked) { boundarySmooth = smooth ? 1 : 0; }
            }
        }
        c.PopClip();
        ChartView.OfferStackedAreaHits(app, f, winLabels, series, i0, g, maxV);
        if (o.showTooltip) {
            ChartView.CartesianTooltip(app, f, winLabels, series, maxV, step, half, i0);
        }
    }
}

