using System;

// A static method reached through an instance (`d.StaticMethod(...)`) is legal:
// it has no receiver parameter, so the receiver is not passed. Emitting it
// anyway shifted every argument by one and failed LLVM verification with an
// argument-count mismatch far from the call site (the `compref_designer`
// regression), so this pins all four receiver shapes.
class Counter {
    static int sTotal;

    public int n;

    public Counter(int v) { n = v; }

    public static int Add(int a, int b) { return a + b; }
    public static string Tag(string s) { return "[" + s + "]"; }
    public static int Bump() { sTotal = sTotal + 1; return sTotal; }

    public int Inst(int k) { return this.n + k; }
}

class Prog {
    static void Main() {
        Counter c = new Counter(10);
        // static through a local instance: no receiver, args unshifted
        Console.WriteLine(Convert.ToString(c.Add(3, 4)));
        Console.WriteLine(c.Tag("x"));
        Console.WriteLine(Convert.ToString(c.Bump()));
        Console.WriteLine(Convert.ToString(c.Bump()));
        // an instance method through the same local still passes its receiver
        Console.WriteLine(Convert.ToString(c.Inst(5)));
        // static through the type name and through a temporary receiver
        Console.WriteLine(Convert.ToString(Counter.Add(1, 2)));
        Console.WriteLine(Convert.ToString(new Counter(1).Add(8, 9)));
        Console.WriteLine(Convert.ToString(c.Add(-1, 1)));
    }
}
