// Conformance: the NativeMemory.GetString intrinsic must hand the caller an
// OWNED (+1) ARC string. It is lowered by the compiler (emit_native_memory_call
// builds a real string via emit_string_alloc_rc + memcpy), but it is DECLARED
// as a bodyless [DllImport] -- so the borrowed-extern rule in
// expr_yields_owned_rc_value used to claim it and every consumer site leaked
// exactly one reference per execution: one leaked copy of the raw HTTP request
// head per request on every WebApp/HttpServer connection.
//
// Every consumer shape must balance: a discarded call, a local binding in a
// loop, an argument temp, a return. Run under the leakcheck twin
// (leakcheck_native_memory_getstring) -- 0 objects may remain at exit.
using System;

class Program {
    // [DllImport] declaration only types the call; the compiler recognizes
    // NativeMemory.GetString and lowers it internally.
    [DllImport("zanrt_mem")]
    static extern string GetString(byte[] bytes, int offset, int count);

    static string EchoHead(byte[] bytes) {
        return NativeMemory.GetString(bytes, 0, 4);
    }

    static int Main() {
        byte[] bytes = new byte[8];
        for (int i = 0; i < 8; i = i + 1) { bytes[i] = 65 + i; }

        // discarded result (the shape HttpRequest.Parse's framer head took)
        NativeMemory.GetString(bytes, 0, 4);

        // local binding released and re-assigned in a loop (the shape the
        // per-request framer loop exercised 200k times)
        string s = "";
        int total = 0;
        while (total < 1000) {
            s = NativeMemory.GetString(bytes, 0, 8);
            total = total + s.Length;
        }
        if (s != "ABCDEFGH") { return 1; }

        // argument temp
        if (EchoHead(bytes) != "ABCD") { return 2; }

        Console.WriteLine("total=" + Convert.ToString(total));
        return 0;
    }
}
