using System;
namespace Conf;

// 回归:INT_MIN / -1 与 LONG_MIN / -1 曾让进程在硬件 #DE 异常里
// 挂死(软失败路径只折了除零,溢出组合仍执行真实 idiv)。
// 修复后溢出组合折为除 1,结果饱和到 MIN(ARM64 sdiv 语义,
// 与 C# unchecked 在 ARM 上一致);x/0 -> x、x%0 -> 0 软契约同时锁定。
class Program {
    static void Main() {
        int lo = -2147483647 - 1;
        int m = -1;
        int q = lo / m;
        Console.WriteLine(q);
        int r = lo % m;
        Console.WriteLine(r);
        long lmin = -9223372036854775807L - 1;
        long lm = -1L;
        Console.WriteLine(lmin / lm);
        Console.WriteLine(lmin % lm);
        // 非溢出除法不受折叠影响
        Console.WriteLine(10 / -1);
        Console.WriteLine(10 % -1);
        Console.WriteLine(-7 / 3);
        // 软失败契约:除零报错后继续,x/0 -> x,x%0 -> 0
        int z = 0;
        int dz = 10 / z;
        Console.WriteLine(dz);
        int dz2 = 10 % z;
        Console.WriteLine(dz2);
    }
}
