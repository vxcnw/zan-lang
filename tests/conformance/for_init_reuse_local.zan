using System;
namespace Conf;
class Program {
    static void Main() {
        // A for whose init assigns an already-declared local must still run
        // (regression: the bare-expression init was silently dropped and the
        // loop read a stale slot, so it never executed).
        int r;
        int n = 0;
        for (r = 0; r < 3; r = r + 1) {
            n = n + 10;
        }
        Console.WriteLine(n);
        Console.WriteLine(r);
        // Declaring form keeps working.
        int m = 0;
        for (int i = 0; i < 4; i = i + 1) {
            m = m + 1;
        }
        Console.WriteLine(m);
        // Nested reuse of an outer local inside a method with several loops.
        int k;
        int total = 0;
        for (k = 0; k < 2; k = k + 1) { total = total + 1; }
        for (k = 5; k > 3; k = k - 1) { total = total + 100; }
        Console.WriteLine(total);
    }
}
