using System;
namespace Conf;

// 回归(D16):语言没有 >>> 无符号右移。补 C# 语义:无论如何操作数的
// 有号性,一律逻辑右移(高位补零)。注意 Zan 的 int 算术在 i64 槽上
// 做(>> 对负数算术移位即在同一槽上),所以 -8 >>> 1 的结果与 C# 的
// long 行为一致(9223372036854775804);要 C# int 宽度的逻辑结果,
// 先 (& 0xFFFFFFFF) 再 >>>。uint/ulong 槽零扩展,与 C# 完全一致。
// 同批:>>>= 复合赋值。
class Program {
    static void Main() {
        int neg = -16;
        Console.WriteLine(neg >> 2);       // -4(算术)
        Console.WriteLine(neg >>> 2);      // 4611686018427387900
        long ln = -9223372036854775807L;
        Console.WriteLine(ln >>> 60);      // 8
        int m1 = -1;
        Console.WriteLine(m1 >>> 28);      // 68719476735
        uint u = 0x80000000u;
        Console.WriteLine(u >>> 4);        // 134217728
        Console.WriteLine(u >>> 31);       // 1
        byte b = 0xFF;
        Console.WriteLine(b >>> 4);        // 15
        // 32 位图案的逻辑结果(int 槽先掩 32 位)
        Console.WriteLine((((long)m1) & 0xFFFFFFFFL) >>> 28);   // 15
        // 复合赋值
        int x = -16;
        x >>>= 2;
        Console.WriteLine(x);              // 4611686018427387900
        Console.WriteLine("end");
    }
}
