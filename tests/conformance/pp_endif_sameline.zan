// Conformance: a preprocessor directive must not swallow a second directive
// written on the same line. `#if 0 x #endif` used to consume the #endif along
// with `x`, so the conditional stayed open and every later declaration was
// silently skipped (only an "unterminated #if" warning hinted at it).
#if 0 x #endif
class Program {
    static void Main() {
        Console.WriteLine(7);
    }
}
