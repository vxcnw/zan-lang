// Regression: `delegate += lambda` used to slip past the checker (an untyped
// lambda types as error, which suppressed the generic operator rejection)
// and reached irgen, which lowered the desugared `d = d + lambda` as integer
// addition on a pointer -- an internal "LLVM verification failed" instead of
// a diagnostic. Delegates are single-cast (no runtime combine record);
// multicast subscription lives on UiEvent, whose op_add the operator path
// already handles.
class Program {
    static void Main() {
        Action<string> log = null;
        log += (string m) => { Console.WriteLine("h:" + m); };
        log("a");
    }
}
