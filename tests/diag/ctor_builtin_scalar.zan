// Regression: `new string(byte[])` used to pass the checker (the ctor
// availability check only looked at classes) and irgen's new lowering had no
// case for scalar primitives either -- its fall-through returned literal 0,
// so the variable silently became null and the failure surfaced far from the
// cause as an unrelated fault (the null-index SIGSEGV family). The builtin
// scalar primitives have no constructors; build strings from literals,
// casts or the conversion functions instead.
using System;
class Program {
    static int Main() {
        byte[] bs = new byte[] { 65, 66 };
        string s = new string(bs);
        return s.Length;
    }
}
