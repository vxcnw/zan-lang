// The Yuri third side: catalog wiring, the mind-control shot, the AI playing
// side 2, and the Neutral renumber to 3. Headless, synthetic map -- same
// contract as objects.zan.
using System;
using System.Collections.Generic;
using Ra2.Formats;
using Ra2.Game;

class YuriTest {

    // An 11-byte IsoMapPack5 record for a cell (clear ground).
    static void PutCell(byte[] buf, int at, int x, int y) {
        buf[at] = (byte)(x & 0xFF);
        buf[at + 1] = (byte)((x >> 8) & 0xFF);
        buf[at + 2] = (byte)(y & 0xFF);
        buf[at + 3] = (byte)((y >> 8) & 0xFF);
        buf[at + 4] = (byte)1;
        buf[at + 5] = (byte)0;
        buf[at + 6] = (byte)0;
        buf[at + 7] = (byte)0;
        buf[at + 8] = (byte)0;          // subTile
        buf[at + 9] = (byte)0;          // level
        buf[at + 10] = (byte)0;         // iceGrowth
    }

    static IsoMap BuildMap() {
        int n = 20 * 20;
        byte[] buf = new byte[n * 11 + 1];
        int i = 0;
        for (int y = 0; y < 20; y = y + 1) {
            for (int x = 0; x < 20; x = x + 1) {
                YuriTest.PutCell(buf, i * 11, x, y);
                i = i + 1;
            }
        }
        return IsoMap.Parse(buf, n * 11, 20, 20);
    }

    static int BuildIdOf(StructureCatalog sc, int side, string reg) {
        for (int i = 0; i < sc.CountFor(side); i = i + 1) {
            StructureType t = sc.TypeFor(side, i);
            if (t != null && t.Reg() == reg) { return i; }
        }
        return -1;
    }

    static int UnitIdOf(UnitCatalog uc, int side, string reg) {
        for (int i = 0; i < uc.ListFor(side).Count; i = i + 1) {
            if (uc.ListFor(side)[i].Reg() == reg) { return i; }
        }
        return -1;
    }

    static void Main() {
        Rules r = Rules.Default();

        // ---- the roster reaches the Yuri catalog ----------------------------
        {
            StructureCatalog sc = StructureCatalog.CreateWith(r);
            UnitCatalog uc = UnitCatalog.CreateWith(r);
            Console.WriteLine("y_side_count=" + Convert.ToString(Side2.Count()));
            Console.WriteLine("y_neutral=" + Convert.ToString(Side2.Neutral()));
            Console.WriteLine("y_units=" + Convert.ToString(uc.ListFor(Side2.Yuri()).Count));
            Console.WriteLine("y_builds=" + Convert.ToString(sc.CountFor(Side2.Yuri())));
            Console.WriteLine("y_init_id=" + Convert.ToString(UnitIdOf(uc, Side2.Yuri(), "INIT")));
            Console.WriteLine("y_lasher_tur=" + uc.ListFor(Side2.Yuri())[UnitIdOf(uc, Side2.Yuri(), "LTNK")].TurretVxl());
            Console.WriteLine("y_barracks=" + Convert.ToString(BuildIdOf(sc, Side2.Yuri(), "YABRCK")));
            StructureType refn = sc.TypeFor(Side2.Yuri(), BuildIdOf(sc, Side2.Yuri(), "YAREFN"));
            StructureType tower = sc.TypeFor(Side2.Yuri(), BuildIdOf(sc, Side2.Yuri(), "YAPSYT"));
            Console.WriteLine("y_refinery=" + Convert.ToString(refn != null && refn.IsRefinery()));
            Console.WriteLine("y_tower_weapon=" + Convert.ToString(tower == null ? -1 : tower.Damage()));
            Console.WriteLine("y_tower_range=" + Convert.ToString(tower == null ? -1 : tower.Range()));
            // The Yuri harvester comes out of its refinery like the others'.
            Console.WriteLine("y_harv=" + Convert.ToString(UnitIdOf(uc, Side2.Yuri(), "SMIN") == uc.HarvesterIdFor(Side2.Yuri())));
            // Prereq aliases resolve against Yuri buildings too: POWER
            // matches YAPOWR, so the Yuri barracks can ever be built.
            Console.WriteLine("y_prereq_slots=" + Convert.ToString(uc.ListFor(Side2.Yuri())[UnitIdOf(uc, Side2.Yuri(), "INIT")].Prereqs().Count));
        }

        // ---- the AI plays side 2 and fights the player ----------------------
        {
            IsoMap iso = YuriTest.BuildMap();
            World w = World.Create(iso, StructureCatalog.CreateWith(r),
                                   UnitCatalog.CreateWith(r));
            GameController gc = GameController.Create(w, Side2.Allied());
            Console.WriteLine("y_enemy=" + Convert.ToString(gc.EnemySide()));
            w.PlaceStructure(Side2.Allied(), 0, 1, 2);
            w.PlaceStructure(Side2.Allied(), BuildIdOf(w.Catalog(),
                             Side2.Allied(), "GAPILE"), 6, 2);
            w.PlaceEnemyBase(Side2.Yuri());
            Console.WriteLine("y_yuri_base=" + Convert.ToString(
                w.SideEliminated(Side2.Yuri()) == false));
            // Neutral is now 3: a civ structure belongs to no combatant.
            int civBefore = 0;
            for (int i = 0; i < w.ObjectCount(); i = i + 1) {
                if (w.ObjectAt(i).Side() == Side2.Neutral()) { civBefore = civBefore + 1; }
            }
            Console.WriteLine("y_neutral_objs=" + Convert.ToString(civBefore));
            int guard = 0;
            while (guard < 500 && gc.Result() == 0) {
                guard = guard + 1;
                gc.Tick();
            }
            int yuriObjs = 0;
            for (int i = 0; i < w.ObjectCount(); i = i + 1) {
                WorldObject o = w.ObjectAt(i);
                if (o.Side() == Side2.Yuri() && !o.IsDead()) { yuriObjs = yuriObjs + 1; }
            }
            Console.WriteLine("y_ticked=" + Convert.ToString(guard));
            Console.WriteLine("y_yuri_objs=" + Convert.ToString(yuriObjs > 0));
            Console.WriteLine("y_result=" + Convert.ToString(gc.Result()));
        }

        // ---- mind control converts, immunity holds --------------------------
        {
            IsoMap iso = YuriTest.BuildMap();
            World w = World.Create(iso, StructureCatalog.CreateWith(r),
                                   UnitCatalog.CreateWith(r));
            // The Soviet-side Yuri unit carries the MindControl gun with a
            // clean 7-cell reach; INIT's PsychicJab is a short jab.
            int yuriId = UnitIdOf(w.Units(), Side2.Soviet(), "YURI");
            int giId = UnitIdOf(w.Units(), Side2.Allied(), "E1");
            int tanyaId = UnitIdOf(w.Units(), Side2.Allied(), "TANY");
            int a = w.SpawnUnit(Side2.Soviet(), yuriId, 5, 5);
            int b = w.SpawnUnit(Side2.Allied(), giId, 8, 5);
            int c = w.SpawnUnit(Side2.Allied(), tanyaId, 5, 8);
            Console.WriteLine("y_spawn_abc=" + Convert.ToString(a >= 0) + ","
                + Convert.ToString(b >= 0) + "," + Convert.ToString(c >= 0));
            WorldObject psi = w.ObjectAt(a);
            WorldObject victim = w.ObjectAt(b);
            WorldObject hero = w.ObjectAt(c);
            w.AttackObject(a, victim);
            int guard = 0;
            while (guard < 60) {
                if (victim.IsDead() || victim.Side() == Side2.Soviet()) { break; }
                guard = guard + 1;
                w.Tick();
            }
            Console.WriteLine("y_mc_convert=" + Convert.ToString(victim.Side() == Side2.Soviet()));
            Console.WriteLine("y_mc_alive=" + Convert.ToString(victim.IsDead() == false));
            // Tanya is mind-immune: the shot damages but never converts.
            w.AttackObject(a, hero);
            int guard2 = 0;
            while (guard2 < 60) {
                if (hero.IsDead() || hero.Side() != Side2.Allied()) { break; }
                guard2 = guard2 + 1;
                w.Tick();
            }
            Console.WriteLine("y_mc_immune=" + Convert.ToString(hero.IsDead() == false && hero.Side() == Side2.Allied()));
            Console.WriteLine("y_attacker_gone_ok=" + Convert.ToString(psi.IsDead() == false || psi.Side() == Side2.Soviet()));
        }

        // ---- shell picks three sides ----------------------------------------
        {
            Shell s = Shell.Create(1);
            s.OpenSkirmish();
            s.SetSide(Side.Yuri());
            Console.WriteLine("y_shell_side=" + Side.NameOf(s.SideIndex()));
            s.ToggleSide();
            Console.WriteLine("y_shell_wrap=" + Side.NameOf(s.SideIndex()));
            s.SetSide(9);
            Console.WriteLine("y_shell_bogus=" + Side.NameOf(s.SideIndex()));
        }
    }
}
