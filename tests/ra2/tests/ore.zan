using System;
using System.Collections.Generic;
using Ra2.Formats;
using Ra2.Game;

// Regression tests for the ore economy: the ore grid, the mining passes and
// the full harvester loop -- seek ore, fill the hold, dock at a refinery,
// unload into the side's funds. The map is a synthetic 20x20 grid of clear
// cells; no game data is read.
class OreTest {

    // An 11-byte IsoMapPack5 record for a cell.
    static void PutCell(byte[] buf, int at, int x, int y) {
        buf[at] = (byte)(x & 0xFF);
        buf[at + 1] = (byte)((x >> 8) & 0xFF);
        buf[at + 2] = (byte)(y & 0xFF);
        buf[at + 3] = (byte)((y >> 8) & 0xFF);
        buf[at + 4] = (byte)1;
        buf[at + 5] = (byte)0;
        buf[at + 6] = (byte)0;
        buf[at + 7] = (byte)0;
        buf[at + 8] = (byte)0;          // subTile
        buf[at + 9] = (byte)0;          // level
        buf[at + 10] = (byte)0;         // iceGrowth
    }

    static IsoMap BuildMap() {
        int n = 20 * 20;
        byte[] buf = new byte[n * 11 + 1];
        int i = 0;
        for (int y = 0; y < 20; y = y + 1) {
            for (int x = 0; x < 20; x = x + 1) {
                OreTest.PutCell(buf, i * 11, x, y);
                i = i + 1;
            }
        }
        return IsoMap.Parse(buf, n * 11, 20, 20);
    }

    static int BuildIdOf(StructureCatalog sc, int side, string reg) {
        for (int i = 0; i < sc.ListFor(side).Count; i = i + 1) {
            StructureType t = sc.TypeFor(side, i);
            if (t != null && t.Reg() == reg) { return i; }
        }
        return 0 - 1;
    }

    static WorldObject FindHarvester(World w, int side) {
        for (int i = 0; i < w.ObjectCount(); i = i + 1) {
            WorldObject o = w.ObjectAt(i);
            if (o.Side() != side || o.Kind() != ObjKind.Unit()) { continue; }
            if (o.UnitType() != null
             && o.UnitType().Role() == UnitRole.Harvester()) { return o; }
        }
        return null;
    }

    static void Main() {
        // ---- rules helpers ------------------------------------------------
        Console.WriteLine("yesno_yes=" + Convert.ToString(Rules.YesNo("yes")));
        Console.WriteLine("yesno_upper=" + Convert.ToString(Rules.YesNo("YES")));
        Console.WriteLine("yesno_no=" + Convert.ToString(Rules.YesNo("no")));
        Console.WriteLine("leadint_plain=" + Convert.ToString(Rules.LeadingInt("5")));
        Console.WriteLine("leadint_frac=" + Convert.ToString(Rules.LeadingInt("5.0")));

        // ---- the ore grid -------------------------------------------------
        {
            World w = World.Create(OreTest.BuildMap(),
                                   StructureCatalog.Create(),
                                   UnitCatalog.Create());
            Console.WriteLine("ore_empty=" + Convert.ToString(w.OreAt(5, 5)));
            w.SetOre(5, 5, 10, 1);
            Console.WriteLine("ore_seeded=" + Convert.ToString(w.OreAt(5, 5)));
            Console.WriteLine("ore_val=" + Convert.ToString(w.OreValueAt(5, 5)));
            // A pass takes what the cell holds, never more.
            Console.WriteLine("ore_take_big=" + Convert.ToString(w.TakeOre(5, 5, 25)));
            Console.WriteLine("ore_after=" + Convert.ToString(w.OreAt(5, 5)));
            Console.WriteLine("ore_take_empty=" + Convert.ToString(w.TakeOre(5, 5, 25)));
            // Out of bounds never traps.
            Console.WriteLine("ore_oob=" + Convert.ToString(w.OreAt(-1, 3)));
        }

        // ---- the harvester loop -------------------------------------------
        // A refinery, warmed to completion, delivers its free harvester. The
        // miner seeks the seeded field, mines it dry into its hold, hauls the
        // full load back to the refinery ring and unloads: the controller's
        // wallet grows by exactly the cargo.
        {
            IsoMap iso = OreTest.BuildMap();
            World w = World.Create(iso, StructureCatalog.Create(),
                                   UnitCatalog.Create());
            GameController gc = GameController.Create(w, Side2.Allied());
            int refId = OreTest.BuildIdOf(w.Catalog(), Side2.Allied(), "GAREFN");
            Console.WriteLine("ref_id=" + Convert.ToString(refId));
            int refinery = w.PlaceStructure(Side2.Allied(), refId, 4, 12);
            Console.WriteLine("ref_place=" + Convert.ToString(refinery));
            // A rich field east of the refinery: 36 cells x 25 units at $1,
            // comfortably more than the 700-credit hold, so the miner fills
            // up and turns home -- an RA2 harvester unloads only when full.
            for (int fy = 11; fy <= 13; fy = fy + 1) {
                for (int fx = 8; fx < 20; fx = fx + 1) {
                    w.SetOre(fx, fy, 25, 1);
                }
            }

            StructureType rt = w.Catalog().TypeFor(Side2.Allied(), refId);
            if (rt == null) { return 1; }
            int warm = 0;
            while (warm < 300
             && w.ObjectAt(refinery).BuiltTicks() < rt.BuildTime()) {
                warm = warm + 1;
                w.Tick();
            }
            Console.WriteLine("ref_built=" + Convert.ToString(
                w.ObjectAt(refinery).BuiltTicks() >= rt.BuildTime()));
            WorldObject harv = OreTest.FindHarvester(w, Side2.Allied());
            Console.WriteLine("harv_free=" + Convert.ToString(harv != null));
            if (harv == null) { return 1; }
            Console.WriteLine("harv_empty=" + Convert.ToString(harv.Cargo()));

            // The loop: mine passes of 25 until the hold hits the 700 cap,
            // then dock and unload. Money moves only at the unload.
            int money0 = gc.Money();
            int ore0 = 0;
            for (int fy = 11; fy <= 13; fy = fy + 1) {
                for (int fx = 8; fx < 20; fx = fx + 1) {
                    ore0 = ore0 + w.OreAt(fx, fy);
                }
            }
            int mined = 0;
            int unloaded = 0;
            int ticked = 0;
            while (ticked < 20000 && unloaded == 0) {
                ticked = ticked + 1;
                gc.Tick();
                if (harv.Cargo() > mined) { mined = harv.Cargo(); }
                if (gc.Money() > money0) { unloaded = gc.Money() - money0; }
            }
            Console.WriteLine("harv_mined=" + Convert.ToString(mined > 0));
            int oreLeft = 0;
            for (int fy = 11; fy <= 13; fy = fy + 1) {
                for (int fx = 8; fx < 20; fx = fx + 1) {
                    oreLeft = oreLeft + w.OreAt(fx, fy);
                }
            }
            Console.WriteLine("harv_ore_gone=" + Convert.ToString(
                ore0 > 0 && oreLeft < ore0));
            Console.WriteLine("harv_unloaded=" + Convert.ToString(unloaded));
            Console.WriteLine("harv_full_load=" + Convert.ToString(
                unloaded == World.OreCapacity()));
            Console.WriteLine("harv_hold_refilled=" + Convert.ToString(
                harv.Cargo() == 0));
            Console.WriteLine("harv_ticked=" + Convert.ToString(ticked > 0));
        }
    }
}
