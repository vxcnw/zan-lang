// Bare-metal riscv32 object emission probe: compute-only, no IO / threads /
// atomics, so the object carries no runtime dependencies beyond the inline
// coroutine driver's zan_timer_* references (undefined symbols are expected
// and resolved by the target SDK). Nothing is linked; the assertion is the
// ELF header of the produced object (tests/run_riscv32_object.cmake).
class Program {
    static int Main() {
        int sum = 0;
        for (int i = 1; i <= 10; i = i + 1) {
            sum = sum + i;
        }
        return sum;
    }
}
