// Build/run separately from the shared compiler test tiers. Requires SDL video.
using System;
using SDL3;
using Game.Kit;

class OutputQualityProbe {
    [DllImport("crt")]
    static extern string calloc(int count, int size);

    static int fails;
    static void Check(bool ok, string message) {
        if (!ok) { fails = fails + 1; Console.WriteLine("FAIL " + message); }
    }
    // A raw byte buffer from calloc: indexed by explicit length (an extern
    // result is opaque, so the NUL-ordinal string bounds never apply), and
    // native readback can't touch a managed string's cached length header.
    static string Frame(Host host, int factor, int ow, int oh) {
        host.SetOutputSupersampling(factor);
        host.Begin(0, 0, 0);
        SdlRenderer r = host.Renderer();
        r.SetColor(255, 255, 255, 255);
        // Rasterize an analytic half-plane at the ACTUAL target resolution.
        // A diagonal edge must acquire fractional coverage on downsample.
        int w = host.RasterWidth(); int h = host.RasterHeight();
        for (int y = 0; y < h; y = y + 1) {
            int edge = w / 4 + y / 3;
            r.FillRectRaw(0, y, edge, 1);
        }
        host.End(); // hudMode keeps the final backbuffer available for readback.
        string px = calloc(ow * oh * 4, 1);
        Check(r.ReadPixels(px, ow, oh), "physical output readback");
        return px;
    }
    // The calloc buffer is opaque only where its initializer IS the extern
    // call (Frame's own local) or where it arrives as a method parameter.
    // Passing it through this helper keeps every index site unguarded and
    // lets Main read arbitrary offsets of the RGBA payload.
    static int ByteAt(string px, int idx) {
        return px[idx] & 255;
    }
    static int Partial(string px, int w, int h) {
        int count = 0;
        for (int y = 2; y < h - 2; y = y + 1) {
            for (int x = 2; x < w - 2; x = x + 1) {
                int v = ByteAt(px, (y * w + x) * 4);
                if (v > 8 && v < 247) { count = count + 1; }
            }
        }
        return count;
    }
    static void Main() {
        Check(Host.QualityRasterWidth(1920, 1080, 1280, 720, 2) == 3840, "2x physical, not logical cap");
        Check(Host.QualityRasterWidth(1920, 1200, 1280, 720, 2) == 3840, "letterbox aspect");
        Check(Host.QualityRasterWidth(960, 540, 1280, 720, 2) == 1920, "small output");
        Check(Host.QualityRasterWidth(0, 1080, 1280, 720, 2) == 0, "minimized dimensions");
        int bounded = Host.QualityRasterWidth(65535, 65535, 1280, 720, 4);
        Check(bounded <= 8192 && (double)bounded * (double)bounded * 720.0 / 1280.0 <= 16777216.0, "allocation budget");
        Host host = Host.CreateSs("output-quality-test", 128, 96, 1);
        Check(host.OutputSupersampling() == 1, "opt-in default");
        Check(host.RasterWidth() == 128, "legacy CreateSs unchanged");
        host.hudMode = true;
        SdlRenderer r = host.Renderer();
        int packed = r.OutputSize(); int ow = packed & 65535; int oh = (packed >> 16) & 65535;
        Check(r.IsValid() && ow > 0 && oh > 0, "SDL renderer available (not skipped)");
        if (r.IsValid() && ow > 0 && oh > 0) {
            string native = Frame(host, 1, ow, oh);
            string aa = Frame(host, 2, ow, oh);
            Check(host.RasterWidth() == ow * 2 && host.RasterHeight() == oh * 2, "real target dimensions");
            Check(Partial(aa, ow, oh) > Partial(native, ow, oh) + oh / 8, "downsample adds edge coverage");
            Check(ByteAt(aa, (oh / 2 * ow + 2) * 4) == 255, "opaque interior preserved");
            Check(ByteAt(aa, (oh / 2 * ow + ow - 3) * 4) == 0, "outside preserved");
            int lx = r.LogicalX((double)host.WindowW() / 2.0, (double)host.WindowH() / 2.0) * r.ScaleDen() / r.ScaleNum();
            Check(lx >= 63 && lx <= 65, "input center remains in design units");
            host.SetOutputSupersampling(999);
            Check(host.OutputSupersampling() == 4, "quality upper clamp");
            host.SetOutputSupersampling(0);
            Frame(host, 1, ow, oh);
            Check(host.OutputSupersampling() == 1 && host.RasterWidth() == ow, "runtime disable");
        }
        host.Close();
        Console.WriteLine("done fails=" + fails);
    }
}
