// wasm32: extern calls lowered to `invoke` inside try/catch must still be
// rewritten to the 32-bit ABI by the w32 adaptation pass.
//
// The suite cannot run a wasm module, so like conformance_try_catch_wasm32 the
// assertion is "compiles and links". The regression this pins: File.ReadAllText
// inside a try block lowers its fread/memcpy calls as `invoke`; the w32adapt
// pass used to rewrite only CallInst, so the invoke kept the 64-bit Zan
// signature and wasm-ld materialized an unreachable stub for the signature
// mismatch -- the program linked but trapped on first file read. The invoke
// rewrite makes the module both link and (verified in Node with a WASI shim)
// print the file contents.
using System;
using System.IO;

class Program {
    static void Main() {
        try {
            File.WriteAllText("wasm32_file_read_in_try.txt", "hello wasm");
            string s = File.ReadAllText("wasm32_file_read_in_try.txt");
            Console.WriteLine(s);
        } catch (Exception e) {
            Console.WriteLine("caught: " + e.Message);
        }
        Console.WriteLine("done");
    }
}
