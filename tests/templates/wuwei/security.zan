using System;
using System.IO;
using Wuwei;
class SecurityTest {
    static void Check(bool value,string message) { if (!value) {throw new Exception(message);} }
    static void Main() {
        string dir=Environment.ArgCount()>0 ? Environment.ArgAt(0) : "_scratch/wuwei-security";
        Directory.CreateDirectoryRecursive(dir);
        string path=dir+"/save.wsv";
        SaveStore store=new SaveStore(path);
        Check(store.Read()=="" && store.Error()=="","missing save");
        string payload="修士山海\nlevel,12\n灵石,12345";
        Check(store.Write(payload),"first write: "+store.Error());
        string first=File.ReadAllText(path);
        Check(!first.Contains("level") && !first.Contains("12345"),"encrypted content");
        Check(store.Read()==payload,"unicode roundtrip");
        Check(store.Write(payload),"second write");
        Check(first!=File.ReadAllText(path),"fresh nonce");
        Check(File.Exists(path+".bak"),"backup exists");
        Check(store.Decode(first)==payload,"previous envelope authenticates");
        List<string> parts=first.Split("|");
        string corrupt="WUW1|"+parts[1]+"|"+parts[2]+"|AAAAAAAAAAAAAAAAAAAAAA==";
        bool rejected=false;try {store.Decode(corrupt);}catch(Exception ex) {rejected=true;}
        Check(rejected,"tamper rejection");
        List<string> malformed=new List<string>();
        malformed.Add("WUW2|"+parts[1]+"|"+parts[2]+"|"+parts[3]);
        malformed.Add("WUW1|bad|"+parts[2]+"|"+parts[3]);
        malformed.Add("WUW1|"+parts[1]+"|%%%%|"+parts[3]);
        malformed.Add("WUW1|"+parts[1]+"|"+parts[2]+"|AAAA");
        malformed.Add(first+"|extra");
        foreach(string bad in malformed) { bool denied=false; try {store.Decode(bad);}catch(Exception ex) {denied=true;} Check(denied,"invalid envelope rejected"); }
        File.WriteAllText(path,corrupt);
        SaveStore recovery=new SaveStore(path);
        Check(recovery.Read()==payload && recovery.Error()!="","backup recovery warning");
        Check(!recovery.Write("replacement"),"corrupt primary never overwritten");
        Check(File.ReadAllText(path)==corrupt,"corrupt evidence preserved");
        File.WriteAllText(path+".bak","broken");
        SaveStore broken=new SaveStore(path);
        Check(broken.Read()=="" && broken.Error()!="","both corrupted");
        Check(!broken.Write(payload),"both corruption protected");
        Console.WriteLine("Wuwei encrypted save tests passed");
    }
}
