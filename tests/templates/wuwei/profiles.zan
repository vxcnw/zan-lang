using System;
using System.IO;
using Wuwei;
using SDL3;
class ProfilesTest {
    static void Check(bool ok,string message) { if (!ok) { throw new Exception(message); } }
    static void Main() {
        string dir=Environment.ArgAt(0); Directory.CreateDirectoryRecursive(dir);
        string overrideDir=KnownFolders.GetEnv("WUWEI_SAVE_DIR");
        if (overrideDir!="") {
            ProfileStore defaults=new ProfileStore();
            Check(defaults.SlotPath(1)==overrideDir+"/save.wsv" && defaults.SlotPath(5)==overrideDir+"/profiles/slot5.wsv","per-user override paths");
        }
        SaveStore legacy=new SaveStore(dir+"/save.wsv"); Check(legacy.Write("legacy角色"),"legacy seed");
        ProfileStore p=new ProfileStore(dir);
        Check(p.Read(1)=="legacy角色","legacy slot1");
        Check(p.Read(0)=="" && p.Error()!="","invalid slot");
        for (int i=1;i<=5;i++) {
            Check(p.Write(i,"state-"+i.ToString()+"\n山海","修士"+i.ToString(),"level 12 | \"summary\""),"slot write "+p.Error());
        }
        ProfileStore reload=new ProfileStore(dir);
        for (int i=1;i<=5;i++) {
            Check(reload.Read(i)=="state-"+i.ToString()+"\n山海","independent slots");
            ProfileInfo meta=reload.Metadata(i);
            Check(meta.Exists && meta.Name=="修士"+i.ToString() && meta.Summary=="level 12 | \"summary\"" && meta.LastPlayed!="" && meta.Error=="","metadata");
            Check(!File.ReadAllText(p.SlotPath(i)).Contains("state-"),"encrypted payload");
        }
        Check(legacy.Read()=="state-1\n山海","legacy reader remains compatible");
        Check(!File.ReadAllText(dir+"/profiles/slot1-meta.wsv").Contains("summary"),"encrypted legacy metadata");
        Check(p.SettingsRead()=="" && p.Error()=="","absent settings");
        Check(p.SettingsWrite("{\"volume\":35,\"mute\":true,\"autoheal\":false}"),"settings write");
        Check(reload.SettingsRead()=="{\"volume\":35,\"mute\":true,\"autoheal\":false}","settings roundtrip");
        Check(p.Write(2,"second","new name","new summary"),"second save");
        string intact=File.ReadAllText(p.SlotPath(2));
        File.WriteAllText(p.SlotPath(2),"corrupt");
        ProfileStore damaged=new ProfileStore(dir);
        Check(damaged.Read(2)=="state-2\n山海" && damaged.Error()!="","backup warning");
        Check(!damaged.Write(2,"overwrite","bad","bad") && File.ReadAllText(p.SlotPath(2))=="corrupt","corrupt primary preserved");
        Check(damaged.Write(3,"healthy","healthy","healthy"),"damage isolated per slot");
        File.WriteAllText(dir+"/profiles/settings.wsv","broken settings");
        Check(!damaged.SettingsWrite("{}") && File.ReadAllText(dir+"/profiles/settings.wsv")=="broken settings","corrupt settings protected");
        SaveStore malformed=new SaveStore(p.SlotPath(4)); Check(malformed.Write("{}"),"authenticated malformed seed");
        Check(!damaged.Write(4,"overwrite","bad","bad"),"semantic corruption protected");
        File.WriteAllText(dir+"/profiles/slot1-meta.wsv","broken metadata");
        string old=File.ReadAllText(p.SlotPath(1));
        Check(!damaged.Write(1,"overwrite","bad","bad") && File.ReadAllText(p.SlotPath(1))==old,"metadata corruption protects legacy state");
        File.Delete(p.SlotPath(5)); File.WriteAllText(p.SlotPath(5)+".bak","broken backup");
        Check(!damaged.Write(5,"overwrite","bad","bad"),"backup-only damage protected");
        if (Environment.ArgCount()>1) {
            AudioService audio=new AudioService(); AudioService other=new AudioService();
            audio.SetVolume(-5); Check(audio.Volume()==0,"volume clamp low");
            audio.SetVolume(150); Check(audio.Volume()==100,"volume clamp high");
            audio.SetVolume(35); audio.SetMuted(true);
            Check(audio.Start(Environment.ArgAt(1)),"ogg start: "+audio.Error());
            Check(audio.IsPlaying() && audio.Muted(),"loop started muted");
            Check(other.Start(Environment.ArgAt(1)),"second voice");
            audio.SetMuted(false); Check(audio.Volume()==35 && !audio.Muted(),"unmute restores volume");
            Check(!audio.Start(dir+"/missing.ogg") && audio.IsPlaying(),"failed replacement keeps loop");
            audio.Dispose(); audio.Dispose(); Check(!audio.IsPlaying() && other.IsPlaying(),"isolated idempotent disposal");
            other.Dispose(); Check(SdlAudio.ActiveVoices()==0,"all owned voices released"); SdlAudio.Close();
        }
        Console.WriteLine("Wuwei profiles and audio tests passed");
    }
}
