# clickid @name targets are resolved by UiDriver in-process via the game's
# "id.<name>" probes; widget ids drift across runs, so never hardcode numbers.
# Sections: nav0 修行 nav1 历练 nav2 杂学 nav3 万宝 nav4 宗门 nav5 轮回 nav6 系统
wait 2000
assert probe menu equals 1
assert probe embeddedArt equals 1
assert probe embeddedMusic equals 1
assert probe embeddedBaseSkin equals 1
assert probe menuArtLoaded equals 1
assert probe musicPlaying equals 1
assert probe musicError equals ""
assert probe ready equals 1
assert probe menuPage equals 0
dump tree menu.json
clickid @menuSettings
wait 300
assert probe menuPage equals 2
clickid @menuVolumeDown
wait 300
assert probe musicAdjusted equals 0
assert probe musicPlaying equals 1
clickid @menuAudioBack
wait 300
clickid @menuAchievements
wait 300
assert probe menuPage equals 3
clickid @menuAwardsBack
wait 300
assert probe menuPage equals 0
clickid @menuStart
wait 300
assert probe menuPage equals 1
clickid @menuNew
wait 400
assert probe menu equals 0
assert probe profile equals 1
assert probe section equals 0
assert probe page equals 0
assert probe activity equals 0
assert probe autoHeal equals 1
clickid @cultivate
wait 1000
assert probe activity equals 1
clickid @rest
wait 300
assert probe activity equals 0
clickid @nav1
wait 300
assert probe section equals 1
assert probe page equals 4
clickid @map0
wait 600
assert probe activity equals 2
clickid @nav0
wait 300
clickid @rest
wait 300
assert probe activity equals 0
clickid @nav2
wait 300
assert probe section equals 2
assert probe page equals 7
assert probe recipeFilter equals fishing
assert probe recipePages equals 4
clickid @recipesNext
wait 300
assert probe recipePage equals 1
clickid @alchemy
wait 300
assert probe recipeFilter equals alchemy
assert probe recipePage equals 0
assert probe recipePages equals 4
assert probe recipeSkills contains "alchemy alchemy alchemy"
clickid @forge
wait 300
assert probe recipeFilter equals forging
assert probe recipePage equals 0
assert probe recipePages equals 13
clickid @nav3
wait 300
assert probe section equals 3
assert probe page equals 8
clickid @nav4
wait 300
assert probe section equals 4
assert probe page equals 10
clickid @nav5
wait 300
assert probe section equals 5
assert probe page equals 13
clickid @nav6
wait 300
assert probe section equals 6
assert probe page equals 14
clickid @tab15
wait 300
assert probe page equals 15
clickid @tab14
wait 300
assert probe page equals 14
clickid @autoHeal
wait 300
assert probe autoHeal equals 0
clickid @save
wait 300
assert probe manualSaves equals 1
assert probe saveStatus contains 保存成功
# Scroll inside the central settings column, leaving the sidebar untouched.
scroll 600 450 -480
wait 300
clickid @volumeDown
wait 300
assert probe musicAdjusted equals 1
dump tree settings.json
dump hitregions settings-hits.json
clickid @profiles
wait 400
assert probe menu equals 1
clickid @menuStart
wait 300
clickid @menuNew
wait 400
assert probe menu equals 0
assert probe profile equals 2
assert probe section equals 0
assert probe page equals 0
assert probe activity equals 0
assert probe autoHeal equals 1
assert probe musicAdjusted equals 0
assert probe manualSaves equals 0
clickid @nav6
wait 300
scroll 600 450 960
wait 300
clickid @save
wait 300
assert probe saveStatus contains 保存成功
scroll 600 450 -480
wait 300
clickid @profiles
wait 400
assert probe menu equals 1
clickid @menuStart
wait 300
clickid @profile1
wait 400
assert probe menu equals 0
assert probe profile equals 1
assert probe section equals 0
assert probe page equals 0
assert probe activity equals 0
assert probe autoHeal equals 0
assert probe musicAdjusted equals 1
assert probe manualSaves equals 1
assert probe saveStatus contains 载入成功
dump probe saveStatus save-status.txt
dump tree reloaded-slot1.json
quit
