using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 地图表。种子由 M2.DB 快照 gamemap 整表写入（迷你传奇原值 35 张）；
   minLevel 是进入门槛，网关在 move 时校验。status=1 开放。
   GM 可在后台加图，客户端登录时拉取全表。 */
[Table(Name = "game_map")]
class GameMap {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    int minLevel;
    int sortOrder;

    /* 美术键：地图缩略图。 */
    [Column(StringLength = 64)]
    string picture;

    int status;
}
