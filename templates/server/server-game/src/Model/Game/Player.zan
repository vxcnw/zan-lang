using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 角色表：属于一个区服（realmId），一个账号每区至多一个（应用层唯一，
   创建时检查）。凭据与封禁在 game_account——账号可登录不等于某区有
   角色，创建角色才进得了世界。username 是账号名的冗余拷贝，仅供后台
   列表展示，鉴权永远走账号表。在线角色的权威状态在内存会话
   （Game.Session）里，定期与登出时落库；离线角色以本表为准。
   status=1 正常；0=屏蔽（GM 手工下架单个角色，账号封禁在账号表）。 */
[Table(Name = "game_player")]
class Player {
    [Column(IsIdentity = true)]
    int id;

    /* 所属账号（game_account.id）。 */
    int accountId;

    [Column(StringLength = 64, IsNullable = false)]
    string username;

    /* 所属区服（game_realm.id）。 */
    int realmId;

    [Column(StringLength = 32, IsNullable = false)]
    string nickname;

    /* 0=战士 1=法师 2=道士。三职业成长曲线（血量/法力/主属性/防御）
       见 Game.ClassCurves——形状忠实移植传奇2 服务端源码
       RecalcLevelAbilitys，数值带按迷你传奇真怪表校准。 */
    int job;

    /* 0=男 1=女（创建角色选定；开局布衣按性别发放）。 */
    int gender;

    int level;

    /* 战斗态：当前血量/法力、累计经验（升级曲线 ExpNext=44*level²），
       已穿戴装备（game_item.id，0=空位；穿戴中的物品不在背包）。
       血量/法力上限由 ClassCurves 三职业曲线推出，升级与登录时回满
       上限约束。 */
    int hp;
    int mp;
    long exp;
    int weaponId;
    int armorId;

    long gold;
    long gems;

    /* 累计击杀：主线任务进度（客户端 quests.csv 首个任务“首次击杀”
       按它展示）。 */
    int kills;

    /* 铁匠铺强化星级（0-9）：武器每星 +2 攻、防具每星 +2 防，见
       Fight.Atk/Def。 */
    int weaponStar;
    int armorStar;

    /* 称谓：玩家在已解锁列表里自选的展示名（空=不显示）。 */
    [Column(StringLength = 32)]
    string title;

    /* 传说塔已通关层数（0=未爬）。 */
    int towerFloor;

    /* 祭坛增益到期时刻（秒）；早于当前时刻即失效。 */
    long buffUntil;

    /* 五行修炼总层数（每层 +1 攻 +5 血，Fight 结算）。 */
    int wuxing;

    /* 所属行会（game_guild.id，0=无会）。 */
    int guildId;

    /* 押镖：0=无任务；1=押送中（escortUntil 前交任务）。 */
    int escortStage;
    long escortUntil;

    /* 师父角色名（空=未拜师）。 */
    [Column(StringLength = 32)]
    string masterName;

    /* 竞技场积分。 */
    int arenaPts;

    /* 当前所在地图（game_map.id）与坐标；移动合法性由网关校验。 */
    int mapId;
    int x;
    int y;

    /* 1=正常；0=屏蔽。 */
    int status;

    /* 角色级登录痕迹：离线结算按本角色的 lastLogoutAt 起算。 */
    long lastLoginAt;
    long lastLogoutAt;

    long createdAt;
    long updatedAt;
}
