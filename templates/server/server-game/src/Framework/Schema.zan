    static async bool AddItem(IDbConnection db, string name, int kind, int atk,
                           int def, int heal, long price, int minLevel) {
        Item it = new Item();
        it.name = name;
        it.kind = kind;
        it.atk = atk;
        it.def = def;
        it.hp = heal;
        it.price = price;
        it.minLevel = minLevel;
        it.status = 1;
        int _id = await db.Insert<Item>(it).ExecuteIdentityAsync();
        return _id > 0;
    }

    /* 刷怪点：每行 count 只同名怪；新手怪必掉兽皮（卖店买药的保底循环），
       高级图掉装备与贵材料。掉落按物品名解析成 id，不依赖自增序号。
       数值面向模板演示，平衡留给二开。 */
    /* 怪物种子：M2.DB（Monster）原 hp/ac/dc/exp，按地图门槛调参：
       普通 DC≤gate+12、HP≤300+30·gate；BOSS DC≤30+0.75·gate、
       HP≤2500+60·gate——数值原味但战斗可赢。生成器：_scratch/m2import.py。 */
    static async bool SeedMobs(IDbConnection db) {
        int n = await db.Select<Mob>().CountAsync();
        if (n > 0) { return true; }
        if (!await Schema.AddMob(db, "鸡", 1, 5, 5, 1, 0, 5, 8, 23, 6, 6, "食人树叶", 3000)) { return false; }
        if (!await Schema.AddMob(db, "鹿", 1, 12, 15, 4, 0, 15, 26, 73, 7, 6, "食人树叶", 2500)) { return false; }
        if (!await Schema.AddMob(db, "羊", 1, 13, 20, 3, 0, 20, 29, 82, 7, 6, "蝎子的尾巴", 2000)) { return false; }
        if (!await Schema.AddMob(db, "稻草人", 1, 10, 15, 2, 0, 12, 20, 57, 6, 6, "毒蜘蛛牙齿", 2000)) { return false; }
        if (!await Schema.AddMob(db, "蛤蟆", 1, 12, 20, 5, 0, 15, 26, 73, 8, 6, "食人树的果实", 1200)) { return false; }
        if (!await Schema.AddMob(db, "多钩猫", 2, 13, 22, 4, 0, 17, 29, 82, 8, 5, "食人树叶", 2500)) { return false; }
        if (!await Schema.AddMob(db, "钉耙猫", 2, 13, 23, 4, 0, 18, 29, 82, 8, 5, "蛆卵", 1200)) { return false; }
