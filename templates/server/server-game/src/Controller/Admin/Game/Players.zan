using System;
using System.Data;
using System.Data.Orm;
using System.Security.Cryptography;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Game;
using ZanWeb.Game;

namespace ZanWeb.Admin.Game;

/* /admin/game/players 玩家管理：搜索、编辑、发奖、封禁、踢下线。
   在线与离线走不同写路径：在线玩家的权威状态在内存会话（World），
   GM 的编辑经 World.ApplyEdit/Adjust 生效并即时推送、随 tick 落库；
   离线玩家直接改库。封禁例外——必须写库（拦下次登录），在线再踢出。 */
[Route("admin/game/players/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("玩家管理")]
class Players : AdminController {
    [HttpGet]
    [Route("/admin/game/players")]
    [Custom(IsMenu = true, Icon = "mdi:account-group", Perm = PermBit.View)]
    [Description("玩家管理")]
    async void Index() {
        ViewData d = await this.Layout("玩家管理");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }

        ListQuery q = this.Paged("id", 20);
        string kw = q.Kw();
        int status = this.InInt("status", -1);
        d.Set("status", Convert.ToString(status));
        if (status == 1) { d.Set("statusOn", "selected"); }
        if (status == 0) { d.Set("statusOff", "selected"); }

        int total = await this.Player
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .WhereIf(status >= 0, a => a.status == status)
            .CountAsync();
        List<Player> rows = await this.Player
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .WhereIf(status >= 0, a => a.status == status)
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();

        List<GameMap> maps = await this.GameMap.OrderBy(a => a.sortOrder)
            .ToListAsync();
        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            Player p = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(p.id));
            row.Set("username", p.username);
            row.Set("nickname", Fmt.Dash(p.nickname));
            row.Set("job", Players.JobText(p.job));
            row.Set("level", Convert.ToString(p.level));
            row.Set("gold", Convert.ToString(p.gold));
            row.Set("gems", Convert.ToString(p.gems));
            row.Set("map", Players.MapName(maps, p.mapId));
            row.Set("lastLoginAt", p.lastLoginAt > 0
                ? Fmt.Stamp(p.lastLoginAt) : "—");
            bool online = World.ByAccount(p.id) != null;
            row.Set("onlineText", online ? "在线" : "离线");
            row.Set("onlineClass", online ? "ok" : "off");
            row.Set("statusText", Players.StatusText(p.status));
            row.Set("statusClass", p.status == 1 ? "ok" : "bad");
            items.Add(row);
        }
        this.Pager(d, q, total);
        this.Page(d);
    }

    /* 编辑对话框；在线玩家的金币/元宝展示内存实时值。 */
    [HttpGet]
    [Custom(Perm = PermBit.Update)]
    [Description("玩家表单")]
    async void Form() {
        int id = this.InInt("id", 0);
        Player p = await this.Reach(id);
        Session live = World.ByAccount(id);
        long curGold = live != null ? live.row.gold : p.gold;
        long curGems = live != null ? live.row.gems : p.gems;
        List<GameMap> maps = await this.GameMap.OrderBy(a => a.sortOrder)
            .ToListAsync();
        int curMap = live != null ? live.row.mapId : p.mapId;
        int curLevel = live != null ? live.row.level : p.level;

        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("username", p.username);
        d.Set("nickname", live != null ? live.row.nickname : p.nickname);
        d.Set("level", Convert.ToString(curLevel));
        d.Set("gold", Convert.ToString(curGold));
        d.Set("gems", Convert.ToString(curGems));
        d.Set("banReason", p.banReason);
        d.Set("dialogTitle", "编辑玩家 " + p.username);
        if (live != null) { d.Set("online", "1"); }
        int job = live != null ? live.row.job : p.job;
        if (job == 1) { d.Set("job1", "selected"); }
        if (job == 2) { d.Set("job2", "selected"); }
        if (job == 0) { d.Set("job0", "selected"); }
        List<StrMap> opts = d.AddList("maps");
        for (int i = 0; i < maps.Count; i = i + 1) {
            StrMap o = new StrMap();
            o.Set("id", Convert.ToString(maps[i].id));
            o.Set("name", maps[i].name + "（"
                + Convert.ToString(maps[i].minLevel) + " 级）");
            if (maps[i].id == curMap) { o.Set("selected", "selected"); }
            opts.Add(o);
        }
        this.Dialog(d);
    }

    /* 保存编辑：在线经 World（差量发奖 + 基本项），离线直写库。
       封禁总是写库，并在玩家在线时同时踢出。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("保存玩家")]
    async void Save() {
        int id = this.InInt("id", 0);
        Player p = await this.Reach(id);
        string nickname = this.Need("nickname", "昵称");
        if (nickname.Length > 32) {
            this.Fail(400, "0003", "昵称最长 32 字符");
        }
        int level = this.InInt("level", 1);
        int job = this.InInt("job", 0);
        long gold = this.InLong("gold", 0);
        long gems = this.InLong("gems", 0);
        int mapId = this.InInt("mapId", 0);
        int status = this.InInt("status", 1);
        if (status != 1) { status = 0; }
        string banReason = this.In("banReason");
        if (status == 0 && banReason.Length == 0) {
            this.Fail(400, "0003", "封禁必须填写原因");
        }
        if (level < 1) { level = 1; }
        if (gold < 0) { gold = 0; }
        if (gems < 0) { gems = 0; }

        Session live = World.ByAccount(id);
        long curGold = live != null ? live.row.gold : p.gold;
        long curGems = live != null ? live.row.gems : p.gems;
        string curNick = live != null ? live.row.nickname : p.nickname;
        string changed = "";

        if (live != null) {
            /* 发奖差量走 World：内存即时生效、推送客户端、随 tick 落库。 */
            if (gold != curGold || gems != curGems) {
                World.Adjust(id, gold - curGold, gems - curGems);
                changed = "发奖已实时生效";
            }
            World.ApplyEdit(id, level, job, mapId);
            if (nickname != curNick) {
                live.row.nickname = nickname;
                live.dirty = true;
            }
            if (changed.Length == 0) { changed = "已应用到在线会话"; }
        } else {
            int n = await this.Player.Update()
                .Set(a => a.nickname, nickname)
                .Set(a => a.level, level)
                .Set(a => a.job, job)
                .Set(a => a.gold, gold)
                .Set(a => a.gems, gems)
                .Set(a => a.mapId, mapId)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            changed = n > 0 ? "已保存" : "无改动";
        }

        if (status == 0 && p.status == 1) {
            int _b = await this.Player.Update()
                .Set(a => a.status, 0)
                .Set(a => a.banReason, banReason)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            if (live != null) { World.Kick(id, "账号已被封禁：" + banReason); }
            changed = "已封禁并踢下线";
        } else if (status == 1 && p.status == 0) {
            int _u = await this.Player.Update()
                .Set(a => a.status, 1)
                .Set(a => a.banReason, "")
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            changed = "已解封";
        }

        await this.Note("保存玩家", "#" + Convert.ToString(id) + " "
            + p.username, true, changed);
        this.Saved("玩家已保存（" + changed + "）");
    }

    /* 踢下线：只对在线玩家有意义。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("踢下线")]
    async void Kick() {
        int id = this.InInt("id", 0);
        Player p = await this.Reach(id);
        bool hit = World.Kick(id, "GM 强制下线");
        await this.Note("踢下线",
            "#" + Convert.ToString(id) + " " + p.username, hit,
            hit ? "" : "玩家不在线");
        if (!hit) { this.Saved("该玩家当前不在线"); return; }
        this.Saved("已发送下线通知并断开连接");
    }

    /* 请求存在的玩家；不存在答 404。 */
    async Player Reach(int id) {
        Player p = await this.Player.Where(a => a.id == id).FirstAsync();
        if (p == null) { this.Fail(404, "0404", "玩家不存在"); }
        return p;
    }

    static string JobText(int job) {
        if (job == 1) { return "法师"; }
        if (job == 2) { return "道士"; }
        return "战士";
    }

    static string MapName(List<GameMap> maps, int id) {
        for (int i = 0; i < maps.Count; i = i + 1) {
            if (maps[i].id == id) { return maps[i].name; }
        }
        return "—";
    }

    static string StatusText(int status) {
        if (status == 1) { return "正常"; }
        return "封禁";
    }
}
