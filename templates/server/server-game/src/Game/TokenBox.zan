using System;
using System.Collections.Generic;
using System.Security.Cryptography;

namespace ZanWeb.Game;

/* HTTP 登录令牌：内存表 token→账号 id。进程内有效（重启即失效，客户端
   收到 401 自然重登），数量受登录过的账号约束；resolve 时顺带清过期项。
   每次登录换新 token（旧 token 随旧会话一起作废），attach 推送通道、
   之后所有 /api/game 请求都凭它。16 随机字节 = 32 hex，不含有意义内容。 */
class TokenBox {
    static List<string> toks = new List<string>();
    static List<int> accs = new List<int>();
    static List<long> exps = new List<long>();

    /* 10 天：与 web 端登录 cookie 同量级。 */
    static long TtlSeconds = 864000;

    static string Issue(int accountId, long now) {
        string token = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        TokenBox.toks.Add(token);
        TokenBox.accs.Add(accountId);
        TokenBox.exps.Add(now + TokenBox.TtlSeconds);
        return token;
    }

    /* 命中返回账号 id；过期/未知返回 0。过期项只在这条路径清，表不涨。 */
    static int Resolve(string token, long now) {
        if (token.Length == 0) { return 0; }
        int i = 0;
        int found = 0;
        while (i < TokenBox.toks.Count) {
            if (TokenBox.exps[i] <= now) {
                TokenBox.toks.RemoveAt(i);
                TokenBox.accs.RemoveAt(i);
                TokenBox.exps.RemoveAt(i);
                continue;
            }
            if (found == 0 && TokenBox.toks[i] == token) {
                found = TokenBox.accs[i];
            }
            i = i + 1;
        }
        return found;
    }
}
