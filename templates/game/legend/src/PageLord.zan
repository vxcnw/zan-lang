using System;
using Gui;
using Gui.Widget;
using Legend;

/// 页 24「爵位」——照原版逐像素还原（`mir2/mir/爵位.png`）。
///
/// 12 列 × 12 行：爵位 / 玩家 / 累计贡献 / 气血 / 法力 / 攻击 / 魔法 / 道术 /
/// 防御 / 魔防 / 速度 / 经验加成。表头带满宽青字；**第 4 行（国公·焱森粥熟夷）
/// 是「自己」的整行紫红高亮底 `#570d41`**（原版里连格缝也是紫红，说明是高亮
/// 整行背景而不是逐格填色）；页脚比称谓页多一组「元宝: [100] [捐献]」与
/// 两条状态文字（累计捐献 / 我的爵位）。
///
/// 表格本体走共享组件 `TableUi.zan`，本页只给数据、逐列配色类名与页脚左组。
///
/// 配色（原版实测）：爵位橙、玩家青、累计贡献黄；**七列属性值按爵位分档上色**
/// ——亲王红 / 国公橙 / 侯爵绿 / 伯爵浅灰，这是原版区分品阶的语义色，不是
/// 逐列固定色（与称谓页的五列固定色**不同**）；速度与经验加成同为黄。
partial class LegendApp {
    /// 表头十二列。
    static List<string> LordHeads() {
        List<string> h = new List<string>();
        h.Add("爵位"); h.Add("玩家"); h.Add("累计贡献");
        h.Add("气血"); h.Add("法力"); h.Add("攻击"); h.Add("魔法");
        h.Add("道术"); h.Add("防御"); h.Add("魔防");
        h.Add("速度"); h.Add("经验加成");
        return h;
    }

    /// 属性列分档配色类名：tier 0 亲王 / 1 国公 / 2 侯爵 / 3 伯爵。
    static string LordAttrCls(int tier) {
        if (tier == 0) { return "lord-attr lord-t0"; }
        if (tier == 1) { return "lord-attr lord-t1"; }
        if (tier == 2) { return "lord-attr lord-t2"; }
        return "lord-attr lord-t3";
    }

    /// 「自己」所在行（原版高亮的那一行，0 起）。
    static int LordSelfRow() { return 3; }

    void BuildLordPage() {
        Panel page0 = Panel.Column(); page0.Class = "tbl-page";
        page0.Pad(0); page0.Gap(0); page0.Grow(); content.With(page0);

        List<int> ws = Spec.TblLordCols();
        Panel box = TblBox(); page0.With(box);
        box.With(TblHead(LordHeads(), ws));

        Panel headGap = Panel.Row(); headGap.Pad(0);
        headGap.Prefer(0, Spec.TblHeadGap()); box.With(headGap);

        Panel wall = Panel.Column(); wall.Pad(0); wall.Gap(Spec.TblRowGap());
        box.With(wall);

        string[] nm = new string[] {
            "亲王", "国公", "国公", "国公", "侯爵", "侯爵",
            "侯爵", "侯爵", "侯爵", "伯爵", "伯爵", "伯爵" };
        string[] pl = new string[] {
            "龙卫——圣战", "龙卫——天尊", "大白花", "焱森粥熟夷", "无敌绵羊",
            "漆黑天使", "风之魔装机神", "大块头", "龙卫——法神", "风车车",
            "画饼", "无敌奶糖" };
        string[] con = new string[] {
            "50,1300", "50,1200", "35,1700", "35,1400", "35,1400", "34,2400",
            "33,9600", "29,4600", "27,8600", "27,8400", "27,8300", "23,5000" };
        string[] pct = new string[] {
            "20%", "12%", "12%", "12%", "8%", "8%",
            "8%", "8%", "8%", "5%", "5%", "5%" };
        string[] spd = new string[] {
            "10%", "7%", "7%", "7%", "5%", "5%",
            "5%", "5%", "5%", "3%", "3%", "3%" };
        string[] exp = new string[] {
            "50%", "40%", "40%", "40%", "25%", "25%",
            "25%", "25%", "25%", "15%", "15%", "15%" };
        int[] tier = new int[] {
            0, 1, 1, 1, 2, 2, 2, 2, 2, 3, 3, 3 };

        for (int r = 0; r < Spec.TblRows(); r = r + 1) {
            List<string> cells = new List<string>();
            cells.Add(nm[r]); cells.Add(pl[r]); cells.Add(con[r]);
            for (int i = 0; i < 7; i = i + 1) { cells.Add(pct[r]); }
            cells.Add(spd[r]); cells.Add(exp[r]);

            List<string> cls = new List<string>();
            cls.Add("lord-c0"); cls.Add("lord-c1"); cls.Add("lord-c2");
            for (int i = 0; i < 7; i = i + 1) { cls.Add(LordAttrCls(tier[r])); }
            cls.Add("lord-cy"); cls.Add("lord-cy");

            bool self = r == LordSelfRow();
            wall.With(TblRowCls(cells, cls, ws, r,
                                self ? "tbl-row-hl" : "tbl-row",
                                self ? "tbl-cell tbl-cell-hl" : "tbl-cell"));
        }
        box.With(TblPad(Spec.TblBottomPad()));

        Panel footGap = Panel.Row(); footGap.Pad(0);
        footGap.Prefer(0, Spec.TblFootGap()); page0.With(footGap);

        SignalInt pgSig = new SignalInt(1);
        Pagination pg = new Pagination(5, pgSig);
        pg.Class = "simple";
        pg.PrevText("上一页"); pg.NextText("下一页");
        pg.Named("lord-pager");
        page0.With(TblFootCustom(LordFootLeft(), pg));
    }

    /// 页脚左组：元宝组 / 累计捐献组 / 我的爵位组。三组用**定宽盒**摆位
    /// （实测左缘 392 / 671 / 916），组间距离不等，用 Gap 凑不出来；两段宽度
    /// 已扣掉页脚容器的 4 设备缝。
    Panel LordFootLeft() {
        Panel left = Panel.Row(); left.Pad(0); left.Gap(0);
        left.Prefer(0, Spec.TblFootH());

        Panel g1 = Panel.Row(); g1.Pad(0); g1.Gap(Spec.TblColGap());
        g1.Prefer(Spec.LordFootCol1W(), Spec.TblFootH());
        Label k = Text("元宝:", "tbl-note-k", 0);
        k.Prefer(Spec.LordFootLblW(), Spec.TblFootH());
        g1.With(k);
        Input yuan = new Input("");
        yuan.Class = "lord-input";
        yuan.Prefer(Spec.LordFootBoxW(), Spec.TblFootH());
        yuan.SetText("100");
        yuan.Named("lord-yuan");
        g1.With(yuan);
        g1.With(BtnDev("捐献", "lord-donate", Spec.LordFootBoxW(),
                       Spec.TblFootH(), () => { LordDonate(yuan); }));
        left.With(g1);

        Panel g2 = Panel.Row(); g2.Pad(0); g2.Gap(0);
        g2.Prefer(Spec.LordFootCol2W(), Spec.TblFootH());
        g2.With(TblFootNote("累计捐献：", "无", "lord-note-o"));
        left.With(g2);

        left.With(TblFootNote("我的爵位：", "无", "lord-note-p"));
        return left;
    }

    /// 「捐献」钮：尚未接玩法，按本模板惯例给明确反馈（不假装已实现）。
    void LordDonate(Input yuan) {
        string amount = yuan.GetText();
        if (amount.Length == 0) { amount = "0"; }
        string msg = "捐献元宝：" + amount;
        if (net.Self() != null) { net.AddChat("[系统]", msg); return; }
        g.Log(msg);
    }
}
