    /// 12 个装备格在立绘图上的落点（原生 168×250 坐标 = 逻辑像素）。
    /// 左列/右列/底行各 4 格环绕立绘，右下与左下角格与底行共用
    /// （原版就是这种环绕摆法；框已烘在底图上，见上）。
    static int BagEquipX(int i) {
        if (i < 4) { return Px(129); }              // 右列
        if (i < 8) { return Px(4); }                // 左列
        return Px(4 + (i - 8) * 42);                // 底行 4/46/88/129
    }
    static int BagEquipY(int i) {
        if (i == 0) { return Px(46); }
        if (i == 1) { return Px(83); }
        if (i == 2) { return Px(134); }
        if (i == 3) { return Px(173); }
        if (i == 4) { return Px(54); }
        if (i == 5) { return Px(93); }
        if (i == 6) { return Px(132); }
        if (i == 7) { return Px(171); }
        return Px(210);                             // 底行 y
    }

    /* ---- 商店（页 27）实测（原图 1871×971）----
       全部按**内容区顶/左**换算：内容区上沿 = 顶栏下边框 165 设备、
       左沿 374、**右沿 1490**（聊天面板左沿）——商店的卡片阵一直排到聊天
       面板，不是地图页那种窄区，这里最初按 1128 当右界量成了 2 列（错），
       实测是 **3 列**。
       货币行：4 个等宽 tab（398..517 / 526..644 / 653..772 / 781..899，每个
       120 设备、间距 9、上下边框 183/225 → 高 42），距内容顶 18 设备 = 12
       逻辑、距内容左 24 设备 = 16 逻辑；右端「激活码：」+ 输入框（1077..
       1378 = 301 设备）+「使用」钮（1388..1466 = 78 设备），右内缩 24。
       首行卡顶 244 → 货币行下沿到卡片 18 设备 = 12 逻辑。
       卡片阵 3 列：卡 1 396..741、卡 2 762..1107、卡 3 1128..1473 → 卡宽
       345 设备 = 230 逻辑、列距 21 = 14；行顶 244/342/439/537/634/732 →
       行距 97.6 设备（卡高 79 + 缝 18.6 = 12 逻辑），一页 6 行 × 3 = 18 张。
       左内缩 22 设备 = 15 逻辑（396−374），卡阵右端 1473 距内容右 17。
       卡内：图标石框 411..471 × 247..320 → 60×73 设备 = 40×49 逻辑，左内缩
       15 设备 = 10 逻辑；右列左缘 480（= 图标右 + 9 = 6 逻辑），
       上行（24 设备）：名称 + 右端价格胶囊 626..721 × 254..278 = 95×24 设备
       = 63×16 逻辑（金边圆角，右距卡右 20 设备）；
       中缝 12 设备 = 8 逻辑；下行 y 290..313（24 设备 = 16 逻辑）= 数量(35)
       [+] (23) [值](64) [−](32) … 购买(73)，右端距卡右 13 设备。
       页脚 y 830..860（30 设备 = 20 逻辑）：左「元宝：0」（左缩 30 设备），
       右 兑换元宝(135) + 上一页(81) + 1/2(60) + 下一页(83)，右内缩 33 设备；
       页脚底距内容底 19 设备 = 13 逻辑。 */
    static int ShopCurrW() { return Px(80); }        // 货币 tab 120 设备
