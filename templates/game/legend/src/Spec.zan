    static int BagCellGapY() { return Px(4); }      // 行距 6 设备 → 节距 53（实测 52.4）
    /// 物品栏列数/行数：实测原图竖线 x = 758 + 59.7k（k=0..12）→ 12 列到
    /// 1474，横线 y = 180 + 52.4k（k=0..7）→ 7 行到 545。
    /// **与底图 `00083.jpg` 的格数一一对应**（488×249 里就是 12×7 = 84 格，
    /// 逐条线扫过：竖线 3/42/83/…/483 共 12 格、横线 36/70/…/245 共 7 格），
    /// 所以整图 stretch 到 715×364 时格子正好重合。
    static int BagCols() { return 12; }
