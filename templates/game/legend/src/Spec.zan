       多出来的宽度是背景，所以这里也一律写定宽、靠左排，不拉伸）。

       上段三段横排（设备像素）：立绘 252×375 / 功能钮列 78 宽 / 物品栏
       6 列 × 7 行（格 57×47，列距 60、行距 53.6）。立绘用整图
       `assets/ui/00009.jpg`（168×250 原生 = 252×375 设备，1:1），
       图里已经把 12 个空格框压好，所以装备只叠道具、不再自己画框。 */
    static int BagTopH() { return Px(250); }        // 上段 375 设备（= 立绘图高）
    static int BagPortraitW() { return Px(168); }   // 00009.jpg 原生宽 = 252 设备
    static int BagSlotW() { return Px(35); }        // 装备格 52.5 设备（原图框内 35×31）
    static int BagSlotH() { return Px(31); }        // 46.5 设备
    static int BagActW() { return Px(57); }         // 功能钮 87 设备（实测框 656..742）
    static int BagActH() { return Px(24); }         // 钮高 36 设备（实测顶/底边框 177..213）
    static int BagActGap() { return Px(4); }        // 钮距 6 设备（实测 5）
    static int BagActBigGap() { return Px(30); }    // 「放入图鉴」「一键熔炼」之间 45 设备空档
