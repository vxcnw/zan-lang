       登录→分区→建角的三窗流程）。 */
    string formPage = "login"; string forgotUser = "";
    string charNameDraft = "";
    string lastFormKey = "";
    /* 最近一次实际渲染出的登录窗页面：按钮只改 formPage，PumpNetStage
       发现不一致才重建（click 处理器里禁止 RemoveAll 自己的容器）。 */
    string renderedFormPage = "";
    /* 发布内置服务器：data/server.txt 首行 host:port（可带 |连接密码），
       LEGEND_SERVER 环境变量可覆盖（本机联调）。没有服务器列表 UI。 */
    string srvAddr = "127.0.0.1:8099"; string srvPass = "";
    int netPhase = -1;
    Input dUser; Input dPass; Input dPass2; Input dEmail; Input dAnswer; Input dNewPass; Input dChar;
    Checkbox dRemember; Checkbox dAgree;
    Button dRegister; Button dLogin; Button dCreate;
    int dJob; int dialogMode;
    /* 选角/建角：分区窗点中的区、建角性别（0=男 1=女）、确认删除的
       行下标（两击确认）。 */
    int charsRealmId; string charsRealmName = ""; int dGender; int armDel = -1;
    int netJob; int netRealmPicked = 1;
    /* 登录记忆：login.txt 三行——上次账号、(弃用)、上次区服 id。*/
    string rememberPath;
    string ArtPath(string name) { return artData.Get(name).Text("path"); }
    string EquipmentArtPath(Equipment e) { return equipmentArtData.At(e.definitionId).Text("path"); }
    /* 联网服务端 picture 编号 → 提取原图：怪物走 boss 包帧 01，物品/地图
       走 item/map 包；编号缺失时回退到占位图，不让缺图卡住页面。 */
    string PicturePath(string kind, int picture) {
        string path = "assets/" + kind + "/"
            + (kind == "boss"
                ? Rules.N(picture).PadLeft(3, "0") + "01.png"
                : Rules.N(picture).PadLeft(5, "0") + (kind == "map" ? ".jpg" : ".png"));
        return File.Exists(path) ? path : ArtPath("empty");
    }
    /* 倍率万分比 → 展示标签：10000→"1.0倍"、15000→"1.5倍"、20000→"2.0倍"。*/
    string RateLabel(int rateTenK) {
        int v = rateTenK > 0 ? rateTenK : 10000;
        int whole = v / 10000; int frac = v % 10000 / 1000;
        if (v % 1000 > 0) { frac = frac + 1; if (frac >= 10) { whole = whole + 1; frac = 0; } }
        return Rules.N(whole) + "." + Rules.N(frac) + "倍";
    }
    /* 背包槽位 → 分类名（服务端 items.csv 原版 slot 值）。非穿戴类
       （slot=-1）按 kind 分：消耗品/材料，其余归"其他"。 */
    string SlotName(int slot, int kind) {
        if (slot == 0) { return "武器"; }
        if (slot == 1) { return "衣服"; }
        if (slot == 2) { return "头盔"; }
        if (slot == 3) { return "项链"; }
        if (slot == 4) { return "手镯"; }
        if (slot == 6) { return "戒指"; }
        if (slot == 8) { return "腰带"; }
        if (slot == 9) { return "靴子"; }
        if (slot == 10) { return "勋章"; }
        if (slot == 11) { return "宝石"; }
        if (kind == 0) { return "消耗"; }
        if (kind == 3) { return "材料"; }
        return "其他";
    }
    string CompareEquipment(Equipment e) {
        if (inspectWorn) { return "\n点击穿戴/卸下可放回背包。"; }
        Equipment old = g.equipped[e.slot]; string text = "\n【与当前" + Rules.Slots()[e.slot] + "比较】";
        foreach (DataRow stat in GameTables.current.attributes.rows) {
            string key = stat.Text("id"); int delta = e.Stat(key) - (old == null ? 0 : old.Stat(key));
            if (delta != 0) { text = text + "\n" + stat.Text("name") + " " + (delta > 0 ? "+" : "") + Rules.N(delta); }
        }
        return text + "\n出售价格：" + Rules.N(GameTables.current.items.At(e.definitionId).Int("sell_price")) + " 金币";
    }
    string EnemyArtPath() {
        int picture = g.mode >= 2 ? encounterArtData.At(g.mode).Int("picture") : g.EnemyData().Int("picture");
        return monsterArtData.At(picture).Text("path");
    }
    void ValidateMonsterPictures(DataTable definitions) {
        foreach (DataRow r in definitions.rows) { monsterArtData.At(r.Int("picture")); }
    }
    void LoadArtwork(string dataDir) {
        equipmentArtData = DataTable.Load(dataDir + "/equipment_art.csv", "id:1:1000000,path");
        foreach (DataRow item in GameTables.current.items.rows) {
            if (item.Int("slot") >= 0 && !File.Exists(equipmentArtData.At(item.Int("id")).Text("path"))) { throw new Exception("Equipment artwork missing: " + item.Text("name")); }
        }
        navigationData = DataTable.Load(dataDir + "/navigation.csv", "id:0:30,name,icon,label");
        artData = DataTable.Load(dataDir + "/art.csv", "id,path");
        monsterArtData = DataTable.Load(dataDir + "/monster_art.csv", "id:1:1000000,name,path");
        encounterArtData = DataTable.Load(dataDir + "/encounter_art.csv", "id:2:4,picture:1:1000000");
        ValidateMonsterPictures(GameTables.current.monsters); ValidateMonsterPictures(GameTables.current.bosses);
        ValidateMonsterPictures(encounterArtData);
        foreach (DataRow r in GameTables.current.encounters.rows) { encounterArtData.At(r.Int("id")); }
        foreach (DataRow r in monsterArtData.rows) {
            if (!File.Exists(r.Text("path"))) { throw new Exception("Monster artwork missing: " + r.Text("path")); }
        }
        foreach (DataRow r in GameTables.current.elements.rows) {
            if (!File.Exists(r.Text("picture"))) { throw new Exception("Element artwork missing: " + r.Text("picture")); }
        }
        if (navigationData.rows.Count != 31) { throw new Exception("navigation.csv: expected 31 routes"); }
        pages = new string[31];
        for (int i = 0; i < 31; i = i + 1) {
            DataRow r = navigationData.At(i); pages[i] = r.Text("name");
            if (!File.Exists(r.Text("icon"))) { throw new Exception("Navigation icon missing: " + r.Text("icon")); }
        }
        foreach (DataRow r in artData.rows) {
            if (!File.Exists(r.Text("path"))) { throw new Exception("Artwork missing: " + r.Text("path")); }
        }
    }

    Label Text(string value, string cls, int height) { Label l = new Label(value); l.Class = cls; l.wrap = true; l.Prefer(0, height); return l; }
    Button Btn(string text, string id, Action action) { Button b = new Button(text); b.Named(id); b.Class = "small"; b.Prefer(0, 28); b.Click.Add(action); return b; }
    Image Art(string name, int w, int h) { Image i = new Image(ArtPath(name), "", "contain"); i.Prefer(w, h); return i; }
    Panel PaperDollCanvas() {
        // The reference body stays as a backdrop; equipped artwork is layered
        // at stable body anchors so wearing/unequipping is visible immediately.
        Panel canvas = new Panel(); canvas.Class = "paperdoll-canvas"; canvas.Pad(0); canvas.Prefer(100, 176); canvas.Grow();
        Image body = Art("paperdoll", 100, 176); body.DockManual(); body.Prefer(100, 176); body.Place(0, 0); canvas.With(body);
        int[] xs = new int[] { 32, 32, 8, 56, 32, 32, 8, 56, 21, 55, 21, 55 };
        int[] ys = new int[] { 2, 38, 60, 60, 82, 104, 136, 136, 148, 148, 104, 104 };
        for (int i = 0; i < 12; i = i + 1) {
            Equipment e = g.equipped[i];
            if (e != null) {
                Image layer = new Image(EquipmentArtPath(e), e.Name(), "contain"); layer.Class = "paperdoll-layer";
                layer.DockManual(); layer.Prefer(36, 36); layer.Place(xs[i], ys[i]); canvas.With(layer);
            }
        }
        return canvas;
    }
    Panel Col(string cls) { Panel p = Panel.Column(); p.Class = cls; p.Pad(4); p.Gap(4); return p; }
    void Note(Panel p, string text) { p.With(Text(text, "secondary", 0)); }
    void Save() { saveState = saves.Write(g, DateTime.UtcNow().epoch) ? "已保存" : saves.error; lastSave = DateTime.UtcNow().epoch; }
    void Changed() { Save(); Refresh(); }
    void Rebuild() { Save(); BuildPage(); Refresh(); }
    void Navigate(int n) { page = n; selected = -1; BuildPage(); Refresh(); }
    void PickJob(int n) { g.Choose(n); lastTime = DateTime.UtcNow().epoch; Rebuild(); }
    Panel Nav(int n) {
        Panel b = Panel.Row(); b.Class = "navtile"; b.Pad(4); b.Gap(4); b.Prefer(0, 48); b.Named("nav-" + Rules.N(n));
        Image icon = new Image(navigationData.At(n).Text("icon"), "", "contain"); icon.Class = "navicon"; icon.Prefer(28, 28); b.With(icon);
        Label l = Text(navigationData.At(n).Text("label").Replace("\\n", "\n"), "navtext", 40); l.wrap = true; l.Grow(); b.With(l);
        b.OnClick(() => { Navigate(n); }); navTiles[n] = b; return b;
    }
    void Run() {
        ProcessHost.UseAppDir("assets");
        string dataDir = KnownFolders.GetEnv("LEGEND_DATA_DIR");
        if (dataDir.Length == 0) { dataDir = "data"; }
        GameTables.Initialize(dataDir); LoadArtwork(dataDir); saves = new SaveStore(SaveStore.DefaultPath());
        rememberPath = SaveStore.DefaultPath().Replace("hero-v2.json", "login.txt");
        long now = DateTime.UtcNow().epoch; g = saves.Read(now); lastTime = now; lastSave = now;
        net = new GameNet(); dJob = 0; netJob = 0;
        netRealmPicked = LoadLastRealm();
        form = Form.CreateDark("迷你传奇 · 登录", 440, 520); app = form.GetApp(); net.Attach(app); app.UseSkin("legend"); app.SetBackdropFx(false);   // 启动只出登录小窗；进世界后 SetClientSize 长成主窗口。
        Panel root = Panel.Root("legend-root"); root.Pad(0); root.DockFill(); form.Add(root);
        Panel chat = Col("chat-panel"); chat.Pad(8); chat.Gap(8); chat.Prefer(252, 0); chat.DockRight(); root.Add(chat); BuildChat(chat);
        Panel main = Panel.Column(); main.Pad(0); main.Gap(4); main.DockFill(); root.Add(main);
        // 启动只出登录联机窗口：主界面两块面板先隐藏（未登录时的本地数值
        // 不作展示基准，主窗口区域也不许露出底色/框架）。弹窗宿主挂在
        // root 上不受影响；进入世界时才显现。
        shellChat = chat; shellMain = main;
        chat.SetShown(false); main.SetShown(false);
        Grid navigation = Grid.Of(10); navigation.Class = "navigation-grid"; navigation.Pad(8); navigation.Gap(4); navigation.Prefer(0, 116); main.With(navigation);
        for (int n = 0; n < 20; n = n + 1) { navigation.With(Nav(n)); }
        Panel body = Panel.Row(); body.Gap(0); body.Grow(); main.With(body);
        Panel sidebar = Panel.Column(); sidebar.Class = "sidebar"; sidebar.Prefer(248, 0); sidebar.Gap(0); body.With(sidebar); BuildProfile(sidebar);
        Panel center = Panel.Column(); center.Gap(4); center.Grow(); body.With(center);
        Grid bottom = Grid.Of(10); bottom.Class = "bottom-nav navigation-grid"; bottom.Pad(8); bottom.Gap(4); bottom.Prefer(0, 64); bottom.DockBottom(); main.Add(bottom);
        for (int i = 20; i < 30; i = i + 1) { bottom.With(Nav(i)); }
        content = Panel.Column(); content.Class = "page-surface"; content.Pad(4); content.Gap(4); content.Grow(); center.With(content);
        // 登录小窗即表单：主界面两块面板隐藏，netForm 排最后铺满全窗。
        // 走完连接/登录/建角进入世界后表单隐藏、小窗长成主窗口；
        // 未登录就关窗 = 不玩：整个程序直接退出。
        netForm = Panel.Column(); netForm.Class = "page-surface"; netForm.Pad(24); netForm.Gap(10); netForm.DockFill(); root.Add(netForm);
        BuildPage(); DeclareUnits(root); Refresh();
        ConnectPublished(dataDir); RebuildNetForm();
        form.Every(120, () => {
          /* HTTP 应答并入 + 25s 保活轮询：必须在表单泵之前，本帧就用
             上新数据。不许抛——Every 里的动作一抛就永久停摆。 */
          try { net.PollHttp(); } catch (Exception) { }
          PumpNetStage();
        });
        form.Every(1000, () => {
          /* 心跳任务不许死：Every 里的动作一抛就永久停摆（探针/存档
             全跟着停），所以整段兜底，异常记进探针便于定位。*/
          try {
            long t = DateTime.UtcNow().epoch;
            if (!net.InWorld()) {
                // 联机挂机由服务端驱动（网络线程自行心跳/看门狗），本地只推进离线战斗。
                long elapsed = t - lastTime; g.Advance((int)(elapsed > 86400 ? 86400 : elapsed), t);
            } else {
                // 挂机战况是本地演示（服务端 60 秒批量结算一次，见 ev idlesum）。
                net.DemoRound();
            }
            lastTime = t;
            if (net.InWorld() && net.DataVersion() != lastNetKey) { lastNetKey = net.DataVersion(); BuildPage(); }
            /* 押镖倒计时与红包池是时限性数据：停在这两页时每 5 秒向
               服务端重拉一次（动作回复本来就带新面板，平时不轮询）。 */
            if (net.InWorld() && (page == 4 || page == 18)) {
                if (page == 4) { escortPoll = escortPoll + 1; } else { redpackPoll = redpackPoll + 1; }
                if (escortPoll >= 5) { escortPoll = 0; net.ReloadEscort(); }
                if (redpackPoll >= 5) { redpackPoll = 0; net.RefreshRedpack(); }
            } else { escortPoll = 0; redpackPoll = 0; }
            /* 掉线看门狗：进过世界后再断开，PumpNetStage 已随表单隐藏
               停泵，由这里把窗口缩回登录小窗，引导重新连接。 */
            bool inWorldNow = net.InWorld();
            if (wasInWorld && !inWorldNow) { BackToLoginForm(); }
            wasInWorld = inWorldNow;
                if (UiDriver.Active()) {
                    // UI 自动化探针：让 ZAN_UI_SCRIPT 能断言联机状态，无需截屏比对。
                // 必须在 Refresh() 之前——无角色时 Refresh 提前返回，探针会一直停在旧值。
                // 探针异常不允许打死这个心跳任务（离线推进与存档都在后面）。
                try {
                    UiDriver.SetProbe("win", Rules.N(app.ClientWidth()) + "x" + Rules.N(app.ClientHeight()));
                    UiDriver.SetProbe("net-stage", Rules.N(net.Stage()));
                    UiDriver.SetProbe("net-status", net.StatusText());
                    UiDriver.SetProbe("net-fight", net.FightLine());
                    UiDriver.SetProbe("net-self", net.SelfLine());
                    UiDriver.SetProbe("net-exp", net.Self() != null
                        ? Rules.N(net.Self().Int("exp", 0)) + "/" + Rules.N(net.Self().Int("expnext", 1)) : "-");
                    UiDriver.SetProbe("net-map", net.Self() != null
                        ? Rules.N(net.Self().Int("map", 0)) : "-");
                    UiDriver.SetProbe("net-feed", net.FeedDump());
                    UiDriver.SetProbe("net-chat", net.ChatDump());
                    UiDriver.SetProbe("page", Rules.N(page));
                    UiDriver.SetProbe("net-bag", Rules.N(net.BagCount()) + "件·武器:"
                        + (net.Self() != null ? net.Self().Str("weaponName", "") : "-")
                        + "·防具:" + (net.Self() != null ? net.Self().Str("armorName", "") : "-"));
                    UiDriver.SetProbe("net-quest", net.Self() != null
                        ? Rules.N(net.Self().Int("kills", 0)) : "-");
                    UiDriver.SetProbe("net-boss", BossProbeLine());
                } catch (Exception e) { }
            }
            if (t - lastSave >= 15) { Save(); } Refresh();
          } catch (Exception e) {
              if (UiDriver.Active()) { try { UiDriver.SetProbe("tick-err", e.ToString()); } catch (Exception e2) { } }
          }
        });
        form.OnExit(() => { if (net.Connected()) { net.Logout(); } Save(); }); form.Run();
    }
    void BuildProfile(Panel sidebar) {
        Panel profile = Col("profile"); profile.Pad(12); profile.Gap(4); profile.Prefer(0, 272); sidebar.With(profile);
        Panel portrait = Panel.Row(); portrait.Gap(12); portrait.Prefer(0, 72); portrait.With(Art("portrait", 60, 60));
        Panel identity = Panel.Column(); identity.Gap(4); identity.Grow(); hero = Text("", "yellow strong", 24); identity.With(hero); identity.With(Text("称谓：无\n行会：无", "secondary", 44)); portrait.With(identity); profile.With(portrait);
        Panel xp = Panel.Row(); xp.Gap(4); xp.Prefer(0, 28); xp.With(Text("经验：", "magenta", 28)); experience = new Progress(0, 2); experience.Prefer(0, 28); experience.Grow(); xp.With(experience); Button upgrade = Btn("升级", "level-up", () => { g.Log("经验达到上限时自动升级。"); Refresh(); }); upgrade.DockRight(); xp.Add(upgrade); profile.With(xp);
        Grid stats = Grid.Of(2); stats.Gap(0); stats.Prefer(0, 140);
        health = Text("", "orange", 24); fame = Text("", "green", 24); mana = Text("", "blue", 24); merit = Text("", "cyan", 24); level = Text("", "pink", 24); spirit = Text("", "purple", 24); coins = Text("", "yellow", 24); yuan = Text("", "magenta", 24);
        stats.With(health); stats.With(fame); stats.With(mana); stats.With(merit); stats.With(level); stats.With(spirit); stats.With(coins);
        Button daily = Btn("每日福利", "daily", () => { g.Daily(); Changed(); }); daily.Prefer(0, 28); stats.With(daily); stats.With(yuan);
        Panel tools = Panel.Row(); tools.Gap(4); Button shop = Btn("商店", "profile-shop", () => { Navigate(27); }); shop.Prefer(44, 28); tools.With(shop); Button save = Btn("刷新", "save", () => { Changed(); }); save.Prefer(44, 28); tools.With(save); stats.With(tools); profile.With(stats);
        Panel feed = Col("feed"); feed.Pad(8); feed.Gap(8); feed.Grow(); sidebar.With(feed);
        feed.With(Text("收益与战斗日志 · 最新在上", "secondary small", 24));
        ScrollColumn feedScroll = new ScrollColumn(); feedScroll.Named("income-scroll"); feedScroll.Grow(); feed.With(feedScroll);
        news = Text("", "green small", 0); news.Named("income-content"); feedScroll.With(news);
        Panel foot = Panel.Row(); foot.Pad(4); foot.Gap(4); foot.Prefer(0, 32); foot.DockBottom(); sidebar.Add(foot); foot.With(Btn("战斗统计", "statistics", () => { Navigate(26); })); state = Text("", "yellow", 24); state.Grow(); foot.With(state);
    }
    void BuildChat(Panel p) {
        Panel header = Panel.Row(); header.Gap(4); header.Prefer(0, 48);
        Label channels = Text("世界 · 行会 · 系统", "secondary small", 40); channels.Grow(); header.With(channels);
        Panel settings = Nav(30); settings.Prefer(84, 48); header.With(settings); settings.DockRight(); p.With(header);
        ScrollColumn chatScroll = new ScrollColumn(); chatScroll.Named("chat-scroll"); chatScroll.Grow(); p.With(chatScroll);
        chatHistory = Text("[系统] 欢迎进入传奇放置。\n[连接] 当前未连接游戏服务器。\n本栏只显示真实消息，不播放伪造玩家聊天。", "secondary", 0); chatHistory.Named("chat-content"); chatScroll.With(chatHistory);
        Panel send = Panel.Row(); send.Gap(4); send.Prefer(0, 28); send.DockBottom(); p.Add(send);
        chatInput = new Input("连接服务器后发送"); chatInput.Disabled = true; chatInput.Grow(); send.With(chatInput);
        chatSend = Btn("发送", "chat-send", () => { if (net.InWorld()) { string t = chatInput.GetText().Trim(); if (t.Length > 0) { net.Say(t); chatInput.Clear(); } } });
        chatSend.Disabled = true; chatSend.Prefer(40, 28); send.With(chatSend); chatSend.DockRight();
    }
    void BuildPage() { BuildPageCore(); DeclareUnits(content); }
    void DeclareUnits(Control c) {
        if (c.logW == 0 && c.prefW > 0 && c.prefSet) { c.logW = c.prefW; }
        if (c.logH == 0 && c.prefH > 0 && c.prefSet) { c.logH = c.prefH; }
        if (c.logGap < 0) { c.logGap = c.gap; }
        if (c.logPad < 0 && c.padSet) { c.logPad = c.padL; }
        foreach (Control child in c.children) { DeclareUnits(child); }
    }
    void BuildPageCore() {
        renderedMode = g.mode; renderedChallenge = g.challenge; content.RemoveAll(); enemySprite = null; enemySpritePath = ""; detail = null; pageInfo = null; foeText = null; playerText = null; combatTitle = null; enemyName = null; battleStatus = null; foe = null; life = null; pause = null; push = null; netQuest = null;
        for (int i = 0; i < 84; i = i + 1) { cells[i] = null; cellImages[i] = null; cellLabels[i] = null; }
        for (int i = 0; i < 12; i = i + 1) { gearLabels[i] = null; gearImages[i] = null; }
        if (net.InWorld()) {
            /* 联机时主窗口只出服务器驱动的页面：背包(20)穿装备、沙巴克(6)
               是主线任务与战斗中枢，其余页签接各自的联机玩法（传送/BOSS
               家/排行/秘境/世界BOSS/寻宝/回收/殿堂/铁匠/成就/爵位/商店/
               帮助/公告/设置/幻境说明）。角色在登录小窗就已创建，绝不
               回落离线建角/幻境界面。 */
            if (page == 20) { BuildNetBag(); return; }
            if (page == 6) { BuildNetPage(); return; }
            if (page == 0) { BuildNetTravel(); return; }
            if (page == 3) { BuildNetBossHome(); return; }
            if (page == 9) { BuildNetRank(); return; }
            if (page == 12) { BuildNetSecret(); return; }
            if (page == 13) { BuildNetWBoss(); return; }
            if (page == 15) { BuildNetDraw(); return; }
            if (page == 17) { BuildNetRecycle(); return; }
            if (page == 19) { BuildNetHall(); return; }
            if (page == 21) { BuildNetForge(); return; }
            if (page == 24) { BuildNetNoble(); return; }
            if (page == 26) { BuildNetAchv(); return; }
            if (page == 27) { BuildNetShop(); return; }
            if (page == 28) { BuildNetHelp(); return; }
            if (page == 29) { BuildNetAnnounce(); return; }
            if (page == 30) { BuildNetSettings(); return; }
            if (page == 31) { BuildNetMapInner(); return; }
            if (page == 2) { BuildNetOfflinePage(); return; }
            if (page == 1) { BuildNetArena(); return; }
            if (page == 4) { BuildNetEscort(); return; }
            if (page == 5) { BuildNetGuild(); return; }
            if (page == 7) { BuildNetSiege(); return; }
            if (page == 8) { BuildNetTower(); return; }
            if (page == 10) { BuildNetWuxing(); return; }
            if (page == 11) { BuildNetMentor(); return; }
            if (page == 14) { BuildNetAltar(); return; }
            if (page == 16) { BuildNetStars(); return; }
            if (page == 18) { BuildNetRedpack(); return; }
            if (page == 22) { BuildNetMarket(); return; }
            if (page == 23) { BuildNetCodexPage(); return; }
            if (page == 25) { BuildNetTitle(); return; }
            BuildNetStub(); return;
        }
        if (g.job < 0) { BuildWelcome(); return; }
        if (page == 0) { BuildMaps(); }
        else if (page == 2 || page == 3 || page == 12) { BuildCombat(); }
        else if (page == 20 || page == 21) { BuildInventory(); }
        else if (page == 10) { BuildElements(); }
        else if (page == 15) { BuildTreasure(); }
        else if (page == 14) { BuildAltar(); }
        else if (page == 17) { BuildRecycle(); }
        else if (page == 23) { BuildCodex(); }
        else if (page == 26) { BuildAchievements(); }
        else if (page == 27) { BuildShop(); }
        else if (page == 28 || page == 30) { BuildSettings(); }
        else if (page == 1) { BuildArena(); }
        else if (page == 4) { BuildEscort(); }
        else if (page == 24 || page == 25) { BuildTitle(); }
        else if (page == 6) { BuildNetPage(); }
        else { BuildOnlinePage(); }
    }
    void BuildWelcome() {
        Panel header = Panel.Row(); header.Gap(12); header.Pad(12); header.With(Art("portrait", 64, 64)); header.With(Text("创建角色\n选择职业后进入幻境", "yellow", 64)); content.With(header);
        Grid choices = Grid.Of(3); choices.Gap(8);
        foreach (DataRow job in GameTables.current.jobs.rows) { int n = job.Int("id"); DataRow skill = GameTables.current.skills.At(job.Int("skill_id")); Panel card = Col("frame"); card.With(Text(job.Text("name") + "\n" + skill.Text("name") + "\n基础生命 " + Rules.N(job.Int("hp_base")) + " / 法力 " + Rules.N(job.Int("mp_base")), "cyan", 100)); card.With(Btn("创建" + job.Text("name"), "job-" + Rules.N(n), () => { PickJob(n); })); choices.With(card); } content.With(choices);
        Note(content, "已有进度自动载入。连接服务器即可与全服玩家同场挂机；离线战斗最多结算24小时。");
    }
    void BuildCombat() {
        Panel split = Panel.Row(); split.Gap(4); split.Grow(); content.With(split);
        Panel ranking = Col("rank-panel"); ranking.Prefer(252, 0); ranking.DockRight(); split.Add(ranking);
        if (page == 3) {
            pageInfo = Text("", "yellow", 48); ranking.With(pageInfo);
            int total = GameTables.current.bosses.rows.Count;
            ScrollColumn bosses = new ScrollColumn(); bosses.Grow(); ranking.With(bosses);
            for (int i = bossPage * 12; i < total && i < (bossPage + 1) * 12; i = i + 1) {
                int n = i; DataRow boss = GameTables.current.bosses.rows[i];
                Button entry = Btn(boss.Text("name") + " · " + Rules.N(boss.Int("min_level")) + "级 / " + Rules.N(boss.Int("rebirth")) + "转", "boss-" + Rules.N(boss.Int("id")), () => { bossSelected = n; Rebuild(); });
                entry.Prefer(0, 30); entry.Class = bossSelected == i ? "nav-active" : ""; bosses.With(entry);
            }
            Panel pager = Panel.Row(); pager.Prefer(0, 28); pager.Gap(4); pager.DockBottom(); ranking.Add(pager);
            Button prevBoss = Btn("上一页", "boss-prev", () => { if (bossPage > 0) { bossPage = bossPage - 1; BuildPage(); Refresh(); } }); prevBoss.Disabled = bossPage == 0; pager.With(prevBoss);
            pager.With(Text(Rules.N(bossPage + 1) + "/" + Rules.N((total + 11) / 12), "secondary", 24));
            Button nextBoss = Btn("下一页", "boss-next", () => { if ((bossPage + 1) * 12 < total) { bossPage = bossPage + 1; BuildPage(); Refresh(); } }); nextBoss.Disabled = (bossPage + 1) * 12 >= total; pager.With(nextBoss);
        } else { ranking.With(Text(page == 12 ? "秘境排行" : "幻境排行", "yellow", 24)); Note(ranking, "未连接排行服务器\n\n当前角色记录："); pageInfo = Text("", "green", 72); ranking.With(pageInfo); }
        Panel field = Panel.Column(); field.Class = "battlefield"; field.Pad(8); field.Gap(4); field.Grow(); split.With(field);
        if ((page == 3 && g.mode != 1) || (page == 12 && g.mode != 4) || (page == 2 && g.mode != 0)) { BuildCombatLobby(field); return; }
        Panel top = Panel.Row(); top.Gap(12); top.Prefer(0, 112);
        Panel heading = Panel.Column(); heading.Gap(4); heading.Grow(); top.With(heading);
        combatTitle = Text("", "battle-title", 32); heading.With(combatTitle);
        battleStatus = Text("", "secondary", 48); heading.With(battleStatus);
        Panel player = Panel.Column(); player.Named("player-unit"); player.Gap(4); player.Prefer(104, 112); top.With(player); player.DockRight();
        player.With(Art("portrait", 64, 64)); playerText = Text("", "red", 24); playerText.Named("player-health-text"); player.With(playerText);
        life = new Progress(100, 5); life.Class = "health-bar"; life.Named("player-health-bar"); life.Prefer(0, 8); life.showIndicator = false; player.With(life); field.With(top);
        Panel space = Panel.Column(); space.Grow(); field.With(space);
        Panel battleBottom = Panel.Column(); battleBottom.Gap(8); battleBottom.Prefer(0, 356); battleBottom.DockBottom(); field.Add(battleBottom);
        Grid monsterRow = Grid.Of(3); monsterRow.Prefer(0, 164); Panel leftSpace = Panel.Column(); monsterRow.With(leftSpace);
        Panel monster = Panel.Column(); monster.Named("enemy-unit"); monster.Gap(4); monster.Prefer(0, 164);
        enemyName = Text("", "strong", 24); enemyName.Named("enemy-name"); monster.With(enemyName);
        foeText = Text("", "red", 24); foeText.Named("enemy-health-text"); monster.With(foeText);
        foe = new Progress(100, 5); foe.Class = "health-bar"; foe.Named("enemy-health-bar"); foe.Prefer(0, 8); foe.showIndicator = false; monster.With(foe);
        enemySpritePath = EnemyArtPath(); enemySprite = new Image(enemySpritePath, g.enemyName, "contain"); enemySprite.Prefer(128, 96); enemySprite.Named("enemy-sprite"); monster.With(enemySprite);
        monsterRow.With(monster); Panel rightSpace = Panel.Column(); monsterRow.With(rightSpace); battleBottom.With(monsterRow);
        Panel controls = Panel.Row(); controls.Gap(4); controls.Prefer(0, 28);
        pause = Btn("", "pause", () => { g.active = !g.active; Changed(); }); controls.With(pause);
        push = Btn("", "autopush", () => { if (page == 12) { g.secretAutoPush = !g.secretAutoPush; } else if (page == 3) { g.bossAutoNext = !g.bossAutoNext; } else { g.autoPush = !g.autoPush; } Changed(); }); controls.With(push);
        controls.With(Btn("继续当前战斗", "challenge", () => { g.active = true; Changed(); })); controls.With(Btn("说明", "battle-help", () => { Navigate(28); })); battleBottom.With(controls);
        battleBottom.With(Btn("撤出挑战 / 返回挂机", "flee", () => { g.LeaveChallenge(); Rebuild(); }));
        Grid drops = Grid.Of(12); drops.Gap(0); drops.Prefer(0, 108);
        for (int i = 0; i < 36; i = i + 1) { drops.With(ItemCell(i, 36)); } battleBottom.With(drops);
    }
    void BuildCombatLobby(Panel field) {
        field.Named(page == 3 ? "boss-lobby" : (page == 12 ? "secret-lobby" : "illusion-lobby"));
        if (page == 3) {
            DataRow boss = GameTables.current.bosses.rows[bossSelected];
            field.With(Text("BOSS之家 · " + boss.Text("name"), "battle-title", 32));
            Image preview = new Image(monsterArtData.At(boss.Int("picture")).Text("path"), boss.Text("name"), "contain"); preview.Named("boss-preview"); preview.Prefer(0, 160); field.With(preview);
            field.With(Text("需求等级 " + Rules.N(boss.Int("min_level")) + " / " + Rules.N(boss.Int("rebirth")) + " 转 · 生命 " + Rules.N(boss.Int("hp")), "cyan", 32));
            field.With(Text("奖励预览：金币 " + Rules.N(boss.Int("gold")) + " · 元宝 " + Rules.N(boss.Int("yuan")) + " · 符文 " + Rules.N(boss.Int("runes")) + "\n装备保底品质：" + Rules.Quality(boss.Int("quality")), "green", 64));
            field.With(Btn("挑战选中BOSS · 消耗1次", "boss-start", () => { g.Challenge(1, bossSelected); Rebuild(); }));
            field.With(Btn(g.bossAutoNext ? "☑ 胜利后挑战下一BOSS" : "☐ 胜利后挑战下一BOSS", "boss-auto-next", () => { g.bossAutoNext = !g.bossAutoNext; Rebuild(); }));
        } else if (page == 12) {
            DataRow secret = GameTables.current.encounters.At(4);
            field.With(Text("秘境 · 独立推层", "battle-title", 32));
            Image preview = new Image(monsterArtData.At(encounterArtData.At(4).Int("picture")).Text("path"), "秘境守卫", "contain"); preview.Prefer(0, 160); field.With(preview);
            field.With(Text("开启条件：" + Rules.N(secret.Int("min_rebirth")) + " 转 / " + Rules.N(secret.Int("min_level")) + " 级\n当前第 " + Rules.N(g.secretFloor) + " 层 · 最高通关 " + Rules.N(g.secrets) + " 层", "cyan", 64));
            field.With(Text("每层清理 " + Rules.N(g.B("secret_wave_count")) + " 个怪物后挑战守关首领。\n装备保底：" + Rules.Quality(secret.Int("quality")) + " · 首领元宝 " + Rules.N(secret.Int("yuan")) + " / 符文 " + Rules.N(secret.Int("runes")), "green", 64));
            field.With(Btn("进入秘境 · 继续独立进度", "secret-start", () => { g.Challenge(4, 0); Rebuild(); }));
        } else {
            field.With(Text("幻境", "battle-title", 32));
            field.With(Text("角色正在其它玩法中战斗，幻境进度已保留。\n切换页面不会退出挑战或消耗次数。", "secondary", 80));
            field.With(Btn("查看当前挑战", "current-battle", () => { Navigate(g.mode == 1 ? 3 : 12); }));
        }
        detail = Text("", "secondary", 0); detail.Named("challenge-notice"); field.With(detail);
    }
    Panel ItemCell(int n, int height) {
        Panel cell = Col("item-cell"); cell.Pad(0); cell.Gap(0); cell.Prefer(0, height); cell.Named("item-" + Rules.N(n));
        Label count = Text("", "yellow tiny", 12); cell.With(count); Image image = Art("sword", 0, height - 12); image.Grow(); cell.With(image);
        cells[n] = cell; cellImages[n] = image; cellLabels[n] = count;
        cell.OnClick(() => { inspectWorn = false; selected = n; Refresh(); });
        cell.OnDoubleClick(() => { selected = n; if (!vault) { g.Wear(selected); selected = -1; Changed(); } }); return cell;
    }
    void BuildInventory() {
        Panel top = Panel.Row(); top.Gap(4); top.Prefer(0, 308); content.With(top);
        Panel doll = Col("paperdoll"); doll.Prefer(192, 308); top.With(doll);
        if (page == 21) { doll.With(Text("装备洗炼", "yellow strong", 24)); }
        Panel dollBody = Panel.Row(); dollBody.Gap(0); dollBody.Grow(); doll.With(dollBody);
        Panel slotsLeft = Panel.Column(); slotsLeft.Prefer(44, 0); slotsLeft.Gap(4); dollBody.With(slotsLeft);
        Panel slotsRight = Panel.Column(); slotsRight.Prefer(44, 0); slotsRight.Gap(4); slotsRight.DockRight(); dollBody.Add(slotsRight);
        Panel dollImage = PaperDollCanvas(); dollBody.With(dollImage);
        for (int i = 0; i < 8; i = i + 1) { Panel slot = GearCell(i); if (i % 2 == 0) { slotsLeft.With(slot); } else { slotsRight.With(slot); } }
        Grid feet = Grid.Of(4); feet.Gap(4); feet.Prefer(0, 44); feet.DockBottom(); for (int i = 8; i < 12; i = i + 1) { feet.With(GearCell(i)); } doll.Add(feet);
        Panel tools = Panel.Column(); tools.Prefer(80, 0); tools.Gap(4); top.With(tools);
        tools.With(Btn(vault ? "切换背包" : "切换仓库", "vault-toggle", () => { vault = !vault; selected = -1; Rebuild(); }));
        tools.With(Btn(vault ? "取出(F)" : "入库(F)", "store", () => { g.Store(selected, vault); selected = -1; Changed(); }));
        tools.With(Btn("加锁", "lock", () => { Equipment e = inspectWorn ? g.equipped[forgeSlot] : Selected(); if (e != null) { e.locked = !e.locked; } Changed(); }));
        tools.With(Btn("穿戴/卸下", "wear", () => { if (inspectWorn) { g.Unequip(forgeSlot); inspectWorn = false; } else if (!vault) { g.Wear(selected); selected = -1; } Changed(); }));
        tools.With(Btn("整理", "sort-inventory", () => { g.SortInventory(vault); selected = -1; Changed(); }));
        tools.With(Btn("自动配装", "best-gear", () => { if (!vault) { g.BestGear(); selected = -1; Changed(); } }));
        tools.With(Btn("放入图鉴", "collect", () => { if (!vault) { g.Collect(selected); selected = -1; } Changed(); }));
        tools.With(Btn("一键熔炼（" + Rules.N(g.RecycleWeakCount()) + "件）", "recycle-weak", () => { if (!vault) { g.RecycleWeak(); selected = -1; Changed(); } }));
        tools.With(Btn("卖出(X)", "recycle", () => { if (!vault) { g.Sell(selected); selected = -1; } Changed(); }));
        Grid inventory = Grid.Of(12); inventory.Gap(0); inventory.Grow(); top.With(inventory);
        for (int i = 0; i < 84; i = i + 1) { inventory.With(ItemCell(i, 44)); }
        Panel lower = Panel.Row(); lower.Gap(8); lower.Grow(); content.With(lower);
        Panel attributes = Col("frame"); attributes.Prefer(192, 0); lower.With(attributes);
        if (page == 21) {
            attributes.With(Btn("开始锻造(D)", "forge-start", () => { RunForge(); }));
            attributes.With(Text("请选择锻造方式", "cyan", 20)); Grid modes = Grid.Of(2); modes.Gap(4);
            for (int i = 0; i < GameTables.current.forge.rows.Count; i = i + 1) { int n = i; Button b = Btn(GameTables.current.forge.rows[i].Text("name"), "forge-" + Rules.N(i), () => { forgeMode = n; Refresh(); }); b.Class = "tiny"; b.Prefer(0, 28); modes.With(b); } attributes.With(modes);
        } else { attributes.With(Text("战斗属性", "strong", 24)); ScrollColumn statScroll = new ScrollColumn(); statScroll.Grow(); attributes.With(statScroll); pageInfo = Text("", "cyan small", 0); statScroll.With(pageInfo); }
        Panel extra = Col("frame"); extra.Grow(); lower.With(extra); detail = Text("", "secondary small", 0);
        ScrollColumn detailsScroll = new ScrollColumn(); detailsScroll.Named("equipment-details-scroll"); detailsScroll.Grow(); extra.With(detailsScroll);
        if (page == 21) { detailsScroll.With(detail); }
        else {
            Panel tabs = Panel.Row(); tabs.Gap(4); tabs.Prefer(0, 28); string[] names = new string[] { "天书", "内功", "宝石", "技能", "符文" };
            for (int i = 0; i < 5; i = i + 1) { int n = i; tabs.With(Btn(names[i], "growth-tab-" + Rules.N(i), () => { growthTab = n; Rebuild(); })); } detailsScroll.With(tabs);
            if (growthTab == 1) {
                detailsScroll.With(Text("内功 · TP " + Rules.N(g.tp) + " · 击杀获得 TP，升级消耗黑铁", "yellow small", 24));
                Grid inner = Grid.Of(2); inner.Gap(4); inner.Prefer(0, 256);
                for (int i = 0; i < 8; i = i + 1) {
                    int n = i; DataRow r = GameTables.current.innerPower.At(i); Panel card = Col("frame");
                    card.With(Text(r.Text("name") + " " + Rules.N(g.innerRanks[i]) + "/" + Rules.N(r.Int("max_level")) + " · " + GameTables.current.attributes.Get(r.Text("stat")).Text("name") + " +" + Rules.N(g.innerRanks[i] * r.Int("value_per_level")), "cyan small", 24));
                    card.With(Btn(g.innerRanks[i] >= r.Int("max_level") ? "已满级" : "升级 · TP " + Rules.N(g.InnerCost(i)) + " / 铁 " + Rules.N(r.Int("iron")), "inner-up-" + Rules.N(i), () => { g.TrainInner(n); Rebuild(); })); inner.With(card);
                }
                detailsScroll.With(inner);
            } else if (growthTab == 2) {
                detailsScroll.With(Text("宝石 · 普通升级 / 低阶合成，属性永久生效", "yellow small", 24));
                Grid gems = Grid.Of(2); gems.Gap(4); gems.Prefer(0, 256);
                for (int i = 0; i < 6; i = i + 1) {
                    int n = i; DataRow gem = GameTables.current.gems.At(i); Panel card = Col("frame");
                    int rank = g.gemRanks[i]; int amount = rank * gem.Int("value_per_level");
                    card.With(Text(gem.Text("name") + " " + Rules.N(rank) + "/" + Rules.N(gem.Int("max_level")), "cyan small", 24));
                    card.With(Text(GameTables.current.attributes.Get(gem.Text("stat")).Text("name") + " +" + Rules.N(amount), "secondary small", 24));
                    card.With(Btn(rank >= gem.Int("max_level") ? "已满级" : "升级 · 金 " + Rules.N(g.GemGoldCost(n)) + " / 铁 " + Rules.N(g.GemIronCost(n)) + " / 元 " + Rules.N(g.GemYuanCost(n)), "gem-up-" + Rules.N(n), () => { g.UpgradeGem(n); Rebuild(); }));
                    card.With(Btn(rank >= gem.Int("synthesis_max_level") ? "合成上限" : "合成 · 金 " + Rules.N(g.GemSynthesisGoldCost(n)) + " / 铁 " + Rules.N(g.GemSynthesisIronCost(n)) + " / 元 " + Rules.N(g.GemSynthesisYuanCost(n)), "gem-synth-" + Rules.N(n), () => { g.SynthesizeGem(n); Rebuild(); }));
                    gems.With(card);
                }
                detailsScroll.With(gems);
            } else if (growthTab == 3) {
                detailsScroll.With(Text("技能配置 · 8 个槽位，按槽位顺序自动施放主动技能；被动技能即时生效", "yellow small", 24));
                Grid skills = Grid.Of(2); skills.Gap(4); skills.Prefer(0, 304);
                for (int i = 0; i < 8; i = i + 1) {
                    int n = i; DataRow ability = g.SkillAtSlot(i); int rank = g.SkillRank(i);
                    Panel card = Col("frame"); string state = g.IsSkillEquipped(i) ? "已装备" : "未装备";
                    string kind = ability.Text("kind") == "active" ? "主动" : "被动";
                    card.With(Text("槽位 " + Rules.N(i + 1) + " · " + kind + " · " + state, "strong small", 22));
                    card.With(Text(ability.Text("name") + " Lv." + Rules.N(rank) + "/" + Rules.N(ability.Int("max_level")), "cyan small", 24));
                    if (ability.Text("kind") == "active") { card.With(Text("冷却 " + Rules.N(ability.Int("cooldown")) + " 秒 · 法力 " + Rules.N(ability.Int("mana")) + " · 伤害 " + Rules.N(ability.Int("damage_pct") + rank * ability.Int("damage_per_level")) + "%", "secondary small", 0)); }
                    else { card.With(Text("攻击 +" + Rules.N(rank * ability.Int("passive_damage_pct")) + " · 防御 +" + Rules.N(rank * ability.Int("passive_defense_pct")), "secondary small", 0)); }
                    card.With(Btn(g.IsSkillEquipped(i) ? "卸下技能" : "装备技能", "skill-toggle-" + Rules.N(i), () => { g.ToggleSkill(n); Rebuild(); }));
                    card.With(Btn(rank >= ability.Int("max_level") ? "已满级" : "升级 · 金 " + Rules.N(rank * ability.Int("train_gold")) + " / 铁 " + Rules.N(rank * ability.Int("train_iron")), "skill-up-" + Rules.N(i), () => { g.TrainSkill(n); Rebuild(); }));
                    skills.With(card);
                }
                detailsScroll.With(skills);
            } else if (growthTab == 4) {
                detailsScroll.With(Text("符文锻造 · 1#至14#符文；3枚同级合成1枚高阶，降级消耗10黑铁", "yellow small", 24));
                Grid runeGrid = Grid.Of(2); runeGrid.Gap(4); runeGrid.Prefer(0, 420);
                for (int i = 0; i < 14; i = i + 1) {
                    int n = i + 1; Panel card = Col("frame");
                    card.With(Text(Rules.N(n) + "#符文 · " + Rules.N(g.RuneCount(n)) + "枚", "cyan small", 24));
                    Button synth = Btn(n >= 12 ? "不可合成" : "合成（3→1）", "rune-synth-" + Rules.N(n), () => { g.SynthesizeRune(n); Rebuild(); });
                    synth.Disabled = n >= 12 || g.RuneCount(n) < 3; card.With(synth);
                    Button down = Btn(n <= 1 || n >= 13 ? "不可降级" : "降级（铁10）", "rune-down-" + Rules.N(n), () => { g.DowngradeRune(n); Rebuild(); });
                    down.Disabled = n <= 1 || n >= 13 || g.RuneCount(n) < 1 || g.iron < 10; card.With(down); runeGrid.With(card);
                }
                detailsScroll.With(runeGrid);
                detailsScroll.With(Text("规则来源：参考配方 1#–11#升级、2#–12#降级。旧版通用符文库存仍保留用于兼容旧存档和既有锻造配方。", "secondary small", 0));
                detailsScroll.With(Text("符文之语 · 传说锻造（配方公开，模板数值）", "yellow small", 24));
                detailsScroll.With(Text("材料：传说矿石 ×" + Rules.N(g.legendOre) + " · " + Rules.N(g.B("rune_word_rune")) + "#符文 ×" + Rules.N(g.RuneCount(g.B("rune_word_rune"))), "cyan small", 0));
                detailsScroll.With(Text("当前选中：" + (selected >= 0 && !vault ? g.BagItemAt(selected) : "（在背包中单击选择装备）"), "secondary small", 0));
                Grid runeWords = Grid.Of(2); runeWords.Gap(4);
                string[] wordNames = new string[] { "锻造传说武器", "锻造传说男衣", "锻造传说女衣" };
                for (int i = 0; i < 3; i = i + 1) {
                    int n = i; Button craft = Btn(wordNames[n], "legend-craft-" + Rules.N(n), () => { g.CraftLegend(n, selected); selected = -1; Rebuild(); });
                    craft.Disabled = !g.LegendReady(n, selected); craft.Class = "tiny"; runeWords.With(craft);
                }
                detailsScroll.With(runeWords);
                Button grow = Btn("形态增长（" + Rules.N(g.B("form_growth_balls")) + "颗当级龙珠 + 新" + Rules.N(g.B("form_growth_rune")) + "#）", "legend-grow", () => { g.GrowLegendForm(selected); selected = -1; Rebuild(); });
                grow.Disabled = !g.GrowReady(selected); detailsScroll.With(grow);
                detailsScroll.With(Text("配方：传说武器 = 赤血魔剑 + 传说矿石×" + Rules.N(g.B("rune_word_ore")) + " + " + Rules.N(g.B("rune_word_rune")) + "#；传说男/女衣 = 城主战袍（男/女）+ 同价材料。形态增长 = 传说装备[第N形态] + 龙珠N★×" + Rules.N(g.B("form_growth_balls")) + " + 新" + Rules.N(g.B("form_growth_rune")) + "#，保留系数/品阶/强化；第九形态为模板终点（更高形态依赖传奇黄，未收录）。材料可从商城购买，基础装备出自巅峰塔深层。", "secondary small", 0));
            } else {
                Equipment book = g.equipped[11]; string bookStatus = "当前未穿戴天书。";
                if (book != null) { bookStatus = "当前天书：" + book.Name() + "\n" + book.Detail(); }
                detailsScroll.With(Text("天书传承 · 选择背包天书作为材料，传入已穿戴天书", "yellow small", 24));
                detailsScroll.With(Text(bookStatus, "cyan small", 0));
                Button inherit = Btn("传承选中天书", "tianshu-inherit", () => { g.InheritTianShu(selected); selected = -1; Rebuild(); });
                inherit.Disabled = vault; detailsScroll.With(inherit);
                detailsScroll.With(Text("规则：只转移更高系数；目标天书的品阶与强化保留；成功后消耗材料。锁定或较低系数材料不会被消耗。", "secondary small", 0));
            }
            detailsScroll.With(detail);
        }
    }
    Panel GearCell(int n) {
        Panel p = Col("item-cell"); p.Pad(0); p.Gap(0); p.Prefer(44, 44); p.Named("slot-" + Rules.N(n));
        Label l = Text("", "yellow tiny", 12); p.With(l); Image image = Art("slot-" + Rules.N(n % 10), 40, 32); p.With(image); gearLabels[n] = l; gearImages[n] = image;
        p.OnClick(() => { forgeSlot = n; inspectWorn = true; selected = -1; Refresh(); }); return p;
    }
    Equipment Selected() { if (selected < 0) { return null; } if (vault) { if (selected < g.storage.Count) { return g.storage[selected]; } } else if (selected < g.bag.Count) { return g.bag[selected]; } return null; }
    void RunForge() { g.Forge(forgeSlot, GameTables.current.forge.rows[forgeMode].Int("id")); Changed(); }
    void BuildMaps() {
        int total = GameTables.current.maps.rows.Count;
        // The reference map selector is a separate 4 x 5 page, not a combat route.
        content.With(Text("地图传送", "strong", 28));
        pageInfo = Text(g.travelMap >= 0 ? "当前驻守：" + g.LocationName() + " 第 " + Rules.N(g.floor) + " 层 · 幻境推层进度第 " + Rules.N(g.homeFloor) + " 层" : "当前：幻境 第 " + Rules.N(g.floor) + " 层 · 最高 " + Rules.N(g.best) + " 层", "cyan", 28); pageInfo.Named("map-location"); content.With(pageInfo);
        Note(content, "选择目的地后停留在地图页；查看战斗请点击上方“幻境”。驻守地图只循环刷怪，不推进幻境层数。");
        ScrollColumn mapScroll = new ScrollColumn(); mapScroll.Named("map-scroll"); mapScroll.Grow(); content.With(mapScroll);
        Grid grid = Grid.Of(4); grid.Named("map-selector"); grid.Class = "map-grid"; grid.Gap(4); mapScroll.With(grid);
        for (int i = mapPage * 20; i < total && i < (mapPage + 1) * 20; i = i + 1) {
            int n = i; DataRow map = GameTables.current.maps.rows[i]; Panel tile = Col("map-tile");
            tile.With(Text(map.Text("name"), "yellow strong", 24));
            tile.With(Text("等级 " + Rules.N(map.Int("min_level")) + " / " + Rules.N(map.Int("rebirth")) + "转 / 幻境记录 " + Rules.N(map.Int("start_floor")) + "层", "secondary small", 24));
            // Rebuild this page on both success and rejection. Never navigate as a side effect.
            tile.With(Btn(g.CanEnter(map) && g.best >= map.Int("start_floor") ? "传送" : "查看解锁条件", "map-" + Rules.N(map.Int("id")), () => { g.Travel(n); mapNotice = g.notice; Rebuild(); })); grid.With(tile);
        }
        Panel pager = Panel.Row(); pager.Prefer(0, 28); pager.Gap(8);
        if (g.travelMap >= 0) { pager.With(Btn("返回幻境 · 第 " + Rules.N(g.homeFloor) + " 层", "map-return", () => { g.ReturnHome(); mapNotice = g.notice; Rebuild(); })); }
        Button previous = Btn("上一页", "map-prev", () => { if (mapPage > 0) { mapPage = mapPage - 1; BuildPage(); Refresh(); } }); previous.Disabled = mapPage == 0; pager.With(previous);
        pager.With(Text("地图 " + Rules.N(mapPage + 1) + " / " + Rules.N((total + 19) / 20), "cyan", 24));
        Button next = Btn("下一页", "map-next", () => { if ((mapPage + 1) * 20 < total) { mapPage = mapPage + 1; BuildPage(); Refresh(); } }); next.Disabled = (mapPage + 1) * 20 >= total; pager.With(next); pager.DockBottom(); content.Add(pager);
        Label result = Text(mapNotice, "secondary small", 0); result.Named("map-result"); result.DockBottom(); content.Add(result);
    }
    void BuildElements() {
        content.With(Text("五行修炼", "yellow strong", 32));
        Panel split = Panel.Row(); split.Gap(8); split.Grow(); content.With(split);
        Panel slots = Col("element-slots"); slots.Prefer(330, 0); slots.DockRight(); split.Add(slots);
        ScrollColumn scroll = new ScrollColumn(); scroll.Grow(); slots.With(scroll);
        foreach (DataRow e in GameTables.current.elements.rows) {
            int id = e.Int("id"); Panel card = Col("frame"); card.Named("element-" + Rules.N(id)); card.Prefer(0, 78); card.Gap(4); card.Pad(4);
            Panel top = Panel.Row(); top.Gap(8); top.Prefer(0, 52);
            Image icon = new Image(e.Text("picture"), e.Text("name") + "行装备", "contain"); icon.Prefer(44, 48); top.With(icon);
            Panel actions = Panel.Column(); actions.Gap(4); actions.Prefer(72, 52); actions.DockRight(); top.Add(actions);
            Button upgrade = Btn("升级", "element-up-" + Rules.N(id), () => { g.UpgradeElement(id); Rebuild(); }); upgrade.Prefer(0, 24); actions.With(upgrade);
            Button inject = Btn("注入", "element-inject-" + Rules.N(id), () => { g.InjectElement(id); Rebuild(); }); inject.Prefer(0, 24); actions.With(inject);
            elementLabels[id] = Text("", "cyan", 48); elementLabels[id].Grow(); top.With(elementLabels[id]); card.With(top);
            elementBars[id] = new Progress(0, 5); elementBars[id].Named("element-progress-" + Rules.N(id)); elementBars[id].Prefer(0, 8); elementBars[id].showIndicator = false; card.With(elementBars[id]); scroll.With(card);
        }
        Panel formation = Col("battlefield"); formation.Grow(); split.With(formation);
        Image diagram = Art("element-formation", 0, 0); diagram.Named("element-formation"); diagram.Grow(); formation.With(diagram);
        Panel bottom = Col("element-summary"); bottom.Prefer(0, 138); bottom.DockBottom(); formation.Add(bottom);
        pageInfo = Text("", "green", 64); pageInfo.Named("element-pool"); bottom.With(pageInfo);
        elementToggle = Btn("", "element-training", () => { g.elementTraining = !g.elementTraining; Changed(); }); bottom.With(elementToggle);
        Note(bottom, "经验池满后停止累计；战斗暂停不影响修炼，离线有效。升级会按五行配置消耗突破材料。");
        detail = Text("", "secondary", 28); content.With(detail); detail.DockBottom();
    }
    void BuildTreasure() {
        content.With(Text("藏宝图", "yellow strong", 28));
        content.With(Text("现有藏宝图：" + Rules.N(g.treasureMaps) + " · 今日已抽：" + Rules.N(g.treasureDraws), "cyan", 28));
        Grid ring = Grid.Of(3); ring.Gap(8);
        for (int i = 0; i < 6; i = i + 1) {
            Panel tile = Col("item-cell"); tile.Named("treasure-slot-" + Rules.N(i));
            tile.With(Art(i == 0 ? "reward" : (i == 1 ? "reward" : (i == 2 ? "ore" : (i == 3 ? "rune" : (i == 4 ? "horn" : "sword")))), 0, 44));
            tile.With(Text(g.TreasureSlot(i), "secondary", 32)); ring.With(tile);
        }
        content.With(ring);
        content.With(Btn("使用藏宝图（消耗 1 张）", "treasure", () => { g.Treasure(); Changed(); }));
        Note(content, "六格奖励池按配置结算：金币、元宝、黑铁、符文、药水或精良装备。每日福利补充藏宝图，装备奖励遇到满包时不消耗。");
    }
    void BuildAltar() {
        content.With(Text("祭坛 · 本地共建", "yellow strong", 32));
        pageInfo = Text("", "cyan", 52); pageInfo.Named("altar-status"); content.With(pageInfo);
        Panel card = Col("frame"); card.With(Art("reward", 72, 72));
        card.With(Text("个人捐献会同步推进个人祭坛与本地共建进度。达到领取线后可领取个人奖励；共建进度达到目标会触发一次本地共建奖励。", "secondary", 64));
        Grid actions = Grid.Of(2); actions.Gap(8);
        Button gold = Btn("捐献金币 · " + Rules.N(g.B("altar_gold_cost")) + " → +" + Rules.N(g.B("altar_gold_gain")), "altar-gold", () => { g.DonateAltar(0); Rebuild(); }); actions.With(gold);
        Button yuan = Btn("捐献元宝 · " + Rules.N(g.B("altar_yuan_cost")) + " → +" + Rules.N(g.B("altar_yuan_gain")), "altar-yuan", () => { g.DonateAltar(1); Rebuild(); }); actions.With(yuan);
        Button large = Btn("大额捐献 · " + Rules.N(g.B("altar_yuan_large_cost")) + "元宝 → +" + Rules.N(g.B("altar_yuan_large_gain")), "altar-yuan-large", () => { g.DonateAltar(2); Rebuild(); }); actions.With(large);
        Button iron = Btn("捐献黑铁 · " + Rules.N(g.B("altar_iron_cost")) + " → +" + Rules.N(g.B("altar_iron_gain")), "altar-iron", () => { g.DonateAltar(3); Rebuild(); }); actions.With(iron);
        card.With(actions);
        Button claim = Btn("领取个人祭坛奖励 · " + Rules.N(g.B("altar_personal_reward_gold")) + "金币 / " + Rules.N(g.B("altar_personal_reward_yuan")) + "元宝", "altar-claim", () => { g.ClaimAltarPersonal(); Rebuild(); }); claim.Disabled = g.altarPersonal < g.AltarPersonalCap(); card.With(claim);
        content.With(card);
        Note(content, "连接服务器后，全服排行与共建玩法自动开放。个人进度超出领取线的部分会保留。\n祭坛换算：金币×1=+1、100元宝=+5、1000元宝=+50、黑铁500=+4。");
        detail = Text("", "secondary", 0); detail.Named("altar-notice"); content.With(detail);
    }
    bool IsRecycleSelected(Equipment e) { for (int i = 0; i < recycleTargets.Count; i = i + 1) { if (recycleTargets[i] == e) { return true; } } return false; }
    void ToggleRecycle(Equipment e) {
        for (int i = 0; i < recycleTargets.Count; i = i + 1) { if (recycleTargets[i] == e) { recycleTargets.RemoveAt(i); return; } }
        if (e != null && !e.locked && g.RecyclePrice(e, recycleCurrency) > 0) { recycleTargets.Add(e); }
    }
    int RecycleSelectedValue() { int total = 0; for (int i = 0; i < recycleTargets.Count; i = i + 1) { total = Rules.Bounded((long)total + g.RecyclePrice(recycleTargets[i], recycleCurrency)); } return total; }
    void ToggleAllRecycle() {
        int eligible = g.RecycleEligibleCount(recycleCurrency);
        if (eligible > 0 && recycleTargets.Count == eligible) { recycleTargets.Clear(); return; }
        recycleTargets.Clear();
        for (int i = 0; i < g.bag.Count; i = i + 1) {
            Equipment e = g.bag[i]; if (!e.locked && g.RecyclePrice(e, recycleCurrency) > 0) { recycleTargets.Add(e); }
        }
    }
    void BuildRecycle() {
        content.With(Text("回收系统 · 装备兑换", "yellow strong", 32));
        Panel split = Panel.Row(); split.Gap(8); split.Grow(); content.With(split);
        Panel categories = Col("frame"); categories.Prefer(88, 0); split.With(categories);
        foreach (DataRow category in GameTables.current.recycle.rows) {
            int id = category.Int("id"); Button tab = Btn(category.Text("name"), "recycle-tab-" + Rules.N(id), () => { recycleCurrency = id; recyclePage = 0; recycleTargets.Clear(); Rebuild(); });
            tab.Prefer(0, 38); tab.Disabled = recycleCurrency == id; categories.With(tab);
        }
        Panel body = Col("recycle-list"); body.Grow(); split.With(body);
        DataRow currency = GameTables.current.recycle.At(recycleCurrency);
        pageInfo = Text("", "cyan", 28); body.With(pageInfo);
        int eligible = g.RecycleEligibleCount(recycleCurrency);
        Panel selectBar = Panel.Row(); selectBar.Gap(8); selectBar.Prefer(0, 32);
        Button selectAll = Btn(recycleTargets.Count == eligible && eligible > 0 ? "取消全选" : "一键全选", "recycle-select-all", () => { ToggleAllRecycle(); Rebuild(); }); selectAll.Prefer(96, 28); selectBar.With(selectAll);
        selectBar.With(Text("可选 " + Rules.N(eligible) + " 件 · 已选 " + Rules.N(recycleTargets.Count), "secondary", 28)); body.With(selectBar);
        ScrollColumn rows = new ScrollColumn(); rows.Named("recycle-scroll"); rows.Grow(); body.With(rows);
        int total = g.bag.Count; if (recyclePage * 6 >= total) { recyclePage = total > 0 ? (total - 1) / 6 : 0; }
        for (int i = recyclePage * 6; i < total && i < (recyclePage + 1) * 6; i = i + 1) {
            Equipment e = g.bag[i]; Panel row = Panel.Row(); row.Class = "frame"; row.Pad(8); row.Gap(8); row.Prefer(0, 76);
            Image icon = new Image(EquipmentArtPath(e), e.Name(), "contain"); icon.Prefer(48, 48); row.With(icon);
            Label name = Text(e.Name() + (e.locked ? " · 已锁定" : "") + "\n单件兑换：" + Rules.N(g.RecyclePrice(e, recycleCurrency)) + " " + currency.Text("name"), "yellow", 56); name.Grow(); row.With(name);
            bool chosen = IsRecycleSelected(e); Button select = Btn(chosen ? "取消选择" : "选择", "recycle-row-" + Rules.N(i), () => { ToggleRecycle(e); Rebuild(); }); select.Disabled = e.locked || g.RecyclePrice(e, recycleCurrency) <= 0; select.Prefer(80, 32); select.DockRight(); row.Add(select); rows.With(row);
        }
        if (total == 0) { rows.With(Text("背包没有可回收装备。穿戴和仓库中的装备不会列入。", "secondary", 64)); }
        Panel footer = Col("frame"); footer.Prefer(0, 150); footer.DockBottom(); body.Add(footer);
        Panel pager = Panel.Row(); pager.Prefer(0, 28); pager.Gap(8);
        Button prev = Btn("上一页", "recycle-prev", () => { recyclePage = recyclePage - 1; Rebuild(); }); prev.Disabled = recyclePage == 0; pager.With(prev);
        pager.With(Text(Rules.N(recyclePage + 1) + " / " + Rules.N(total == 0 ? 1 : (total + 5) / 6), "secondary", 28));
        Button next = Btn("下一页", "recycle-next", () => { recyclePage = recyclePage + 1; Rebuild(); }); next.Disabled = (recyclePage + 1) * 6 >= total; pager.With(next); footer.With(pager);
        footer.With(Text(recycleTargets.Count == 0 ? "请选择一件或多件装备；只兑换当前分类，不附送其它货币。" : "将消耗 " + Rules.N(recycleTargets.Count) + " 件\n获得 " + Rules.N(RecycleSelectedValue()) + " " + currency.Text("name"), "secondary", 56));
        Button confirm = Btn("确认回收选中的" + Rules.N(recycleTargets.Count) + "件", "recycle-confirm", () => { if (g.RecycleBatch(recycleTargets, recycleCurrency)) { recycleTargets.Clear(); } Rebuild(); }); confirm.Disabled = recycleTargets.Count == 0; footer.With(confirm);
        detail = Text("", "secondary", 32); content.With(detail); detail.DockBottom();
    }
    void BuildCodex() {
        content.With(Text("图鉴 · 在背包中选中装备后放入", "yellow", 28)); content.With(Text("已收录定义：" + Rules.N(g.CodexCount()) + " 件 · 槽位品质进度仍用于基础收藏评分", "cyan", 22)); Grid grid = Grid.Of(3); grid.Gap(8);
        for (int i = 0; i < 12; i = i + 1) { Panel cell = Col("frame"); cell.With(Text(Rules.Slots()[i], "cyan", 24)); cell.With(Art("slot-" + Rules.N(i % 10), 0, 48)); cell.With(Text(g.collected[i] == 0 ? "未收录" : Rules.Quality(g.collected[i]), "green", 20)); grid.With(cell); } content.With(grid);
        content.With(Text(g.SetSummary(), "secondary", 22));
        Note(content, "收录同一物品定义只计一次；套装按已收录的物品定义数量激活，存档会保留明细。");
    }
    void BuildAchievements() {
        content.With(Text("成就与奖励", "yellow strong", 28)); pageInfo = Text("", "green", 100); content.With(pageInfo);
        content.With(Btn("领取主线奖励", "quest-claim", () => { g.ClaimQuest(); Changed(); })); content.With(Btn("领取每日30杀悬赏", "bounty", () => { g.Bounty(); Changed(); }));
        content.With(Text("战斗统计", "cyan", 28)); detail = Text("", "secondary", 160); content.With(detail);
    }
    void BuildShop() {
        content.With(Text("配置商品 · 本地商店", "cyan", 28)); int total = GameTables.current.shop.rows.Count;
        Panel pager = Panel.Row(); pager.Prefer(0, 28); pager.With(Btn("上一页", "shop-prev", () => { if (shopPage > 0) { shopPage = shopPage - 1; BuildPage(); Refresh(); } }));
        pager.With(Text(Rules.N(shopPage + 1) + " / " + Rules.N((total + 5) / 6), "secondary", 24)); pager.With(Btn("下一页", "shop-next", () => { if ((shopPage + 1) * 6 < total) { shopPage = shopPage + 1; BuildPage(); Refresh(); } })); content.With(pager);
        Grid grid = Grid.Of(3); grid.Gap(8);
        for (int i = shopPage * 6; i < total && i < (shopPage + 1) * 6; i = i + 1) { DataRow offer = GameTables.current.shop.rows[i]; int id = offer.Int("id"); Panel tile = Col("frame"); tile.With(Art(offer.Text("reward") == "iron" ? "ore" : "reward", 0, 48)); tile.With(Text(offer.Text("name") + " ×" + Rules.N(offer.Int("quantity")) + "\n金币 " + Rules.N(offer.Int("gold") + g.capacity * offer.Int("capacity_gold")) + " / 黑铁 " + Rules.N(offer.Int("iron")) + " / 元宝 " + Rules.N(offer.Int("yuan")), "yellow", 60)); tile.With(Btn("购买", "shop-" + Rules.N(id), () => { g.Shop(id); Changed(); })); grid.With(tile); } content.With(grid);
        Note(content, "商品名称、数量与价格来自 shop.csv；重启后加载。未接入真实充值、推广和激活码服务。");
    }
    void BuildSettings() {
        content.With(Text(page == 28 ? "帮助 · 操作与现有规则" : "设置", "yellow strong", 28)); Grid grid = Grid.Of(2); grid.Gap(8);
        Panel battle = Col("frame"); battle.With(Text("挂机设置", "cyan", 24)); battle.With(Btn(g.active ? "☑ 自动战斗" : "☐ 自动战斗", "settings-active", () => { g.active = !g.active; Rebuild(); })); battle.With(Btn(g.autoPush ? "☑ 自动推层" : "☐ 自动推层", "settings-push", () => { g.autoPush = !g.autoPush; Rebuild(); })); battle.With(Btn(g.autoPotion ? "☑ 自动用药" : "☐ 自动用药", "settings-potion", () => { g.autoPotion = !g.autoPotion; Rebuild(); })); grid.With(battle);
        Panel filter = Col("frame"); filter.With(Text("拾取过滤", "cyan", 24));
        filter.With(Btn("最低品质：" + Rules.Quality(g.filter), "filter-quality", () => { g.filter = (g.filter + 1) % 5; Rebuild(); }));
        filter.With(Btn("最低系数：" + Rules.N(g.filterCoefficient), "filter-coefficient", () => { g.CycleFilterCoefficient(); Rebuild(); }));
        filter.With(Btn("最低等级：" + (g.filterMinLevel == 0 ? "不限" : Rules.N(g.filterMinLevel)), "filter-level", () => { g.CycleFilterLevel(); Rebuild(); }));
        filter.With(Btn(g.filterJobOnly ? "☑ 只保留本职业" : "☐ 只保留本职业", "filter-job", () => { g.filterJobOnly = !g.filterJobOnly; Rebuild(); }));
        Note(filter, "品质、系数、装备等级和职业可独立组合；过滤掉的装备不会占用背包。\n不会自动售卖或回收。"); grid.With(filter);
        Panel save = Col("frame"); save.With(Text("存档", "cyan", 24)); save.With(Btn("立即保存", "settings-save", () => { Changed(); })); Note(save, "每15秒、每次操作和正常退出保存。主文件损坏尝试备份；两份均损坏时禁止覆盖。"); grid.With(save);
        Panel help = Col("frame"); help.With(Text("操作说明", "cyan", 24)); Note(help, "单击装备选中；双击穿戴。\n左侧装备格选择锻造槽位。\n锁定保护回收、献祭。\n暂停挂机会暂停离线战斗。\n离线最多结算24小时。"); grid.With(help); content.With(grid);
        Note(content, "本地存档：" + saves.path);
    }
    void BuildArena() {
        content.With(Text("PK竞技场 · 本地对手", "yellow strong", 28));
        pageInfo = Text("", "cyan", 48); pageInfo.Named("arena-status"); content.With(pageInfo);
        Panel intro = Col("frame"); intro.With(Text("当前战力：" + Rules.N(g.Power()), "green", 32));
        Note(intro, "竞技场暂未接入服务器，以下为可重复验证的本地 NPC 对手；胜负、次数与战功都会写入本地存档。"); content.With(intro);
        Grid rivals = Grid.Of(3); rivals.Gap(8);
        for (int i = 0; i < 3; i = i + 1) {
            int n = i; Panel rival = Col("frame"); rival.Named("arena-rival-" + Rules.N(i));
            rival.With(Art(i == 0 ? "monster" : (i == 1 ? "horn" : "sword"), 64, 64));
            rival.With(Text("NPC 对手 " + Rules.N(i + 1), "strong", 28));
            rival.With(Text("挑战倍率 " + Rules.N(100 + i * g.B("arena_power_rival")) + "%\n胜利：战功 +" + Rules.N(g.B("arena_win_merit")) + "、金币 +" + Rules.N(g.B("arena_win_gold")) + "\n失败：战功 +" + Rules.N(g.B("arena_lose_merit")), "secondary", 64));
            Button fight = Btn("挑战（消耗1次）", "arena-fight-" + Rules.N(i), () => { g.Arena(n); Rebuild(); }); fight.Disabled = g.arenaTries <= 0; rival.With(fight); rivals.With(rival);
        }
        content.With(rivals); detail = Text("", "secondary", 0); detail.Named("arena-notice"); content.With(detail);
    }
    void BuildEscort() {
        content.With(Text("押镖 · 离线收益", "yellow strong", 28));
        pageInfo = Text("", "cyan", 64); pageInfo.Named("escort-status"); content.With(pageInfo);
        Panel route = Col("frame"); route.With(Art("reward", 64, 64));
        route.With(Text("镖车从本地营地出发，完成后自动发放金币与声望。等级、营地等级会影响最终金币；关闭游戏期间也会继续倒计时。", "secondary", 72));
        Button start = Btn("发起押镖 · 消耗 " + Rules.N(g.B("escort_gold")) + " 金币", "escort-start", () => { g.Escort(); Rebuild(); }); start.Disabled = g.escortLeft > 0 || g.escortTries <= 0; route.With(start); content.With(route);
        detail = Text("", "secondary", 0); detail.Named("escort-notice"); content.With(detail);
    }
    void BuildTitle() {
        bool rankPage = page == 24;
        content.With(Text(rankPage ? "爵位" : "称谓展示", "yellow strong", 28));
        pageInfo = Text("", "cyan", 64); pageInfo.Named(rankPage ? "rank-status" : "title-status"); content.With(pageInfo);
        Panel card = Col("frame"); card.With(Art(rankPage ? "horn" : "portrait", 72, 72));
        if (rankPage) {
            DataRow rule = GameTables.current.growth.At(2);
            card.With(Text("本地爵位成长 · 当前等级 " + Rules.N(g.title) + " / " + Rules.N(rule.Int("max_level")), "strong", 36));
            card.With(Text("每级提升全属性百分比；消耗声望 " + Rules.N(rule.Int("merit")) + " + 等级成长费用，并按配置扣除金币。", "secondary", 64));
            Button upgrade = Btn(g.title >= rule.Int("max_level") ? "已达上限" : "提升爵位", "title-upgrade", () => { g.Train(2); Rebuild(); }); upgrade.Disabled = g.title >= rule.Int("max_level"); card.With(upgrade);
        } else {
            card.With(Text("当前称谓等级 " + Rules.N(g.title), "strong", 36));
            card.With(Text("称谓加成已作用于战斗属性。", "secondary", 64));
            card.With(Btn("前往爵位提升", "title-go-rank", () => { Navigate(24); }));
        }
        content.With(card); detail = Text("", "secondary", 0); detail.Named("title-notice"); content.With(detail);
    }
    /* 联机页（沙巴克 · page 6）：进世界后的主线任务与战斗中枢。
       首个任务“首次击杀”的进度来自服务端累计击杀（self.kills），
       完成时奖励公告进右侧聊天栏；往下是战况、怪物与地图。
       登录/建角都在登录小窗完成，这里不再有连接/断开表单。加密与
       协议见 src/Net.zan。 */
    void BuildNetPage() {
        content.With(Text("沙巴克之路 · 主线任务", "yellow strong", 28));
        netStatus = Text(net.StatusText(), "cyan", 28); netStatus.Named("net-status"); content.With(netStatus);
        if (!net.InWorld()) {
            Panel conn = Col("frame");
            conn.With(Btn("重新连接服务器", "net-open", () => { BackToLoginForm(); BuildPage(); Refresh(); }));
            conn.With(Text("与服务器的连接已断开。点击回到登录窗重新连接；离线玩法不受影响。", "secondary small", 0));
            content.With(conn);
            return;
        }
        DataRow quest = GameTables.current.quests.At(0);
        int target = quest.Int("target");
        netQuest = Text("", "strong", 24); netQuest.Named("net-quest"); content.With(netQuest);
        content.With(Text("击杀任意怪物 " + Rules.N(target) + " 只，奖励金币 "
            + Rules.N(quest.Int("gold")) + "。完成时全服公告发奖。",
            "secondary small", 24));
        Panel world = Col("frame"); world.Grow();
        netFight = Text(net.FightLine(), "green", 96); netFight.Named("net-fight"); world.With(netFight);
        Panel actions = Panel.Row(); actions.Gap(4); actions.Prefer(0, 30);
        actions.With(Btn("停止挂机", "net-auto-off", () => { net.AutoHunt(0, false); }));
        actions.With(Btn("嗑药", "net-potion", () => { net.UsePotion(); }));
        actions.With(Btn("去背包", "net-go-bag", () => { Navigate(20); }));
        world.With(actions);
        if (net.MobCount() > 0) {
            world.With(Text("本图怪物（点击挂机，战况实时刷新）", "yellow small", 24));
            Grid mobRow = Grid.Of(3); mobRow.Gap(4);
            for (int i = 0; i < net.MobCount() && i < 6; i = i + 1) {
                JsonValue mob = net.MobAt(i);
                int tpl = mob.Int("tpl", 0);
                if (tpl <= 0 || mob.Int("alive", 0) != 1) { continue; }
                string label = mob.Str("name", "怪物") + " · " + Rules.N(mob.Int("level", 1)) + "级 · 血" + Rules.N(mob.Int("hp", 0));
                Panel card = Col("frame");
                Panel top = Panel.Row(); top.Gap(6); top.Prefer(0, 44);
                Image micon = new Image(PicturePath("boss", mob.Int("picture", 0)), mob.Str("name", "怪物"), "contain"); micon.Prefer(52, 44); top.With(micon);
                Label mlabel = Text(label, "cyan small", 0); mlabel.Grow(); top.With(mlabel);
                card.With(top);
                Panel row2 = Panel.Row(); row2.Gap(4); row2.Prefer(0, 28);
                Button autoBtn = Btn("挂机", "net-auto-" + Rules.N(tpl), () => { net.AutoHunt(tpl, true); }); autoBtn.Prefer(0, 26); row2.With(autoBtn);
                Button hitBtn = Btn("打一只", "net-hunt-" + Rules.N(tpl), () => { net.Hunt(tpl); }); hitBtn.Prefer(0, 26); row2.With(hitBtn);
                card.With(row2);
                mobRow.With(card);
            }
            world.With(mobRow);
        }
        if (net.MapCount() > 0) {
            world.With(Text("移动到其它地图", "yellow small", 24));
            Grid mapRow = Grid.Of(4); mapRow.Gap(4);
            for (int i = 0; i < net.MapCount() && i < 8; i = i + 1) {
                JsonValue mp = net.MapAt(i);
                int id = mp.Int("id", 0);
                string name = mp.Str("name", "地图") + " · " + Rules.N(mp.Int("minLevel", 1)) + "级";
                mapRow.With(Btn(name, "net-map-" + Rules.N(id), () => { net.MoveTo(id); }));
            }
            world.With(mapRow);
        }
        netWorld = Text("点击怪物开始挂机；世界聊天在右栏输入发送。", "secondary small", 20);
        world.With(netWorld);
        content.With(world);
        Panel foot = Panel.Row(); foot.Gap(4); foot.Prefer(0, 30);
        foot.With(Btn("退出登录", "net-logout", () => { net.Logout(); lastNetKey = -1; BackToLoginForm(); BuildPage(); Refresh(); }));
        content.With(foot);
        Note(content, "打怪掉落与任务奖励自动入账；断线后回登录窗重连，进度原样保留。");
    }

    /* 联机背包页（page 20）：左侧角色面板（穿着与战斗属性，可卸下），
       右侧物品格子墙；点物品在下方出「该物品 vs 当前穿戴」的属性对比，
       可穿戴/使用/卖出。进世界默认落在本页，好让新角色第一时间穿上
       初始装备。 */
    void BuildNetBag() {
        JsonValue st = net.Self();
        if (st == null) { return; }
        content.With(Text("背包", "yellow strong", 28));
        int myLv = st.Int("level", 1);
        Panel body = Panel.Row(); body.Gap(8); body.Grow(); content.With(body);
        Panel chr = Col("frame"); chr.Pad(10); chr.Gap(6); chr.Prefer(272, 0); body.With(chr);
        chr.With(Text("角色", "yellow", 28));
        chr.With(Text(st.Str("name", "旅人") + " · " + Rules.N(myLv) + "级"
            + (st.Str("title", "").Length > 0 ? " · " + st.Str("title", "") : ""), "cyan", 24));
        /* 穿戴位照原版列全（0武器…11宝石，空位不占行）：穿戴中的物品
           不在背包，名字/星级/属性由 self.worn 就地下发。 */
        chr.With(Text("穿戴", "yellow", 28));
        for (int i = 0; i < net.WornCount(); i = i + 1) {
            JsonValue w = net.WornAt(i);
            if (w == null) { continue; }
            int sl = w.Int("slot", -1);
            Panel wr = Panel.Row(); wr.Gap(4); wr.Prefer(0, 26);
            string star = w.Int("star", 0) > 0 ? " ★" + Rules.N(w.Int("star", 0)) : "";
            Label wl = Text(SlotName(sl, 2) + "：" + w.Str("name", "") + star, "cyan small", 0);
            wl.Grow(); wr.With(wl);
            int slCap = sl;
            Button off = Btn("卸", "net-takeoff-" + Rules.N(sl), () => { net.TakeOff(slCap); });
            off.Prefer(40, 24); wr.With(off);
            chr.With(wr);
        }
        if (net.WornCount() == 0) { chr.With(Text("（未穿装备，从右侧背包穿）", "secondary", 24)); }
        chr.With(Text("战斗属性", "yellow", 28));
        int aLo = st.Int("atkLo", 0); int aHi = st.Int("atk", 0);
        int dLo = st.Int("defLo", 0); int dHi = st.Int("def", 0);
        int mLo = st.Int("macLo", 0); int mHi = st.Int("mac", 0);
        chr.With(Text("攻击 " + (aLo < aHi ? Rules.N(aLo) + "-" : "") + Rules.N(aHi)
            + "\n防御 " + (dLo < dHi ? Rules.N(dLo) + "-" : "") + Rules.N(dHi)
            + "\n魔御 " + (mLo < mHi ? Rules.N(mLo) + "-" : "") + Rules.N(mHi)
            + "\n生命 " + Rules.N(st.Int("hp", 0)) + "/" + Rules.N(st.Int("maxhp", 1))
            + "\n经验 " + Rules.N(st.Int("exp", 0)) + "/" + Rules.N(st.Int("expnext", 1))
            + "\n击杀 " + Rules.N(st.Int("kills", 0)) + "\n金币 " + Rules.N(st.Int("gold", 0)), "green", 176));
        Panel right = Panel.Column(); right.Gap(8); right.Grow(); body.With(right);
        /* 分类签页：全部 / 消耗材料 / 武器 / 衣服 / 头盔 / 项链 / 手镯 /
           戒指 / 其他穿戴（腰带/靴子/勋章/宝石）。空类不显示。 */
        List<int> tabs = new List<int>(); tabs.Add(-2); tabs.Add(-1);
        for (int i = 0; i < net.BagCount(); i = i + 1) {
            int sl = net.BagAt(i).Int("slot", -1);
            if (sl >= 0 && !tabs.Contains(sl)) { tabs.Add(sl); }
        }
        for (int i = 0; i < net.BagCount(); i = i + 1) {
            int sl = net.BagAt(i).Int("slot", -1);
            if (sl >= 0 && sl != 0 && sl != 1 && sl != 2 && sl != 3 && sl != 4 && sl != 6 && !tabs.Contains(99)) { tabs.Add(99); }
        }
        Grid tabRow = Grid.Of(tabs.Count > 5 ? tabs.Count : 5); tabRow.Gap(4); tabRow.Prefer(0, 26); right.With(tabRow);
        for (int i = 0; i < tabs.Count; i = i + 1) {
            int tb = tabs[i];
            int n = 0;
            for (int k = 0; k < net.BagCount(); k = k + 1) {
                int sl = net.BagAt(k).Int("slot", -1);
                if (tb == -2) { n = net.BagCount(); break; }
                if (tb == -1 && sl < 0) { n = n + 1; }
                else if (tb == 99 && sl >= 0 && sl != 0 && sl != 1 && sl != 2 && sl != 3 && sl != 4 && sl != 6) { n = n + 1; }
                else if (tb >= 0 && sl == tb) { n = n + 1; }
            }
            if (n == 0 && tb != -2 && tb != -1) { continue; }
            Button tb2 = Btn((bagTab == tb ? "▶" : "") + (tb == -2 ? "全部" + Rules.N(n)
                : tb == -1 ? "消耗/材料" + Rules.N(n)
                : tb == 99 ? "其他" + Rules.N(n)
                : SlotName(tb, 1) + Rules.N(n)), "net-bag-tab-" + Rules.N(tb),
                () => { bagTab = tb; BuildPage(); });
            if (bagTab == tb) { tb2.Class = "primary"; }
            tabRow.With(tb2);
        }
        ScrollColumn list = new ScrollColumn(); list.Named("net-bag-scroll"); list.Grow(); right.With(list);
        if (net.BagCount() == 0) { list.With(Text("背包空空如也。去“沙巴克”打怪可获得掉落。", "secondary", 48)); }
        Grid cells = Grid.Of(5); cells.Gap(8); list.With(cells);
        JsonValue selItem = null;
        for (int i = 0; i < net.BagCount(); i = i + 1) {
            JsonValue it = net.BagAt(i);
            int id = it.Int("id", 0);
            int kind = it.Int("kind", 3);
            int slot = it.Int("slot", -1);
            int minLv = it.Int("minLevel", 0);
            /* 签页过滤：当前分类不匹配的不进网格。 */
            if (bagTab == -1 && slot >= 0) { continue; }
            if (bagTab == 99 && (slot < 0 || slot == 0 || slot == 1 || slot == 2 || slot == 3 || slot == 4 || slot == 6)) { continue; }
            if (bagTab >= 0 && slot != bagTab) { continue; }
            if (id == bagSel) { selItem = it; }
            string desc = SlotName(slot, kind);
            string stats = StatLine(it);
            if (stats.Length > 0) { desc = desc + "\n" + stats; }
            bool sel = id == bagSel;
            Button cell = Btn((sel ? "▶ " : "") + it.Str("name", "物品") + " ×" + Rules.N(it.Int("count", 1)) + "\n" + desc,
                "net-sel-" + Rules.N(id), () => { bagSel = id; BuildPage(); });
            cell.Prefer(0, 108);
            Image cellIcon = new Image(PicturePath("item", it.Int("picture", 0)), it.Str("name", "物品"), "contain");
            cellIcon.Prefer(36, 36); cell.With(cellIcon);
            cells.With(cell);
        }
        Panel cmp = Col("frame"); cmp.Pad(10); cmp.Gap(4); cmp.Prefer(0, 172); right.With(cmp);
        if (selItem == null) {
            cmp.With(Text("点上面的物品，这里显示它与当前穿戴的属性对比。", "secondary", 24));
        } else {
            int kind = selItem.Int("kind", 3);
            string kindName = SlotName(selItem.Int("slot", -1), kind);
            string sname = selItem.Str("name", "物品");
            int price = selItem.Int("price", 0);
            JsonValue tpl = ItemTpl(sname);
            if (price == 0 && tpl != null) { price = tpl.Int("price", 0); }
            cmp.With(Text(sname + " · " + kindName + " ×" + Rules.N(selItem.Int("count", 1))
                + " · 卖出价 " + Rules.N(price / 2), "yellow strong", 28));
            Panel btns = Panel.Row(); btns.Gap(4); btns.Prefer(0, 28);
            if (kind == 1 || kind == 2) {
                JsonValue worn = net.WornInSlot(selItem.Int("slot", -1));
                string wornName = worn != null ? worn.Str("name", "") : "";
                int mySum = SelSum(selItem);
                int curSum = worn != null ? SelSum(worn) : 0;
                int delta = mySum - curSum;
                string verdict; string vColor;
                string myStats = StatLine(selItem);
                if (wornName == sname) { verdict = "当前正穿戴这件"; vColor = "green"; }
                else if (worn == null) { verdict = "当前该栏位为空，穿上即生效"; vColor = "green"; }
                else if (delta > 0) { verdict = "比 " + wornName + " 高 " + Rules.N(delta) + " 点属性"; vColor = "green"; }
                else if (delta < 0) { verdict = "比 " + wornName + " 低 " + Rules.N(-delta) + " 点属性"; vColor = "orange"; }
                else { verdict = "与 " + wornName + " 属性相当"; vColor = "secondary"; }
                cmp.With(Text("该物品：" + (myStats.Length > 0 ? myStats : "无附加属性")
                    + "\n当前" + SlotName(selItem.Int("slot", -1), kind) + "："
                    + (worn != null ? wornName + " " + StatLine(worn) : "（空）")
                    + "\n" + verdict, vColor, 66));
                Button eq = Btn("穿 戴", "net-equip-" + Rules.N(selItem.Int("id", 0)), () => { net.EquipItem(selItem.Int("id", 0)); });
                eq.Disabled = myLv < selItem.Int("minLevel", 0);
                eq.Prefer(72, 28); btns.With(eq);
            } else {
                cmp.With(Text(kind == 0 ? "服用回血 " + Rules.N(selItem.Int("heal", 0))
                    : "卖店换钱的材料，「回收」页可一键清仓。", "secondary", 24));
                if (kind == 0) {
                    Button use = Btn("使 用", "net-use-" + Rules.N(selItem.Int("id", 0)), () => { net.UseItem(selItem.Int("id", 0)); });
                    use.Prefer(72, 28); btns.With(use);
                }
            }
            Button sell = Btn("卖 出", "net-sell-" + Rules.N(selItem.Int("id", 0)), () => { net.SellItem(selItem.Int("id", 0)); });
            sell.Prefer(72, 28); btns.With(sell);
            cmp.With(btns);
        }
        Note(content, "卖出价为商店半价；穿上更好的装备，攻防立刻生效。");
    }

    /* 原版属性行：攻/魔/道/防/魔御 lo-hi 区间（lo>0 且 <hi 才带下限）
       + 消耗品回血/装备血蓝加成 + 职业/等级门槛 + 重量；只列非零段，
       空串=白板。背包/商店行加成键是 heal，worn 行键是 hp，都接。 */
    string StatLine(JsonValue it) {
        string s = "";
        int lo = it.Int("atkMin", 0); int hi = it.Int("atk", 0);
        if (hi > 0) { s = s + "攻" + (lo > 0 && lo < hi ? Rules.N(lo) + "-" : "") + Rules.N(hi) + " "; }
        lo = it.Int("magicMin", 0); hi = it.Int("magic", 0);
        if (hi > 0) { s = s + "魔" + (lo > 0 && lo < hi ? Rules.N(lo) + "-" : "") + Rules.N(hi) + " "; }
        lo = it.Int("taoMin", 0); hi = it.Int("tao", 0);
        if (hi > 0) { s = s + "道" + (lo > 0 && lo < hi ? Rules.N(lo) + "-" : "") + Rules.N(hi) + " "; }
        lo = it.Int("defMin", 0); hi = it.Int("def", 0);
        if (hi > 0) { s = s + "防" + (lo > 0 && lo < hi ? Rules.N(lo) + "-" : "") + Rules.N(hi) + " "; }
        lo = it.Int("mdefMin", 0); hi = it.Int("mdef", 0);
        if (hi > 0) { s = s + "魔御" + (lo > 0 && lo < hi ? Rules.N(lo) + "-" : "") + Rules.N(hi) + " "; }
        int hp = it.Int("heal", 0);
        if (hp == 0) { hp = it.Int("hp", 0); }
        if (hp > 0) {
            s = s + (it.Int("kind", 3) == 0 ? "回血" + Rules.N(hp) + " "
                : "血+" + Rules.N(hp) + " ");
        }
        int mp = it.Int("mp", 0);
        if (mp > 0) { s = s + "蓝+" + Rules.N(mp) + " "; }
        int jn = it.Int("jobNeed", 0);
        if (jn == 1) { s = s + "限战士 "; }
        else if (jn == 2) { s = s + "限法师 "; }
        else if (jn == 3) { s = s + "限道士 "; }
        int lv = it.Int("minLevel", 0);
        if (lv > 1) { s = s + "需" + Rules.N(lv) + "级 "; }
        int wt = it.Int("weight", 0);
        if (wt > 0) { s = s + "重" + Rules.N(wt); }
        return s;
    }

    /* 穿戴价值粗比：攻/魔/道/防/魔御上限合计（背包对比行的 delta）。 */
    int SelSum(JsonValue it) {
        return it.Int("atk", 0) + it.Int("magic", 0) + it.Int("tao", 0)
            + it.Int("def", 0) + it.Int("mdef", 0);
    }

    /* 按名字查物品档：先翻背包，再翻商店缓存；都无则 null（只报名字）。 */
    JsonValue ItemTpl(string name) {        for (int i = 0; i < net.BagCount(); i = i + 1) {
            JsonValue it = net.BagAt(i);
            if (it.Str("name", "") == name) { return it; }
        }
        for (int i = 0; i < net.ShopCount(); i = i + 1) {
            JsonValue it = net.ShopAt(i);
            if (it.Str("name", "") == name) { return it; }
        }
        return null;
    }

    /* ---- 联机玩法页（服务端权威，占位页全部做实） ---- */

    /* 地图名/门槛：地图缓存（进区即拉全表）里查 id。 */
    string MapName(int id) {
        for (int i = 0; i < net.MapCount(); i = i + 1) {
            JsonValue mp = net.MapAt(i);
            if (mp.Int("id", 0) == id) { return mp.Str("name", "地图"); }
        }
        return "地图" + Rules.N(id);
    }

    int MapMinLevel(int id) {
        for (int i = 0; i < net.MapCount(); i = i + 1) {
            JsonValue mp = net.MapAt(i);
            if (mp.Int("id", 0) == id) { return mp.Int("minLevel", 1); }
        }
        return 1;
    }

    int MapOpen(int id) {
        for (int i = 0; i < net.MapCount(); i = i + 1) {
            JsonValue mp = net.MapAt(i);
            if (mp.Int("id", 0) == id) { return mp.Int("open", 1); }
        }
        return 1;
    }

    /* 地图缩略图：原版 map 包按出现顺序无名编号，地图 id N 对应第
       (N-1)*3 个条目（已用水印表逐一核对）；非当前图用预生成的灰度
       变体（_g），照原版“只有当前所在是彩色”。 */
    string MapThumbPath(int id, bool gray) {
        int idx = (id - 1) * 3;
        if (idx < 0) { idx = 0; }
        string path = "assets/map/" + Rules.N(idx).PadLeft(5, "0")
            + (gray ? "_g" : "") + ".jpg";
        return File.Exists(path) ? path : PicturePath("map", id);
    }

    /* 页 0 地图：照原版 BOSS 链——击败上一张图的 BOSS 才解锁下一张；
       解锁的图全彩色（当前图金框常亮，其余蓝框、悬停变金框），锁定
       的图置灰不可点；整卡就是地图截图，图名叠在图上右上角。
       底部 [1][2] 翻页（每页 20 张）。只动主体区域。 */
    void BuildNetTravel() {
        JsonValue st = net.Self();
        int curMap = st != null ? st.Int("map", 0) : 0;
        int unlocked = st != null && st.Int("mapUnlocked", 0) > 0
            ? st.Int("mapUnlocked", 0) : 1;
        int total = net.MapCount();
        /* 卡宽随窗口推导：中央=窗宽-聊天栏252-侧栏248，四列去内边距
           与列距。1080 宽下 ≈140×64，与原版 146×64 同量级。 */
        int cardW = (app.ClientWidth() - 252 - 248 - 8 - 12) / 4;
        if (cardW < 120) { cardW = 120; }
        int imgW = cardW - 2; int imgH = 64;
        ScrollColumn list = new ScrollColumn(); list.Named("net-travel-list"); list.Grow(); content.With(list);
        Grid cards = Grid.Of(4); cards.Class = "map-grid"; list.With(cards);
        int from = mapPage * 20;
        for (int i = from; i < total && i < from + 20; i = i + 1) {
            JsonValue mp = net.MapAt(i);
            int id = mp.Int("id", 0);
            bool here = id == curMap;
            bool open = id <= unlocked;
            string name = mp.Str("name", "地图");
            Panel card = new Panel();
            card.Class = here ? "map-tile map-tile-here"
                : open ? "map-tile map-tile-open" : "map-tile";
            card.Pad(1); card.Prefer(0, imgH + 2); card.Named("net-map-" + Rules.N(id));
            Image thumb = new Image(MapThumbPath(id, !open), name, "cover");
            thumb.DockManual(); thumb.Prefer(imgW, imgH); thumb.Place(0, 0); card.With(thumb);
            int nx = imgW - 6 - name.Length * 13; if (nx < 0) { nx = 0; }
            Label nm = Text(name, "map-name", 18); nm.DockManual(); nm.Prefer(imgW - nx, 18);
            nm.Place(nx, 3); card.With(nm);
            if (!here) {
                int mid = id;
                if (open) {
                    /* 解锁图：照原版点卡即进图，落到这张图的内页。 */
                    card.OnClick(() => {
                        net.MoveTo(mid);
                        net.OpenMapPage(mid);
                        Navigate(31);
                    });
                } else {
                    /* 锁定的图也接点击：服务端闸门会回报原因（尚未解锁：
                       先在上一张图的内页挑战并击败 BOSS），不能点了没反应。 */
                    card.OnClick(() => { net.MoveTo(mid); });
                }
            } else {
                /* 当前图：直接看内页（重进不需要移动）。 */
                int mid = id;
                card.OnClick(() => { net.OpenMapPage(mid); Navigate(31); });
            }
            cards.With(card);
        }
        /* 分页照原版在卡片阵下方（左下 [1][2]），随内容滚动。 */
        Panel pager = Panel.Row(); pager.Prefer(0, 34); pager.Pad(2);
        Label lp = Text("", "secondary", 0); lp.Grow(); pager.With(lp);
        int pages = (total + 19) / 20;
        for (int p = 0; p < pages; p = p + 1) {
            int pp = p;
            Button pg = Btn(Rules.N(p + 1), "map-page-" + Rules.N(p + 1), () => { mapPage = pp; BuildPage(); Refresh(); });
            pg.Prefer(30, 22); pager.With(pg);
        }
        Label rp = Text("", "secondary", 0); rp.Grow(); pager.With(rp);
        list.With(pager);
    }

    /* 页 31 地图内页（照原版进图后的页面）：左上战斗场景（我方对本图
       BOSS，头顶血条），其下战报滚动，底部返回/离线挂机条；右侧 BOSS
       面板——挑战(剩N)次、次数输入+扫荡、结束后自动挑战、属性栅格
       （气血/法力/攻击/魔法/道术 | 等级/转生/防御/魔防/幸运）。 */
    void BuildNetMapInner() {
        JsonValue st = net.Self();
        int mapId = netInnerMap;
        JsonValue page = net.BossPage();
        if (page == null) { net.OpenMapPage(mapId); }
        string mapName = "";
        for (int i = 0; i < net.MapCount(); i = i + 1) {
            JsonValue mp = net.MapAt(i);
            if (mp.Int("id", 0) == mapId) { mapName = mp.Str("name", ""); break; }
        }
        Panel split = Panel.Row(); split.Gap(8); split.Grow(); content.With(split);
        Panel left = Panel.Column(); left.Grow(); left.Gap(8); split.With(left);

        /* 战斗场景：我方（左）对本图 BOSS（右），头顶血量与血条。 */
        Panel scene = Col("boss-scene"); scene.Pad(12); scene.Gap(6); scene.Prefer(0, 248); left.With(scene);
        Panel duo = Panel.Row(); duo.Grow(); duo.Gap(0); scene.With(duo);
        Panel pside = Panel.Column(); pside.Grow(); pside.Gap(4); duo.With(pside);
        int php = st != null ? st.Int("hp", 0) : 0;
        int pmax = st != null ? st.Int("maxhp", 1) : 1;
        string pname = st != null ? st.Str("name", "旅人") : " ";
        Label phpl = Text(pname + " " + Rules.N(php) + "/" + Rules.N(pmax), "red", 18);
        phpl.Prefer(160, 18); pside.With(phpl);
        Progress pbar = new Progress(100, 5); pbar.Class = "health-bar"; pbar.Prefer(160, 6); pbar.showIndicator = false;
        pbar.percent = pmax > 0 ? (int)((long)php * 100 / pmax) : 0; pside.With(pbar);
        pside.With(Art("portrait", 76, 76));
        pside.With(Text(pname, "map-name", 18));
        Panel bside = Panel.Column(); bside.Grow(); bside.Gap(4); duo.With(bside);
        JsonValue bo = page != null ? page.Get("boss") : null;
        bool hasBoss = bo != null && bo.IsObject();
        int bhpLeft = hasBoss ? bo.Int("hpLeft", 0) : 0;
        int bhpMax = hasBoss ? bo.Int("hp", 1) : 1;
        Label bhpl = Text(Rules.N(bhpLeft) + "/" + Rules.N(bhpMax), "red", 18);
        bhpl.Prefer(160, 18); bside.With(bhpl);
        Progress bbar = new Progress(100, 5); bbar.Class = "health-bar"; bbar.Prefer(160, 6); bbar.showIndicator = false;
        bbar.percent = bhpMax > 0 ? (int)((long)bhpLeft * 100 / bhpMax) : 0; bside.With(bbar);
        if (hasBoss) {
            Image bimg = new Image(PicturePath("boss", bo.Int("picture", 0)), bo.Str("name", "BOSS"), "contain");
            bimg.Prefer(120, 108); bside.With(bimg);
        } else {
            bside.With(Text("本图无 BOSS", "secondary", 40));
        }
        bside.With(Text(hasBoss ? bo.Str("name", "BOSS") : " ", "map-name", 18));

        /* 战报：[BOSS] 黄、[战报]/[扫荡] 青、胜利绿、失败红。行数少，
           直接平铺 Label（嵌套 ScrollColumn 在列里会退化，不冒这个险）。 */
        Panel logPanel = Col("feed"); logPanel.Pad(8); logPanel.Gap(4); logPanel.Grow(); left.With(logPanel);
        int logN = net.BossLogCount();
        if (logN == 0) {
            logPanel.With(Text("尚未开战。点右侧「挑战BOSS」正面刚，胜利解锁下一张图；或底部「开始挂机」离线刷怪。", "secondary", 48));
        }
        for (int i = logN > 12 ? logN - 12 : 0; i < logN; i = i + 1) {
            string ln = net.BossLogAt(i);
            string cls = "secondary";
            if (ln.IndexOf("[BOSS]") == 0) { cls = "yellow"; }
            else if (ln.IndexOf("[战报]") == 0) { cls = "cyan"; }
            else if (ln.IndexOf("[扫荡]") == 0) { cls = "cyan"; }
            else if (ln.IndexOf("胜利") >= 0) { cls = "green"; }
            else if (ln.IndexOf("失败") >= 0) { cls = "red"; }
            logPanel.With(Text(ln, cls, 20));
        }

        /* 底部条：返回 | 离线挂机提示 | 开始挂机 | 说明。 */
        Panel foot = Panel.Row(); foot.Pad(2); foot.Gap(8); foot.Prefer(0, 36); left.With(foot);
        foot.With(Btn("返回", "inner-back", () => { Navigate(0); }));
        Label hint = Text("开始挂机后，可以关闭客户端，离线挂机→", "secondary", 0); hint.Grow(); foot.With(hint);
        foot.With(Btn("开始挂机", "inner-auto", () => {
            if (net.MobCount() > 0) { net.AutoHunt(net.MobAt(0).Int("tpl", 0), true); }
            else { net.AddFeed("本图怪物列表还没拉到，稍后再试。"); }
        }));
        foot.With(Btn("说明", "inner-help", () => {
            net.AddFeed("挑战BOSS每天 20 次；打输 BOSS 留血，接着挑战继续磨；打赢解锁下一张图。");
        }));

        /* 右侧 BOSS 面板：固定宽度列要 DockRight()+Add（照 BuildCombat），
           否则 Row 布局把固定列排到 Grow 列前面，左右颠倒。 */
        Panel right = Panel.Column(); right.Prefer(320, 0); right.DockRight();
        right.Gap(8); split.Add(right);
        Panel bossCard = Col("frame"); bossCard.Pad(10); bossCard.Gap(8); bossCard.Grow(); right.With(bossCard);
        bossCard.With(Text(mapName + (st != null && st.Int("map", 0) == mapId ? "（当前所在）" : ""), "yellow strong", 24));
        if (!hasBoss) {
            bossCard.With(Text("这张图没有配置 BOSS。", "secondary", 48));
            return;
        }
        bossCard.With(Text(Rules.N(bhpLeft) + "/" + Rules.N(bhpMax), "red strong", 20));
        Progress bhpBar = new Progress(100, 5); bhpBar.Class = "health-bar"; bhpBar.Prefer(0, 8); bhpBar.showIndicator = false;
        bhpBar.percent = bhpMax > 0 ? (int)((long)bhpLeft * 100 / bhpMax) : 0; bossCard.With(bhpBar);
        Image bpic = new Image(PicturePath("boss", bo.Int("picture", 0)), bo.Str("name", "BOSS"), "contain");
        bpic.Prefer(120, 108); bossCard.With(bpic);
        int tries = page != null ? page.Int("tries", 0) : 0;
        Panel ops = Panel.Row(); ops.Gap(6); ops.Prefer(0, 34); bossCard.With(ops);
        Button fightBtn = Btn("挑战BOSS(剩" + Rules.N(tries) + ")次", "boss-fight", () => { net.BossFight(mapId); });
        fightBtn.Prefer(0, 34); fightBtn.Grow(); ops.With(fightBtn);
        Input sweepIn = new Input("10"); sweepIn.Prefer(46, 34); ops.With(sweepIn);
        ops.With(Btn("扫荡", "boss-sweep", () => {
            string t = sweepIn.GetText().Trim();
            bool digits = t.Length > 0;
            for (int c = 0; c < t.Length; c = c + 1) {
                if (t[c] < '0' || t[c] > '9') { digits = false; break; }
            }
            int n = digits ? Convert.ToInt(t) : 10;
            if (n < 1) { n = 10; }
            if (n > 20) { n = 20; }
            net.BossSweep(mapId, n);
        }));
        Button autoBtn = Btn(net.BossAuto() ? "☑ 结束后自动挑战BOSS(勾选生效)" : "☐ 结束后自动挑战BOSS(勾选生效)",
            "boss-auto", () => { net.SetBossAuto(!net.BossAuto()); });
        autoBtn.Prefer(0, 28); bossCard.With(autoBtn);

        /* 属性栅格：照原版两列（青=基础属性，绿=成长，紫=稀有）。 */
        Grid stat = Grid.Of(2); stat.Gap(4); bossCard.With(stat);
        stat.With(StatCell("气血", Rules.N(bhpMax), "cyan"));
        stat.With(StatCell("等级", Rules.N(bo.Int("level", 1)), "green"));
        stat.With(StatCell("法力", Rules.N(bo.Int("mp", 0)), "cyan"));
        stat.With(StatCell("转生", "0", "magenta"));
        stat.With(StatCell("攻击", Rules.N(bo.Int("atkMin", 0)) + " - " + Rules.N(bo.Int("atk", 0)), "cyan"));
        stat.With(StatCell("防御", "0 - " + Rules.N(bo.Int("def", 0)), "green"));
        stat.With(StatCell("魔法", "0 - 0", "cyan"));
        stat.With(StatCell("魔防", "0 - " + Rules.N(bo.Int("mdef", 0)), "magenta"));
        stat.With(StatCell("道术", "0 - 0", "cyan"));
        stat.With(StatCell("幸运", "0", "magenta"));
        bossCard.With(Text("击败 BOSS 掉好装备并解锁下一张图；扫荡需先击败过它。", "secondary", 20));
    }

    /* 内页属性栅格格：彩色标签 + 白值。 */
    Panel StatCell(string label, string value, string cls) {
        Panel cell = Panel.Row(); cell.Gap(4); cell.Prefer(0, 24);
        cell.With(Text(label + "：", cls, 20));
        Label v = Text(value, "", 20); v.Grow(); cell.With(v);
        return cell;
    }

    /* UiDriver 探针：内页 BOSS 面板状态一行。 */
    string BossProbeLine() {
        JsonValue bp = net.BossPage();
        if (bp == null) { return "page:N log:" + Rules.N(net.BossLogCount()); }
        JsonValue bb = bp.Get("boss");
        return "tries:" + Rules.N(bp.Int("tries", 0)) + " boss:"
            + (bb != null && bb.IsObject()
                ? bb.Str("name", "?") + "@" + Rules.N(bb.Int("hpLeft", 0))
                    + "/" + Rules.N(bb.Int("hp", 0))
                : "none")
            + " log:" + Rules.N(net.BossLogCount());
    }

    /* 页 3 BOSS 之家：全场唯一刷怪点（教主类）清单，带在场/重生倒计时
       与掉落，一键前往它所在的地图。 */
    void BuildNetBossHome() {
        JsonValue st = net.Self();
        net.MaybeRefreshBosses();
        content.With(Text("BOSS 之家", "yellow strong", 28));
        Panel head = Panel.Row(); head.Gap(4); head.Prefer(0, 28);
        head.With(Btn("刷新状态", "net-boss-reload", () => { net.ReloadBosses(); }));
        head.With(Text("唯一刷怪点的教主都在这里；击杀掉好装备。", "secondary small", 0));
        content.With(head);
        ScrollColumn list = new ScrollColumn(); list.Named("net-boss-list"); list.Grow(); content.With(list);
        if (net.BossCount() == 0) { list.With(Text("正在拉取 BOSS 列表…", "secondary", 48)); }
        for (int i = 0; i < net.BossCount(); i = i + 1) {
            JsonValue b = net.BossAt(i);
            int mapId = b.Int("map", 0);
            bool alive = b.Int("alive", 0) == 1;
            bool here = st != null && st.Int("map", 0) == mapId;
            Panel row = Panel.Row(); row.Class = "frame"; row.Pad(8); row.Gap(8); row.Prefer(0, 64);
            Image bicon = new Image(PicturePath("boss", b.Int("picture", 0)), b.Str("name", "BOSS"), "contain");
            bicon.Prefer(56, 56); row.With(bicon);
            string line = b.Str("name", "BOSS") + " · " + Rules.N(b.Int("level", 1)) + "级 · 血"
                + Rules.N(b.Int("hp", 0)) + (alive ? " · 在场" : " · 重生 " + Rules.N(b.Int("respawnIn", 0)) + "s")
                + "\n" + MapName(mapId) + " · 掉落：" + b.Str("drop", "无")
                + " · 经验 " + Rules.N(b.Int("exp", 0)) + " · 金 " + b.Str("gold", "0");
            Label name = Text(line, alive ? "yellow" : "secondary", 52); name.Grow(); row.With(name);
            Button go = Btn(here ? "就在本图" : "前往", "net-boss-go-" + Rules.N(b.Int("tpl", 0)), () => { net.MoveTo(mapId); });
            int unlockedNow = st != null && st.Int("mapUnlocked", 0) > 0
                ? st.Int("mapUnlocked", 0) : 1;
            go.Disabled = here || mapId > unlockedNow;
            go.Prefer(84, 28); go.DockRight(); row.Add(go);
            list.With(row);
        }
        Note(content, "前往后到“沙巴克”点它的「挂机」即可自动开打；BOSS 被杀会全服公告，重生要等一阵。");
    }

    /* 页 9 排行榜：本区等级/经验前 10，自己一行高亮。 */
    void BuildNetRank() {
        JsonValue st = net.Self();
        net.RefreshRank();
        content.With(Text("排行榜 · 本区", "yellow strong", 28));
        Panel head = Panel.Row(); head.Gap(4); head.Prefer(0, 28);
        head.With(Btn("刷新", "net-rank-reload", () => { net.ReloadRank(); }));
        head.With(Text("全服等级与经验实时排行。", "secondary small", 0));
        content.With(head);
        ScrollColumn list = new ScrollColumn(); list.Named("net-rank-list"); list.Grow(); content.With(list);
        if (net.RankCount() == 0) { list.With(Text("正在拉取排行…", "secondary", 48)); }
        for (int i = 0; i < net.RankCount(); i = i + 1) {
            JsonValue r = net.RankAt(i);
            bool me = r.Int("me", 0) == 1;
            Panel row = Panel.Row(); row.Class = "frame"; row.Pad(8); row.Gap(8); row.Prefer(0, 44);
            Label name = Text(Rules.N(i + 1) + ". " + r.Str("name", "???") + (me ? "（我）" : "")
                + "\n" + Rules.N(r.Int("level", 1)) + "级 · 击杀 " + Rules.N(r.Int("kills", 0))
                + (r.Str("title", "").Length > 0 ? " · " + r.Str("title", "") : ""), me ? "green" : "yellow", 34);
            name.Grow(); row.With(name);
            list.With(row);
        }
        Note(content, "想上榜就多挂机——顶号、掉线都不影响名次。");
    }

    /* 页 12 秘境：高阶打宝图（门槛 ≥15 级的秘境图）+ 图内 BOSS，一键
       前往。与地图传送同一条 move 协议，只是按秘境视角组织。 */
    void BuildNetSecret() {
        JsonValue st = net.Self();
        net.MaybeRefreshBosses();
        content.With(Text("秘境 · 打宝图", "yellow strong", 28));
        content.With(Text("门槛高、怪物密、掉落好——成型装备的主要产地。", "cyan", 24));
        ScrollColumn list = new ScrollColumn(); list.Named("net-secret-list"); list.Grow(); content.With(list);
        for (int i = 0; i < net.MapCount(); i = i + 1) {
            JsonValue mp = net.MapAt(i);
            int id = mp.Int("id", 0);
            int minLv = mp.Int("minLevel", 1);
            if (minLv < 15 || id < 6) { continue; }
            bool here = st != null && st.Int("map", 0) == id;
            Panel row = Panel.Row(); row.Class = "frame"; row.Pad(8); row.Gap(8); row.Prefer(0, 52);
            Label name = Text(mp.Str("name", "秘境") + (here ? "（当前）" : "") + "\n门槛 "
                + Rules.N(minLv) + " 级 · BOSS：" + SecretBossName(id), "yellow", 40);
            name.Grow(); row.With(name);
            Button go = Btn(here ? "就在这" : "前往", "net-secret-go-" + Rules.N(id), () => { net.MoveTo(id); });
            int unlockedNow = st != null && st.Int("mapUnlocked", 0) > 0
                ? st.Int("mapUnlocked", 0) : 1;
            go.Disabled = here || id > unlockedNow;
            go.Prefer(72, 28); go.DockRight(); row.Add(go);
            list.With(row);
        }
        Note(content, "秘境教主同样出现在“BOSS 之家”，被杀后全服公告。挂机请去“沙巴克”页选怪。");
    }

    string SecretBossName(int mapId) {
        for (int i = 0; i < net.BossCount(); i = i + 1) {
            JsonValue b = net.BossAt(i);
            if (b.Int("map", 0) == mapId) { return b.Str("name", "???"); }
        }
        return "无";
    }

    /* 页 13 世界BOSS：全服同管血，人人可打；击杀者大奖、伤害王随公告。 */
    void BuildNetWBoss() {
        JsonValue st = net.Self();
        JsonValue w = net.WBoss();
        net.RefreshWBoss();
        content.With(Text("世界 BOSS · 全服共斗", "yellow strong", 28));
        Panel card = Col("frame"); card.Grow();
        if (w == null) {
            card.With(Text("正在拉取世界 BOSS 状态…", "secondary", 48));
        } else if (w.Int("alive", 0) == 1) {
            int hp = w.Int("hp", 0); int max = w.Int("maxhp", 1);
            int pct = max > 0 ? hp * 100 / max : 0;
            card.With(Text(w.Str("name", "世界BOSS") + " · " + Rules.N(w.Int("level", 1)) + "级", "yellow", 36));
            card.With(Text("血量 " + Rules.N(hp) + " / " + Rules.N(max)
                + "（" + Rules.N(pct) + "%）", "cyan", 28));
            card.With(Text("伤害王：" + (w.Str("top", "").Length > 0 ? w.Str("top", "") : "虚位以待")
                + " · 我的累计伤害：" + Rules.N(st != null ? w.Int("mydmg", 0) : 0), "secondary small", 24));
            Button hit = Btn("全力攻击", "net-wboss-hit", () => { net.WBossHit(); });
            hit.Prefer(120, 32); card.With(hit);
            card.With(Text("每次攻击按自身攻击力结算伤害，BOSS 也会还手（打不死你，但会掉血）；随时可以去别页挂机，回来继续。", "secondary small", 24));
        } else {
            card.With(Text(w.Str("name", "世界BOSS") + " 已被击杀", "green", 36));
            card.With(Text("伤害王：" + w.Str("top", "???") + " · " + Rules.N(w.Int("respawnIn", 0)) + " 秒后重生", "secondary", 28));
        }
        content.With(card);
        netFight = Text(net.FightLine(), "green", 96); netFight.Named("net-fight"); content.With(netFight);
        Note(content, "击杀公告全服可见，大奖（金币+神装）归完成最后一击的人。重生 5 分钟。");
    }

    /* 页 15 寻宝：200 金币一抽，奖池覆盖全物品档（屠龙 0.2%）。 */
    void BuildNetDraw() {
        JsonValue st = net.Self();
        content.With(Text("寻宝", "yellow strong", 28));
        Panel card = Col("frame"); card.Grow();
        card.With(Text("每次 200 金币，随机得一件物品，直入背包。", "cyan", 28));
        card.With(Text("奖池：金创药/材料为主，铁剑、轻盔、修罗、战神盔甲次之；屠龙爆率 0.2%。", "secondary small", 24));
        card.With(Text("当前金币：" + Rules.N(st != null ? st.Int("gold", 0) : 0), "yellow", 28));
        Button draw = Btn("寻宝一次（200 金币）", "net-draw", () => { net.DrawTreasure(); });
        draw.Disabled = st == null || st.Int("gold", 0) < 200;
        draw.Prefer(160, 32); card.With(draw);
        content.With(card);
        netFight = Text(net.FightLine(), "green", 96); netFight.Named("net-fight"); content.With(netFight);
        Note(content, "抽到的武器/防具去背包页穿戴；材料可去回收系统一次清空换金币。");
    }

    /* 页 17 回收系统：背包里的材料（兽皮/蝎子壳/祖玛头像/赤月精华）
       一键按卖店半价全部结成金币。 */
    void BuildNetRecycle() {
        JsonValue st = net.Self();
        content.With(Text("回收系统 · 材料换金", "yellow strong", 28));
        ScrollColumn list = new ScrollColumn(); list.Named("net-recycle-list"); list.Grow(); content.With(list);
        int kinds = 0;
        for (int i = 0; i < net.BagCount(); i = i + 1) {
            JsonValue it = net.BagAt(i);
            if (it.Int("kind", 0) != 3) { continue; }
            kinds = kinds + 1;
            long each = it.Int("price", 0) / 2;
            Panel row = Panel.Row(); row.Class = "frame"; row.Pad(8); row.Gap(8); row.Prefer(0, 44);
            Label name = Text(it.Str("name", "材料") + " ×" + Rules.N(it.Int("count", 1))
                + "\n单价回收 " + Rules.N(each) + " 金币", "yellow", 34);
            name.Grow(); row.With(name);
            list.With(row);
        }
        if (kinds == 0) { list.With(Text("背包里暂时没有可回收的材料（兽皮/蝎子壳/祖玛头像/赤月精华）。去挂机打怪就有了。", "secondary", 48)); }
        Button all = Btn("一键回收全部材料", "net-recycle-all", () => { net.RecycleAll(); });
        all.Disabled = kinds == 0;
        all.Prefer(160, 32); content.With(all);
        Note(content, "回收价=商店半价，与背包页逐件“卖出”相同；这里是批量出水口，打金买药更顺手。");
    }

    /* 页 19 至尊极品殿堂：本区排行前三的展示位（复用排行协议）。 */
    void BuildNetHall() {
        net.RefreshRank();
        content.With(Text("至尊极品殿堂", "yellow strong", 28));
        ScrollColumn list = new ScrollColumn(); list.Named("net-hall-list"); list.Grow(); content.With(list);
        if (net.RankCount() == 0) { list.With(Text("正在拉取殿堂名单…", "secondary", 48)); }
        string[] medals = new string[] { "🥇", "🥈", "🥉" };
        for (int i = 0; i < net.RankCount() && i < 3; i = i + 1) {
            JsonValue r = net.RankAt(i);
            Panel row = Panel.Row(); row.Class = "frame"; row.Pad(12); row.Gap(12); row.Prefer(0, 72);
            Label name = Text(medals[i] + " " + r.Str("name", "???")
                + (r.Int("me", 0) == 1 ? "（我）" : "") + "\n" + Rules.N(r.Int("level", 1)) + "级 · 击杀 "
                + Rules.N(r.Int("kills", 0)) + (r.Str("title", "").Length > 0 ? " · " + r.Str("title", "") : ""), "yellow", 52);
            name.Grow(); row.With(name);
            list.With(row);
        }
        if (net.RankCount() > 3) { list.With(Text("……更多信息见「排行榜」。", "secondary small", 24)); }
        Note(content, "殿堂即本区等级前三；称号靠挂机与击杀堆出来。");
    }

    /* 页 21 铁匠铺：武器/防具强化星（每星武器+2攻、防具+2防，满星9），
       费用 = (星+1)*800 金币，服务端现结。 */
    void BuildNetForge() {
        JsonValue st = net.Self();
        content.With(Text("铁匠铺 · 强化", "yellow strong", 28));
        int wStar = st != null ? st.Int("weaponStar", 0) : 0;
        int aStar = st != null ? st.Int("armorStar", 0) : 0;
        long gold = st != null ? st.Int("gold", 0) : 0;
        Panel wcard = Col("frame");
        wcard.With(Text("武器：" + (st != null && st.Str("weaponName", "").Length > 0 ? st.Str("weaponName", "") : "（空）")
            + " · 强化 " + Rules.N(wStar) + " 星 · 攻击 " + Rules.N(st != null ? st.Int("atk", 0) : 0), "cyan", 28));
        Button fw = Btn(wStar >= 9 ? "武器已满星" : "强化武器（" + Rules.N((wStar + 1) * 800) + " 金币）",
            "net-forge-weapon", () => { net.Forge("weapon"); });
        fw.Disabled = st == null || wStar >= 9 || gold < (wStar + 1) * 800;
        fw.Prefer(200, 32); wcard.With(fw);
        content.With(wcard);
        Panel acard = Col("frame");
        acard.With(Text("防具：" + (st != null && st.Str("armorName", "").Length > 0 ? st.Str("armorName", "") : "（空）")
            + " · 强化 " + Rules.N(aStar) + " 星 · 防御 " + Rules.N(st != null ? st.Int("def", 0) : 0), "cyan", 28));
        Button fa = Btn(aStar >= 9 ? "防具已满星" : "强化防具（" + Rules.N((aStar + 1) * 800) + " 金币）",
            "net-forge-armor", () => { net.Forge("armor"); });
        fa.Disabled = st == null || aStar >= 9 || gold < (aStar + 1) * 800;
        fa.Prefer(200, 32); acard.With(fa);
        content.With(acard);
        content.With(Text("金币：" + Rules.N(gold) + " · 换新武器/防具后星级保留在角色身上，不随装备丢失。", "secondary small", 24));
        Note(content, "强化必成、稳定变强；金币主要靠挂机掉落与材料回收，世界BOSS 一击奖励 5000。");
    }

    /* 页 24 爵位：按累计击杀授爵（服务端权威的 kills），纯展示+进度。 */
    void BuildNetNoble() {
        JsonValue st = net.Self();
        int kills = st != null ? st.Int("kills", 0) : 0;
        string[] names = new string[] { "平民", "侍卫", "骑士", "男爵", "子爵", "伯爵", "名将", "战神" };
        int[] need = new int[] { 0, 20, 50, 120, 300, 800, 2000, 5000 };
        int cur = 0;
        for (int i = 0; i < need.Length; i = i + 1) { if (kills >= need[i]) { cur = i; } }
        content.With(Text("爵位 · 按击杀授爵", "yellow strong", 28));
        Panel card = Col("frame");
        card.With(Text("当前爵位：" + names[cur] + "（累计击杀 " + Rules.N(kills) + "）", "green", 36));
        if (cur + 1 < need.Length) {
            card.With(Text("下一爵位 " + names[cur + 1] + "：还需 " + Rules.N(need[cur + 1] - kills) + " 次击杀", "cyan", 28));
        } else {
            card.With(Text("已至最高爵位。", "yellow", 28));
        }
        content.With(card);
        ScrollColumn list = new ScrollColumn(); list.Named("net-noble-list"); list.Grow(); content.With(list);
        for (int i = 0; i < names.Length; i = i + 1) {
            Panel row = Panel.Row(); row.Class = "frame"; row.Pad(6); row.Gap(8); row.Prefer(0, 36);
            Label name = Text(names[i] + " · 需击杀 " + Rules.N(need[i]) + (i == cur ? "　✅当前" : (kills >= need[i] ? "　✅" : "")), i == cur ? "green" : "yellow", 26);
            name.Grow(); row.With(name);
            list.With(row);
        }
        Note(content, "击杀数随挂机与BOSS战累计；排行榜会展示你的名字与爵位同行的击杀数。");
    }

    /* 页 26 成就：里程碑清单（数据全部来自服务端 self），达成打勾。 */
    void BuildNetAchv() {
        JsonValue st = net.Self();
        int kills = st != null ? st.Int("kills", 0) : 0;
        int level = st != null ? st.Int("level", 1) : 1;
        long gold = st != null ? st.Int("gold", 0) : 0;
        int wStar = st != null ? st.Int("weaponStar", 0) : 0;
        string[] names = new string[] { "首次击杀", "小有名气", "百人斩", "千军斩", "初出茅庐", "崭露头角", "登堂入室", "第一桶金", "富甲一方", "神兵初成" };
        string[] desc = new string[] { "累计击杀 5", "累计击杀 50", "累计击杀 100", "累计击杀 1000", "达到 10 级", "达到 20 级", "达到 30 级", "持有 1000 金币", "持有 10000 金币", "武器强化 3 星" };
        bool[] done = new bool[] { kills >= 5, kills >= 50, kills >= 100, kills >= 1000, level >= 10, level >= 20, level >= 30, gold >= 1000, gold >= 10000, wStar >= 3 };
        content.With(Text("成就 · 里程碑", "yellow strong", 28));
        ScrollColumn list = new ScrollColumn(); list.Named("net-achv-list"); list.Grow(); content.With(list);
        for (int i = 0; i < names.Length; i = i + 1) {
            Panel row = Panel.Row(); row.Class = "frame"; row.Pad(6); row.Gap(8); row.Prefer(0, 36);
            Label name = Text((done[i] ? "✅ " : "⬜ ") + names[i] + " · " + desc[i], done[i] ? "green" : "yellow", 26);
            name.Grow(); row.With(name);
            list.With(row);
        }
        Note(content, "成就按当前进度实时判定；「首次击杀」完成时有 400 金币奖励公告（主线任务）。");
    }

    /* 页 27 商店：服务端 shop 档（price>0 的物品），买一件入背包。 */
    void BuildNetShop() {
        JsonValue st = net.Self();
        net.MaybeRefreshShop();
        content.With(Text("商店", "yellow strong", 28));
        content.With(Text("金币：" + Rules.N(st != null ? st.Int("gold", 0) : 0) + " · 买断一件即入背包；卖出在背包页（半价）。", "cyan", 24));
        ScrollColumn list = new ScrollColumn(); list.Named("net-shop-list"); list.Grow(); content.With(list);
        if (net.ShopCount() == 0) { list.With(Text("正在拉取商品…", "secondary", 48)); }
        for (int i = 0; i < net.ShopCount(); i = i + 1) {
            JsonValue it = net.ShopAt(i);
            int id = it.Int("id", 0);
            int minLv = it.Int("minLevel", 1);
            int kind = it.Int("kind", 0);
            string kindName = kind == 0 ? "消耗品"
                : kind == 1 ? "武器" : SlotName(it.Int("slot", -1), 2);
            string desc = kindName;
            string stats = StatLine(it);
            if (stats.Length > 0) { desc = desc + " · " + stats; }
            Panel row = Panel.Row(); row.Class = "frame"; row.Pad(8); row.Gap(8); row.Prefer(0, 52);
            Label name = Text(it.Str("name", "商品") + " · " + Rules.N(it.Int("price", 0)) + " 金币\n" + desc, "yellow", 40);
            name.Grow(); row.With(name);
            Button buy = Btn("购买", "net-buy-" + Rules.N(id), () => { net.BuyItem(id); });
            buy.Disabled = st != null && st.Int("level", 1) < minLv;
            buy.Prefer(64, 28); buy.DockRight(); row.Add(buy);
            list.With(row);
        }
        Note(content, "升级武器/防具的顺手店：铁剑(5级)、修罗(12级)、战神盔甲(12级)……屠龙要靠 BOSS 掉。");
    }

    /* 页 28 帮助：玩法上手（全为已做实的联机功能）。 */
    void BuildNetHelp() {
        content.With(Text("帮助 · 怎么玩", "yellow strong", 28));
        ScrollColumn list = new ScrollColumn(); list.Named("net-help-list"); list.Grow(); content.With(list);
        string[] lines = new string[] {
            "① 进世界先穿装备：落在「背包」页，把木剑/布衣点「穿戴」。",
            "② 挂机练级：去「沙巴克」（主线任务页）选一只怪点「挂机」。战况动画是本地演示，服务端每 60 秒批量结算一次，经验和金币自动入账。",
            "③ 换图进阶：「地图传送」按等级门槛去沃玛森林/僵尸洞窟/祖玛寺庙/赤月峡谷，怪更强、掉落更好。",
            "④ 打 BOSS：「BOSS 之家」看全服教主在不在场，一键前往；击杀掉神装并全服公告。",
            "⑤ 世界 BOSS：「世界 BOSS」页全服共斗一管血，最后一击拿 5000 金币大奖，伤害王上公告。",
            "⑥ 变强：「铁匠铺」花金币强化武器/防具（每星+2 攻/防，满星 9）；「商店」买进阶装备与药。",
            "⑦ 打金循环：「回收系统」一键清空材料换金币；「寻宝」200 金币碰运气（屠龙 0.2%）。",
            "⑧ 荣誉：「排行榜」看本区名次；「至尊极品殿堂」是前三名的展示位；「爵位/成就」按击杀与里程碑解锁。",
            "⑨ 断线不用慌：连接断开会回到登录小窗，重新连接后角色、背包、进度原样都在。",
            "⑩ 聊天：右侧输入框发世界聊天；公告（任务完成/BOSS 击杀）也会推送到这里。"
        };
        for (int i = 0; i < lines.Length; i = i + 1) {
            Panel row = Panel.Row(); row.Class = "frame"; row.Pad(6); row.Gap(8); row.Prefer(0, 40);
            Label name = Text(lines[i], "cyan", 30); name.Grow(); row.With(name);
            list.With(row);
        }
        Note(content, "玩法随版本持续更新。");
    }

    /* 页 29 邮箱/公告：服务端公告列表（GM 后台发的都在这）。 */
    void BuildNetAnnounce() {
        net.MaybeRefreshAnnounces();
        content.With(Text("邮箱 · 公告", "yellow strong", 28));
        ScrollColumn list = new ScrollColumn(); list.Named("net-ann-list"); list.Grow(); content.With(list);
        if (net.AnnounceCount() == 0) { list.With(Text("正在拉取公告…", "secondary", 48)); }
        for (int i = 0; i < net.AnnounceCount(); i = i + 1) {
            JsonValue a = net.AnnounceAt(i);
            Panel row = Panel.Row(); row.Class = "frame"; row.Pad(8); row.Gap(8); row.Prefer(0, 64);
            Label name = Text("📢 " + a.Str("title", "公告") + "\n" + a.Str("body", ""), "yellow", 52);
            name.Grow(); row.With(name);
            list.With(row);
        }
        Note(content, "GM 后台发布的公告都会出现在这里；任务完成、世界 BOSS 击杀等事件公告走右侧聊天栏。");
    }

    /* 页 30 设置（联机）：会话信息 + 退出登录。 */
    void BuildNetSettings() {
        JsonValue st = net.Self();
        content.With(Text("设置", "yellow strong", 28));
        Panel card = Col("frame");
        card.With(Text("账号：" + (st != null ? st.Str("name", "???") : "???")
            + "（UID " + Rules.N(st != null ? st.Int("uid", 0) : 0) + "）", "cyan", 28));
        card.With(Text("区服：" + net.RealmName() + "（经验 " + RateLabel(net.ExpRate())
            + " · 金币 " + RateLabel(net.GoldRate()) + " · 爆率 " + RateLabel(net.DropRate())
            + "）", "cyan", 28));
        card.With(Text("会话：" + (st != null ? "在线" : "离线")
            + " · AES-256-GCM 加密 · HKDF-SHA256 派生 · 序号防重放", "secondary small", 24));
        card.With(Text("存档：角色/背包/进度按区服隔离存在服务器，换机器登录同账号即可续玩。", "secondary small", 24));
        content.With(card);
        Panel foot = Panel.Row(); foot.Gap(4); foot.Prefer(0, 30);
        foot.With(Btn("退出登录", "net-settings-logout", () => { net.Logout(); lastNetKey = -1; BackToLoginForm(); BuildPage(); Refresh(); }));
        content.With(foot);
        Note(content, "离线模式进度保存在本机，与本账号互不影响；退出登录后可继续离线玩。");
    }

    /* 页 2 幻境（联机视角）：离线挂机系统说明与进度展示。 */
    void BuildNetOfflinePage() {
        content.With(Text("幻境 · 离线挂机", "yellow strong", 28));
        Panel card = Col("frame");
        card.With(Text("世界内挂机自动结算任务、击杀与掉落；本页展示离线幻境进度。", "cyan", 28));
        card.With(Text("离线幻境进度（当前第 " + Rules.N(g.challenge) + " 层挑战）原样保留；退出登录后自动继续，收益不丢。", "secondary", 28));
        content.With(card);
        Panel go = Panel.Row(); go.Gap(4); go.Prefer(0, 30);
        go.With(Btn("去挂机（沙巴克）", "net-offline-go-quest", () => { Navigate(6); }));
        go.With(Btn("去背包", "net-offline-go-bag", () => { Navigate(20); }));
        content.With(go);
        Note(content, "离线幻境数据在本机存档，世界角色进度在服务器，互不覆盖。");
    }

    /* 联机时其余导航页的诚实占位：玩法未开就说明未开，并给出去任务
       页/背包页的入口——不回落离线界面冒充联机内容。 */
    void BuildNetStub() {
        content.With(Text(pages[page] + "（即将开放）", "yellow strong", 28));
        Note(content, "此页玩法即将开放；离线进度已保留，退出登录后可继续。");
        Panel go = Panel.Row(); go.Gap(4); go.Prefer(0, 30);
        go.With(Btn("去主线任务", "net-go-quest", () => { Navigate(6); }));
        go.With(Btn("去背包", "net-go-bag2", () => { Navigate(20); }));
        content.With(go);
    }

    /* ---- 玩法页（Play 模块的 13 个 op）：每页 = 进页拉一次缓存 +
       按钮动作就地合入；数据形状对照服务端 Play.zan。页码即导航号：
       1 竞技场 4 押镖 5 行会 7 攻城 8 传说塔 10 五行 11 师徒
       14 祭坛 16 将星 18 红包 22 市场 23 图鉴 25 称谓。---- */

    /* 页 1 PK竞技场：每日 5 场，三个对手按编号变强；胜得战功+金币。 */
    void BuildNetArena() {
        net.MaybeRefreshArena();
        JsonValue st = net.Self();
        content.With(Text("PK竞技场", "yellow strong", 28));
        JsonValue a = net.PlayArena();
        if (a == null) {
            content.With(Text("正在拉取竞技场数据…", "secondary", 48));
            Note(content, "每日 5 场；对手越靠后越强，赢越多对手也越强。");
            return;
        }
        int tries = a.Int("tries", 0);
        Panel card = Col("frame");
        card.With(Text("战功 " + Rules.N(a.Int("pts", 0)) + " · 胜场 " + Rules.N(a.Int("wins", 0))
            + " · 攻击 " + Rules.N(a.Int("power", 0)) + " · 今日剩余 " + Rules.N(tries) + " 场", "cyan", 30));
        card.With(Text("胜：战功 +100、金币 +200；败也有战功 +20 保底。战功在「称谓」页换称号。", "secondary small", 24));
        content.With(card);
        Panel go = Panel.Row(); go.Gap(4); go.Prefer(0, 30);
        string[] rivals = new string[] { "挑战对手一", "挑战对手二", "挑战对手三" };
        for (int i = 0; i < 3; i = i + 1) {
            int rival = i + 1;
            Button b = Btn(rivals[i], "net-arena-fight-" + Rules.N(rival), () => { net.ArenaFight(rival); });
            b.Disabled = tries <= 0;
            go.With(b);
        }
        content.With(go);
        Note(content, "对手战力随你的胜场增长——见好就收还是乘胜追击，自己掂量。");
    }

    /* 页 4 押镖：3 次/日；出发扣 100 押金，60 秒后交镖连本带利拿回。 */
    void BuildNetEscort() {
        net.MaybeRefreshEscort();
        JsonValue st = net.Self();
        content.With(Text("押镖", "yellow strong", 28));
        JsonValue a = net.PlayEscort();
        if (a == null) {
            content.With(Text("正在拉取镖车信息…", "secondary", 48));
            Note(content, "每日 3 次；出发扣 100 金币押金，60 秒后交镖连本带利拿回。");
            return;
        }
        int tries = a.Int("tries", 0);
        int stage = a.Int("stage", 0);
        Panel card = Col("frame");
        if (stage == 1) {
            long left = a.Int("left", 0);
            long reward = a.Int("reward", 0);
            card.With(Text(left > 0
                ? "镖车在路上，还剩 " + Rules.N(left) + " 秒到站。\n到站后交镖入账 " + Rules.N(reward) + " 金币。"
                : "镖车已到站！点「交镖」结算 " + Rules.N(reward) + " 金币。", "green", 48));
            Button collect = Btn(left > 0 ? "镖车未到站" : "交 镖", "net-escort-collect", () => { net.EscortCollect(); });
            collect.Disabled = left > 0;
            collect.Prefer(140, 32); card.With(collect);
        } else {
            card.With(Text("今日剩余 " + Rules.N(tries) + " 次 · 押金 100 金币 · 交镖收益 400 + 等级×20 + 押金", "cyan", 30));
            Button go = Btn("接镖出发（100 金币）", "net-escort-go", () => { net.EscortGo(); });
            go.Disabled = tries <= 0 || st == null || st.Int("gold", 0) < 100;
            go.Prefer(190, 32); card.With(go);
        }
        content.With(card);
        Note(content, "本页每 5 秒自动刷新倒计时；到站后记得点「交镖」，超时不扣钱但也不结账。");
    }

    /* 页 5 行会：建会（1000 金币）/入会/退会；会长退会=解散（仅当无他人）。 */
    void BuildNetGuild() {
        JsonValue st = net.Self();
        if (net.PlayGuild() == null) { net.RefreshGuild(); }
        content.With(Text("行会", "yellow strong", 28));
        int myGuild = st != null ? st.Int("guildId", 0) : 0;
        Panel create = Col("frame");
        if (myGuild > 0) {
            create.With(Text("你已在行会中。会长退会=解散（仅当再无其他成员），普通成员随时可退。", "cyan", 26));
            Button quit = Btn("退出行会", "net-guild-quit", () => { net.GuildQuit(); });
            quit.Prefer(120, 32); create.With(quit);
        } else {
            create.With(Text("没有行会？花 1000 金币自己建一个，或从下面的列表挑一个加入。", "cyan", 26));
            Input nameIn = new Input("行会名（2-12 字）"); nameIn.Prefer(0, 30); create.With(nameIn);
            Button mk = Btn("创建行会（1000 金币）", "net-guild-create",
                () => { string n = nameIn.GetText().Trim(); if (n.Length > 0) { net.GuildCreate(n); } });
            mk.Prefer(180, 32); create.With(mk);
        }
        content.With(create);
        ScrollColumn list = new ScrollColumn(); list.Named("net-guild-list"); list.Grow(); content.With(list);
        JsonValue rows = net.PlayGuild();
        if (rows == null || rows.Count() == 0) { list.With(Text("正在拉取行会列表…（一个行会都没有时，建一个就是全服第一）", "secondary", 48)); }
        for (int i = 0; rows != null && i < rows.Count(); i = i + 1) {
            JsonValue g = rows.At(i);
            int gid = g.Int("id", 0);
            Panel row = Panel.Row(); row.Class = "frame"; row.Pad(8); row.Gap(8); row.Prefer(0, 52);
            Label name = Text((g.Int("mine", 0) == 1 ? "⭐ " : "") + g.Str("name", "???")
                + "\n会长 " + g.Str("leader", "-") + " · 成员 " + Rules.N(g.Int("members", 0))
                + " · 基金 " + Rules.N(g.Int("fund", 0)), "yellow", 40);
            name.Grow(); row.With(name);
            Button join = Btn(g.Int("mine", 0) == 1 ? "我的行会" : "加 入", "net-guild-join-" + Rules.N(gid),
                () => { net.GuildJoin(gid); });
            join.Disabled = myGuild > 0 || g.Int("mine", 0) == 1;
            join.Prefer(84, 28); row.With(join);
            list.With(row);
        }
        Note(content, "行会是攻城的门槛：只有行会成员能去「城池争夺」宣战攻打沙巴克。");
    }

    /* 页 7 城池争夺：行会成员花 2000 金币宣战，按战力掷骰易主。 */
    void BuildNetSiege() {
        JsonValue st = net.Self();
        if (net.PlaySiege() == null) { net.RefreshSiege(); }
        content.With(Text("城池争夺", "yellow strong", 28));
        JsonValue a = net.PlaySiege();
        if (a == null) {
            content.With(Text("正在拉取城池状态…", "secondary", 48));
            Note(content, "先入行会，再花 2000 金币宣战；战胜守军城池易主并全服公告。");
            return;
        }
        string owner = a.Str("owner", "");
        Panel card = Col("frame");
        card.With(Text(owner.Length > 0
            ? "现任城主：" + owner + "（" + a.Str("guild", "-") + "）\n已驻守 " + Rules.N(a.Int("holdSeconds", 0) / 60) + " 分钟"
            : "沙巴克城目前无主——第一个攻下来的行会将名震全服！", "green", 52));
        int myGuild = st != null ? st.Int("guildId", 0) : 0;
        Button attack = Btn("宣战攻城（2000 金币）", "net-siege-attack", () => { net.SiegeAttack(); });
        attack.Disabled = myGuild <= 0 || st == null || st.Int("gold", 0) < 2000;
        attack.Prefer(190, 32); card.With(attack);
        if (myGuild <= 0) { card.With(Text("你还没有行会——先去「行会」页加入或创建。", "secondary small", 24)); }
        content.With(card);
        Note(content, "宣战胜率 = 40% + 战力/10；败了金币不退，赢了全服公告、城头换旗。");
    }

    /* 页 8 传说塔：每日 20 次尝试；敌人随层变强，胜利楼层+1 并入账。 */
    void BuildNetTower() {
        net.MaybeRefreshTower();
        content.With(Text("传说塔", "yellow strong", 28));
        JsonValue a = net.PlayTower();
        if (a == null) {
            content.With(Text("正在拉取塔层信息…", "secondary", 48));
            Note(content, "每日 20 次尝试；每攻克一层金币与经验入账，下一层更强。");
            return;
        }
        int floor = a.Int("floor", 0);
        int tries = a.Int("tries", 0);
        Panel card = Col("frame");
        card.With(Text("当前进度：第 " + Rules.N(floor) + " 层已攻克 · 下一层是第 " + Rules.N(floor + 1)
            + " 层 · 今日剩余 " + Rules.N(tries) + "/" + Rules.N(a.Int("maxTries", 20)) + " 次", "cyan", 30));
        Button climb = Btn("挑战第 " + Rules.N(floor + 1) + " 层", "net-tower-climb", () => { net.TowerClimb(); });
        climb.Disabled = tries <= 0;
        climb.Prefer(170, 32); card.With(climb);
        content.With(card);
        Note(content, "失败层位保留，明天免费再战；层数没有上限，塔里全是你自己的极限。");
    }

    /* 页 10 五行修炼：打怪入池；注入把池经验补进单行，突破花金币/元宝升级。 */
    void BuildNetWuxing() {
        JsonValue st = net.Self();
        if (net.PlayWuxing() == null) { net.RefreshWuxing(); }
        content.With(Text("五行修炼", "yellow strong", 28));
        JsonValue a = net.PlayWuxing();
        if (a == null) {
            content.With(Text("正在拉取修炼进度…", "secondary", 48));
            Note(content, "打怪经验自动入池；注入后花金币突破，每层攻+2、血+20。");
            return;
        }
        int pool = a.Int("pool", 0);
        Panel card = Col("frame");
        card.With(Text("经验池 " + Rules.N(pool) + "/" + Rules.N(a.Int("poolCap", 600))
            + "（挂机击杀自动累计）· 总层数 " + Rules.N(st != null ? st.Int("wuxing", 0) : 0), "cyan", 30));
        content.With(card);
        ScrollColumn list = new ScrollColumn(); list.Named("net-wuxing-list"); list.Grow(); content.With(list);
        JsonValue rows = a.Get("rows");
        for (int i = 0; rows != null && i < rows.Count(); i = i + 1) {
            JsonValue e = rows.At(i);
            int id = e.Int("id", 0);
            int rank = e.Int("rank", 0);
            int xp = e.Int("xp", 0);
            int need = e.Int("need", 1);
            Panel row = Panel.Row(); row.Class = "frame"; row.Pad(8); row.Gap(8); row.Prefer(0, 56);
            Label name = Text(e.Str("name", "?") + " · " + Rules.N(rank) + " 级\n经验 " + Rules.N(xp) + "/" + Rules.N(need)
                + (rank >= 100 ? " · 已满级" : " · 突破需 " + Rules.N(800 + rank * 400) + " 金币+" + Rules.N(rank / 2) + " 元宝"), "yellow", 44);
            name.Grow(); row.With(name);
            Button inj = Btn("注入", "net-wx-inject-" + Rules.N(id), () => { net.WuxingAct("inject", id); });
            inj.Disabled = xp >= need || rank >= 100 || pool <= 0;
            inj.Prefer(56, 28); row.With(inj);
            Button up = Btn("突破", "net-wx-up-" + Rules.N(id), () => { net.WuxingAct("up", id); });
            up.Disabled = xp < need || rank >= 100;
            up.Prefer(56, 28); row.With(up);
            list.With(row);
        }
        Note(content, "注入是把池里的经验补进该行（注满为止），突破才升层——先注入再突破。");
    }

    /* 页 11 师徒：拜等级更高的玩家为师；30 级出师拿 2000 金币+3000 经验。 */
    void BuildNetMentor() {
        JsonValue st = net.Self();
        if (net.PlayMentor() == null) { net.RefreshMentor(); }
        content.With(Text("师徒", "yellow strong", 28));
        JsonValue a = net.PlayMentor();
        if (a == null) {
            content.With(Text("正在拉取师徒信息…", "secondary", 48));
            Note(content, "拜等级比你高的玩家为师；30 级出师拿 2000 金币+3000 经验。");
            return;
        }
        string master = a.Str("master", "");
        Panel card = Col("frame");
        if (master.Length > 0) {
            card.With(Text("师父：" + master + "（出师奖励自动发放）", "green", 30));
            bool canTake = a.Int("canTake", 0) == 1;
            Button take = Btn(canTake ? "出 师（30 级已到）" : "出 师（需 30 级）", "net-mentor-take", () => { net.MentorTake(); });
            take.Disabled = !canTake;
            take.Prefer(170, 32); card.With(take);
        } else {
            card.With(Text("还没有师父。输入本区玩家名拜师——对方等级必须比你高。", "cyan", 26));
            Input nameIn = new Input("师父角色名"); nameIn.Prefer(0, 30); card.With(nameIn);
            Button bow = Btn("拜 师", "net-mentor-bow",
                () => { string n = nameIn.GetText().Trim(); if (n.Length > 0) { net.MentorBow(n); } });
            bow.Prefer(100, 32); card.With(bow);
        }
        content.With(card);
        Note(content, "收徒不用操作：徒弟拜你为师即可；出师奖励只发徒弟，师父赚个人情。");
    }

    /* 页 14 祭坛：捐献攒个人进度并开启 30 分钟打怪 ×1.1；满 1000 领大奖。 */
    void BuildNetAltar() {
        JsonValue st = net.Self();
        if (net.PlayAltar() == null) { net.RefreshAltar(); }
        content.With(Text("祭坛", "yellow strong", 28));
        JsonValue a = net.PlayAltar();
        if (a == null) {
            content.With(Text("正在拉取祭坛进度…", "secondary", 48));
            Note(content, "金币×1=+1、100元宝=+5、1000元宝=+50、黑铁500=+4；增益期间打怪收益 ×1.1。");
            return;
        }
        int personal = a.Int("personal", 0);
        int cap = a.Int("cap", 1000);
        int buff = a.Int("buff", 0);
        int ironHave = 0;
        for (int i = 0; i < net.BagCount(); i = i + 1) {
            JsonValue it = net.BagAt(i);
            if (it.Str("name", "") == "黑铁矿石") { ironHave = ironHave + it.Int("count", 0); }
        }
        Panel card = Col("frame");
        card.With(Text("个人进度 " + Rules.N(personal) + "/" + Rules.N(cap)
            + " · 今日已捐 " + Rules.N(a.Int("donations", 0)) + " 次"
            + (buff > 0 ? " · 增益剩余 " + Rules.N(buff / 60) + " 分钟" : " · 增益未开启"), "cyan", 30));
        Panel acts = Panel.Row(); acts.Gap(4); acts.Prefer(0, 30);
        Button g = Btn("捐100金币", "net-altar-gold", () => { net.AltarDonate("gold"); });
        g.Disabled = st == null || st.Int("gold", 0) < 100;
        Button y = Btn("捐100元宝", "net-altar-yuan", () => { net.AltarDonate("yuan"); });
        y.Disabled = st == null || st.Int("gems", 0) < 100;
        Button yl = Btn("捐1000元宝", "net-altar-large", () => { net.AltarDonate("large"); });
        yl.Disabled = st == null || st.Int("gems", 0) < 1000;
        Button ir = Btn("捐500黑铁", "net-altar-iron", () => { net.AltarDonate("iron"); });
        ir.Disabled = ironHave < 500;
        acts.With(g); acts.With(y); acts.With(yl); acts.With(ir);
        card.With(acts);
        Button claim = Btn(personal >= cap ? "领取个人奖励（1000金币+100元宝）" : "领取个人奖励（进度未满）",
            "net-altar-claim", () => { net.AltarClaim(); });
        claim.Disabled = personal < cap;
        claim.Prefer(250, 32); card.With(claim);
        content.With(card);
        Note(content, "捐献即开启 30 分钟打怪收益 ×1.1；个人进度满 " + Rules.N(cap) + " 领大奖，超出的部分保留。");
    }

    /* 页 16 将星图谱：全 BOSS 清单；击败对应地图 BOSS 即点亮。 */
    void BuildNetStars() {
        net.RefreshStars();
        content.With(Text("将星图谱", "yellow strong", 28));
        ScrollColumn list = new ScrollColumn(); list.Named("net-stars-list"); list.Grow(); content.With(list);
        JsonValue rows = net.PlayStars();
        int lit = 0;
        for (int i = 0; rows != null && i < rows.Count(); i = i + 1) {
            if (rows.At(i).Int("lit", 0) == 1) { lit = lit + 1; }
        }
        if (rows == null || rows.Count() == 0) { list.With(Text("正在拉取星图…", "secondary", 48)); }
        for (int i = 0; rows != null && i < rows.Count(); i = i + 1) {
            JsonValue e = rows.At(i);
            bool on = e.Int("lit", 0) == 1;
            Panel row = Panel.Row(); row.Class = "frame"; row.Pad(8); row.Gap(8); row.Prefer(0, 44);
            Label name = Text((on ? "⭐ " : "☆ ") + e.Str("name", "???")
                + "\n" + Rules.N(e.Int("level", 1)) + " 级 · 第 " + Rules.N(e.Int("map", 0)) + " 张地图", on ? "green" : "yellow", 40);
            name.Grow(); row.With(name);
            list.With(row);
        }
        if (rows != null && rows.Count() > 0) {
            content.With(Text("已点亮 " + Rules.N(lit) + "/" + Rules.N(rows.Count()) + " 将星", "cyan", 26));
        }
        Note(content, "每个 BOSS 首杀即点亮一颗将星；「BOSS 之家」可一键前往未点亮的地图。");
    }

    /* 页 18 发红包：全服奖池——发一个（100-100000 金币）全服公告，每人限抢一次。 */
    void BuildNetRedpack() {
        JsonValue st = net.Self();
        if (net.PlayRedpack() == null) { net.RefreshRedpack(); }
        content.With(Text("发红包", "yellow strong", 28));
        JsonValue a = net.PlayRedpack();
        if (a == null) {
            content.With(Text("正在拉取红包池…", "secondary", 48));
            Note(content, "发 100-100000 金币红包全服公告；每人每轮限抢一次。");
            return;
        }
        long pool = a.Int("pool", 0);
        bool taken = a.Int("taken", 0) == 1;
        Panel card = Col("frame");
        card.With(Text(pool > 0
            ? "红包雨进行中：" + a.Str("from", "???") + " 发的 " + Rules.N(pool) + " 金币还在池里！"
            : "奖池空空如也——发一个让全服都记得你。", pool > 0 ? "green" : "cyan", 30));
        if (pool > 0) {
            Button grab = Btn(taken ? "本轮已抢过" : "抢 红 包", "net-redpack-grab", () => { net.RedpackGrab(); });
            grab.Disabled = taken;
            grab.Prefer(140, 32); card.With(grab);
        }
        Panel send = Panel.Row(); send.Gap(4); send.Prefer(0, 32);
        Input amt = new Input("金额（100-100000）"); amt.Prefer(0, 30); send.With(amt);
        Button doSend = Btn("发红包", "net-redpack-send", () => {
            string t = amt.GetText().Trim();
            bool digits = t.Length >= 3 && t.Length <= 6;
            for (int c = 0; digits && c < t.Length; c = c + 1) {
                if (t[c] < '0' || t[c] > '9') { digits = false; }
            }
            if (digits) { net.RedpackSend(Convert.ToInt(t)); }
        });
        doSend.Disabled = st == null || st.Int("gold", 0) < 100;
        doSend.Prefer(100, 30); send.With(doSend);
        card.With(send);
        content.With(card);
        Note(content, "红包池全服共享、本页每 5 秒刷新；服务器重启后奖池清零，手快有手慢无。");
    }

    /* 页 22 交易市场：上架（背包选品+定价）/购买（离线也到账）/下架退回。 */
    void BuildNetMarket() {
        JsonValue st = net.Self();
        if (net.PlayMarket() == null) { net.RefreshMarket(); }
        content.With(Text("交易市场", "yellow strong", 28));
        Panel sell = Col("frame");
        if (marketSellId > 0) {
            sell.With(Text("上架商品：" + marketSellName, "cyan", 26));
            Panel opts = Panel.Row(); opts.Gap(4); opts.Prefer(0, 32);
            Input cnt = new Input("数量1"); cnt.Prefer(76, 30); opts.With(cnt);
            Input price = new Input("单价金币"); price.Prefer(96, 30); opts.With(price);
            Button list = Btn("挂 单", "net-market-sell", () => {
                string tc = cnt.GetText().Trim(); string tp = price.GetText().Trim();
                bool okc = tc.Length > 0; bool okp = tp.Length > 0;
                for (int c = 0; okc && c < tc.Length; c = c + 1) { if (tc[c] < '0' || tc[c] > '9') { okc = false; } }
                for (int c = 0; okp && c < tp.Length; c = c + 1) { if (tp[c] < '0' || tp[c] > '9') { okp = false; } }
                if (okc && okp) { net.MarketSell(marketSellId, Convert.ToInt(tc), Convert.ToInt(tp)); }
            });
            list.Prefer(80, 30); opts.With(list);
            sell.With(opts);
        } else {
            sell.With(Text("从下面的背包列表挑一件商品挂单（选品后再填数量与单价）。", "cyan", 26));
        }
        content.With(sell);
        ScrollColumn bagList = new ScrollColumn(); bagList.Named("net-market-bag"); bagList.Prefer(0, 148); content.With(bagList);
        bagList.With(Text("我的背包（点「选」上架）", "yellow small", 0));
        for (int i = 0; i < net.BagCount(); i = i + 1) {
            JsonValue it = net.BagAt(i);
            int iid = it.Int("id", 0);
            string iname = it.Str("name", "???");
            Panel row = Panel.Row(); row.Class = "frame"; row.Pad(6); row.Gap(8); row.Prefer(0, 38);
            Label name = Text(iname + " ×" + Rules.N(it.Int("count", 1)), "yellow", 26);
            name.Grow(); row.With(name);
            Button pick = Btn("选", "net-market-pick-" + Rules.N(iid),
                () => { marketSellId = iid; marketSellName = iname; BuildPage(); Refresh(); });
            pick.Prefer(44, 26); row.With(pick);
            bagList.With(row);
        }
        if (net.BagCount() == 0) { bagList.With(Text("背包是空的——先去挂机打点装备与材料。", "secondary", 40)); }
        ScrollColumn list2 = new ScrollColumn(); list2.Named("net-market-list"); list2.Grow(); content.With(list2);
        JsonValue rows = net.PlayMarket();
        if (rows == null) { list2.With(Text("正在拉取市场…", "secondary", 40)); }
        for (int i = 0; rows != null && i < rows.Count(); i = i + 1) {
            JsonValue g = rows.At(i);
            int rid = g.Int("id", 0);
            bool mine = g.Int("mine", 0) == 1;
            Panel row = Panel.Row(); row.Class = "frame"; row.Pad(8); row.Gap(8); row.Prefer(0, 48);
            Label name = Text(g.Str("name", "???") + " ×" + Rules.N(g.Int("count", 1)) + " · " + Rules.N(g.Int("price", 0)) + " 金币\n卖家：" + g.Str("seller", "-"), "yellow", 40);
            name.Grow(); row.With(name);
            Button act = Btn(mine ? "下 架" : "购 买", "net-market-act-" + Rules.N(rid),
                () => { if (mine) { net.MarketCancel(rid); } else { net.MarketBuy(rid); } });
            act.Prefer(64, 28); row.With(act);
            list2.With(row);
        }
        if (rows != null && rows.Count() == 0) { list2.With(Text("市场空空——第一件挂单就是全服独一份。", "secondary", 40)); }
        Note(content, "买家金币直付卖家（对方离线也到账）；不能买自己的挂单，下架原物退回背包。");
    }

    /* 页 23 图鉴明细：物品/怪物两张签页各 20 条，服务端切页。 */
    void BuildNetCodexPage() {
        if (net.CodexPage() == null) { net.RefreshCodexPage(codexKindView, 0); }
        content.With(Text("图鉴", "yellow strong", 28));
        Panel tabs = Panel.Row(); tabs.Gap(4); tabs.Prefer(0, 30);
        Button ti = Btn(codexKindView == "items" ? "【物品图鉴】" : "物品图鉴", "net-codex-items",
            () => { codexKindView = "items"; net.RefreshCodexPage("items", 0); });
        Button tm = Btn(codexKindView == "mobs" ? "【怪物图鉴】" : "怪物图鉴", "net-codex-mobs",
            () => { codexKindView = "mobs"; net.RefreshCodexPage("mobs", 0); });
        tabs.With(ti); tabs.With(tm);
        int total = net.CodexTotal();
        int pageNo = net.CodexPageNo();
        int last = (total + 19) / 20 - 1;
        Label pg = Text("第 " + Rules.N(pageNo + 1) + "/" + Rules.N(last + 1) + " 页 · 共 " + Rules.N(total) + " 条", "cyan small", 0); pg.Grow(); tabs.With(pg);
        Button prev = Btn("上一页", "net-codex-prev", () => { net.RefreshCodexPage(codexKindView, pageNo - 1); });
        prev.Disabled = pageNo <= 0;
        Button next = Btn("下一页", "net-codex-next", () => { net.RefreshCodexPage(codexKindView, pageNo + 1); });
        next.Disabled = pageNo >= last;
        tabs.With(prev); tabs.With(next);
        content.With(tabs);
        ScrollColumn list = new ScrollColumn(); list.Named("net-codex-list"); list.Grow(); content.With(list);
        JsonValue rows = net.CodexPage();
        if (rows == null || rows.Count() == 0) { list.With(Text("正在拉取图鉴…", "secondary", 48)); }
        for (int i = 0; rows != null && i < rows.Count(); i = i + 1) {
            JsonValue e = rows.At(i);
            string desc;
            if (codexKindView == "mobs") {
                desc = Rules.N(e.Int("level", 1)) + " 级 · 血 " + Rules.N(e.Int("hp", 0)) + " · 攻 " + Rules.N(e.Int("atk", 0))
                    + " · 防 " + Rules.N(e.Int("def", 0)) + " · 经验 " + Rules.N(e.Int("exp", 0))
                    + " · 第 " + Rules.N(e.Int("map", 0)) + " 图" + (e.Int("boss", 0) == 1 ? " · BOSS" : "");
            } else {
                int kind = e.Int("kind", 0);
                string kindName = kind == 0 ? "消耗品" : kind == 1 ? "武器" : kind == 2 ? "防具" : "材料";
                string stats = StatLine(e);
                desc = kindName + (stats.Length > 0 ? " · " + stats : "") + " · 售价 " + Rules.N(e.Int("price", 0))
                    + " 金币 · 需 " + Rules.N(e.Int("minLevel", 1)) + " 级";
            }
            Panel row = Panel.Row(); row.Class = "frame"; row.Pad(8); row.Gap(8); row.Prefer(0, 44);
            Label name = Text(e.Str("name", "???") + "\n" + desc, "yellow", 40);
            name.Grow(); row.With(name);
            list.With(row);
        }
        Note(content, "图鉴与服务器物品/怪物库同源；掉落看运气，先把怪都认全再谈屠龙。");
    }

    /* 页 25 称谓：战功解锁（初出茅庐免费），佩戴后全服可见。 */
    void BuildNetTitle() {
        JsonValue st = net.Self();
        if (net.PlayTitle() == null) { net.RefreshTitle(); }
        content.With(Text("称谓", "yellow strong", 28));
        content.With(Text("当前战功 " + Rules.N(st != null ? st.Int("arenaPts", 0) : 0)
            + " · 佩戴：" + (st != null && st.Str("title", "").Length > 0 ? st.Str("title", "") : "无"), "cyan", 28));
        ScrollColumn list = new ScrollColumn(); list.Named("net-title-list"); list.Grow(); content.With(list);
        JsonValue rows = net.PlayTitle();
        if (rows == null || rows.Count() == 0) { list.With(Text("正在拉取称谓…", "secondary", 48)); }
        for (int i = 0; rows != null && i < rows.Count(); i = i + 1) {
            JsonValue e = rows.At(i);
            string name = e.Str("name", "???");
            bool owned = e.Int("owned", 0) == 1;
            bool worn = e.Int("worn", 0) == 1;
            int cost = e.Int("cost", 0);
            Panel row = Panel.Row(); row.Class = "frame"; row.Pad(8); row.Gap(8); row.Prefer(0, 44);
            Label label = Text((worn ? "🎖 " : (owned ? "✅ " : "🔒 ")) + name
                + "\n" + (owned ? "已解锁" : "解锁需战功 " + Rules.N(cost)), worn ? "green" : "yellow", 40);
            label.Grow(); row.With(label);
            if (!owned) {
                Button unlock = Btn("解 锁", "net-title-unlock-" + Rules.N(i),
                    () => { net.TitleUnlock(name); });
                unlock.Disabled = st != null && st.Int("arenaPts", 0) < cost;
                unlock.Prefer(56, 28); row.With(unlock);
            } else {
                Button wear = Btn(worn ? "摘 下" : "佩 戴", "net-title-wear-" + Rules.N(i),
                    () => { net.TitleWear(worn ? "无" : name); });
                wear.Prefer(56, 28); row.With(wear);
            }
            list.With(row);
        }
        Note(content, "战功来自 PK竞技场（胜 100/败 20）；佩戴的称谓在排行榜与聊天里都看得到。");
    }

    /* ---- 登录小窗：窗口本身即表单，不套模态弹窗。阶段：
       0 选/编辑服务器并连接 → 1 连接中 → 2 账号登录/注册 → 3 建角；
       进入世界后表单隐藏、小窗长成主窗口。---- */

    /* 断开/退出登录后回到登录小窗：主界面隐藏、窗口缩回小窗、
       表单重建到“选择服务器”一步。*/
    void BackToLoginForm() {
        app.SetClientSize(440, 520);
        app.SetWindowTitle("迷你传奇 · 登录");
        shellChat.SetShown(false); shellMain.SetShown(false);
        netForm.SetShown(true);
        netPhase = -1;
        formPage = "login"; forgotUser = ""; charNameDraft = ""; lastFormKey = ""; armDel = -1;
        RebuildNetForm();
    }

    int NetPhase() {
        if (!net.Connected() && !net.connecting) { return 0; }
        if (net.Stage() >= 3) { return 3; }
        if (net.Stage() >= 1) { return 2; }
        return 1;
    }

    /* 每 120ms 泵（form.Every）：阶段变了就重建表单；进入世界则收起
       表单、小窗长成主窗口，主界面此刻才首次显现。*/
    void PumpNetStage() {
        if (netForm == null || !netForm.visible) { return; }
        if (UiDriver.Active()) {
            try {
                UiDriver.SetProbe("win", Rules.N(app.ClientWidth()) + "x" + Rules.N(app.ClientHeight()));
                UiDriver.SetProbe("net-raw", "connected=" + Rules.N(net.Connected() ? 1 : 0)
                    + " connecting=" + Rules.N(net.connecting ? 1 : 0)
                    + " stage=" + Rules.N(net.Stage())
                    + " errLen=" + Rules.N(net.Error().Length)
                    + " last=" + net.LastChat());
            } catch (Exception e) { }
        }
        if (net.InWorld()) {
            netForm.SetShown(false);
            app.SetClientSize(1080, 640);
            /* 区服信息上标题栏，照原版把区名带在窗口标题里。 */
            string realm = net.RealmName();
            app.SetWindowTitle(realm.Length > 0 ? "迷你传奇 · " + realm : "迷你传奇");
            shellChat.SetShown(true); shellMain.SetShown(true);
            /* 进世界落点：直接到“背包”页——服务端建角已发初始装备
               （木剑+布衣），进游戏第一件事就是穿上；主线任务进度在
               “沙巴克”页常驻。角色在登录窗已创建，主窗口不再出现
               建角表单或离线幻境界面。 */
            page = 20; selected = -1; vault = false; inspectWorn = false;
            lastNetKey = net.DataVersion();
            BuildPage();
            Refresh();
            app.RequestRedraw(); return;
        }
        int ph = NetPhase();
        /* 分区页点进了没角色的区：转到建角页（照原版选区后建角）。 */
        if (ph == 3 && net.NeedCreate() && formPage != "char") { formPage = "char"; netPhase = -1; }
        /* 登录窗按钮只置 formPage 等状态、不同步重建：在 click 处理器里
           RemoveAll 自己所在容器会让重建出的输入焦点/命中失效。这里
           统一轮询重建：页面切换、密保/角色数据到达都收敛到这一处。 */
        if (ph != netPhase || (netForm.visible && ph >= 2 && formPage != renderedFormPage)) { RebuildNetForm(); }
        else if (formPage == "forgot") {
            /* 密保问题/重置结果异步回来：内容变了就重建「修改密码」页
               （账号输入用 forgotUser 保住，不因重建丢失）。 */
            string fk = net.ForgotQuestion() + "|" + net.ForgotMsg() + "|" + net.ResetMsg();
            if (fk != lastFormKey) { lastFormKey = fk; RebuildNetForm(); }
        }
        else if (formPage == "chars") {
            /* 角色列表异步回来/删除后重拉：就绪状态或数量变了就重建；
               armDel 计入 key——两击确认的第一击要立刻把按钮换成
               「确认删除」。 */
            string ck = (net.CharsReady() ? "R" : "-") + Rules.N(net.CharCount())
                + (armDel >= 0 ? "D" + Rules.N(armDel) : "");
            if (ck != lastFormKey) { lastFormKey = ck; RebuildNetForm(); }
        }
        else if (formPage == "char") {
            /* 建角页换职业/性别：联动两排头像（PickJob/PickGender 存好
               名字草稿并清 lastFormKey，这里重建回填）。 */
            string jk = "J" + Rules.N(dJob) + "G" + Rules.N(dGender);
            if (jk != lastFormKey) { lastFormKey = jk; RebuildNetForm(); }
        }
        if (netHint != null) {
            /* 状态行只属于动态页：登录页跟着连接状态/服务器消息走，建号
               页显示注册结果（RegisterFromForm 的本地校验直接写 netHint，
               不被这里冲掉）；其余页的提示行是页面自己的固定说明。 */
            string s = "";
            if (formPage == "login") {
                s = net.Error().Length > 0 ? net.Error()
                    : (net.LastChat().Length > 0 ? net.LastChat() : net.StatusText());
            } else if (formPage == "create") {
                s = net.FormMsg();
            }
            if (s.Length > 0 && netHint.Text != s) { netHint.Text = s; app.RequestRedraw(); }
        }
        /* UiDriver 调试探针：登录窗各页的表单状态，供 `dump probe`
           远程查看（正文当前输入、草稿、选中职业/性别、重建 key）。 */
        try {
            UiDriver.SetProbe("form", "page=" + formPage + " job=" + Rules.N(dJob)
                + " gender=" + Rules.N(dGender) + " key=[" + lastFormKey
                + "] draft=[" + charNameDraft + "] input=["
                + (dChar != null ? dChar.GetText() : "-") + "]");
        } catch (Exception e) { }
    }

    /* 表单随阶段重建：RemoveAll 后按 NetPhase() 摆控件。阶段切换
       本来就意味着换一批输入框，未保存的输入随重建丢弃。*/
    void RebuildNetForm() {
        int ph = NetPhase();
        netPhase = ph;
        netForm.RemoveAll();
        netHint = null;
        dUser = null; dPass = null; dPass2 = null; dEmail = null; dAnswer = null; dNewPass = null;
        dRemember = null; dAgree = null; dChar = null;
        if (ph <= 1) { BuildConnectingForm(); }
        else if (ph == 2) {
            /* 加密就绪：照原版先「请登录」，创建账号/修改密码是它的两
               个子页。 */
            if (formPage == "create") { BuildCreateAccountPage(); }
            else if (formPage == "forgot") { BuildForgotPage(); }
            else { formPage = "login"; BuildLoginPage(); }
        }
        else {
            /* 账号已登录：先「分区」，点区服出「选择角色」（可删可建），
               再进世界/建角。 */
            if (formPage == "char") { BuildCharPage(); }
            else if (formPage == "chars") { BuildCharsPage(); }
            else { formPage = "realms"; BuildRealmsPage(); }
        }
        renderedFormPage = formPage;
        DeclareUnits(netForm);
        app.RequestRedraw();
    }

    /* 照原版第一窗「请登录」：账号/密码、记住我的账户，修改密码+登录
       两键，底部“初次使用没有账号？”+ 创建免费账号。服务器不在此窗：
       发布时内置唯一入口，启动已自动连接。*/
    void BuildLoginPage() {
        netForm.With(Text("请登录", "yellow strong", 30));
        netHint = Text("登录后选择分区进入；一个账号可进所有区。", "secondary small", 0);
        netForm.With(netHint);
        dUser = new Input("账号"); dUser.Prefer(0, 34);
        if (LoadRememberedUser().Length > 0) { dUser.SetText(LoadRememberedUser()); }
        netForm.With(dUser);
        dPass = new Input("密码"); dPass.password = true; dPass.Prefer(0, 34); netForm.With(dPass);
        dRemember = new Checkbox("记住我的账户");
        if (LoadRememberedUser().Length > 0) { dRemember.SetChecked(true); }
        netForm.With(dRemember);
        /* 按钮块停靠底部：修改密码/登录对半；创建账号引导整行沉底。*/
        Panel bottomBlock = Panel.Column(); bottomBlock.Gap(10); bottomBlock.DockBottom();
        Grid auth = Grid.Of(2); auth.Gap(8); auth.Prefer(0, 38);
        auth.With(Btn("修改密码", "net-d-forgot", () => { formPage = "forgot"; }));
        dLogin = Btn("登录", "net-d-login", () => { LoginFromForm(); });
        dLogin.Class = "primary"; auth.With(dLogin);
        bottomBlock.With(auth);
        bottomBlock.With(Text("初次使用没有账号？", "cyan", 24));
        Button mk = Btn("创建免费账号", "net-d-tocreate", () => { net.SetFormMsg(""); formPage = "create"; });
        mk.Prefer(0, 38); bottomBlock.With(mk);
        netForm.Add(bottomBlock);
    }

    /* 照原版「创建新账号」：账号/密码/确认/邮箱 + 同意许可协议，
       申请新账号/返回。密保不在窗上（服务端密保可空，找回密码用）。*/
    void BuildCreateAccountPage() {
        netForm.With(Text("创建新账号", "yellow strong", 30));
        netHint = Text("注册免费账号；一个账号可进所有分区。", "secondary small", 0);
        netForm.With(netHint);
        dUser = new Input("账号（3-32 字）"); dUser.Prefer(0, 34); netForm.With(dUser);
        dPass = new Input("密码（6-64 位）"); dPass.password = true; dPass.Prefer(0, 34); netForm.With(dPass);
        dPass2 = new Input("确认密码"); dPass2.password = true; dPass2.Prefer(0, 34); netForm.With(dPass2);
        dEmail = new Input("邮箱（选填）"); dEmail.Prefer(0, 34); netForm.With(dEmail);
        dAgree = new Checkbox("同意许可协议"); netForm.With(dAgree);
        Panel bottomBlock = Panel.Column(); bottomBlock.Gap(10); bottomBlock.DockBottom();
        Grid auth = Grid.Of(2); auth.Gap(8); auth.Prefer(0, 38);
        dRegister = Btn("申请新账号", "net-d-register", () => { RegisterFromForm(); }); auth.With(dRegister);
        Button back = Btn("返回", "net-d-backlogin", () => { formPage = "login"; }); auth.With(back);
        bottomBlock.With(auth);
        netForm.Add(bottomBlock);
    }

    /* 照原版登录窗的「修改密码」：账号取密保问题，答案+新密码重置。
       问题/结果异步回来，PumpNetStage 按 lastFormKey 重建本页。*/
    void BuildForgotPage() {
        netForm.With(Text("修改密码", "yellow strong", 30));
        netHint = Text("通过密保问题重置密码；未设置密保的账号无法用此功能。", "secondary small", 0);
        netForm.With(netHint);
        dUser = new Input("账号"); dUser.Prefer(0, 34);
        if (forgotUser.Length > 0) { dUser.SetText(forgotUser); }
        netForm.With(dUser);
        Panel qrow = Panel.Row(); qrow.Gap(8); qrow.Prefer(0, 40);
        Button getq = Btn("获取问题", "net-d-forgot-get", () => {
            if (dUser == null) { return; }
            forgotUser = dUser.GetText().Trim();
            net.Forgot(forgotUser);
        });
        getq.Prefer(96, 32); qrow.With(getq);
        string q = net.ForgotQuestion();
        Label ql = Text(q.Length > 0 ? "密保问题：" + q
            : net.ForgotMsg().Length > 0 ? net.ForgotMsg() : "点「获取问题」拉取你的密保问题。",
            "cyan", 32); ql.wrap = true; ql.Grow(); qrow.With(ql);
        netForm.With(qrow);
        dAnswer = new Input("密保答案"); dAnswer.Prefer(0, 34); netForm.With(dAnswer);
        dNewPass = new Input("新密码（6-64 位）"); dNewPass.password = true; dNewPass.Prefer(0, 34); netForm.With(dNewPass);
        if (net.ResetMsg().Length > 0) { netForm.With(Text(net.ResetMsg(), net.ResetOk() ? "green" : "red", 24)); }
        Panel bottomBlock = Panel.Column(); bottomBlock.Gap(10); bottomBlock.DockBottom();
        Grid auth = Grid.Of(2); auth.Gap(8); auth.Prefer(0, 38);
        auth.With(Btn("确认修改", "net-d-reset", () => {
            if (dUser == null || dAnswer == null || dNewPass == null) { return; }
            forgotUser = dUser.GetText().Trim();
            net.Reset(forgotUser, dAnswer.GetText(), dNewPass.GetText());
        }));
        Button back = Btn("返回", "net-d-backlogin2", () => { formPage = "login"; }); auth.With(back);
        bottomBlock.With(auth);
        netForm.Add(bottomBlock);
    }

    void BuildConnectingForm() {
        netForm.With(Text("连接中", "yellow strong", 22));
        netHint = Text("正在连接服务器，进行加密握手…", "secondary small", 0);
        netForm.With(netHint);
    }

    /* 照原版「分区」窗：左侧「分区」页签框，右侧一列按钮组平铺所有
       区服（分区组做小标题行，不再钻取第二层）；点区服出「选择角色」。
       维护中的区置灰。 */
    void BuildRealmsPage() {
        netForm.With(Text("选择分区", "yellow strong", 32));
        netHint = Text("一个账号可进所有区；角色按区独立。", "secondary small", 0);
        netForm.With(netHint);
        Panel body = Panel.Row(); body.Gap(10); body.Grow(); body.Class = "align-start";
        Panel tabBox = Col("frame"); tabBox.Prefer(84, 52);
        tabBox.With(Text("分区", "cyan strong", 26));
        body.With(tabBox);
        Panel list = Panel.Column(); list.Gap(8); list.Grow();
        string lastGrp = "\u0001";
        for (int i = 0; i < net.RealmCount(); i = i + 1) {
            JsonValue rl = net.RealmAt(i);
            string grp = rl.Str("grp", "永久区");
            if (grp.Length == 0) { grp = "永久区"; }
            if (grp != lastGrp) {
                lastGrp = grp;
                Label head = Text("── " + grp + " ──", "secondary", 22);
                head.Prefer(0, 22); list.With(head);
            }
            int rid = rl.Int("id", 0);
            bool open = rl.Int("state", 1) == 0;
            string rname = rl.Str("name", "区服");
            Button rb = Btn(rname + "  " + Rules.N(rl.Int("online", 0)) + "人 · "
                + RateLabel(rl.Int("expRate", 10000)) + (open ? "" : "（维护中）"),
                "net-d-realm-" + Rules.N(rid),
                () => { OpenRealm(rid, rname); });
            rb.Prefer(0, 44); rb.Disabled = !open; list.With(rb);
        }
        body.With(list);
        netForm.With(body);
    }

    /* 分区窗点区服：记下目标区，切「选择角色」页并拉角色列表。 */
    void OpenRealm(int rid, string name) {
        try {
            if (UiDriver.Active()) {
                UiDriver.SetProbe("open-realm", "rid=" + Rules.N(rid) + " name=" + name);
            }
        } catch (Exception) { }
        charsRealmId = rid; charsRealmName = name; armDel = -1;
        formPage = "chars"; lastFormKey = "";
        net.RefreshChars(rid);
    }

    /* 照原版选角：列出该区角色（点击进入游戏），删除两击确认；没有
       角色给「创建角色」引导。 */
    void BuildCharsPage() {
        netForm.With(Text("选择角色", "yellow strong", 32));
        netHint = Text("分区「" + charsRealmName + "」", "secondary small", 0);
        netForm.With(netHint);
        if (!net.CharsReady()) {
            netForm.With(Text("正在读取角色…", "cyan", 28));
        } else if (net.CharCount() == 0) {
            netForm.With(Text("这个区还没有角色。", "cyan", 28));
        }
        for (int i = 0; i < net.CharCount(); i = i + 1) {
            JsonValue ch = net.CharAt(i);
            Panel row = Panel.Row(); row.Gap(8); row.Prefer(0, 46);
            Button go = Btn(ch.Str("name", "角色") + " · "
                + Rules.N(ch.Int("level", 1)) + "级 · " + Rules.Job(ch.Int("job", 0)),
                "char-go-" + Rules.N(i), () => {
                    net.EnterRealm(charsRealmId, charsRealmName);
                    SaveLastRealm(charsRealmId);
                });
            go.Prefer(0, 44); row.With(go);
            int ci = i;
            Button del = Btn(armDel == ci ? "确认删除" : "删除", "char-del-" + Rules.N(ci), () => {
                if (armDel != ci) { armDel = ci; return; }
                armDel = -1;
                net.DelChar(charsRealmId);
            });
            del.Prefer(104, 44); row.With(del);
            netForm.With(row);
        }
        Panel bottomBlock = Panel.Column(); bottomBlock.Gap(10); bottomBlock.DockBottom();
        Button mk = Btn("创建角色", "net-d-tochar", () => {
            charNameDraft = "";
            formPage = "char";
            lastFormKey = "J" + Rules.N(dJob) + "G" + Rules.N(dGender);
        });
        mk.Prefer(0, 44); bottomBlock.With(mk);
        Button back = Btn("返回分区列表", "net-d-backrealms", () => { formPage = "realms"; });
        back.Prefer(0, 34); bottomBlock.With(back);
        netForm.Add(bottomBlock);
    }

    /* 照原版「创建角色」窗：请输入名字 + 六个头像块 + 大按钮「创建
       角色并进入游戏」。头像用游戏自带的 ui 素材 00111-00116：上排
       男战士(00111)/男法师(00115)/男道士(00113)，下排对应的女像
       （素材对是 战士男女、道士男女、法师男女）；点哪块就同时选定
       职业+性别，选中描金边。32x31 原生 2 倍摆放，界面全部标准库
       组件。 */
    void BuildCharPage() {
        netForm.With(Text("创建角色", "yellow strong", 32));
        netHint = Text("分区「" + charsRealmName + "」", "secondary small", 0);
        netForm.With(netHint);
        netForm.With(Text("请输入一个名字：", "cyan", 24));
        dChar = new Input(""); dChar.Prefer(0, 42);
        if (charNameDraft.Length > 0) { dChar.SetText(charNameDraft); }
        netForm.With(dChar);
        int[] colJob = new int[] { 0, 1, 2 };
        int[] colFace = new int[] { 111, 115, 113 };
        string[] colName = new string[] { "战士", "法师", "道士" };
        Panel faces = Panel.Column(); faces.Gap(8); faces.Prefer(0, 232);
        for (int row = 0; row < 2; row = row + 1) {
            Panel fr = Panel.Row(); fr.Gap(12); fr.Prefer(0, 110);
            for (int c = 0; c < 3; c = c + 1) {
                int job = colJob[c];
                int gender = row;
                Panel tile = Panel.Column();
                tile.Class = (dJob == job && dGender == gender) ? "jobtile jobtile-active" : "jobtile";
                tile.Pad(6); tile.Gap(4); tile.Prefer(108, 0);
                Image ic = new Image(PicturePath("ui", colFace[c] + gender), colName[c], "contain");
                ic.Prefer(64, 62); tile.With(ic);
                Label tl = Text((gender == 0 ? "男" : "女") + colName[c], "cyan", 22);
                tl.Prefer(76, 22); tile.With(tl);
                tile.OnClick(() => { PickCharFace(job, gender); });
                tile.Named("net-d-face-" + Rules.N(row) + Rules.N(c));
                fr.With(tile);
            }
            faces.With(fr);
        }
        netForm.With(faces);
        Panel bottomBlock = Panel.Column(); bottomBlock.Gap(10); bottomBlock.DockBottom();
        dCreate = Btn("创建角色并进入游戏", "net-d-create", () => { CreateFromForm(); });
        dCreate.Class = "primary"; dCreate.Prefer(0, 46); bottomBlock.With(dCreate);
        Button back = Btn("返回选择角色", "net-d-backchars", () => { formPage = "chars"; });
        back.Prefer(0, 34); bottomBlock.With(back);
        netForm.Add(bottomBlock);
    }

    /* 点头像块：一次选定职业+性别。只记状态（名字草稿先存下，重建
       后回填），重建交给 PumpNetStage——在 click 处理器里同步
       RemoveAll 自身容器会弄坏派发链。 */
    void PickCharFace(int job, int gender) {
        if (dChar != null) { charNameDraft = dChar.GetText(); }
        dJob = job; dGender = gender; lastFormKey = "";
    }

    /* 建角页的“创建角色并进入游戏”：区服在分区窗已选定（realmId 即
       目标区），名字/职业/性别照原版创建角色窗；服务端建角即进入世界。 */
    void CreateFromForm() {
        if (dChar == null) { return; }
        net.CreateChar(dChar.GetText().Trim(), dJob, dGender);
        charNameDraft = "";
        SaveLastRealm(net.RealmId());
    }

    /* 「创建新账号」的申请新账号：确认密码与协议都在本地校验，服务端
       只收 账号/密码/邮箱（密保可空）。 */
    void RegisterFromForm() {
        if (dUser == null || dPass == null || dPass2 == null || dAgree == null) { return; }
        net.SetFormMsg("");
        string p = dPass.GetText();
        if (p != dPass2.GetText()) { if (netHint != null) { netHint.Text = "两次输入的密码不一致。"; } return; }
        if (!dAgree.IsChecked()) { if (netHint != null) { netHint.Text = "请先勾选同意许可协议。"; } return; }
        net.Register(dUser.GetText().Trim(), p, dEmail != null ? dEmail.GetText().Trim() : "");
    }
    void LoginFromForm() {
        if (dUser == null || dPass == null) { return; }
        string u = dUser.GetText().Trim();
        net.Login(u, dPass.GetText().Trim());
        if (dRemember != null && dRemember.IsChecked()) { SaveRememberedUser(u); }
        else { SaveRememberedUser(""); }
    }

    /* ---- 已保存服务器（servers.txt 每行 host|连接密码）与登录记忆
       （login.txt 三行：上次账号、上次连接地址、上次区服 id）。---- */
    string RmLine(int idx) {
        if (!File.Exists(rememberPath)) { return ""; }
        try {
            string rest = File.ReadAllText(rememberPath);
            for (int i = 0; i < idx; i = i + 1) {
                int nl = rest.IndexOf("\n");
                if (nl < 0) { return ""; }
                rest = rest.Substring(nl + 1);
            }
            int end = rest.IndexOf("\n");
            string line = end >= 0 ? rest.Substring(0, end) : rest;
            return line.Trim();
        } catch (Exception e) { return ""; }
    }
    string LoadRememberedUser() { return RmLine(0); }
    void SaveRememberedUser(string u) {
        try { File.WriteAllText(rememberPath, u + "\n" + RmLine(1) + "\n"
            + RmLine(2) + "\n"); } catch (Exception e) { }
    }
    /* 发布内置服务器：LEGEND_SERVER 环境变量优先（本机联调/测试），
       其次 data/server.txt 首行 host:port（|连接密码 可选）；都没有
       用本机默认。启动即拨号——登录窗从「连接中」开始，照原版不设
       服务器列表。 */
    void ConnectPublished(string dataDir) {
        srvAddr = KnownFolders.GetEnv("LEGEND_SERVER");
        srvPass = "";
        if (srvAddr.Length == 0) {
            srvAddr = "127.0.0.1:8099";
            string path = dataDir + "/server.txt";
            if (File.Exists(path)) {
                try {
                    string body = File.ReadAllText(path).Replace("\r", "");
                    int nl = body.IndexOf("\n");
                    string line = (nl >= 0 ? body.Substring(0, nl) : body).Trim();
                    int bar = line.IndexOf("|");
                    if (bar >= 0) {
                        srvPass = line.Substring(bar + 1).Trim();
                        line = line.Substring(0, bar).Trim();
                    }
                    if (line.Length > 0) { srvAddr = line; }
                } catch (Exception e) { }
            }
        }
        net.ConnectAddr(srvAddr, srvPass);
    }
    /* 上次区服 id：登录成功后自动进这一区（区没了/维护则自动退回
       第一个开放区）。 */
    int LoadLastRealm() {
        string v = RmLine(2);
        if (v.Length == 0) { return 1; }
        return Convert.ToInt(v);
    }
    void SaveLastRealm(int id) {
        try { File.WriteAllText(rememberPath, RmLine(0) + "\n" + RmLine(1)
            + "\n" + Convert.ToString(id) + "\n"); } catch (Exception e) { }
    }

    void BuildOnlinePage() {
        content.With(Text(pages[page], "yellow strong", 28));
        string header = "角色                      等级                 状态                 操作";
        if (page == 22) { header = "物品名称            卖家            数量            单价            购买"; }
        if (page == 5) { header = "行会名称            会长            等级            人数            查看"; }
        if (page == 29) { header = "发件人                 主题                    附件             领取"; }
        content.With(Text(header, "cyan table-head", 32));
        for (int i = 0; i < 8; i = i + 1) { content.With(Text("", i % 2 == 0 ? "table-row" : "table-alt", 32)); }
        Note(content, "此页玩法尚未完成。连接服务器后即可注册登录、挂机与聊天；不使用假玩家、假交易或本地 BOSS 冒充实现。");
    }
    void Refresh() {
        if ((page == 2 || page == 3 || page == 12) && (renderedMode != g.mode || renderedChallenge != g.challenge)) { BuildPage(); }
        for (int n = 0; n < 31; n = n + 1) {
            if (navTiles[n] != null) { navTiles[n].Class = n == page ? "navtile navtile-active" : "navtile"; }
        }
        hero.Text = g.job < 0 ? "创建你的角色" : Rules.Job(g.job) + " · 传奇旅人";
        health.Text = "生命：" + Rules.N(g.hp); mana.Text = "法力：" + Rules.N(g.mp); level.Text = "等级：" + Rules.N(g.level) + "级"; coins.Text = "金币：" + Rules.N(g.gold); yuan.Text = "元宝：" + Rules.N(g.gems); fame.Text = "声望：" + Rules.N(g.reputation); merit.Text = "战功：" + Rules.N(g.merit); spirit.Text = "灵符：未接入";
        experience.percent = (int)((long)g.xp * 100 / g.NeedXp()); state.Text = g.active && g.job >= 0 ? "状态：挂机中" : "状态：空闲中";
        string log = ""; for (int i = g.logs.Count - 1; i >= 0; i = i - 1) { if (log.Length > 0) { log = log + "\n"; } log = log + g.logs[i]; } news.Text = log.Length == 0 ? "暂无收益记录。\n开始战斗后显示真实掉落与收益。" : log;
        if (net.InWorld()) {
            // 联机时顶栏、战报与聊天全部来自服务器；离线数值原样保留在后台。
            JsonValue st = net.Self();
            hero.Text = st.Str("name", "旅人") + " · " + net.RealmName()
                + "（经验" + RateLabel(net.ExpRate()) + "）";
            int hp = st.Int("hp", 0); int maxhp = st.Int("maxhp", 1);
            health.Text = "生命：" + Rules.N(hp) + "/" + Rules.N(maxhp);
            mana.Text = "法力：—"; level.Text = "等级：" + Rules.N(st.Int("level", 1)) + "级";
            coins.Text = "金币：" + Rules.N(st.Int("gold", 0)); yuan.Text = "元宝：" + Rules.N(st.Int("gems", 0));
            fame.Text = "声望：—"; merit.Text = "战功：—"; spirit.Text = "灵符：—";
            int exp = st.Int("exp", 0); int expnext = st.Int("expnext", 1);
            experience.percent = expnext > 0 ? (int)((long)exp * 100 / expnext) : 0;
            state.Text = "状态：" + (net.LastFight() != null ? "战斗中" : "待机");
            news.Text = net.FeedDump();
        }
        if (chatHistory != null) {
            string chatLog = net.ChatDump();
            if (chatLog.Length > 0) { chatHistory.Text = chatLog; }
            bool live = net.InWorld();
            chatInput.Disabled = !live; chatSend.Disabled = !live;
        }
        if (g.job < 0 && !net.InWorld()) { app.RequestRedraw(); return; }
        if (enemySprite != null) {
            string path = EnemyArtPath();
            if (path != enemySpritePath) { enemySprite.Src = path; enemySpritePath = path; }
            enemySprite.Alt = g.enemyName;
        }
        if (combatTitle != null) { combatTitle.Text = page == 3 ? "BOSS之家 · " + g.enemyName : (page == 12 ? "秘境 · 第 " + Rules.N(g.secretFloor) + " 层" : g.LocationName() + " · 第 " + Rules.N(g.floor) + " 层"); enemyName.Text = g.enemyName; battleStatus.Text = (g.recovery > 0 ? "重伤恢复中" : (g.active ? "自动战斗中" : "战斗已暂停")) + "\n背包 " + Rules.N(g.bag.Count) + " / " + Rules.N(g.capacity) + (g.bag.Count >= g.capacity ? " · 已满，请整理掉落" : ""); foeText.Text = Rules.N(g.enemyHp) + "/" + Rules.N(g.enemyMax); foe.percent = g.enemyMax > 0 ? (int)((long)g.enemyHp * 100 / g.enemyMax) : 0; playerText.Text = Rules.N(g.hp) + "/" + Rules.N(g.MaxHp()); life.percent = (int)((long)g.hp * 100 / g.MaxHp()); pause.Text = g.active ? "☑ 自动" : "☐ 自动"; push.Text = page == 3 ? (g.bossAutoNext ? "☑ 连续挑战" : "☐ 连续挑战") : ((page == 12 ? g.secretAutoPush : g.autoPush) ? "☑ 推层" : "☐ 推层"); if (pageInfo != null) { pageInfo.Text = "最高幻境：" + Rules.N(g.best) + "层\n个人BOSS胜利：" + Rules.N(g.bossWins) + "\n秘境通关：" + Rules.N(g.secrets); } }
        int count = vault ? g.storage.Count : g.bag.Count;
        for (int i = 0; i < 84; i = i + 1) {
            if (cells[i] == null) { continue; }
            if (i < count) { Equipment e = vault ? g.storage[i] : g.bag[i]; cellLabels[i].Text = (e.locked ? "锁" : "×") + Rules.N(e.coefficient); cellImages[i].Src = EquipmentArtPath(e); cellImages[i].SetShown(true);  cells[i].Class = selected == i ? "item-selected" : "item-cell"; }
            else { cellLabels[i].Text = ""; cellImages[i].SetShown(false);  cells[i].Class = i >= (vault ? 48 : g.capacity) ? "item-locked" : "item-cell"; }
        }
        for (int i = 0; i < 12; i = i + 1) { if (gearLabels[i] != null) { Equipment e = g.equipped[i]; gearLabels[i].Text = e == null ? Rules.Slots()[i] : (e.locked ? "锁 " : "") + "×" + Rules.N(e.coefficient); gearImages[i].SetShown(e != null); if (e != null) { gearImages[i].Src = EquipmentArtPath(e); } } }
        if (page == 1 && pageInfo != null) { pageInfo.Text = "今日剩余次数：" + Rules.N(g.arenaTries) + "\n累计胜场：" + Rules.N(g.arenaWins) + " · 当前战功：" + Rules.N(g.merit); detail.Text = g.notice; }
        if (page == 4 && pageInfo != null) { pageInfo.Text = "今日剩余次数：" + Rules.N(g.escortTries) + "\n" + (g.escortLeft > 0 ? "运输中 · 剩余 " + Rules.N(g.escortLeft) + " 秒\n预计金币：" + Rules.N(g.escortReward) : "当前没有运输中的镖车"); detail.Text = g.notice; }
        if (page == 14 && pageInfo != null) { pageInfo.Text = g.AltarSummary() + "\n累计捐献 " + Rules.N(g.altarDonations) + " 次"; detail.Text = g.notice; }
        if ((page == 24 || page == 25) && pageInfo != null) { pageInfo.Text = "当前称谓/爵位等级：" + Rules.N(g.title) + "\n战斗属性称谓加成：" + Rules.N(g.title) + " × 配置比例"; detail.Text = g.notice; }
        if (page == 0 && pageInfo != null) { pageInfo.Text = "当前地点：" + GameTables.current.Map(g.floor).Text("name") + " · " + (g.mode != 0 ? "正在挑战，暂不可传送" : (g.active ? "自动战斗中" : "战斗已暂停")); }
        if (page == 20 && !net.InWorld()) {
            pageInfo.Text = "攻击：" + g.StatPair("attack") + "\n魔法：" + g.StatPair("magic") + "\n道术：" + g.StatPair("tao") + "\n防御：" + g.StatPair("defense") + "\n魔防：" + g.StatPair("magic_defense") + "\n生命：" + Rules.N(g.MaxHp()) + "\n法力：" + Rules.N(g.MaxMp()) + "\n战力：" + Rules.N(g.Power());
            Equipment e = inspectWorn ? g.equipped[forgeSlot] : Selected();
            detail.Text = e == null ? "请选择背包或身上的装备查看完整属性。" : (inspectWorn ? "【已穿戴】" : "【背包/仓库】") + e.Name() + "\n" + e.Detail() + (e.CanWear(g.job, g.level, g.rebirth) ? "" : "\n当前不满足穿戴要求，属性不生效。") + CompareEquipment(e);
        }
        if (page == 21 && !net.InWorld()) {
            Equipment e = g.equipped[forgeSlot]; DataRow recipe = GameTables.current.forge.rows[forgeMode];
            detail.Text = "【" + recipe.Text("name") + "】 · " + Rules.Slots()[forgeSlot] + "\n" + (e == null ? "尚未穿戴装备" : e.Name() + "\n" + e.Detail())
                + "\n" + g.ForgePreview(forgeSlot, recipe.Int("id"))
                + "\n操作上限 " + Rules.N(recipe.Int("limit")) + " · 点击开始锻造后才会扣除材料。";
        }
        if ((page == 2 || page == 3 || page == 12) && detail != null) { detail.Text = g.notice; }
        if (page == 3 && pageInfo != null) { pageInfo.Text = "BOSS之家 · 剩余 " + Rules.N(g.bossTries) + " 次\n累计胜利 " + Rules.N(g.bossWins) + " 次"; }
        if (page == 12 && pageInfo != null) { pageInfo.Text = "秘境最高通关 " + Rules.N(g.secrets) + " 层\n当前第 " + Rules.N(g.secretFloor) + " 层"; }
        if (page == 17 && pageInfo != null) { pageInfo.Text = GameTables.current.recycle.At(recycleCurrency).Text("name") + "余额：" + Rules.N(g.RecycleBalance(recycleCurrency)); detail.Text = g.notice; }
        if (page == 10 && pageInfo != null) {
            pageInfo.Text = "修炼经验：" + Rules.N(g.elementPool) + " / " + Rules.N(g.B("element_pool_cap")) + "\n累计修炼：" + Rules.N(g.elementSeconds / 60) + "分 " + Rules.N(g.elementSeconds % 60) + "秒";
            elementToggle.Text = g.elementTraining ? "暂停修炼" : "开始修炼"; detail.Text = g.notice;
            for (int i = 0; i < 5; i = i + 1) {
                DataRow e = GameTables.current.elements.At(i);
                elementLabels[i].Text = e.Text("name") + " · " + Rules.N(g.elementRanks[i]) + "级 · " + Rules.N(g.elementXp[i]) + "/" + Rules.N(g.ElementNeed(i)) + "\n" + GameTables.current.attributes.Get(e.Text("stat")).Text("name") + " +" + Rules.N(g.elementRanks[i] * e.Int("value_per_level")) + "\n突破：黑铁 " + Rules.N(g.ElementIronCost(i)) + " / 元宝 " + Rules.N(g.ElementYuanCost(i));
                elementBars[i].percent = g.elementXp[i] * 100 / g.ElementNeed(i);
            }
        }
        if (page == 6 && netStatus != null) { netStatus.Text = net.StatusText(); if (netFight != null) { netFight.Text = net.FightLine(); } }
        if (page == 6 && netQuest != null && net.InWorld()) {
            /* 主线进度即走：kills 随每帧 fight 推送就地刷新，不必等重建。 */
            JsonValue stq = net.Self();
            DataRow quest = GameTables.current.quests.At(0);
            int target = quest.Int("target");
            int kills = stq != null ? stq.Int("kills", 0) : 0;
            int shown = kills < target ? kills : target;
            netQuest.Text = "主线 · " + quest.Text("name") + "　"
                + Rules.N(shown) + " / " + Rules.N(target)
                + (kills >= target ? " · 已完成，奖励已发放" : "");
        }
        if ((page == 2 || page == 3 || page == 12) && net.InWorld() && net.LastFight() != null && combatTitle != null) {
            // 联机战斗覆盖：战斗页沿用同一组控件，数值取服务器最近一帧战况。
            JsonValue f = net.LastFight();
            combatTitle.Text = "战斗 · " + f.Str("mob", "战斗");
            enemyName.Text = f.Str("mob", "怪物");
            foeText.Text = "余血 " + Rules.N(f.Int("mobhp", 0)) + " · 我方伤害 " + Rules.N(f.Int("dmg", 0));
            JsonValue st = net.Self();
            playerText.Text = Rules.N(st.Int("hp", 0)) + "/" + Rules.N(st.Int("maxhp", 1));
            int maxhp = st.Int("maxhp", 1);
            life.percent = maxhp > 0 ? (int)((long)st.Int("hp", 0) * 100 / maxhp) : 0;
            battleStatus.Text = "自动挂机中：战况实时刷新";
        }
        if (page == 26 && pageInfo != null) { pageInfo.Text = g.QuestText() + "\n今日击杀 " + Rules.N(g.dailyKills) + "/30"; detail.Text = "累计击杀：" + Rules.N(g.kills) + "\n战败次数：" + Rules.N(g.deaths) + "\nBOSS胜利：" + Rules.N(g.bossWins) + "\n回收件数：" + Rules.N(g.recycled) + "\n离线结算：" + Rules.N(g.offlineSeconds) + "秒\n" + saveState; }
        app.RequestRedraw();
    }
    static void Main() { try { LegendApp game = new LegendApp(); game.Run(); } catch (Exception e) { Console.WriteLine("Legend startup failed: " + e.Message); } }
}
