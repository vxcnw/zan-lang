using System;
using System.IO;
using Gui;
using Gui.Widget;
using Legend;

/// 页 31「地图内页」——照原版 `地图-进入.png` 1:1 还原。
///
/// 入口：地图传送页点一张地图卡（见 PageMap.zan 的三分支点击语义），
/// 而不是开机首页。分区（REFERENCE_AUDIT.md 4.0 实测）：
///   左列：BOSS 场景（玩家/BOSS 血条+立绘+怪物气泡）→ 战斗日志 → 底部操作行
///   右列：挑战BOSS卡（血条/立绘/挑战/扫荡/自动挑战/属性两列）
partial class LegendApp {
    /// 内页当前地图 id：地图卡点击时先置这里再 Navigate(31)。
    /// （旧版漏赋值导致内页永远看 1 号图的 BOSS，这里每条入口都赋。）
    int netInnerMap = 1;

    /// 场景/卡片底板：带 css 类的列容器（原版 Col 工厂）。
    Panel Col(string cls) {
        Panel p = Panel.Column();
        p.Class = cls;
        p.Pad(4); p.Gap(4);
        return p;
    }

    /// 右栏属性两列里的一个格子：「标签：值」一行。
    Panel StatCell(string label, string value, string cls) {
        Panel cell = Panel.Row(); cell.Gap(4); cell.Prefer(0, 24);
        cell.With(Text(label + "：", cls, 20));
        Label v = Text(value, "", 20); v.Grow(); cell.With(v);
        return cell;
    }

    /// 内页当前图名：从地图列表里找 id 对应的名字。
    string MapName(int id) {
        for (int i = 0; i < net.MapCount(); i = i + 1) {
            JsonValue mp = net.MapAt(i);
            if (mp != null && mp.Int("id", 0) == id) { return mp.Str("name", ""); }
        }
        return "";
    }

    /// 美术键 → 客户端素材路径：boss 用 NNN01.png（每只 BOSS 首帧），
    /// map 用 NNNNN.jpg，其余 NNNNN.png；缺图落 item 的空白占位图。
    string PicturePath(string kind, int picture) {
        string path = "assets/" + kind + "/"
            + (kind == "boss"
                ? Rules.N(picture).PadLeft(3, "0") + "01.png"
                : Rules.N(picture).PadLeft(5, "0") + (kind == "map" ? ".jpg" : ".png"));
        return File.Exists(path) ? path : "assets/item/00002.png";
    }

    void BuildMapInner() {
        JsonValue st = net.Self();
        int mapId = netInnerMap;
        JsonValue page = net.BossPage();
        string mapName = MapName(mapId);

        Panel split = Panel.Row(); split.Gap(8); split.Grow(); content.With(split);
        Panel left = Panel.Column(); left.Grow(); left.Gap(8); split.With(left);

        /* ---- BOSS 场景 ---- */
        Panel scene = Col("boss-scene"); scene.Pad(12); scene.Gap(6);
        scene.Prefer(0, 248); left.With(scene);
        scene.With(Text("首次击杀本关BOSS通关", "scene-tag", 14));
        Panel duo = Panel.Row(); duo.Grow(); duo.Gap(0); scene.With(duo);

        /* 玩家半边：名+血量 → 血条 → 立绘。 */
        Panel pside = Panel.Column(); pside.Grow(); pside.Gap(4); duo.With(pside);
        int php = st != null ? st.Int("hp", 0) : 0;
        int pmax = st != null ? st.Int("maxhp", 1) : 1;
        string pname = st != null ? st.Str("name", "旅人") : " ";
        Label phpl = Text(pname + " " + Rules.N(php) + "/" + Rules.N(pmax), "red", 18);
        phpl.Prefer(160, 18); pside.With(phpl);
        Progress pbar = new Progress(100, 5); pbar.Class = "health-bar";
        pbar.Prefer(160, 6); pbar.showIndicator = false;
        pbar.percent = pmax > 0 ? (int)((long)php * 100 / pmax) : 0; pside.With(pbar);
        Image pimg = new Image("assets/show/00001.png", pname, "contain");
        pimg.Prefer(76, 76); pside.With(pimg);
        pside.With(Text(pname, "map-name", 18));

        /* BOSS 半边：血量 → 血条 → 立绘/无BOSS占位。 */
        Panel bside = Panel.Column(); bside.Grow(); bside.Gap(4); duo.With(bside);
        JsonValue bo = page != null ? page.Get("boss") : null;
        bool hasBoss = bo != null && bo.IsObject();
        int bhpLeft = hasBoss ? bo.Int("hpLeft", 0) : 0;
        int bhpMax = hasBoss ? bo.Int("hp", 1) : 1;
        Label bhpl = Text(Rules.N(bhpLeft) + "/" + Rules.N(bhpMax), "red", 18);
        bhpl.Prefer(160, 18); bside.With(bhpl);
        Progress bbar = new Progress(100, 5); bbar.Class = "health-bar";
        bbar.Prefer(160, 6); bbar.showIndicator = false;
        bbar.percent = bhpMax > 0 ? (int)((long)bhpLeft * 100 / bhpMax) : 0; bside.With(bbar);
        if (hasBoss) {
            Image bimg = new Image(PicturePath("boss", Convert.ToInt(bo.Str("picture", "0"))),
                bo.Str("name", "BOSS"), "contain");
            bimg.Prefer(120, 108); bside.With(bimg);
        } else {
            bside.With(Text("本图无 BOSS", "secondary", 40));
        }
        bside.With(Text(hasBoss ? bo.Str("name", "BOSS") : " ", "map-name", 18));

        /* ---- 战斗日志 ---- */
        Panel logPanel = Col("feed"); logPanel.Pad(8); logPanel.Gap(4);
        logPanel.Grow(); left.With(logPanel);
        int logN = net.BossLogCount();
        if (logN == 0) {
            logPanel.With(Text("尚未开战。点右侧「挑战BOSS」正面刚，胜利解锁下一张图；或底部「开始挂机」离线刷怪。", "secondary", 48));
        }
        for (int i = logN > 12 ? logN - 12 : 0; i < logN; i = i + 1) {
            string ln = net.BossLogAt(i);
            string cls = "secondary";
            if (ln.IndexOf("[BOSS]") == 0) { cls = "yellow"; }
            else if (ln.IndexOf("[战报]") == 0) { cls = "cyan"; }
            else if (ln.IndexOf("[扫荡]") == 0) { cls = "cyan"; }
            else if (ln.IndexOf("胜利") >= 0) { cls = "green"; }
            else if (ln.IndexOf("失败") >= 0) { cls = "red"; }
            logPanel.With(Text(ln, cls, 20));
        }

        /* ---- 底部操作行 ---- */
        Panel foot = Panel.Row(); foot.Pad(2); foot.Gap(8); foot.Prefer(0, 36);
        left.With(foot);
        foot.With(Btn("返回", "inner-back", () => { Navigate(0); }));
        Label hint = Text("开始挂机后，可以关闭客户端，离线挂机→", "secondary", 0);
        hint.Grow(); foot.With(hint);
        foot.With(Btn("开始挂机", "inner-auto", () => {
            if (net.MobCount() > 0) { net.AutoHunt(net.MobAt(0).Int("tpl", 0), true); }
            else { net.AddFeed("本图怪物列表还没拉到，稍后再试。"); }
        }));
        foot.With(Btn("说明", "inner-help", () => {
            net.AddFeed("挑战BOSS每天 20 次；打输 BOSS 留血，接着挑战继续磨；打赢解锁下一张图。");
        }));

        /* ---- 右栏：挑战BOSS卡（固定 320 宽，DockRight 才不会被 Grow 挤走）---- */
        Panel right = Panel.Column(); right.Prefer(320, 0); right.DockRight();
        right.Gap(8); split.Add(right);
        Panel bossCard = Col("frame"); bossCard.Pad(10); bossCard.Gap(8);
        bossCard.Grow(); right.With(bossCard);
        bossCard.With(Text(mapName + (st != null && st.Int("map", 0) == mapId ? "（当前所在）" : ""),
            "yellow strong", 24));
        if (!hasBoss) {
            bossCard.With(Text("这张图没有配置 BOSS。", "secondary", 48));
            return;
        }
        bossCard.With(Text(Rules.N(bhpLeft) + "/" + Rules.N(bhpMax), "red strong", 20));
        Progress bhpBar = new Progress(100, 5); bhpBar.Class = "health-bar";
        bhpBar.Prefer(0, 8); bhpBar.showIndicator = false;
        bhpBar.percent = bhpMax > 0 ? (int)((long)bhpLeft * 100 / bhpMax) : 0;
        bossCard.With(bhpBar);
        Image bpic = new Image(PicturePath("boss", Convert.ToInt(bo.Str("picture", "0"))),
            bo.Str("name", "BOSS"), "contain");
        bpic.Prefer(120, 108); bossCard.With(bpic);
        int tries = page != null ? page.Int("tries", 0) : 0;
        Panel ops = Panel.Row(); ops.Gap(6); ops.Prefer(0, 34); bossCard.With(ops);
        Button fightBtn = Btn("挑战BOSS(剩" + Rules.N(tries) + ")次", "boss-fight",
            () => { net.BossFight(mapId); });
        fightBtn.Prefer(0, 34); fightBtn.Grow(); ops.With(fightBtn);
        Input sweepIn = new Input("10"); sweepIn.Prefer(46, 34); ops.With(sweepIn);
        ops.With(Btn("扫荡", "boss-sweep", () => {
            string t = sweepIn.GetText().Trim();
            bool digits = t.Length > 0;
            for (int c = 0; c < t.Length; c = c + 1) {
                if (t[c] < '0' || t[c] > '9') { digits = false; break; }
            }
            int n = digits ? Convert.ToInt(t) : 10;
            if (n < 1) { n = 10; }
            if (n > 20) { n = 20; }
            net.BossSweep(mapId, n);
        }));
        Button autoBtn = Btn(net.BossAuto() ? "☑ 结束后自动挑战BOSS(勾选生效)"
            : "☐ 结束后自动挑战BOSS(勾选生效)", "boss-auto",
            () => { net.SetBossAuto(!net.BossAuto()); });
        autoBtn.Prefer(0, 28); bossCard.With(autoBtn);

        Grid stat = Grid.Of(2); stat.Gap(4); bossCard.With(stat);
        stat.With(StatCell("气血", Rules.N(bhpMax), "cyan"));
        stat.With(StatCell("等级", Rules.N(bo.Int("level", 1)), "green"));
        stat.With(StatCell("法力", Rules.N(bo.Int("mp", 0)), "cyan"));
        stat.With(StatCell("转生", "0", "magenta"));
        stat.With(StatCell("攻击", Rules.N(bo.Int("atkMin", 0)) + " - " + Rules.N(bo.Int("atk", 0)), "cyan"));
        stat.With(StatCell("防御", "0 - " + Rules.N(bo.Int("def", 0)), "green"));
        stat.With(StatCell("魔法", "0 - 0", "cyan"));
        stat.With(StatCell("魔防", "0 - " + Rules.N(bo.Int("mdef", 0)), "magenta"));
        stat.With(StatCell("道术", "0 - 0", "cyan"));
        stat.With(StatCell("幸运", "0", "magenta"));
        bossCard.With(Text("击败 BOSS 掉好装备并解锁下一张图；扫荡需先击败过它。", "secondary", 20));
    }
}
