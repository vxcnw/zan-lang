using System;
using Gui;
using Gui.Widget;
using Legend;

/// 左栏「角色信息」+ 右侧聊天区 + 底部状态行。
/// 原版实测结构见 REFERENCE_AUDIT.md「左栏」一节。
partial class LegendApp {
    /* ---- 左栏 ---- */
    void BuildProfile(Panel side) {
        side.Class = "profile";
        JsonValue st = net.Self();

        /* 头像 + 角色名（黄字）+ VIP。 */
        Panel head = Panel.Row(); head.Class = "hero-head"; head.Pad(6); head.Gap(6);
        head.Prefer(0, 72); side.With(head);
        Image avatar = new Image("assets/show/00001.png", "角色", "cover");
        avatar.Prefer(60, 60); head.With(avatar);
        Panel headCol = Panel.Column(); headCol.Gap(2); headCol.Grow(); head.With(headCol);
        string nm = st != null ? st.Str("name", "无名") : "无名";
        heroName = Text(nm, "hero-name", 0); headCol.With(heroName);
        heroTitle = Text("称谓：无", "hero-kv", 0); headCol.With(heroTitle);
        heroGuild = Text("行会：无", "hero-kv", 0); headCol.With(heroGuild);

        /* 经验条 + 数值 + 升级钮。 */
        Panel expRow = Panel.Row(); expRow.Class = "hero-exp"; expRow.Pad(6); expRow.Gap(4);
        expRow.Prefer(0, 28); side.With(expRow);
        expText = Text("经验：", "hero-label", 0); expRow.With(expText);
        expBar = new Progress(0, 1); expBar.Prefer(0, 14); expBar.Grow(); expRow.With(expBar);
        expRow.With(Btn("升级", "level-up", () => { }));
        /* 数值栅格：两列。 */
        Panel grid = Panel.Column(); grid.Class = "hero-grid"; grid.Pad(6); grid.Gap(4);
        grid.Prefer(0, 176); side.With(grid);
        Panel r1 = Panel.Row(); r1.Gap(4); r1.Grow(); grid.With(r1);
        heroHp = Text("生命：0", "hero-kv", 0); heroHp.Grow(); r1.With(heroHp);
        heroFame = Text("声望：0", "hero-kv", 0); heroFame.Grow(); r1.With(heroFame);
        Panel r2 = Panel.Row(); r2.Gap(4); r2.Grow(); grid.With(r2);
        heroMp = Text("法力：0", "hero-kv", 0); heroMp.Grow(); r2.With(heroMp);
        heroMerit = Text("战功：0", "hero-kv", 0); heroMerit.Grow(); r2.With(heroMerit);
        Panel r3 = Panel.Row(); r3.Gap(4); r3.Grow(); grid.With(r3);
        heroLv = Text("等级：1级", "hero-kv", 0); heroLv.Grow(); r3.With(heroLv);
        heroSpirit = Text("灵符：0", "hero-kv", 0); heroSpirit.Grow(); r3.With(heroSpirit);
        Panel r4 = Panel.Row(); r4.Gap(4); r4.Grow(); grid.With(r4);
        heroGold = Text("金币：0", "hero-kv", 0); heroGold.Grow(); r4.With(heroGold);
        heroYuan = Text("元宝：0", "hero-kv", 0); heroYuan.Grow(); r4.With(heroYuan);

        /* 快捷按钮行。 */
        Panel quick = Panel.Row(); quick.Class = "hero-quick"; quick.Pad(6); quick.Gap(4);
        quick.Prefer(0, 28); side.With(quick);
        quick.With(Btn("每日福利", "daily", () => { }));
        quick.With(Btn("充值", "recharge", () => { }));
        quick.With(Btn("刷新", "refresh", () => { BuildPage(); Refresh(); }));

        /* 信息滚动区。 */
        Panel feedBox = Panel.Column(); feedBox.Class = "hero-feed"; feedBox.Pad(6); feedBox.Gap(2);
        feedBox.Grow(); side.With(feedBox);
        newsFeed = Text("", "hero-feed-text", 0);
        newsFeed.Grow(); feedBox.With(newsFeed);

        /* 底部状态行。 */
        Panel foot = Panel.Row(); foot.Class = "hero-foot"; foot.Pad(6); foot.Gap(4);
        foot.Prefer(0, 32); foot.DockBottom(); side.Add(foot);
        foot.With(Btn("战斗统计", "statistics", () => { Navigate(26); }));
        statusText = Text("状态：空闲中", "hero-kv", 0);
        statusText.Grow(); foot.With(statusText);
    }

    /* ---- 右侧聊天区 ---- */
    Label chatText;
    void BuildChat(Panel panel) {
        panel.Class = "chat-panel"; panel.Pad(6); panel.Gap(4);
        chatText = Text("", "chat-text", 0);
        chatText.Grow(); panel.With(chatText);
        Panel sendRow = Panel.Row(); sendRow.Gap(4); sendRow.Prefer(0, 28);
        sendRow.DockBottom(); panel.Add(sendRow);
        Input box = new Input("说点什么"); box.Grow(); sendRow.With(box);
        sendRow.With(Btn("发送", "chat-send", () => { }));
    }

    /* ---- 每帧刷新左栏数值 ---- */
    void Refresh() {
        JsonValue st = net.Self();
        if (st == null) { return; }
        int hp = st.Int("hp", 0); int maxHp = st.Int("maxhp", 1);
        if (heroHp != null) { heroHp.Text = "生命：" + Rules.N(hp); }
        if (heroMp != null) { heroMp.Text = "法力：" + Rules.N(st.Int("mp", 0)); }
        if (heroLv != null) { heroLv.Text = "等级：" + Rules.N(st.Int("level", 1)) + "级"; }
        if (heroGold != null) { heroGold.Text = "金币：" + Rules.N(st.Int("gold", 0)); }
        if (heroYuan != null) { heroYuan.Text = "元宝：" + Rules.N(st.Int("yuan", 0)); }
        if (heroFame != null) { heroFame.Text = "声望：" + Rules.N(st.Int("fame", 0)); }
        if (heroMerit != null) { heroMerit.Text = "战功：" + Rules.N(st.Int("merit", 0)); }
        if (heroSpirit != null) { heroSpirit.Text = "灵符：" + Rules.N(st.Int("spirit", 0)); }
        if (heroName != null) { heroName.Text = st.Str("name", "无名"); }
        int exp = st.Int("exp", 0); int expNext = st.Int("expnext", 1);
        if (expBar != null) {
            int pct = expNext > 0 ? (exp * 100) / expNext : 0;
            if (pct < 0) { pct = 0; } if (pct > 100) { pct = 100; }
            expBar.percent = pct;
        }
        if (expText != null) { expText.Text = Rules.N(exp) + "/" + Rules.N(expNext); }
        if (newsFeed != null) { newsFeed.Text = net.FeedDump(); }
        if (chatText != null) { chatText.Text = net.ChatDump(); }
    }

    /* ---- 登录窗（占位，稍后按原版三窗流程还原）---- */
    void ConnectPublished(string dataDir) {
        string addr = KnownFolders.GetEnv("LEGEND_SERVER");
        if (addr.Length == 0) {
            string f = dataDir + "/server.txt";
            if (File.Exists(f)) {
                string line = File.ReadAllText(f).Trim();
                int bar = line.IndexOf("|");
                if (bar >= 0) { srvPass = line.Substring(bar + 1, line.Length - bar - 1); line = line.Substring(0, bar); }
                addr = line;
            }
        }
        if (addr.Length == 0) { addr = srvAddr; }
        net.ConnectAddr(addr, srvPass);
    }
}
