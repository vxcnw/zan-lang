using System;
using System.Json;
using System.Net.Sockets;
using System.Security.Cryptography;
using System.Text;
using System.Threading;
using Gui;
using Legend;

/* 一条 op 回复的回调。*/
delegate void NetReply(JsonValue r);

// 联机会话加密：与 templates/server/server-game/src/Game/Secure.zan 同一套线格式。
// 握手三行明文（连接通告 → hello → 切密通告，均不含秘密）之后，双向每行一条
// Base64(密文 ‖ 16字节tag) 帧；HKDF 派生双向独立密钥；序号进 IV 与 AAD，
// 接收端按严格相等校验，对不上即重放/注入，立即断开。
// 收发拆成两个实例：ForSend 只碰 txKey/txSeq（网络线程专用），
// ForRecv 只碰 rxKey/rxSeq（UI 线程专用），两边字段互不共享。
class Secure {
    byte[] txKey;
    byte[] rxKey;
    long txSeq;
    long rxSeq;
    string dirTx;
    string dirRx;

    /* 用共享 secret 与双向随机数派生主密钥；参数不足返回 null。*/
    static byte[] MasterOf(string secret, string cnonce, string snonce) {
        if (secret.Length == 0 || snonce.Length < 16 || cnonce.Length < 16) { return null; }
        return Hkdf.Derive(cnonce + snonce, (cnonce + snonce).Length,
            secret, secret.Length, "zan-game-v2", "zan-game-v2".Length, 32);
    }

    /* 发送侧（C2S）：只在网络线程上使用。*/
    static Secure ForSend(byte[] master) {
        if (master == null) { return null; }
        Secure c = new Secure();
        c.txKey = Hkdf.Expand(master, "zan-game-c2s", "zan-game-c2s".Length, 32);
        c.dirTx = "C";
        c.txSeq = 0;
        return c;
    }

    /* 接收侧（S2C）：只在 UI 线程上使用。*/
    static Secure ForRecv(byte[] master) {
        if (master == null) { return null; }
        Secure c = new Secure();
        c.rxKey = Hkdf.Expand(master, "zan-game-s2c", "zan-game-s2c".Length, 32);
        c.dirRx = "S";
        c.rxSeq = 0;
        return c;
    }

    static string Secret = "zan-game-dev-secret";

    /* 加密一条明文（JSON），返回一行 Base64 帧（不含行尾）。*/
    string Seal(string plain) {
        long seq = this.txSeq;
        this.txSeq = seq + 1;
        byte[] iv = Secure.Iv(seq);
        string aad = Secure.Aad(this.dirTx, seq);
        byte[] tag = new byte[16];
        byte[] ct = AesGcm.Encrypt(this.txKey, 32, iv, aad, aad.Length,
            plain, plain.Length, tag);
        if (ct == null) { return ""; }
        byte[] frame = new byte[ct.Length + 16];
        for (int i = 0; i < ct.Length; i = i + 1) { frame[i] = ct[i] & 255; }
        for (int i = 0; i < 16; i = i + 1) { frame[ct.Length + i] = tag[i] & 255; }
        return Base64.Encode(frame, frame.Length);
    }

    /* 解一条帧；序号不连续或认证失败返回 null（调用方必须断开）。*/
    string Open(string frame) {
        List<int> n = new List<int>();
        n.Add(0);
        byte[] buf = Base64.Decode(frame, n);
        if (buf == null || n[0] < 16) { return null; }
        int ctLen = n[0] - 16;
        byte[] tag = new byte[16];
        for (int i = 0; i < 16; i = i + 1) { tag[i] = buf[ctLen + i] & 255; }
        long seq = this.rxSeq;
        byte[] iv = Secure.Iv(seq);
        string aad = Secure.Aad(this.dirRx, seq);
        List<int> ok = new List<int>();
        ok.Add(0);
        byte[] pt = AesGcm.Decrypt(this.rxKey, 32, iv, aad, aad.Length,
            buf, ctLen, tag, ok);
        if (pt == null || ok[0] != -1) { return null; }
        this.rxSeq = seq + 1;
        return pt.ToStr(0, ctLen);
    }

    static byte[] Iv(long seq) {
        byte[] iv = new byte[12];
        for (int i = 0; i < 8; i = i + 1) {
            iv[i] = Bits.Shr64(seq, 8 * (7 - i)) & 255;
        }
        return iv;
    }

    static string Aad(string dir, long seq) {
        byte[] a = new byte[9];
        a[0] = dir[0] & 255;
        for (int i = 0; i < 8; i = i + 1) {
            a[1 + i] = Bits.Shr64(seq, 8 * (7 - i)) & 255;
        }
        return a.ToStr(0, 9);
    }
}

// 联机接入层：连接 → 加密握手 → 收发循环 → 世界状态缓存。
// 线程模型：Gui 主线程不驱动 IO 反应器，因此所有套接字 IO 都跑在一条
// 专用后台线程上（同 Gui.ImageHttp 的做法）；网络线程只搬字节并做
// C2S 加密，收到的每一行经 App.Post 投回 UI 线程解密、解析、改状态，
// UI 发出的 op 经互斥队列交给网络线程发送。所有 GameNet 状态字段仅由
// UI 线程读写（带 secRx/gen 后缀的字段除外，各归各线程）。
// 传输量约定：挂机战斗由服务端驱动，客户端每个回合不发任何上行，
// 只被动收一条 ~百字节级 fight 推送；心跳 30 秒一次；帧 overhead 固定
// 16 字节 tag + Base64 4/3，无额外包头。
class GameNet {
    /* 网络线程持有（其余字段仅 UI 线程访问）。*/
    nint wsock = -1;
    Secure secTx;
    bool wenc;
    string wrx = "";
    List<string> queue = new List<string>();
    Mutex qlock = Mutex.Create();
    string cHost = "";
    int cPort;
    /* 服务器连接密码：hello 随 cnonce 一并上送，由服务端校验。*/
    string cPass = "";

    /* UI 侧状态。sec 只在 UI 线程使用（S2C 方向）。*/
    App app;
    bool connected;
    bool connecting;
    bool ready;
    int gen;
    Secure sec;
    /* op 回复回调队列：协议一问一答且严格按序，每个 Op 各占一槽、回复
       按发出顺序对号入座。单个槽位会让连发的两条 op（如 RefreshWorld
       的 mobs+maps）互相覆盖，回复错位、数据丢进别的字段。 */
    List<NetReply> replySinks = new List<NetReply>();

    /* 连接阶段：0 未连接，1 已连上待握手，2 加密就绪，3 已登录，4 已进区。*/
    int stage;
    string error = "";
    int uid;
    string user = "";
    int realmId = 1;
    string realmName = "";
    /* 分区窗选中的区没有角色（enter 被拒）：登录窗据此切到建角页。 */
    bool needCreate;
    bool NeedCreate() { return this.needCreate; }
    JsonValue self;
    JsonValue realms;
    JsonValue mobs;
    JsonValue maps;
    JsonValue bag;
    /* 玩法页数据缓存：BOSS 之家 / 商店 / 排行 / 图鉴 / 世界 BOSS / 公告。 */
    JsonValue bosses;
    JsonValue shop;
    JsonValue rank;
    JsonValue codex;
    JsonValue wboss;
    JsonValue announces;
    JsonValue lastFight;
    List<string> chat = new List<string>();
    List<string> feed = new List<string>();

    static string[] JobNames = new string[] { "战士", "法师", "道士" };

    bool Connected() { return this.connected; }
    bool Ready() { return this.ready; }
    int Stage() { return this.stage; }
    string Error() { return this.error; }
    bool InWorld() { return this.stage >= 4 && this.self != null; }
    JsonValue Self() { return this.self; }
    JsonValue LastFight() { return this.lastFight; }
    int RealmCount() { return this.realms != null && this.realms.IsArray() ? this.realms.Count() : 0; }
    int MobCount() { return this.mobs != null && this.mobs.IsArray() ? this.mobs.Count() : 0; }
    int MapCount() { return this.maps != null && this.maps.IsArray() ? this.maps.Count() : 0; }
    JsonValue RealmAt(int i) { return this.realms.At(i); }
    JsonValue MobAt(int i) { return this.mobs.At(i); }
    JsonValue MapAt(int i) { return this.maps.At(i); }
    int BossCount() { return this.bosses != null && this.bosses.IsArray() ? this.bosses.Count() : 0; }
    JsonValue BossAt(int i) { return this.bosses.At(i); }
    int ShopCount() { return this.shop != null && this.shop.IsArray() ? this.shop.Count() : 0; }
    JsonValue ShopAt(int i) { return this.shop.At(i); }
    int RankCount() { return this.rank != null && this.rank.IsArray() ? this.rank.Count() : 0; }
    JsonValue RankAt(int i) { return this.rank.At(i); }
    JsonValue Codex() { return this.codex; }
    JsonValue WBoss() { return this.wboss; }
    int AnnounceCount() { return this.announces != null && this.announces.IsArray() ? this.announces.Count() : 0; }
    JsonValue AnnounceAt(int i) { return this.announces.At(i); }
    int BagCount() { return this.bag != null && this.bag.IsArray() ? this.bag.Count() : 0; }
    JsonValue BagAt(int i) { return this.bag.At(i); }
    string RealmName() { return this.realmName; }
    /* 当前/想要进入的区服 id（登录窗建角步用它记玩家的选择）。 */
    int RealmId() { return this.realmId; }
    /* 当前区服倍率（万分比，进区后随 self 下发）；未进区回 0。 */
    int ExpRate() { return this.self != null ? this.self.Int("expRate", 0) : 0; }
    int GoldRate() { return this.self != null ? this.self.Int("goldRate", 0) : 0; }
    int DropRate() { return this.self != null ? this.self.Int("dropRate", 0) : 0; }
    /* 阶段或世界数据变化时递增，LegendApp 借此重建联机页。*/
    int dataVersion;
    int DataVersion() { return this.stage * 1000 + this.dataVersion; }
    void Bump() { this.dataVersion = this.dataVersion + 1; }

    string StatusText() {
        if (this.stage >= 4) {
            return this.realmName + " · " + this.SelfLine();
        }
        if (this.stage >= 3) { return "已登录：" + this.user + "，准备进入世界…"; }
        if (this.stage >= 2) { return "加密会话已建立（AES-256-GCM）。"; }
        if (this.stage >= 1) { return "已连上服务器，握手中…"; }
        if (this.connecting) { return "正在连接 " + this.cHost + "…"; }
        if (this.error.Length > 0) { return "未连接（" + this.error + "）"; }
        return "未连接。点击服务器直接连接；离线玩法不受影响。";
    }

    /* 弹窗里显示的一行提示：最近的服务器消息/错误。*/
    string LastChat() {
        return this.chat.Count > 0 ? this.chat[this.chat.Count - 1] : "";
    }

    string SelfLine() {
        if (this.self == null) { return ""; }
        int job = this.self.Int("job", 0);
        string jobName = job >= 0 && job < 3 ? JobNames[job] : "旅人";
        return this.self.Str("name", "旅人") + " · " + jobName + " · "
            + Convert.ToString(this.self.Int("level", 1)) + "级 · 血 "
            + Convert.ToString(this.self.Int("hp", 0)) + "/"
            + Convert.ToString(this.self.Int("maxhp", 1)) + " · 金 "
            + Convert.ToString(this.self.Int("gold", 0)) + " · 攻 "
            + Convert.ToString(this.self.Int("atk", 0)) + " · 防 "
            + Convert.ToString(this.self.Int("def", 0)) + " · 强化 ★"
            + Convert.ToString(this.self.Int("weaponStar", 0)) + "/"
            + Convert.ToString(this.self.Int("armorStar", 0));
    }

    string FightLine() {
        if (this.lastFight == null) { return this.InWorld() ? "尚未开战。选一只怪开始挂机。" : ""; }
        JsonValue f = this.lastFight;
        string t = f.Str("mob", "怪物") + "：造成 " + Convert.ToString(f.Int("dmg", 0))
            + " 伤害，怪物余血 " + Convert.ToString(f.Int("mobhp", 0))
            + "；我方受击 " + Convert.ToString(f.Int("mdmg", 0))
            + "，余血 " + Convert.ToString(f.Int("hp", 0));
        if (f.Int("killed", 0) == 1) { t = t + "\n击杀！经验 +" + Convert.ToString(f.Int("exp", 0)) + "，自动刷新下一只。"; }
        if (f.Int("levelup", 0) > 0) { t = t + "\n升级到 " + Convert.ToString(f.Int("levelup", 0)) + " 级！"; }
        if (f.Str("drop", "").Length > 0) { t = t + "\n掉落：" + f.Str("drop", ""); }
        if (f.Int("die", 0) == 1) { t = t + "\n你倒下了，已被送回城休整，挂机停止。"; }
        return t;
    }

    string ChatDump() {
        string t = "";
        for (int i = 0; i < this.chat.Count; i = i + 1) {
            t = t + (i > 0 ? "\n" : "") + this.chat[i];
        }
        return t;
    }

    string FeedDump() {
        string t = "";
        for (int i = this.feed.Count - 1; i >= 0; i = i - 1) {
            t = t + (t.Length > 0 ? "\n" : "") + this.feed[i];
        }
        return t.Length > 0 ? t : "暂无战况，去沙巴克开挂机吧。";
    }

    void AddChat(string who, string text) {
        this.chat.Add(who + " " + text);
        if (this.chat.Count > 40) { this.chat.RemoveAt(0); }
    }

    void AddFeed(string text) {
        this.feed.Add(text);
        if (this.feed.Count > 16) { this.feed.RemoveAt(0); }
    }

    /* ---- 连接生命周期 ---- */

    /* UI 线程启动时注入 App：网络线程靠它把行投回 UI。*/
    void Attach(App a) { this.app = a; }

    /* UI 线程：发起连接。真正的拨号在后台线程做，主线程绝不阻塞。
       gatePass 是服务器连接密码（门禁），不是账号密码。*/
    void Connect(string host, int port, string gatePass) {
        if (this.connected || this.connecting) { return; }
        this.cHost = host;
        this.cPort = port;
        this.cPass = gatePass;
        this.error = "";
        this.connecting = true;
        this.gen = this.gen + 1;
        this.AddChat("[系统]", "正在连接 " + host + ":" + Convert.ToString(port) + "…");
        GameNet.worker = this;
        Thread.Start(GameNet.ThreadEntry);
    }

    /* 登录窗第一步的“连接服务器”：host:port 串（缺省端口 7100）+
       连接密码。解析失败返回 false，弹窗提示，不发起连接。*/
    bool ConnectAddr(string addr, string gatePass) {
        string a = addr.Trim();
        int colon = a.IndexOf(":");
        string host = a;
        int port = 7100;
        if (colon >= 0) {
            host = a.Substring(0, colon);
            port = Convert.ToInt32(a.Substring(colon + 1));
        }
        if (host.Length < 1 || port <= 0 || port > 65535) {
            this.AddChat("[系统]", "服务器地址应为 host:端口，如 127.0.0.1:7100。");
            return false;
        }
        this.Connect(host, port, gatePass);
        return true;
    }

    /* 最小 JSON 字符串转义：连接密码可能含引号/反斜杠。*/
    static string JStr(string s) {
        string t = s.Replace("\\", "\\\\");
        return t.Replace("\"", "\\\"");
    }

    /* Thread.Start 需要非捕获委托：经静态中转拿到当前会话实例。*/
    static GameNet worker;
    static void ThreadEntry() { GameNet.worker.NetMain(); }

    /* 网络线程主体：阻塞拨号 → 非阻塞收发轮询。只搬字节；
     * C2S 加密（secTx）在本线程，收到的行原样投回 UI 线程。*/
    void NetMain() {
        Socket.Initialize();
        nint sock = Socket.CreateTcp();
        if (sock < 0) { this.PostFail("无法创建套接字"); return; }
        int rc = Socket.Connect(sock, this.cHost, this.cPort);
        if (rc != 0) {
            Socket.Close(sock);
            this.PostFail("连接失败，错误码 " + Convert.ToString(rc));
            return;
        }
        Socket.SetNonBlocking(sock);
        this.wsock = sock;
        this.app.Post(() => { this.OnConnected(); });
        byte[] buf = new byte[16385];
        string wrx = "";
        long lastRecv = DateTime.UtcNow().epoch;
        long lastHb = lastRecv;
        this.wenc = false;
        bool run = true;
        while (run) {
            long now = DateTime.UtcNow().epoch;
            /* 发送：排队 op（握手完成前不出队发送）。*/
            List<string> items = this.Drain();
            if (items != null) {
                for (int i = 0; i < items.Count; i = i + 1) {
                    if (items[i] == "!close") { run = false; break; }
                    if (!this.wenc) { continue; }
                    if (!this.WSendText(this.secTx.Seal(items[i]) + "\n")) {
                        this.PostLinkDown("发送失败，断开"); run = false; break;
                    }
                    lastHb = now;
                }
            }
            if (!run) { break; }
            /* 心跳与看门狗（网络线程自行计时，不依赖 UI tick）。*/
            if (this.wenc && now - lastHb >= 30) {
                if (!this.WSendText(this.secTx.Seal("{\"op\":\"hb\"}") + "\n")) {
                    this.PostLinkDown("发送失败，断开"); break;
                }
                lastHb = now;
            }
            if (now - lastRecv >= 150) { this.PostLinkDown("150 秒没有收到服务器数据，断开"); break; }
            /* 接收：把就绪数据全部读走，按行投回 UI。*/
            bool idle = true;
            while (Socket.IsReadable(sock)) {
                int n = Socket.Recv(sock, buf, 16384);
                if (n <= 0) { this.PostLinkDown("与服务器的连接已断开"); run = false; break; }
                lastRecv = DateTime.UtcNow().epoch;
                idle = false;
                wrx = wrx + buf.ToStr(0, n);
                while (true) {
                    int nl = wrx.IndexOf("\n");
                    if (nl < 0) { break; }
                    string line = wrx.Substring(0, nl);
                    wrx = wrx.Substring(nl + 1);
                    if (line.Length == 0) { continue; }
                    if (!this.wenc) {
                        string kind = this.OnWorkerLine(line);
                        if (kind == "stop") { run = false; break; }
                        if (kind == "swallow") { continue; }
                    }
                    string lineF = line;
                    this.app.Post(() => { this.OnLine(lineF); });
                }
                if (!run) { break; }
            }
            if (!run) { break; }
            if (idle && items == null) { Thread.Sleep(30); }
        }
        if (this.wsock >= 0) { Socket.Close(this.wsock); this.wsock = -1; }
    }

    /* 网络线程：握手期的一行。返回 "swallow"（本行不投 UI）、
     * "stop"（断开退出）或 "post"（继续投 UI）。服务端 hello 在此
     * 消化：生成 cnonce、派生双向密钥、发出 hello；S2C 半边经
     * Post 交给 UI，收发两半自此各归一个线程。*/
    string OnWorkerLine(string line) {
        if (line.IndexOf("\"snonce\"") < 0) {
            if (line.IndexOf("\"enc\"") >= 0) { this.wenc = true; }
            return "post";
        }
        JsonValue m = null;
        try { m = JsonValue.ParseLenient(line); } catch (Exception) { m = null; }
        string snonce = m != null ? m.Str("snonce", "") : "";
        string cnonce = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        byte[] master = Secure.MasterOf(Secure.Secret, cnonce, snonce);
        this.secTx = Secure.ForSend(master);
        Secure rx = Secure.ForRecv(master);
        if (this.secTx == null || rx == null) {
            this.PostLinkDown("握手派生失败"); return "stop";
        }
        if (!this.WSendText("{\"op\":\"hello\",\"enc\":\"aes-gcm\",\"cnonce\":\""
                + cnonce + "\",\"pass\":\"" + GameNet.JStr(this.cPass) + "\"}\n")) {
            this.PostLinkDown("发送失败，断开"); return "stop";
        }
        this.app.Post(() => { this.OnHandshake(rx); });
        return "swallow";
    }

    /* 网络线程：同步发送一小段文本；套接字为非阻塞，小帧一次
     * 系统调用即可完成，偶发 would-block 重试几次。*/
    bool WSendText(string data) {
        if (this.wsock < 0) { return false; }
        for (int attempt = 0; attempt < 50; attempt = attempt + 1) {
            int n = Socket.Send(this.wsock, data, data.Length);
            if (n == data.Length) { return true; }
            if (attempt < 49) { Thread.Sleep(10); }
        }
        return false;
    }

    /* UI 线程：互斥队列交接 op 与控制行（"!close"）。*/
    void Enqueue(string item) {
        Mutex.Lock(this.qlock);
        this.queue.Add(item);
        Mutex.Unlock(this.qlock);
    }

    List<string> Drain() {
        List<string> rest = null;
        Mutex.Lock(this.qlock);
        if (this.queue.Count > 0) {
            rest = this.queue;
            this.queue = new List<string>();
        }
        Mutex.Unlock(this.qlock);
        return rest;
    }

    /* 以下回调都经 App.Post 在 UI 线程执行。gen 保证旧会话的
     * 迟到回调不会污染新一轮连接。*/
    void PostFail(string msg) {
        string m = msg;
        this.app.Post(() => { this.OnConnectFail(m); });
    }

    void PostLinkDown(string reason) {
        if (this.wsock >= 0) { Socket.Close(this.wsock); this.wsock = -1; }
        string r = reason;
        this.app.Post(() => { this.OnLinkDown(r); });
    }

    void OnConnectFail(string msg) {
        if (this.stage == 0 && !this.connecting) { return; }
        this.connecting = false;
        this.connected = false;
        this.stage = 0;
        this.error = msg;
        this.AddChat("[系统]", msg + "。离线模式继续可用。");
        this.Bump();
    }

    void OnConnected() {
        this.connecting = false;
        this.connected = true;
        this.stage = 1;
        this.error = "";
        this.AddChat("[系统]", "已连接 " + this.cHost + ":" + Convert.ToString(this.cPort)
            + "，等待加密握手…");
        this.Bump();
    }

    void OnHandshake(Secure rx) { this.sec = rx; }

    void OnLinkDown(string reason) {
        if (!this.connecting && !this.connected && this.stage == 0) { return; }
        this.connecting = false;
        this.Drop(reason);
    }

    void Drop(string reason) {
        this.connected = false;
        this.connecting = false;
        this.ready = false;
        this.stage = 0;
        this.sec = null;
        this.replySinks.Clear();
        this.self = null;
        this.realms = null;
        this.mobs = null;
        this.maps = null;
        this.bag = null;
        this.bosses = null;
        this.shop = null;
        this.rank = null;
        this.codex = null;
        this.wboss = null;
        this.announces = null;
        this.lastFight = null;
        this.uid = 0;
        /* realmId 不清零：断线重连分区窗仍默认选中上次玩过的区。 */
        this.realmName = "";
        this.needCreate = false;
        /* 保留本次连接里更早的错误（如服务器密码不正确）：它才是
           用户要看的断开原因；reason 只在没有更早错误时兜底。*/
        if (this.error.Length == 0) { this.error = reason; }
        this.AddChat("[系统]", "连接断开：" + reason + "。离线模式继续可用。");
    }

    /* ---- 行解析与握手 ---- */

    /* UI 线程：网络线程投来的原始行。加密期先解帧再解析；
     * 解不开 = 被篡改/重放，立即断开。*/
    void OnLine(string line) {
        if (this.ready) {
            if (this.sec == null) { this.Drop("加密状态丢失，断开"); return; }
            string plain = this.sec.Open(line);
            if (plain == null) { this.Drop("加密帧校验失败，断开"); return; }
            line = plain;
        }
        this.HandleLine(line);
    }

    void HandleLine(string line) {
        JsonValue m = null;
        try { m = JsonValue.ParseLenient(line); } catch (Exception) { m = null; }
        if (m == null || !m.IsObject()) { return; }
        if (m.Int("enc", 0) == 1) {
            this.ready = true;
            this.stage = 2;
            this.AddChat("[系统]", "加密会话已建立（AES-256-GCM · HKDF-SHA256 · 序号防重放）。");
            this.Bump();
            return;
        }
        if (m.Str("ev", "").Length > 0) { this.OnEvent(m); return; }
        if (this.replySinks.Count > 0) {
            NetReply cb = this.replySinks[0];
            this.replySinks.RemoveAt(0);
            cb(m);
            return;
        }
        if (m.Int("ok", 1) == 0) {
            this.error = m.Str("err", "未知错误");
            this.AddChat("[系统]", "服务器：" + this.error);
        }
    }

    /* ---- 事件（服务端驱动的世界推送） ---- */

    void OnEvent(JsonValue m) {
        string ev = m.Str("ev", "");
        if (ev == "state") {
            JsonValue st = m.Get("self");
            if (st != null && st.IsObject()) { this.self = st; this.Bump(); }
            return;
        }
        if (ev == "fight") {
            this.lastFight = m;
            if (this.self != null && m.Int("hp", -1) >= 0) {
                this.self.Set("hp", JsonValue.NewNum(Convert.ToString(m.Int("hp", 0))));
            }
            /* 累计击杀随 fight 推送同步（服务端权威值），任务进度即走吧。 */
            if (this.self != null && m.Int("killed", 0) == 1) {
                this.self.Set("kills", JsonValue.NewNum(Convert.ToString(
                    m.Int("kills", this.self.Int("kills", 0) + 1))));
                /* 金币走增量累加（fight 带本次所得，任务奖励已由服务端
                   并进那一击的值），self 的金币显示才不会停在进场旧值。 */
                this.self.Set("gold", JsonValue.NewNum(Convert.ToString(
                    this.self.Int("gold", 0) + m.Int("gold", 0))));
            }
            /* 等级/经验绝对值随战况下发（服务端进度戳）：经验条逐杀
               增长，不必等升级快照才刷新。 */
            if (this.self != null) {
                if (m.Get("level") != null) {
                    this.self.Set("level", JsonValue.NewNum(
                        Convert.ToString(m.Int("level", 0))));
                }
                if (m.Get("expNow") != null) {
                    this.self.Set("exp", JsonValue.NewNum(
                        Convert.ToString(m.Int("expNow", 0))));
                }
                if (m.Get("expNext") != null) {
                    this.self.Set("expnext", JsonValue.NewNum(
                        Convert.ToString(m.Int("expNext", 0))));
                }
            }
            string t = "交战 " + m.Str("mob", "怪物") + "：伤害 " + Convert.ToString(m.Int("dmg", 0))
                + " · 受击 " + Convert.ToString(m.Int("mdmg", 0))
                + " · 余血 " + Convert.ToString(m.Int("hp", 0));
            if (m.Int("killed", 0) == 1) { t = t + " · 击杀 经验+" + Convert.ToString(m.Int("exp", 0)); }
            this.AddFeed(t);
            return;
        }
        if (ev == "levelup") {
            /* 升级事件带整份 self（等级/血量上限/经验曲线都变了），与
               op 回复同一个替换规则。 */
            JsonValue st = m.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.AddFeed(m.Str("text", "升级！")); return;
        }
        if (ev == "drop") {
            JsonValue bg = m.Get("bag");
            if (bg != null && bg.IsArray()) { this.bag = bg; this.Bump(); }
            this.AddFeed(m.Str("text", "获得掉落")); return;
        }
        if (ev == "die") { this.AddFeed(m.Str("text", "你倒下了，挂机已停止。")); return; }
        if (ev == "chat") { this.AddChat("[" + m.Str("from", "玩家") + "]", m.Str("text", "")); return; }
        if (ev == "move" || ev == "walk") { this.AddChat("[系统]", m.Str("text", "")); return; }
        if (ev == "announce") { this.AddChat("[公告]", m.Str("title", "") + " " + m.Str("body", "")); return; }
        if (ev == "kick") { this.Drop(m.Str("reason", "被服务器断开（顶号或封禁）")); }
    }

    /* ---- 发送 ---- */

    /* 带回调的请求：回复按发出顺序逐条对号入座（协议一问一答且严格
       按序，回调排成 FIFO，见 replySinks 注释）。*/
    void Op(string json, NetReply onReply) {
        if (!this.ready) { this.AddChat("[系统]", "尚未连接服务器。"); return; }
        this.replySinks.Add(onReply);
        this.Enqueue(json);
    }

    /* 无回复推送类 op（state/mobs/maps 的回复都带数据，用 Op；Fire 只用于不需要回执的行）。*/
    void Fire(string json) {
        if (!this.ready) { return; }
        this.Enqueue(json);
    }

    /* ---- UI 动作 ---- */

    /* 注册：照原版「创建新账号」只收 账号/密码/邮箱（密保可空，服务端
       两者都空=不设置）。结果存 formMsg 给登录窗建号页提示行（聊天流
       同步留一份）。 */
    string formMsg = "";
    string FormMsg() { return this.formMsg; }
    void SetFormMsg(string s) { this.formMsg = s; }
    void Register(string user, string pass, string email) {
        if (user.Length < 3 || pass.Length < 6) { this.AddChat("[系统]", "账号需 ≥3 字符，密码需 ≥6 位。"); return; }
        this.Op("{\"op\":\"register\",\"user\":\"" + user + "\",\"pass\":\"" + pass
            + "\",\"email\":\"" + email + "\"}", (JsonValue r) => {
            if (r.Int("ok", 0) == 1) {
                this.formMsg = "注册成功，请登录。";
                this.AddChat("[系统]", this.formMsg);
            } else {
                this.formMsg = "注册失败：" + r.Str("err", "未知错误");
                this.AddChat("[系统]", this.formMsg);
            }
            this.Bump();
        });
    }

    /* 登录成功：拿区服列表（应答自带）后停在「分区」选择页——照原版
       不自动进区，玩家选分区→区服才进；一个账号所有区通用。 */
    void Login(string user, string pass) {
        this.Op("{\"op\":\"login\",\"user\":\"" + user + "\",\"pass\":\"" + pass + "\"}", (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "登录失败：" + r.Str("err", "未知错误")); return; }
            this.uid = r.Int("uid", 0);
            this.user = user;
            this.stage = 3;
            this.needCreate = false;
            JsonValue rows = r.Get("realms");
            if (rows != null && rows.IsArray() && rows.Count() > 0) { this.realms = rows; }
            this.AddChat("[系统]", "登录成功，请选择分区进入。");
            this.Bump();
        });
    }

    /* 修改密码（密保找回）：forgot 拿问题，reset 校验答案并改密。
       结果存字段，登录窗「修改密码」页直接读。 */
    string forgotQuestion = "";
    string forgotMsg = "";
    bool resetOk; string resetMsg = "";
    string ForgotQuestion() { return this.forgotQuestion; }
    string ForgotMsg() { return this.forgotMsg; }
    bool ResetOk() { return this.resetOk; }
    string ResetMsg() { return this.resetMsg; }
    void Forgot(string user) {
        this.forgotQuestion = ""; this.forgotMsg = "";
        this.Op("{\"op\":\"forgot\",\"user\":\"" + user + "\"}", (JsonValue r) => {
            if (r.Int("ok", 0) == 1) { this.forgotQuestion = r.Str("question", ""); }
            else { this.forgotMsg = r.Str("err", "未知错误"); }
            this.Bump();
        });
    }
    void Reset(string user, string answer, string newpass) {
        this.resetMsg = "";
        this.Op("{\"op\":\"reset\",\"user\":\"" + user + "\",\"answer\":\"" + answer
            + "\",\"newpass\":\"" + newpass + "\"}", (JsonValue r) => {
            this.resetOk = r.Int("ok", 0) == 1;
            this.resetMsg = this.resetOk ? r.Str("msg", "密码已重置，请用新密码登录")
                : r.Str("err", "未知错误");
            this.Bump();
        });
    }

    /* 选择角色页：characters 列表缓存（进页拉一次，删除后重拉）+
       删除角色。 */
    JsonValue chars; bool charsReady;
    int CharCount() { return this.chars != null && this.chars.IsArray() ? this.chars.Count() : 0; }
    JsonValue CharAt(int i) { return this.chars.At(i); }
    bool CharsReady() { return this.charsReady; }
    void RefreshChars(int realmId) {
        this.chars = null; this.charsReady = false;
        this.Op("{\"op\":\"characters\",\"realm\":" + Convert.ToString(realmId) + "}", (JsonValue r) => {
            JsonValue rows = r.Get("rows");
            if (rows != null && rows.IsArray()) { this.chars = rows; }
            this.charsReady = true;
            this.Bump();
        });
    }
    void DelChar(int realmId) {
        this.Op("{\"op\":\"delchar\",\"realm\":" + Convert.ToString(realmId) + "}", (JsonValue r) => {
            this.AddChat("[系统]", r.Int("ok", 0) == 1 ? "角色已删除。"
                : "删除失败：" + r.Str("err", "未知错误"));
            this.RefreshChars(realmId);
        });
    }

    /* 进区：分区窗点区服调用。有角色直接进世界（self 带回）；没角色
       服务端拒绝，needCreate 置位，登录窗切到建角页。 */
    void EnterRealm(int id, string name) {
        this.realmId = id;
        this.realmName = name;
        this.Op("{\"op\":\"enter\",\"realm\":" + Convert.ToString(id) + "}", (JsonValue r) => {
            if (r.Int("ok", 0) != 1) {
                /* 该区还没有角色：置标记，登录窗切到建角页（照原版选区
                   后没角色就先建角）。*/
                this.needCreate = true;
                this.AddChat("[系统]", r.Str("err", "请先创建角色"));
                this.self = null;
                this.Bump();
                return;
            }
            this.needCreate = false;
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.stage = 4;
            this.AfterEnter();
        });
    }

    /* 建角入口：先拉一次区服列表把区名/倍率备好，再 create 到当前
       选中区（realmId 可被建角窗的区服列表改过）；服务端建角即进入
       世界（self 直接带回来）。 */
    void CreateChar(string name, int job, int gender) {
        if (name.Length < 2) { this.AddChat("[系统]", "角色名需 2 个字符以上。"); return; }
        this.Op("{\"op\":\"create\",\"realm\":" + Convert.ToString(this.realmId)
            + ",\"name\":\"" + name + "\",\"job\":" + Convert.ToString(job)
            + ",\"gender\":" + Convert.ToString(gender) + "}", (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "创建角色失败：" + r.Str("err", "未知错误")); return; }
            this.needCreate = false;
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.stage = 4;
            this.AddChat("[系统]", "角色已创建并进入 " + this.realmName + "。");
            this.AfterEnter();
        });
    }

    void AfterEnter() {
        this.lastFight = null;
        this.feed.Clear();
        this.AddFeed("进入 " + this.realmName + "，战况将实时显示在这里。");
        this.RefreshWorld();
        this.RefreshBag();
    }

    /* 进区/换图后刷新怪物与地图缓存（一次各一条小回复）。*/
    void RefreshWorld() {
        this.Op("{\"op\":\"mobs\"}", (JsonValue r) => {
            JsonValue rows = r.Get("rows");
            if (rows != null && rows.IsArray()) { this.mobs = rows; this.Bump(); }
        });
        this.Op("{\"op\":\"maps\"}", (JsonValue r) => {
            JsonValue rows = r.Get("maps");
            if (rows == null) { rows = r.Get("rows"); }
            if (rows != null && rows.IsArray()) { this.maps = rows; this.Bump(); }
        });
    }

    /* ---- 背包与穿戴 ---- */

    /* 背包：物品列表 + 最新 self（金币/穿装随行更新）。*/
    void RefreshBag() {
        this.Op("{\"op\":\"bag\"}", (JsonValue r) => {
            JsonValue rows = r.Get("items");
            if (rows != null && rows.IsArray()) { this.bag = rows; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.Bump();
        });
    }

    void EquipItem(int itemId) {
        this.Op("{\"op\":\"equip\",\"item\":" + Convert.ToString(itemId) + "}", (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "穿戴失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.AddFeed("装备已穿上。");
            this.RefreshBag();
        });
    }

    void TakeOff(string slot) {
        this.Op("{\"op\":\"takeoff\",\"slot\":\"" + slot + "\"}", (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "卸下失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.RefreshBag();
        });
    }

    void UseItem(int itemId) {
        this.Op("{\"op\":\"use\",\"item\":" + Convert.ToString(itemId) + "}", (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "使用失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.RefreshBag();
        });
    }

    void SellItem(int itemId) {
        this.Op("{\"op\":\"sell\",\"item\":" + Convert.ToString(itemId) + ",\"count\":1}", (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "卖出失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.RefreshBag();
        });
    }

    /* ---- 玩法页数据：BOSS / 排行 / 商店 / 图鉴 / 世界 BOSS / 公告 ---- */
    /* 各页首次构建时数据缓存为空则拉一次；回复 Bump 后心跳整页重建，
       数据就位。Drop 时全部清空，重连后按页重拉。 */

    void MaybeRefreshBosses() {
        if (this.bosses != null) { return; }
        this.Op("{\"op\":\"bosses\"}", (JsonValue r) => {
            JsonValue rows = r.Get("rows");
            if (rows != null && rows.IsArray()) { this.bosses = rows; this.Bump(); }
        });
    }

    void MaybeRefreshShop() {
        if (this.shop != null) { return; }
        this.Op("{\"op\":\"shop\"}", (JsonValue r) => {
            JsonValue rows = r.Get("shop");
            if (rows != null && rows.IsArray()) { this.shop = rows; this.Bump(); }
        });
    }

    /* 排行榜/世界BOSS 状态：进页时为空才拉（回复 Bump 重建一次后
       数据就位，不再循环）；手动刷新走 Reload*。 */
    void RefreshRank() {
        if (this.rank != null) { return; }
        this.Op("{\"op\":\"rank\"}", (JsonValue r) => {
            JsonValue rows = r.Get("rows");
            if (rows != null && rows.IsArray()) { this.rank = rows; this.Bump(); }
        });
    }

    void ReloadRank() { this.rank = null; this.RefreshRank(); }

    void ReloadBosses() { this.bosses = null; this.MaybeRefreshBosses(); }

    void MaybeRefreshCodex() {
        if (this.codex != null) { return; }
        this.Op("{\"op\":\"codex\"}", (JsonValue r) => {
            JsonValue cx = r.Get("codex");
            if (cx != null && cx.IsObject()) { this.codex = cx; this.Bump(); }
        });
    }

    void MaybeRefreshAnnounces() {
        if (this.announces != null) { return; }
        this.Op("{\"op\":\"announces\"}", (JsonValue r) => {
            JsonValue rows = r.Get("rows");
            if (rows != null && rows.IsArray()) { this.announces = rows; this.Bump(); }
        });
    }

    /* 世界 BOSS：进页拉一次状态；hit=1 是攻击一轮（状态与 self 一并
       回来，Bump 后页面血条刷新）。 */
    void RefreshWBoss() {
        if (this.wboss != null) { return; }
        this.Op("{\"op\":\"wboss\"}", (JsonValue r) => {
            JsonValue w = r.Get("wboss");
            if (w != null && w.IsObject()) { this.wboss = w; this.Bump(); }
        });
    }

    void WBossHit() {
        this.Op("{\"op\":\"wboss\",\"hit\":1}", (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddFeed("攻击失败：" + r.Str("err", "未知错误")); return; }
            JsonValue w = r.Get("wboss");
            if (w != null && w.IsObject()) { this.wboss = w; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            JsonValue f = r.Get("fight");
            if (f != null && f.IsObject()) {
                this.AddFeed("世界BOSS：伤害 " + Convert.ToString(f.Int("dmg", 0))
                    + " · 累计 " + Convert.ToString(f.Int("mydmg", 0))
                    + (f.Int("killed", 0) == 1 ? " · 击杀！大奖已发！" : ""));
                if (f.Str("drop", "").Length > 0) { this.AddFeed("击杀掉落：" + f.Str("drop", "")); }
            }
            this.Bump();
        });
    }

    void Forge(string slot) {
        this.Op("{\"op\":\"forge\",\"slot\":\"" + slot + "\"}", (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "强化失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.AddFeed("强化成功，属性已提升。");
            this.Bump();
        });
    }

    void DrawTreasure() {
        this.Op("{\"op\":\"draw\"}", (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "寻宝失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.AddFeed("寻宝抽得【" + r.Str("item", "??") + "】！");
            this.RefreshBag();
            this.Bump();
        });
    }

    void RecycleAll() {
        this.Op("{\"op\":\"recycle\"}", (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "回收失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.AddFeed("材料回收完成，入账 " + Convert.ToString(r.Int("gain", 0)) + " 金币。");
            this.RefreshBag();
            this.Bump();
        });
    }

    void AutoHunt(int mobId, bool on) {
        string json = on
            ? "{\"op\":\"auto\",\"mob\":" + Convert.ToString(mobId) + ",\"on\":1}"
            : "{\"op\":\"auto\",\"on\":0}";
        this.Op(json, (JsonValue r) => {
            if (r.Int("ok", 0) == 1) {
                this.AddFeed(r.Int("auto", 0) > 0 ? "自动挂机开启，战况每秒推送。" : "自动挂机已停止。");
            } else { this.AddChat("[系统]", "挂机失败：" + r.Str("err", "未知错误")); }
        });
    }

    void Hunt(int mobId) {
        this.Op("{\"op\":\"hunt\",\"mob\":" + Convert.ToString(mobId) + "}", (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "开战失败：" + r.Str("err", "未知错误")); return; }
            JsonValue f = r.Get("fight");
            if (f != null && f.IsObject()) { this.lastFight = f; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
        });
    }

    void UsePotion() {
        this.Op("{\"op\":\"use\",\"item\":1}", (JsonValue r) => {
            this.AddChat("[系统]", r.Int("ok", 0) == 1 ? "嗑药成功。" : "嗑药失败：" + r.Str("err", "未知错误"));
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
        });
    }

    void MoveTo(int mapId) {
        this.Op("{\"op\":\"move\",\"map\":" + Convert.ToString(mapId) + "}", (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddFeed("移动失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            /* 换图后怪物/地图缓存要重拉（mob 列表按当前图过滤）。 */
            this.RefreshWorld();
            this.Bump();
        });
    }

    void BuyItem(int itemId) {
        this.Op("{\"op\":\"buy\",\"item\":" + Convert.ToString(itemId) + ",\"count\":1}", (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "购买失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.AddFeed("购买成功，物品已入背包。");
            this.RefreshBag();
            this.Bump();
        });
    }

    void Say(string text) {
        if (text.Length == 0) { return; }
        this.Fire("{\"op\":\"say\",\"text\":\"" + text + "\"}");
    }

    void Logout() {
        if (this.stage >= 2) { this.Enqueue("{\"op\":\"logout\"}"); }
        this.Enqueue("!close");
        this.Drop("主动断开");
    }
}
