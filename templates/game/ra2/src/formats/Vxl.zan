using System;
using System.Collections.Generic;

namespace Ra2.Formats;

// One limb of a VXL voxel model: a dense colour grid of sizeX * sizeY * sizeZ
// palette indices. Empty space is stored as -1; a filled voxel carries the
// palette index the vehicle section of the unit palette resolves. The normal
// table the format stores per voxel is deliberately dropped -- the renderer
// lights from the voxel grid's occupancy instead, which needs no per-format
// normal palettes.
class VxlLimb {
    string name;
    int sizeX;
    int sizeY;
    int sizeZ;
    int normalType; // 2 = Tiberian Sun's 32 normals, 4 = RA2's 256
    byte[] vox;     // (y*sizeX + x)*sizeZ + z -> palette index + 1, 0 = empty

    static VxlLimb Create(string name, int sizeX, int sizeY, int sizeZ,
                          int normalType) {
        VxlLimb l = new VxlLimb();
        l.name = name;
        l.sizeX = sizeX;
        l.sizeY = sizeY;
        l.sizeZ = sizeZ;
        l.normalType = normalType;
        l.vox = new byte[sizeX * sizeY * sizeZ + 1];
        return l;
    }

    string Name() { return this.name; }
    int SizeX() { return this.sizeX; }
    int SizeY() { return this.sizeY; }
    int SizeZ() { return this.sizeZ; }

    /// <summary>The palette index of the voxel at (x,y,z), or -1 for empty.</summary>
    int VoxelAt(int x, int y, int z) {
        if (x < 0 || y < 0 || z < 0
         || x >= this.sizeX || y >= this.sizeY || z >= this.sizeZ) {
            return -1;
        }
        return this.vox[(y * this.sizeX + x) * this.sizeZ + z] - 1;
    }

    void SetVoxel(int x, int y, int z, int color) {
        if (x < 0 || y < 0 || z < 0
         || x >= this.sizeX || y >= this.sizeY || z >= this.sizeZ) {
            return;
        }
        this.vox[(y * this.sizeX + x) * this.sizeZ + z] = (byte)(color + 1);
    }
}

// Parses a Westwood VXL voxel model as used by Red Alert 2 vehicle art
// (HTNK.VXL, MTNK.VXL, ...). Clean-room: layout derived from the format's
// published structure and verified against install files; tests synthesize
// models. Pixels are unit-palette indices; pair with unittem.pal for RGB.
//
// Layout (little-endian):
//   header    : magic "Voxel Animation"(16), skip(u32), limbCount(u32),
//               skip(u32), bodySize(u32), embedded palette(770 bytes)
//   limbHeader: name(16) + pad(12), one per limb          -- at base (802)
//   limbFooter: limbDataOffset(u32), table2Offset(u32), spansOffset(u32),
//               scale(f32), bounds+reserved(72), sizeX(u8), sizeY(u8),
//               sizeZ(u8), normalType(u8)                  -- 92 bytes each
//   voxelData : the limb's block sits at base + 28*limbCount +
//               limbDataOffset and holds, sequentially, a column offset
//               table (sizeX*sizeY i32, -1 = empty column), a second table
//               of the same size (unused), and the span records. A column's
//               record lives at block + spansOffset + table value and is a
//               chain of spans -- gap(u8), count(u8),
//               count * (color(u8), normal(u8)), a 1-byte terminator --
//               until a zero count or the column's z passes sizeZ.
class VxlImage {
    List<VxlLimb> limbs;

    static VxlImage Parse(string data, int length) {
        VxlImage img = new VxlImage();
        img.limbs = new List<VxlLimb>();
        BinaryReader r = BinaryReader.FromBuffer(data, length);
        // Magic: "Voxel Animation" padded to 16 bytes.
        bool magic = true;
        string want = "Voxel Animation";
        for (int i = 0; i < want.Length; i = i + 1) {
            if (r.ByteAt(i) != (want[i] & 0xFF)) { magic = false; break; }
        }
        if (!magic) { return img; }
        r.Skip(16);
        r.Skip(4);                          // unknown
        int limbCount = (int)r.ReadU32();
        r.Skip(4);                          // unknown
        int bodySize = (int)r.ReadU32();
        r.Skip(770);                        // embedded palette (superseded)
        int baseOfs = r.Position();         // 802 in a well-formed file

        if (limbCount <= 0 || limbCount > 64) { return img; }

        // Limb footers sit after the headers and the shared body. Read them
        // first so each limb's block offset is known, then decode the spans.
        List<int> blocks = new List<int>();
        List<int> spansOfs = new List<int>();
        List<int> sizes = new List<int>();
        for (int i = 0; i < limbCount; i = i + 1) {
            int footer = baseOfs + 28 * limbCount + bodySize + 92 * i;
            if (footer + 92 > length) { return img; }
            r.Seek(footer);
            blocks.Add((int)r.ReadU32());
            r.Skip(4);                      // second table offset (unused)
            spansOfs.Add((int)r.ReadU32());
            r.Skip(4);                      // scale: unused, render at own px/voxel
            r.Skip(72);                     // bounds + reserved
            int sx = r.ReadU8();
            int sy = r.ReadU8();
            int sz = r.ReadU8();
            int normalType = r.ReadU8();
            sizes.Add(sx | (sy << 8) | (sz << 16) | (normalType << 24));
        }

        for (int i = 0; i < limbCount; i = i + 1) {
            int sx = sizes[i] & 0xFF;
            int sy = (sizes[i] >> 8) & 0xFF;
            int sz = (sizes[i] >> 16) & 0xFF;
            int normalType = (sizes[i] >> 24) & 0xFF;
            if (sx <= 0 || sy <= 0 || sz <= 0) { continue; }
            int headerOfs = baseOfs + 28 * i;
            string name = VxlImage.ReadName(r, headerOfs);
            VxlLimb limb = VxlLimb.Create(name, sx, sy, sz, normalType);
            int block = baseOfs + 28 * limbCount + blocks[i];
            VxlImage.DecodeLimb(data, length, block, spansOfs[i], limb);
            img.limbs.Add(limb);
        }
        return img;
    }

    static string ReadName(BinaryReader r, int ofs) {
        byte[] buf = new byte[17];
        int n = 0;
        r.Seek(ofs);
        for (int i = 0; i < 16; i = i + 1) {
            int b = r.ReadU8();
            if (b <= 0) { break; }
            buf[n] = (byte)b;
            n = n + 1;
        }
        return buf.ToStr(0, n);
    }

    int LimbCount() { return this.limbs.Count; }

    VxlLimb LimbAt(int index) {
        if (index < 0 || index >= this.limbs.Count) { return null; }
        return this.limbs[index];
    }

    /// <summary>The first limb -- vehicle models carry exactly one; multi-limb
    /// models put the body first.</summary>
    VxlLimb Main() { return this.LimbAt(0); }

    /// <summary>Decodes a limb's span stream into its dense voxel grid. The
    /// offset table maps (x,y) to the column's span record, relative to the
    /// spans section; columns run spans of gap-then-run until their z cursor
    /// passes sizeZ.</summary>
    static void DecodeLimb(string data, int length, int block, int spansOfs,
                           VxlLimb limb) {
        int sx = limb.SizeX();
        int sy = limb.SizeY();
        int sz = limb.SizeZ();
        int columns = sx * sy;
        int spans = block + spansOfs;
        BinaryReader r = BinaryReader.FromBuffer(data, length);
        r.Seek(block);
        if (r.Position() + 4 * columns > length) { return; }
        for (int c = 0; c < columns; c = c + 1) {
            int ofs = r.ReadI32();
            if (ofs < 0) { continue; }
            int save = r.Position();
            r.Seek(spans + ofs);
            int x = c % sx;
            int y = c / sx;
            int z = 0;
            // A column runs spans until its z cursor passes sizeZ; each span
            // is gap(u8), count(u8), count voxels of color(u8)+normal(u8),
            // then a 1-byte terminator. A zero count is a no-op span, not
            // the end -- color 0 marks a transparent voxel and is dropped.
            while (z < sz) {
                int gap = r.ReadU8();
                int count = r.ReadU8();
                if (gap < 0 || count < 0) { break; }    // past end of file
                z = z + gap;
                for (int i = 0; i < count && z < sz; i = i + 1) {
                    int color = r.ReadU8();
                    r.Skip(1);              // normal index: unused
                    if (color != 0 && z >= 0) {
                        limb.SetVoxel(x, y, z, color);
                    }
                    z = z + 1;
                }
                r.Skip(1);                  // span terminator
            }
            r.Seek(save);
        }
    }
}
