using System;
using System.Collections.Generic;

namespace Ra2.Formats;

// A map (.MAP/.MPR) -- an INI file whose [Map] section frames the playable
// area and whose IsoMapPack5 section holds the terrain.
//
// [Map] Size is the full grid "0,0,w,h" while LocalSize is the visible window
// "x,y,w,h" inside it; the border between them is off-limits scenery.
//
// IsoMapPack5 cell coordinates are not bounded by the declared size. The map
// is a diamond rotated into cell space, so its bounding box runs to w+h on
// both axes -- a 40x80 map reaches (119,119). Sizing the grid by the declared
// width instead throws away every cell past it: on MP07T4 that silently
// dropped 3660 of 14340 records.
class MapFile {
    IniDocument doc;
    string theater;
    int width;
    int height;
    int localX;
    int localY;
    int localWidth;
    int localHeight;
    IsoMap terrain;
    // The overlay plane, as two byte arrays in diamond cell space. RA2 packs
    // them as Format5 chunk streams whose chunks carry Format80, and lays
    // them out on a fixed 512-wide canvas -- cell (x,y) lives at y*512+x
    // (verified against MP02T2 and MP07T4; a span-sized grid does not fit the
    // decoded data). OverlayPack holds the type index into the rules'
    // [OverlayTypes] list, 0xFF for empty; OverlayDataPack holds the data
    // byte -- the frame for walls, the ore amount for the GEM overlays. RA2's
    // ore lives entirely in the GEM overlays; there are no ORE_* types.
    int[] overlay;
    int[] overlayData;

    static MapFile Parse(string text) {
        MapFile m = new MapFile();
        m.doc = IniParser.Parse(text);
        m.theater = m.doc.GetOr("Map", "Theater", "TEMPERATE");

        List<int> size = MapFile.ParseCsv(m.doc.GetOr("Map", "Size", "0,0,0,0"));
        if (size.Count >= 4) {
            m.width = size[2];
            m.height = size[3];
        }
        List<int> local = MapFile.ParseCsv(m.doc.GetOr("Map", "LocalSize", "0,0,0,0"));
        if (local.Count >= 4) {
            m.localX = local[0];
            m.localY = local[1];
            m.localWidth = local[2];
            m.localHeight = local[3];
        }

        int span = m.width + m.height;
        string packed = MapPack.JoinSection(m.doc, "IsoMapPack5");
        if (packed.Length > 0) {
            List<int> len = new List<int>();
            len.Add(0);
            byte[] raw = MapPack.Decode(packed, len);
            m.terrain = IsoMap.Parse(raw, len[0], span, span);
        } else {
            m.terrain = IsoMap.Parse("", 0, span, span);
        }

        m.overlay = new int[512 * 512];
        m.overlayData = new int[512 * 512];
        for (int c = 0; c < 512 * 512; c = c + 1) {
            m.overlay[c] = -1;
            m.overlayData[c] = 0;
        }
        m.ParseOverlay("OverlayPack", "OverlayDataPack");
        return m;
    }

    /// <summary>Reads the overlay plane from the two packed sections.</summary>
    void ParseOverlay(string packName, string dataName) {
        this.ParseOverlayPack(packName, this.overlay, true);
        this.ParseOverlayPack(dataName, this.overlayData, false);
    }

    /// <summary>Decodes one packed overlay section into a plane. The type
    /// plane stores -1 for the 0xFF empty marker; the data plane keeps the
    /// raw byte, since 255 is a legitimate (fully rich) ore amount.</summary>
    void ParseOverlayPack(string packName, int[] plane, bool ffe) {
        string packed = MapPack.JoinSection(this.doc, packName);
        if (packed.Length == 0) { return; }
        List<int> b64Len = new List<int>();
        b64Len.Add(0);
        byte[] raw64 = Base64.Decode(packed, b64Len);
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = MapPack.DecodeChunks80(raw64, b64Len[0], len);
        int n = len[0];
        if (n > plane.Length) { n = plane.Length; }
        for (int c = 0; c < n; c = c + 1) {
            int v = raw[c] & 0xFF;
            plane[c] = ffe && v == 0xFF ? -1 : v;
        }
    }

    /// <summary>Splits a "a,b,c,d" value into integers, ignoring blanks.</summary>
    static List<int> ParseCsv(string s) {
        List<int> parts = new List<int>();
        int start = 0;
        for (int i = 0; i <= s.Length; i = i + 1) {
            if (i == s.Length || s.Substring(i, 1) == ",") {
                if (i > start) {
                    parts.Add(Convert.ToInt32(s.Substring(start, i - start).Trim()));
                }
                start = i + 1;
            }
        }
        return parts;
    }

    IniDocument Document() { return this.doc; }
    string Theater() { return this.theater; }
    int Width() { return this.width; }
    int Height() { return this.height; }
    int LocalX() { return this.localX; }
    int LocalY() { return this.localY; }
    int LocalWidth() { return this.localWidth; }
    int LocalHeight() { return this.localHeight; }
    IsoMap Terrain() { return this.terrain; }

    /// <summary>The overlay type index at a cell, or -1 when the cell is
    /// empty or outside the map. The index numbers the rules' [OverlayTypes]
    /// list from zero -- GEM01, the first ore overlay, is 27 in this
    /// install's rules.</summary>
    int OverlayAt(int x, int y) {
        return this.OverlayLookup(x, y, this.overlay);
    }

    /// <summary>The overlay's data byte: the wall's frame, or for the GEM
    /// overlays the amount of ore in the cell.</summary>
    int OverlayDataAt(int x, int y) {
        int v = this.OverlayLookup(x, y, this.overlayData);
        return v < 0 ? 0 : v;
    }

    int OverlayLookup(int x, int y, int[] plane) {
        int span = this.width + this.height;
        if (x < 0 || y < 0 || x >= span || y >= span) { return -1; }
        return plane[y * 512 + x];
    }

    string Name() { return this.doc.GetOr("Basic", "Name", ""); }

    /// <summary>The number of starting positions declared in [Waypoints].
    /// RA2 reserves waypoints 0-7 for player starts.</summary>
    int StartCount() {
        IniSection w = this.doc.Section("Waypoints");
        if (w == null) { return 0; }
        int n = 0;
        for (int i = 0; i < 8; i = i + 1) {
            if (w.Contains(Convert.ToString(i))) { n = n + 1; }
        }
        return n;
    }

    /// <summary>The cell of a starting position, written to slots 0 and 1 of
    /// outXy. Waypoint values are packed as y * 1000 + x.</summary>
    ///
    /// Fills a list the caller may have pre-sized or left empty. Out-parameter
    /// lists are spelled both ways in this code base -- Base64.Decode assigns
    /// to slot 0, this used to append -- and mixing the two reads back the
    /// caller's own seed values instead of the result, so both are accepted.
    bool StartCell(int index, List<int> outXy) {
        IniSection w = this.doc.Section("Waypoints");
        if (w == null) { return false; }
        string v = w.GetOr(Convert.ToString(index), "");
        if (v.Length == 0) { return false; }
        int packed = Convert.ToInt32(v);
        MapFile.SetSlot(outXy, 0, packed % 1000);
        MapFile.SetSlot(outXy, 1, packed / 1000);
        return true;
    }

    static void SetSlot(List<int> list, int slot, int v) {
        while (list.Count <= slot) { list.Add(0); }
        list[slot] = v;
    }

    /// <summary>How many pre-placed structures the map declares: the count of
    /// sequential numbered keys in [Structures].</summary>
    int StructureCount() {
        IniSection s = this.doc.Section("Structures");
        if (s == null) { return 0; }
        int n = 0;
        while (s.Contains(Convert.ToString(n))) { n = n + 1; }
        return n;
    }

    /// <summary>One [Structures] entry, split by comma into outFields:
    /// house, building reg, health (0-256), x, y (and an optional facing the
    /// caller may ignore). Returns false when the entry is missing or too
    /// short to place.</summary>
    bool StructureEntry(int index, List<string> outFields) {
        IniSection s = this.doc.Section("Structures");
        if (s == null) { return false; }
        string v = s.GetOr(Convert.ToString(index), "");
        if (v.Length == 0) { return false; }
        int start = 0;
        for (int i = 0; i <= v.Length; i = i + 1) {
            if (i == v.Length || v.Substring(i, 1) == ",") {
                if (i > start) {
                    outFields.Add(v.Substring(start, i - start).Trim());
                }
                start = i + 1;
            }
        }
        return outFields.Count >= 5;
    }
}
