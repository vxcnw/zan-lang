            "CANWY24.SHP", 2, 2, 800, 0, 0, 0, ArmorClass.Steel(), 4));
        r.civs.Add(BuildingDef.Create("GASPOT", "了望塔",
            "GASPOT.SHP", 1, 1, 400, 0, 0, 0, ArmorClass.Wood(), 4));

        // -- tech-tree aliases, the shipped [General] values ------------------
        r.preqPower = Rules.Csv("GAPOWR,NAPOWR,YAPOWR");
        r.preqFactory = Rules.Csv("GAWEAP,NAWEAP,YAWEAP");
        r.preqBarracks = Rules.Csv("NAHAND,GAPILE,YABRCK");
        r.preqRadar = Rules.Csv("GAAIRC,NARADR,NAPSIS");
        r.preqTech = Rules.Csv("GATECH,NATECH,YATECH");
        r.preqProc = Rules.Csv("GAREFN,NAREFN,YAREFN");

        // -- the AI's build lists, the shipped [AI] values --------------------
        r.aiConst = Rules.Csv("GACNST,NACNST,YACNST");
        r.aiPower = Rules.Csv("NAPOWR,GAPOWR,YAPOWR");
        r.aiRefinery = Rules.Csv("NAREFN,GAREFN,YAREFN");
        r.aiBarracks = Rules.Csv("NAHAND,GAPILE,YABRCK");
        r.aiWeapons = Rules.Csv("GAWEAP,NAWEAP,YAWEAP");
        r.aiTech = Rules.Csv("NATECH,GATECH,YATECH");
        r.aiRadar = Rules.Csv("GAAIRC,NARADR,NAPSIS");
        r.aiDefense = Rules.Csv("TESLA,NALASR,NAFLAK,GAPILL,YAGGUN");

        // -- economy -----------------------------------------------------------
        r.startMoney = 10000;
        r.oilIncome = 1;
        r.oilCapture = 1000;
        r.bombDamage = 400;
        r.bombDelay = 300;
        r.splashScale = 50;
        r.blackoutTicks = 300;
        r.freezeTicks = 90;
        // The shipped [General] sell/repair block: half the price back for a
        // sold building, a full repair costing 15% of it, 8 hp per repair
        // step. RepairRate=.016 minutes is one step a second at the 1:1
        // tick pacing the rest of the economy already runs on.
        r.refundPercent = 50;
        r.repairPercent = 15;
        r.repairStep = 8;
        r.repairRateTicks = 60;
        return r;
    }

    // ---- reading the player's RULES.INI --------------------------------------

    /// <summary>The ruleset for a real game: the transcribed defaults, then
    /// whatever the install's own RULES.INI still defines layered on top. A
    /// null or empty document leaves the defaults untouched, which keeps the
    /// tests -- and machines without an install -- on the exact shipped
    /// balance.</summary>
    static Rules Load(IniDocument ini) {
        Rules r = Rules.Default();
        if (ini == null || ini.Count() == 0) { return r; }
        r.ApplyIni(ini);
        return r;
    }

    /// <summary>Load with the install's string table alongside the rules, so
    /// sidebar labels read exactly what the original game showed.</summary>
    static Rules LoadWith(IniDocument ini, CsfTable strings) {
        Rules r = Rules.Default();
        r.strings = strings;
        if (ini == null || ini.Count() == 0) { return r; }
        r.ApplyIni(ini);
        return r;
    }

    /// <summary>The extension an Image= override keeps: a voxel unit stays
    /// voxel, a shape unit stays shape, so [APOC] Image=HTNK under a voxel
    /// default resolves to HTNK.VXL while infantry resolve to .SHP.</summary>
    static string ArtExtension(string shp) {
        if (shp == null) { return ".SHP"; }
        int dot = shp.Length - 4;
        if (dot < 0) { return ".SHP"; }
        bool vxl = true;
        string want = ".VXL";
        for (int i = 0; i < 4; i = i + 1) {
            if ((shp[dot + i] & 0xDF) != (want[i] & 0xDF)) { vxl = false; break; }
        }
        return vxl ? ".VXL" : ".SHP";
    }

    void ApplyIni(IniDocument ini) {
        // Warheads first: weapons relink against them below.
        for (int i = 0; i < this.warheads.Count; i = i + 1) {
            Warhead w = this.warheads[i];
            IniSection s = ini.Section(w.Name());
            if (s == null) { continue; }
            string verses = s.Get("Verses");
            if (verses.Length > 0) {
                List<int> v = Rules.ParsePercents(verses);
                for (int a = 0; a < v.Count && a < ArmorClass.Count();
                     a = a + 1) {
                    w.SetVerse(a, v[a]);
                }
            }
            if (s.Contains("CellSpread")) {
                w.SetSpread(s.GetIntOr("CellSpread", w.Spread()));
            }
        }
        for (int i = 0; i < this.weapons.Count; i = i + 1) {
            Weapon w = this.weapons[i];
            IniSection s = ini.Section(w.Name());
            if (s == null) { continue; }
            if (s.Contains("Damage")) { w.SetDamage(s.GetIntOr("Damage", w.Damage())); }
            if (s.Contains("ROF")) { w.SetRof(s.GetIntOr("ROF", w.Rof())); }
            string range = s.Get("Range");
            if (range.Length > 0) { w.SetRange(Rules.ParseRange(range)); }
            string wh = s.Get("Warhead");
            if (wh.Length > 0 && this.WarheadNamed(wh) != null) {
                w.SetWarhead(this.WarheadNamed(wh));
            }
        }
        for (int i = 0; i < this.units.Count; i = i + 1) {
            UnitDef d = this.units[i];
            IniSection s = ini.Section(d.Reg());
            if (s == null) { continue; }
            if (s.Contains("Cost")) { d.SetCost(s.GetIntOr("Cost", d.Cost())); }
            if (s.Contains("Strength")) { d.SetHp(s.GetIntOr("Strength", d.Hp())); }
            if (s.Contains("Speed")) { d.SetSpeed(s.GetIntOr("Speed", d.Speed())); }
            string armor = s.Get("Armor");
            if (armor.Length > 0) { d.SetArmor(ArmorClass.Parse(armor)); }
            string image = s.Get("Image");
            if (image.Length > 0) {
                d.SetShp(image + Rules.ArtExtension(d.Shp()));
                d.SetArtKey(image.ToUpper());
            } else {
                d.SetArtKey(d.Reg());
            }
            string nt = s.Get("NewTheater");
            if (nt.Length > 0 && Rules.YesNo(nt)) { d.SetNewTheater(true); }
            string primary = s.Get("Primary");
            if (primary.Length > 0 && this.WeaponNamed(primary) != null) {
                d.SetPrimary(this.WeaponNamed(primary));
            }
            string secondary = s.Get("Secondary");
            if (secondary.Length > 0 && this.WeaponNamed(secondary) != null) {
                d.SetSecondary(this.WeaponNamed(secondary));
            }
        }
        for (int i = 0; i < this.buildings.Count; i = i + 1) {
            BuildingDef d = this.buildings[i];
            IniSection s = ini.Section(d.Reg());
            if (s == null) { continue; }
            if (s.Contains("Cost")) { d.SetCost(s.GetIntOr("Cost", d.Cost())); }
            if (s.Contains("Strength")) { d.SetHp(s.GetIntOr("Strength", d.Hp())); }
            if (s.Contains("Power")) { d.SetPower(s.GetIntOr("Power", d.Power())); }
            if (s.Contains("Drain")) { d.SetDrain(s.GetIntOr("Drain", d.Drain())); }
            string image = s.Get("Image");
            if (image.Length > 0) {
                d.SetShp(image + Rules.ArtExtension(d.Shp()));
                d.SetArtKey(image.ToUpper());
            }
            string ntB = s.Get("NewTheater");
            if (ntB.Length > 0 && Rules.YesNo(ntB)) { d.SetNewTheater(true); }
        }
        IniSection general = ini.Section("General");
        if (general != null) {
            this.oreGrows = Rules.YesNo(general.GetOr("TiberiumGrows", "yes"));
            this.oreSpreads = Rules.YesNo(general.GetOr("TiberiumSpreads",
                                                        "yes"));
            this.growthRate = Rules.LeadingInt(general.GetOr("GrowthRate",
                                                             "5"));
            this.preqPower = Rules.CsvOr(general, "PrerequisitePower",
                                         this.preqPower);
            this.preqFactory = Rules.CsvOr(general, "PrerequisiteFactory",
                                           this.preqFactory);
            this.preqBarracks = Rules.CsvOr(general, "PrerequisiteBarracks",
                                            this.preqBarracks);
            this.preqRadar = Rules.CsvOr(general, "PrerequisiteRadar",
                                         this.preqRadar);
            this.preqTech = Rules.CsvOr(general, "PrerequisiteTech",
                                        this.preqTech);
            this.preqProc = Rules.CsvOr(general, "PrerequisiteProc",
                                        this.preqProc);
            this.refundPercent = Rules.LeadingInt(general.GetOr(
                "RefundPercent", Convert.ToString(this.refundPercent)));
            this.repairPercent = Rules.LeadingInt(general.GetOr(
                "RepairPercent", Convert.ToString(this.repairPercent)));
            this.repairStep = Rules.LeadingInt(general.GetOr(
                "RepairStep", Convert.ToString(this.repairStep)));
        }
        IniSection ai = ini.Section("AI");
        if (ai != null) {
            this.aiConst = Rules.CsvOr(ai, "BuildConst", this.aiConst);
            this.aiPower = Rules.CsvOr(ai, "BuildPower", this.aiPower);
            this.aiRefinery = Rules.CsvOr(ai, "BuildRefinery", this.aiRefinery);
            this.aiBarracks = Rules.CsvOr(ai, "BuildBarracks", this.aiBarracks);
            this.aiWeapons = Rules.CsvOr(ai, "BuildWeapons", this.aiWeapons);
            this.aiTech = Rules.CsvOr(ai, "BuildTech", this.aiTech);
            this.aiRadar = Rules.CsvOr(ai, "BuildRadar", this.aiRadar);
            this.aiDefense = Rules.CsvOr(ai, "BuildDefense", this.aiDefense);
        }
        // The overlay type table: keys 1..n map to indices 0..n-1, exactly
        // how the map's OverlayPack bytes index it (GEM01 is key 28,
        // therefore byte value 27, in this install's rules).
        IniSection ov = ini.Section("OverlayTypes");
        if (ov != null) {
            this.overlayTypes = new List<string>();
            for (int i = 0; i < ov.Count(); i = i + 1) {
                string name = ov.EntryAt(i).Value().Trim();
                int semi = -1;
                for (int c = 0; c < name.Length; c = c + 1) {
                    if (name[c] == 59) { semi = c; break; }
                }
                if (semi >= 0) { name = name.Substring(0, semi).Trim(); }
                this.overlayTypes.Add(name);
            }
        }
        // Sidebar names come from the install's own string table, the same
        // labels the original menu showed: each unit/building's UIName points
        // at a CSF label (Name:E1 -> 美国大兵). Only overrides; anything the
        // table lacks keeps the transcribed default.
        if (this.strings != null) {
            for (int i = 0; i < this.units.Count; i = i + 1) {
                UnitDef d = this.units[i];
                IniSection s = ini.Section(d.Reg());
                if (s == null) { continue; }
                string ui = s.Get("UIName");
                if (ui.Length == 0) { continue; }
                string text = this.strings.Lookup(ui);
                if (text != null && text.Length > 0) { d.SetLabel(text); }
            }
            for (int i = 0; i < this.buildings.Count; i = i + 1) {
                BuildingDef d = this.buildings[i];
                IniSection s = ini.Section(d.Reg());
                if (s == null) { continue; }
                string ui = s.Get("UIName");
                if (ui.Length == 0) { continue; }
                string text = this.strings.Lookup(ui);
                if (text != null && text.Length > 0) { d.SetLabel(text); }
            }
        }
    }

    /// <summary>Applies the art ini (ART.INI with ARTMD.INI layered on top):
    /// each infantry's Sequence= section tells where its walk and stand
    /// frames start, and the walk cycle's length -- e.g. [GI]
    /// Sequence=GISequence, [GISequence] Walk=8,6,6 Ready=0,1,1. Without
    /// this, every trooper would march through the wrong frames. Buildings
    /// flagged NewTheater=yes ship one sprite per theater, addressed by the
    /// file name's second letter (GAtcnst for temperate); the renderer swaps
    /// that letter against the loaded map's theater.</summary>
    void ApplyArtIni(IniDocument art) {
        if (art == null) { return; }
        for (int i = 0; i < this.buildings.Count; i = i + 1) {
            BuildingDef d = this.buildings[i];
            if (d.ArtKey() == null) { continue; }
            IniSection section = art.Section(d.ArtKey());
            if (section == null) { continue; }
            string nt = section.Get("NewTheater");
            if (nt.Length > 0 && Rules.YesNo(nt)) { d.SetNewTheater(true); }
        }
        for (int i = 0; i < this.units.Count; i = i + 1) {
            UnitDef d = this.units[i];
            if (d.ArtKey() == null) { continue; }
            IniSection section = art.Section(d.ArtKey());
            if (section == null) { continue; }
            string nt = section.Get("NewTheater");
            if (nt.Length > 0 && Rules.YesNo(nt)) { d.SetNewTheater(true); }
            string seqName = section.Get("Sequence");
            if (seqName.Length == 0) { continue; }
            IniSection seq = art.Section(seqName);
            if (seq == null) { continue; }
            List<int> ready = Rules.LeadingInts(seq.Get("Ready"));
            if (ready.Count >= 1) { d.SetReadySeq(ready[0]); }
            List<int> walk = Rules.LeadingInts(seq.Get("Walk"));
            if (walk.Count >= 2) { d.SetWalkSeq(walk[0], walk[1]); }
        }
    }

    /// <summary>Leading comma-separated integers of "8,6,6" into [8,6];
    /// stops at the first token that starts with a non-number. Empty input
    /// yields an empty list.</summary>
    static List<int> LeadingInts(string s) {
        List<int> vals = new List<int>();
        if (s == null) { return vals; }
        List<string> parts = Rules.Csv(s);
        for (int i = 0; i < parts.Count; i = i + 1) {
            string part = parts[i];
            if (part.Length == 0 || part[0] < 48 || part[0] > 57) { break; }
            vals.Add(Rules.LeadingInt(part));
        }
        return vals;
    }

    // ---- small string helpers ------------------------------------------------

    /// <summary>"a,b, c" into ["a","b","c"], dropping blanks.</summary>
    static List<string> Csv(string s) {
        List<string> parts = new List<string>();
        int start = 0;
        for (int i = 0; i <= s.Length; i = i + 1) {
            if (i == s.Length || s.Substring(i, 1) == ",") {
                if (i > start) {
                    string part = s.Substring(start, i - start).Trim();
                    if (part.Length > 0) { parts.Add(part); }
                }
                start = i + 1;
            }
        }
        return parts;
    }

    static List<string> CsvOr(IniSection s, string key, List<string> fallback) {
        string raw = s.Get(key);
        if (raw.Length == 0) { return fallback; }
        return Rules.Csv(raw);
    }

    /// <summary>"100%,80%,..." into [100,80,...]; a bare number works too.</summary>
    static List<int> ParsePercents(string s) {
        List<int> parts = new List<int>();
        int start = 0;
        for (int i = 0; i <= s.Length; i = i + 1) {
            if (i == s.Length || s.Substring(i, 1) == ",") {
                if (i > start) {
                    string part = s.Substring(start, i - start).Trim();
                    if (part.Length > 0) {
                        if (part.Substring(part.Length - 1, 1) == "%") {
                            part = part.Substring(0, part.Length - 1);
                        }
                        parts.Add(Convert.ToInt32(part));
                    }
                }
                start = i + 1;
            }
        }
        return parts;
    }

    /// <summary>RA2 ranges are fractional ("5.5"); the grid wants whole
    /// cells, rounded up so a gunner keeps his published reach.</summary>
    static int ParseRange(string s) {
        string t = s.Trim();
        int dot = -1;
        for (int i = 0; i < t.Length; i = i + 1) {
            if (t.Substring(i, 1) == ".") { dot = i; break; }
        }
        if (dot < 0) { return Convert.ToInt32(t); }
        int whole = Convert.ToInt32(t.Substring(0, dot));
        string frac = t.Substring(dot + 1, t.Length - dot - 1).Trim();
        if (frac.Length > 0 && frac != "0") { whole = whole + 1; }
        return whole;
    }
}
