        r.civs.Add(oil);
        r.civs.Add(BuildingDef.Create("CAHOSP", "医院",
            "CAHOSP.SHP", 2, 2, 800, 0, 0, 0, ArmorClass.Concrete(), 4));
        r.civs.Add(BuildingDef.Create("CABHUT", "小木屋",
            "CABHUT.SHP", 1, 1, 2000, 0, 0, 0, ArmorClass.Wood(), 4));
