using System;
using System.Collections.Generic;
using SDL3;
using Game.Kit;
using Ra2.Assets;
using Ra2.Formats;
using Ra2.Game;

namespace Ra2.Ui;

/// <summary>The game's own shell art, loaded from the player's install.</summary>
///
/// RA2 ships its menu backdrops as PCX, so the shell shows the real artwork
/// rather than something drawn here. When a piece is missing -- installs vary,
/// and only the base archives are required -- the screen falls back to a plain
/// panel instead of failing to open.
class ShellArt {
    SdlTexture title;
    SdlTexture logo;
    SdlTexture load;
    bool loaded;

    static ShellArt Load(SdlRenderer r, Vfs vfs) {
        ShellArt a = new ShellArt();
        a.loaded = false;
        a.title = ShellArt.LoadPcx(r, vfs, "TITLE.PCX");
        a.logo = ShellArt.LoadPcx(r, vfs, "LOGO.PCX");
        a.load = ShellArt.LoadPcx(r, vfs, "LOAD.PCX");
        if (a.title != null || a.logo != null || a.load != null) {
            a.loaded = true;
        }
        return a;
    }

    /// <summary>Decodes a PCX from the archives into a GPU texture, or null
    /// when the install does not carry it.</summary>
    static SdlTexture LoadPcx(SdlRenderer r, Vfs vfs, string name) {
        if (!vfs.Contains(name)) { return null; }
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = vfs.Read(name, len);
        if (len[0] == 0) { return null; }
        PcxImage img = PcxImage.Parse(raw, len[0]);
        if (!img.IsValid() || !img.HasPalette()) { return null; }

        Texture rgba = Texture.FromPcx(img);
        SdlTexture tex = SdlTexture.CreateRgba32(r, rgba.Width(), rgba.Height(), true);
        tex.Update(rgba.Pixels(), rgba.Width() * 4);
        rgba.Close();
        img.Close();
        return tex;
    }

    SdlTexture Title() { return this.title; }
    SdlTexture Logo() { return this.logo; }
    SdlTexture Load() { return this.load; }
    bool HasTitle() { return this.title != null; }
    bool HasLogo() { return this.logo != null; }
    bool HasLoad() { return this.load != null; }

    void Close() {
        if (this.title != null) { this.title.Close(); }
        if (this.logo != null) { this.logo.Close(); }
        if (this.load != null) { this.load.Close(); }
        this.title = null;
        this.logo = null;
        this.load = null;
    }
}

/// <summary>Draws the shell screens: main menu and skirmish setup.</summary>
///
/// The screens read a Shell and call its transitions; they hold no state of
/// their own beyond hit-test rectangles, so the flow stays testable without a
/// window. Every label comes from the install's CSF table when one is
/// mounted -- the exact strings the original menu showed (遭遇战, 選項,
/// 退出遊戲) -- falling back to the transcribed text without one.
class Strings {
    CsfTable table;

    static Strings Load(Vfs vfs) {
        Strings s = new Strings();
        s.table = null;
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = vfs.Read("RA2MD.CSF", len);
        if (len[0] == 0) {
            raw = vfs.Read("RA2.CSF", len);
        }
        if (len[0] > 0) { s.table = CsfTable.Parse(raw, len[0]); }
        return s;
    }

    /// <summary>The CSF text for <paramref name="label"/>, or the fallback
    /// when the table is missing or the label absent.</summary>
    string Or(string label, string fallback) {
        if (this.table == null) { return fallback; }
        string v = this.table.Lookup(label);
        if (v == null || v.Length == 0) { return fallback; }
        return v;
    }

    bool Loaded() { return this.table != null; }

    void Close() { this.table = null; }
}

class Screens {
    static int PanelW() { return 420; }

    /// <summary>Main menu over the game's own title art. Returns the action
    /// the click landed on: 0 none, 1 skirmish, 2 quit.</summary>
    ///
    /// The original menu runs its intro video behind a left-anchored seven
    /// button strip (遭遇戰/單人遊戲/網際網路/網路/選項/社群/退出遊戲,
    /// read from the install's CSF). The install carries no VQP decoder, so
    /// the backdrop is the shipped LOGO.PCX -- the box-art war scene the
    /// shell also used for static moments -- letterboxed 640x480 just as the
    /// game drew it, button strip down the left like the real one.
    static int DrawMainMenu(SdlRenderer r, ShellArt art, Strings ui,
                            int viewW, int viewH,
                            int mouseX, int mouseY, bool clicked) {
        SdlTexture backdrop = art != null && art.HasLogo() ? art.Logo()
                            : art != null && art.HasTitle() ? art.Title() : null;
        if (backdrop != null) {
            // 4:3 centred, the aspect the original art was drawn for; the
            // bars either side take the widescreen slack.
            int bh = viewH;
            int bw = bh * 4 / 3;
            if (bw > viewW) { bw = viewW; bh = bw * 3 / 4; }
            r.DrawTexture(backdrop, (viewW - bw) / 2, 0, bw, bh);
            // A vertical darkening behind the buttons so the gold text
            // keeps its contrast over the bright sky part of the scene,
            // the way the video's left side fell dark behind them.
            int stripX = (viewW - bw) / 2;
            Draw.RoundRectFill(r, stripX, 0, bw / 2 + 40, viewH, 0,
                               12, 12, 14, 110);
        } else {
            KitUi.Backdrop(r, null, viewW, viewH);
        }

        // The original menu's seven buttons, top to bottom, with the CSF
        // labels the install ships: 遭遇戰, 單人遊戲, 網際網路, 網路,
        // 選項, 社群, 退出遊戲.
        string skirmishLabel = ui.Or("GUI:Skirmish", "遭遇战");
        string singleLabel = ui.Or("GUI:SinglePlayerMenu", "单人游戏");
        string internetLabel = ui.Or("GUI:Internet", "网际网络");
        string networkLabel = ui.Or("GUI:Network", "网络游戏");
        string optionsLabel = ui.Or("GUI:Options", "选项");
        string communityLabel = ui.Or("GUI:YuriWebsite", "社群");
        string exitLabel = ui.Or("GUI:ExitGame", "退出游戏");

        // The strip hugs the left edge of the 4:3 frame, buttons stacked
        // tight like the shipped menu's -- narrower and shorter than the
        // old slab buttons, all seven rows of them.
        int bw = 250;
        int bh = 52;
        int gap = 14;
        int totalH = 7 * bh + 6 * gap;
        int bx = 36;
        int by = (viewH - totalH) / 2;

        // Skirmish is the one implemented mode. The rest are drawn disabled
        // rather than hidden so the menu reads like the real one and the gap
        // is honest.
        int action = 0;
        bool hovSkirmish = Ra2UiButton(r, mouseX, mouseY, bx, by, bw, bh,
                                       skirmishLabel, true);
        if (hovSkirmish && clicked) { action = 1; }

        Screens.DisabledButton(r, bx, by + (bh + gap), bw, bh, singleLabel);
        Screens.DisabledButton(r, bx, by + (bh + gap) * 2, bw, bh,
                               internetLabel);
        Screens.DisabledButton(r, bx, by + (bh + gap) * 3, bw, bh,
                               networkLabel);
        Screens.DisabledButton(r, bx, by + (bh + gap) * 4, bw, bh,
                               optionsLabel);
        Screens.DisabledButton(r, bx, by + (bh + gap) * 5, bw, bh,
                               communityLabel);

        bool hovQuit = Ra2UiButton(r, mouseX, mouseY, bx,
                                   by + (bh + gap) * 6, bw, bh,
                                   exitLabel, false);
        if (hovQuit && clicked) { action = 2; }

        Text.Draw(r, "Esc 退出  F11 全屏", 20, viewH - 34, 2, 150, 158, 172,
                  255);
        return action;
    }

    /// <summary>The Red Alert style menu button: a dark metal slab with a red
    /// warning stripe across the top, gold text, and a highlight on hover.
    /// Returns true when hovered.</summary>
    static bool Ra2UiButton(SdlRenderer r, int mx, int my, int x, int y, int w,
                            int h, string label, bool accent) {
        bool hov = Draw.PointIn(mx, my, x, y, w, h);
        // Body.
        int bodyR = 40;
        int bodyG = 44;
        int bodyB = 52;
        if (hov) { bodyR = 56; bodyG = 62; bodyB = 74; }
        Draw.RoundRectFill(r, x - 2, y - 2, w + 4, h + 4, 6, 10, 12, 16, 255);
        Draw.RoundRectFill(r, x, y, w, h, 4, bodyR, bodyG, bodyB, 255);
        // Red warning stripe across the top.
        r.SetColor(178, 24, 24, 255);
        r.FillRect(x + 2, y + 2, w - 4, 5);
        // Bottom bevel.
        r.SetColor(20, 22, 28, 255);
        r.FillRect(x + 2, y + h - 6, w - 4, 4);
        if (hov) {
            r.SetColor(120, 220, 160, 60);
            r.FillRect(x, y, w, h);
        }
        int tc = 224;
        if (accent) { tc = 236; }
        Text.DrawCenteredShadow(r, label, x + w / 2, y + h / 2 - 12, 3, tc, tc, tc, 2);
        return hov;
    }

    /// <summary>A button that reads as present but unavailable.</summary>
    static void DisabledButton(SdlRenderer r, int x, int y, int w, int h,
                               string label) {
        Draw.RoundRectFill(r, x - 2, y - 2, w + 4, h + 4, 14, 8, 10, 16, 200);
        Draw.RoundRectFill(r, x, y, w, h, 12, 40, 44, 54, 255);
        Text.DrawCentered(r, label, x + w / 2, y + h / 2 - 12, 3,
                          110, 116, 130, 255);
    }

    /// <summary>Skirmish setup: map list on the left, side pick and a preview
    /// of the selected map on the right. Returns 0 none, 1 start, 2 back.</summary>
    static int DrawSkirmish(SdlRenderer r, Shell shell, List<string> maps,
                            SdlTexture preview, Strings ui, int viewW,
                            int viewH, int mouseX, int mouseY, bool clicked) {
        KitUi.Backdrop(r, null, viewW, viewH);
        Text.DrawShadow(r, ui.Or("GUI:Skirmish", "遭遇战"), 40, 40, 4,
                        236, 208, 120, 3);

        int listX = 40;
        int listY = 120;
        int listW = 560;
        int rowH = 42;
        // The list shows a window of rows around the selection so a long map
        // list does not run off the bottom of the screen.
        int rows = (viewH - listY - 130) / rowH;
        KitUi.Panel(r, listX - 12, listY - 14, listW + 24, rows * rowH + 28,
                 22, 26, 36, 210);

        int first = shell.MapIndex() - rows / 2;
        if (first > shell.MapCount() - rows) { first = shell.MapCount() - rows; }
        if (first < 0) { first = 0; }

        for (int i = 0; i < rows && first + i < maps.Count; i = i + 1) {
            int idx = first + i;
            int ry = listY + i * rowH;
            bool sel = idx == shell.MapIndex();
            bool hov = Draw.PointIn(mouseX, mouseY, listX, ry, listW, rowH - 4);
            if (sel) {
                Draw.RoundRectFill(r, listX, ry, listW, rowH - 4, 8,
                                   224, 176, 66, 235);
            } else if (hov) {
                Draw.RoundRectFill(r, listX, ry, listW, rowH - 4, 8,
                                   62, 70, 88, 200);
            }
            int tc = 224;
            if (sel) { tc = 32; }
            Text.Draw(r, maps[idx], listX + 16, ry + 9, 2, tc, tc, tc, 255);
            if (hov && clicked) { shell.SelectMapAt(idx); }
        }

        // Side picker: Allies, Soviets, Yuri. The first two names come from
        // the CSF's Name:Allies / Name:Soviets -- the exact words the
        // original skirmish screen used; Name:YuriCountry covers Yuri.
        int sideX = viewW - 460;
        KitUi.Panel(r, sideX - 12, listY - 14, 420, 200, 22, 26, 36, 210);
        Text.Draw(r, ui.Or("GUI:Side", "阵营"), sideX + 8, listY, 3,
                  236, 208, 120, 255);
        int sw = 120;
        int sh = 62;
        int sy = listY + 60;
        int alliedKind = 0;
        int sovietKind = 0;
        int yuriKind = 0;
        if (shell.SideIndex() == Side.Allied()) { alliedKind = 2; }
        else if (shell.SideIndex() == Side.Soviet()) { sovietKind = 2; }
        else { yuriKind = 2; }
        bool hovA = KitUi.Button(r, mouseX, mouseY, sideX + 8, sy, sw, sh,
                              ui.Or("Name:Allies", "盟军"), 3, alliedKind);
        bool hovS = KitUi.Button(r, mouseX, mouseY, sideX + 8 + sw + 10, sy,
                              sw, sh, ui.Or("Name:Soviets", "苏联"), 3,
                              sovietKind);
        bool hovY = KitUi.Button(r, mouseX, mouseY, sideX + 8 + (sw + 10) * 2,
                              sy, sw, sh, ui.Or("Name:YuriCountry", "尤里"),
                              3, yuriKind);
        if (clicked) {
            if (hovA) { shell.SetSide(Side.Allied()); }
            if (hovS) { shell.SetSide(Side.Soviet()); }
            if (hovY) { shell.SetSide(Side.Yuri()); }
        }

        // Map preview, rendered from the selected map's own terrain by the
        // caller and handed in as a texture; null while it is still loading or
        // when the map failed to open.
        int pvY = listY + 220;
        int pvW = 396;
        int pvH = 220;
        KitUi.Panel(r, sideX - 12, pvY, pvW + 24, pvH + 40, 22, 26, 36, 210);
        Text.Draw(r, "预览", sideX + 8, pvY + 10, 2, 236, 208, 120, 255);
        if (preview != null) {
            r.DrawTexture(preview, sideX + 8, pvY + 38, pvW, pvH - 8);
        } else {
            Text.DrawCentered(r, "载入中…", sideX + 8 + pvW / 2, pvY + 120, 2,
                              120, 128, 142, 255);
        }

        // Actions.
        int bw = 200;
        int bh = 62;
        int by = viewH - 100;
        int action = 0;
        bool hovBack = KitUi.Button(r, mouseX, mouseY, 40, by, bw, bh,
            ui.Or("GUI:Back", "返回"), 3, 0);
        bool hovGo = KitUi.Button(r, mouseX, mouseY, viewW - 40 - bw, by, bw, bh,
                               ui.Or("GUI:StartGame", "开始"), 3, 1);
        if (clicked) {
            if (hovBack) { action = 2; }
            if (hovGo) { action = 1; }
        }

        Text.Draw(r, "上下键选择地图  Enter 开始  Esc 返回",
                  40, viewH - 148, 2, 150, 158, 172, 255);
        return action;
    }

    /// <summary>The in-game overlay: which map is loaded and the controls.
    /// The sidebar, minimap and build menu are not implemented yet, so this
    /// deliberately shows only what exists.</summary>
    static void DrawHud(SdlRenderer r, string mapName, string sideName,
                        int cells, int drawn, int viewW, int viewH) {
        KitUi.Panel(r, 12, 12, 520, 76, 18, 22, 32, 190);
        Text.Draw(r, mapName + "   " + sideName, 28, 24, 2, 236, 208, 120, 255);
        Text.Draw(r, "单元 " + Convert.ToString(cells)
                  + "   本帧绘制 " + Convert.ToString(drawn),
                  28, 54, 2, 170, 178, 192, 255);

        Text.Draw(r, "方向键平移  +/- 缩放  Esc 返回",
                  12, viewH - 34, 2, 150, 158, 172, 255);
    }
}
