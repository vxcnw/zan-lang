using System;
using System.Collections.Generic;
using SDL3;
using Game.Kit;
using Ra2.Assets;
using Ra2.Formats;
using Ra2.Game;

namespace Ra2.Ui;

/// <summary>The game's own shell art, loaded from the player's install.</summary>
///
/// RA2 keeps its shell chrome in LOCAL.MIX: TITLE.PCX is the menu backdrop
/// the exe falls back to, MNBTTN.SHP + MAINBTTN.PAL are the real menu button
/// plates (red at rest, orange on hover, yellow while clicked), and
/// DBAK6440.PCX is the standard dialog backdrop behind every shell screen.
/// When a piece is missing -- installs vary -- the screens fall back to drawn
/// panels instead of failing to open.
class ShellArt {
    SdlTexture title;
    SdlTexture load;
    SdlTexture[] btns;    // menu button plates, indexed by state
    SdlTexture dialog;
    bool loaded;

    static ShellArt Load(SdlRenderer r, Vfs vfs) {
        ShellArt a = new ShellArt();
        a.loaded = false;
        a.title = ShellArt.LoadPcx(r, vfs, "TITLE.PCX");
        a.load = ShellArt.LoadPcx(r, vfs, "LOAD.PCX");
        a.dialog = ShellArt.LoadPcx(r, vfs, "DBAK6440.PCX");
        a.btns = ShellArt.LoadButtons(r, vfs);
        if (a.title != null || a.load != null || a.dialog != null
         || a.btns != null) {
            a.loaded = true;
        }
        return a;
    }

    /// <summary>Decodes a PCX from the archives into a GPU texture, or null
    /// when the install does not carry it.</summary>
    static SdlTexture LoadPcx(SdlRenderer r, Vfs vfs, string name) {
        if (!vfs.Contains(name)) { return null; }
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = vfs.Read(name, len);
        if (len[0] == 0) { return null; }
        PcxImage img = PcxImage.Parse(raw, len[0]);
        if (!img.IsValid() || !img.HasPalette()) { return null; }

        Texture rgba = Texture.FromPcx(img);
        SdlTexture tex = SdlTexture.CreateRgba32(r, rgba.Width(), rgba.Height(), true);
        tex.Update(rgba.Pixels(), rgba.Width() * 4);
        rgba.Close();
        img.Close();
        return tex;
    }

    /// <summary>MNBTTN.SHP's three 126x25 frames over MAINBTTN.PAL -- the
    /// exact plates the original menu drew its buttons from. Frame order is
    /// the state order the game cycles through: rest, hover, pressed.</summary>
    static SdlTexture[] LoadButtons(SdlRenderer r, Vfs vfs) {
        if (!vfs.Contains("MNBTTN.SHP") || !vfs.Contains("MAINBTTN.PAL")) {
            return null;
        }
        List<int> plen = new List<int>();
        plen.Add(0);
        byte[] praw = vfs.Read("MAINBTTN.PAL", plen);
        if (plen[0] < 768) { return null; }
        Palette pal = Palette.Parse(praw, plen[0]);

        List<int> slen = new List<int>();
        slen.Add(0);
        byte[] sraw = vfs.Read("MNBTTN.SHP", slen);
        if (slen[0] == 0) { return null; }
        ShpImage shp = ShpImage.Parse(sraw, slen[0]);
        if (shp.FrameCount() < 3) { return null; }

        SdlTexture[] outTex = new SdlTexture[3];
        for (int i = 0; i < 3; i = i + 1) {
            ShpFrame f = shp.FrameAt(i);
            if (f == null || f.IsEmpty()) { continue; }
            byte[] idx = shp.DecodeFrame(i);
            Texture tex = Texture.FromIndexed(idx, f.Width(), f.Height(), pal);
            SdlTexture st = SdlTexture.CreateRgba32(r, tex.Width(),
                tex.Height(), true);
            st.Update(tex.Pixels(), tex.Width() * 4);
            tex.Close();
            outTex[i] = st;
        }
        return outTex;
    }

    SdlTexture Title() { return this.title; }
    SdlTexture Load() { return this.load; }
    SdlTexture Dialog() { return this.dialog; }
    bool HasTitle() { return this.title != null; }
    bool HasLoad() { return this.load != null; }
    bool HasDialog() { return this.dialog != null; }
    bool Loaded() { return this.loaded; }

    /// <summary>The button plate for a state (0 rest, 1 hover, 2 pressed),
    /// or null when the install did not carry the plates.</summary>
    SdlTexture Btn(int state) {
        if (this.btns == null || state < 0 || state > 2) { return null; }
        return this.btns[state];
    }
    bool HasBtns() { return this.btns != null && this.btns[0] != null; }

    void Close() {
        if (this.title != null) { this.title.Close(); }
        if (this.load != null) { this.load.Close(); }
        if (this.dialog != null) { this.dialog.Close(); }
        if (this.btns != null) {
            for (int i = 0; i < 3; i = i + 1) {
                if (this.btns[i] != null) { this.btns[i].Close(); }
            }
        }
        this.title = null;
        this.load = null;
        this.dialog = null;
        this.btns = null;
    }
}

/// <summary>Draws the shell screens: main menu and skirmish setup.</summary>
///
/// The screens read a Shell and call its transitions; they hold no state of
/// their own beyond hit-test rectangles, so the flow stays testable without a
/// window. Every label comes from the install's CSF table when one is
/// mounted -- the exact strings the original menu showed (遭遇战, 選項,
/// 退出遊戲) -- falling back to the transcribed text without one.
class Strings {
    CsfTable table;

    static Strings Load(Vfs vfs) {
        Strings s = new Strings();
        s.table = null;
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = vfs.Read("RA2MD.CSF", len);
        if (len[0] == 0) {
            raw = vfs.Read("RA2.CSF", len);
        }
        if (len[0] > 0) { s.table = CsfTable.Parse(raw, len[0]); }
        return s;
    }

    /// <summary>The CSF text for <paramref name="label"/>, or the fallback
    /// when the table is missing or the label absent.</summary>
    string Or(string label, string fallback) {
        if (this.table == null) { return fallback; }
        string v = this.table.Lookup(label);
        if (v == null || v.Length == 0) { return fallback; }
        return v;
    }

    bool Loaded() { return this.table != null; }

    void Close() { this.table = null; }
}

class Screens {
    /// <summary>Main menu over the game's own title chrome. Returns the
    /// action the click landed on: 0 none, 1 skirmish, 2 quit.</summary>
    ///
    /// The original menu runs its intro video behind a left-anchored seven
    /// button strip (遭遇戰/單人遊戲/網際網路/網路/選項/社群/退出遊戲,
    /// read from the install's CSF). The static fallback the exe itself uses
    /// is TITLE.PCX -- black field on the left for the buttons, raised
    /// panels on the right where the video windows sat -- with the buttons
    /// drawn from MNBTTN.SHP's own plates at the original 126x25 design size.
    static int DrawMainMenu(SdlRenderer r, ShellArt art, Strings ui,
                            int viewW, int viewH,
                            int mouseX, int mouseY, bool clicked) {
        SdlTexture backdrop = art != null && art.HasTitle() ? art.Title()
                            : null;
        int ax = 0;
        int ay = 0;
        int ah = viewH;
        if (backdrop != null) {
            // 4:3 centred, the aspect the art was drawn for (640x480); the
            // bars either side take the widescreen slack.
            int aw = ah * 4 / 3;
            if (aw > viewW) { aw = viewW; ah = aw * 3 / 4; }
            ax = (viewW - aw) / 2;
            ay = (viewH - ah) / 2;
            r.DrawTexture(backdrop, ax, ay, aw, ah);
        } else {
            KitUi.Backdrop(r, null, viewW, viewH);
            ah = ah * 3 / 4;
        }

        // The original menu's seven buttons, top to bottom, with the CSF
        // labels the install ships: 遭遇戰, 單人遊戲, 網際網路, 網路,
        // 選項, 社群, 退出遊戲.
        string skirmishLabel = ui.Or("GUI:Skirmish", "遭遇战");
        string singleLabel = ui.Or("GUI:SinglePlayerMenu", "单人游戏");
        string internetLabel = ui.Or("GUI:Internet", "网际网络");
        string networkLabel = ui.Or("GUI:Network", "网络游戏");
        string optionsLabel = ui.Or("GUI:Options", "选项");
        string communityLabel = ui.Or("GUI:YuriWebsite", "社群");
        string exitLabel = ui.Or("GUI:ExitGame", "退出游戏");

        // Button strip geometry in the art's 640x480 design space: 126x25
        // plates in a tight left column starting a third of the way down,
        // 36 pixels between plate tops. Scaled by the same factor as the
        // backdrop so the strip keeps its place on the chrome.
        int s = ah / 480;
        if (s < 1) { s = 1; }
        int bw = 126 * s;
        int bh = 25 * s;
        int pitch = 36 * s;
        int bx = ax + 14 * s;
        int by = ay + 160 * s;

        // Skirmish is the one implemented mode. The rest are drawn dimmed
        // rather than hidden so the menu reads like the real one and the gap
        // is honest.
        int action = 0;
        bool hovSkirmish = Screens.MenuButton(r, art, mouseX, mouseY, bx, by,
                                              bw, bh, skirmishLabel, true,
                                              false, clicked);
        if (hovSkirmish && clicked) { action = 1; }

        Screens.MenuButton(r, art, mouseX, mouseY, bx, by + pitch, bw, bh,
                           singleLabel, false, true, false);
        Screens.MenuButton(r, art, mouseX, mouseY, bx, by + pitch * 2, bw, bh,
                           internetLabel, false, true, false);
        Screens.MenuButton(r, art, mouseX, mouseY, bx, by + pitch * 3, bw, bh,
                           networkLabel, false, true, false);
        Screens.MenuButton(r, art, mouseX, mouseY, bx, by + pitch * 4, bw, bh,
                           optionsLabel, false, true, false);
        Screens.MenuButton(r, art, mouseX, mouseY, bx, by + pitch * 5, bw, bh,
                           communityLabel, false, true, false);

        bool hovQuit = Screens.MenuButton(r, art, mouseX, mouseY, bx,
                                          by + pitch * 6, bw, bh, exitLabel,
                                          false, false, clicked);
        if (hovQuit && clicked) { action = 2; }

        Text.Draw(r, "Esc 退出  F11 全屏", ax + 20 * s, ay + ah - 36 * s, 2,
                  150, 158, 172, 255);
        return action;
    }

    /// <summary>One main-menu entry in the original's own art: the MNBTTN
    /// plate -- red at rest, orange under the cursor, yellow on the click
    /// frame -- with the gold CSF label over it. Entries the shell cannot
    /// honour yet draw the same plate dimmed, as the shipped menu drew all
    /// seven of its rows. Without the plates it falls back to a drawn slab.
    /// Returns true when hovered.</summary>
    static bool MenuButton(SdlRenderer r, ShellArt art, int mx, int my,
                           int x, int y, int w, int h, string label,
                           bool enabled, bool disabled, bool clicked) {
        bool hov = enabled && Draw.PointIn(mx, my, x, y, w, h);
        int state = 0;
        if (hov) { state = clicked ? 2 : 1; }
        SdlTexture plate = art != null ? art.Btn(state) : null;
        if (plate != null) {
            r.DrawTexture(plate, x, y, w, h);
            if (disabled) {
                r.SetColor(8, 8, 10, 150);
                r.FillRect(x, y, w, h);
            }
        } else {
            // No plates in this install: a drawn stand-in slab.
            int bodyR = 40;
            int bodyG = 44;
            int bodyB = 52;
            if (hov) { bodyR = 56; bodyG = 62; bodyB = 74; }
            Draw.RoundRectFill(r, x - 2, y - 2, w + 4, h + 4, 6, 10, 12, 16,
                               255);
            Draw.RoundRectFill(r, x, y, w, h, 4, bodyR, bodyG, bodyB, 255);
            r.SetColor(178, 24, 24, 255);
            r.FillRect(x + 2, y + 2, w - 4, 5);
            r.SetColor(20, 22, 28, 255);
            r.FillRect(x + 2, y + h - 6, w - 4, 4);
            if (disabled) {
                r.SetColor(8, 8, 10, 150);
                r.FillRect(x, y, w, h);
            }
        }
        int lr = 236;
        int lg = 208;
        int lb = 120;
        if (disabled) { lr = 120; lg = 122; lb = 130; }
        Text.DrawCenteredShadow(r, label, x + w / 2, y + h / 2 - 9, 2,
                                lr, lg, lb, 255);
        return hov;
    }

    /// <summary>Skirmish setup on the game's own dialog backdrop, laid out
    /// like the original's 遭遇戰模式 screen: player and enemy slots down the
    /// left (each with a start-spot chip, a name/difficulty plate, a country
    /// dropdown and a colour swatch), the map preview under the slots, and a
    /// right column with the game options -- speed, credits and unit-count
    /// steppers, the four checkboxes, and the red 開始遊戲 plate. Returns
    /// 0 none, 1 start, 2 back.</summary>
    static int DrawSkirmish(SdlRenderer r, ShellArt art, Shell shell,
                            List<string> maps, SdlTexture preview,
                            Strings ui, int viewW, int viewH, int mouseX,
                            int mouseY, bool clicked) {
        KitUi.Backdrop(r, null, viewW, viewH);

        // The standard RA2 dialog chrome (DBAK6440.PCX, 640x400) scaled to
        // the 4:3 frame; every control sits inside it, the way the shell's
        // screens carried the dialog plate behind their fields.
        int ah = viewH * 3 / 4;
        int aw = ah * 4 / 3;
        if (aw > viewW) { aw = viewW; ah = aw * 3 / 4; }
        int dx = (viewW - aw) / 2;
        int dy = (viewH - ah) / 2;
        int dh = ah * 400 / 480;
        if (art != null && art.HasDialog()) {
            r.DrawTexture(art.Dialog(), dx, dy + (ah - dh) / 2, aw, dh);
        } else {
            Draw.RoundRectFill(r, dx, dy + (ah - dh) / 2, aw, dh, 8,
                               24, 28, 38, 255);
        }
        dy = dy + (ah - dh) / 2;
        ah = dh;

        // Everything below is placed in the dialog's own 640x400 design
        // space; the chrome keeps that aspect, so one scale fits both axes.
                Text.DrawShadow(r, ui.Or("GUI:Skirmish", "遭遇战") + "模式",
                        dx + 20 * aw / 640, dy + 12 * aw / 640, 3, 236, 208, 120, 3);
        Text.Draw(r, "Enter 开始  Esc 返回  ↑↓ 选图", dx + 396 * aw / 640,
                  dy + 22 * aw / 640, 1, 150, 158, 172, 255);

        // ---- player and enemy slots ------------------------------------
        // Slot 0 is the player; slots 1..7 are the AI opponents, each
        // openable or closable with its own difficulty. Rows are compact
        // (28 design px) so all eight fit between the header and the map
        // preview. Each open row: start-spot chip, name or difficulty
        // plate, country field, colour swatch.
        int slotX = dx + 20 * aw / 640;
        int slotW = 360 * aw / 640;
        int slotH = 24 * aw / 640;
        int slotPitch = 28 * aw / 640;
        int used = 0;

        // The dropdown's geometry, needed by the hit tests before the draw
        // pass reaches it. One flat list across the sides, like the
        // original's country box: 美国..英国, 苏俄..伊拉克, 尤里.
        int dropX = slotX + 174 * aw / 640;
        int dropY = dy + 84 * aw / 640;
        int dropW = 140 * aw / 640;
        int dropH = (Shell.FlatCount() * 24 + 8) * aw / 640;

        for (int i = 0; i < 8; i = i + 1) {
            int ry = dy + (52 + i * 28) * aw / 640;
            bool player = i == 0;
            if (!player && !shell.EnemyOpen(i - 1)) {
                // A closed enemy slot: dim plate, click it to join.
                Draw.RoundRectFill(r, slotX, ry, slotW, slotH, 4,
                                   26, 30, 40, 140);
                Text.DrawCentered(r, "关闭(点击加入)", slotX + slotW / 2,
                                  ry + slotH / 2 - 7, 1, 96, 100, 112, 200);
                if (clicked && Draw.PointIn(mouseX, mouseY, slotX, ry,
                                            slotW, slotH)) {
                    shell.ToggleEnemyOpen(i - 1);
                    used = 1;
                }
                continue;
            }

            Draw.RoundRectFill(r, slotX, ry, slotW, slotH, 4, 30, 34, 46, 220);
            bool hovRow = Draw.PointIn(mouseX, mouseY, slotX, ry, slotW,
                                       slotH);
            if (hovRow) {
                Draw.RoundRectStroke(r, slotX, ry, slotW, slotH, 4, 2,
120, 128, 142, 200);
            }

            // Start-spot chip. The player's cycles 随机 → 1..4; the AI's
            // just reports the spot it will take (the next one over).
            string spotText = "随";
            if (player) {
                if (shell.StartPosIndex() > 0) {
                    spotText = Convert.ToString(shell.StartPosIndex());
                }
            } else {
                spotText = Convert.ToString(shell.StartPosIndex() % 4 + i);
            }
            Draw.RoundRectFill(r, slotX + 4 * aw / 640, ry + 3 * aw / 640, 26 * aw / 640,
                               slotH - 6 * aw / 640, 4, 40, 44, 58, 255);
            Text.DrawCentered(r, spotText, slotX + 17 * aw / 640,
                              ry + slotH / 2 - 7, 1, 236, 208, 120, 255);

            // Name plate: the player, or the AI's skill -- clicking the
            // enemy's plate walks 简单的敌人 → 普通的敌人 → 冷酷的敌人,
            // exactly what the original's slot did.
            string name = player ? "指挥官"
                : Difficulty.NameOf(shell.EnemyDifficulty(i - 1));
            Draw.RoundRectFill(r, slotX + 34 * aw / 640, ry + 3 * aw / 640, 106 * aw / 640,
                               slotH - 6 * aw / 640, 4, 40, 44, 58, 255);
            Text.DrawCentered(r, name, slotX + 87 * aw / 640, ry + slotH / 2 - 7,
                              1, 224, 228, 238, 255);
            bool hovName = Draw.PointIn(mouseX, mouseY, slotX + 34 * aw / 640,
                                        ry + 3 * aw / 640, 106 * aw / 640, slotH - 6 * aw / 640);
            if (hovName && !player) {
                Draw.RoundRectStroke(r, slotX + 34 * aw / 640, ry + 3 * aw / 640, 106 * aw / 640,
                                     slotH - 6 * aw / 640, 4, 236, 2, 208, 120, 255);
            }
            if (hovName && !player && clicked) {
                shell.CycleEnemyDifficulty(i - 1);
                used = 1;
            }

            // Country field: the player's opens the flat country dropdown
            // (which carries the side with it); the AI plays a random
            // sub-faction, written the way the original wrote it.
            string country = player
                ? Shell.FlatName(shell.FlatIndex()) : "随机(???)";
            Draw.RoundRectFill(r, slotX + 146 * aw / 640, ry + 3 * aw / 640, 110 * aw / 640,
                               slotH - 6 * aw / 640, 4, 40, 44, 58, 255);
            Text.DrawCentered(r, country, slotX + 201 * aw / 640, ry + slotH / 2 - 7,
                              1, 224, 228, 238, 255);
            if (player) {
                bool hovC = Draw.PointIn(mouseX, mouseY, slotX + 146 * aw / 640,
                                         ry + 3 * aw / 640, 110 * aw / 640, slotH - 6 * aw / 640);
                if (hovC) {
                    Draw.RoundRectStroke(r, slotX + 146 * aw / 640, ry + 3 * aw / 640,
                                         110 * aw / 640, slotH - 6 * aw / 640, 4, 2,
236, 208, 120, 255);
                }
                if (hovC && clicked) {
                    shell.SetCountryListOpen(!shell.CountryListOpen());
                    used = 1;
                }
            } else {
                // Open slots can be left again -- click the country field.
                bool hovC = Draw.PointIn(mouseX, mouseY, slotX + 146 * aw / 640,
                                         ry + 3 * aw / 640, 110 * aw / 640, slotH - 6 * aw / 640);
                if (hovC && clicked) {
                    shell.ToggleEnemyOpen(i - 1);
                    used = 1;
                }
            }

            // Colour swatch: the player cycles the original's eight; the
            // enemies wear per-slot hostile hues (matches the minimap dots).
            int cr = 196;
            int cg = 32;
            int cb = 32;
            if (player) {
                List<int> rgb = new List<int>();
                Shell.ColorRgb(shell.ColorIndex(), rgb);
                cr = rgb[0];
                cg = rgb[1];
                cb = rgb[2];
            } else {
                List<int> dot = new List<int>();
                Screens.EnemySwatch(i, dot);
                cr = dot[0];
                cg = dot[1];
                cb = dot[2];
            }
            int swX = slotX + 262 * aw / 640;
            int swW = slotW - 266 * aw / 640;
            Draw.RoundRectFill(r, swX, ry + 3 * aw / 640, swW, slotH - 6 * aw / 640, 4,
                               cr, cg, cb, 255);
            Draw.RoundRectStroke(r, swX, ry + 3 * aw / 640, swW, slotH - 6 * aw / 640, 4, 2,
16, 18, 24, 255);
            if (player) {
                bool hovSw = Draw.PointIn(mouseX, mouseY, swX, ry + 3 * aw / 640,
                                          swW, slotH - 6 * aw / 640);
                if (hovSw && clicked) {
                    shell.SetColor((shell.ColorIndex() + 1) % 8);
                    used = 1;
                }
                bool hovSpot = Draw.PointIn(mouseX, mouseY, slotX + 4 * aw / 640,
                                            ry + 3 * aw / 640, 26 * aw / 640, slotH - 6 * aw / 640);
                if (hovSpot && clicked) {
                    shell.SetStartPos((shell.StartPosIndex() + 1) % 5);
                    used = 1;
                }
            }
        }

        // ---- map preview -------------------------------------------------
        int pvX = slotX;
        int pvY = dy + 278 * aw / 640;
        int pvW = slotW;
        int pvH = 116 * aw / 640;
        Draw.RoundRectFill(r, pvX, pvY, pvW, pvH, 6, 26, 30, 40, 220);
        Text.Draw(r, ui.Or("GUI:Map", "地图") + ":", pvX + 10 * aw / 640,
                  pvY + 5 * aw / 640, 1, 236, 208, 120, 255);
        Text.Draw(r, maps[shell.MapIndex()], pvX + 48 * aw / 640, pvY + 5 * aw / 640, 1,
                  224, 228, 238, 255);
        bool hovPrev = Draw.PointIn(mouseX, mouseY, pvX + 8 * aw / 640,
                                    pvY + 22 * aw / 640, pvW - 16 * aw / 640, pvH - 30 * aw / 640);
        if (preview != null) {
            r.DrawTexture(preview, pvX + 8 * aw / 640, pvY + 22 * aw / 640, pvW - 16 * aw / 640,
                          pvH - 30 * aw / 640);
        } else {
            Text.DrawCentered(r, "载入中…", pvX + pvW / 2, pvY + pvH / 2, 2,
                              120, 128, 142, 255);
        }

        // ---- right column: options ---------------------------------------
        int colX = dx + 396 * aw / 640;
        int colW = 224 * aw / 640;

        Draw.RoundRectFill(r, colX, dy + 56 * aw / 640, colW, 136 * aw / 640, 6,
                           26, 30, 40, 220);
        int spd = Screens.Stepper(r, mouseX, mouseY, colX + 12 * aw / 640,
                                  dy + 64 * aw / 640, ui.Or("GUI:GameSpeed", "游戏速度"),
                                  Convert.ToString(shell.GameSpeed()));
        int crd = Screens.Stepper(r, mouseX, mouseY, colX + 12 * aw / 640,
                                  dy + 104 * aw / 640, ui.Or("GUI:Credits", "资金"),
                                  Convert.ToString(shell.StartCredits()));
        int unt = Screens.Stepper(r, mouseX, mouseY, colX + 12 * aw / 640,
                                  dy + 144 * aw / 640, ui.Or("GUI:UnitCount", "部队数"),
                                  Convert.ToString(shell.UnitCount()));
        if (clicked) {
            if (spd < 0) { shell.AdjustSpeed(0 - 1); used = 1; }
            if (spd > 0) { shell.AdjustSpeed(1); used = 1; }
            if (crd < 0) { shell.AdjustCredits(0 - 500); used = 1; }
            if (crd > 0) { shell.AdjustCredits(500); used = 1; }
            if (unt < 0) { shell.AdjustUnits(0 - 1); used = 1; }
            if (unt > 0) { shell.AdjustUnits(1); used = 1; }
        }

        Draw.RoundRectFill(r, colX, dy + 200 * aw / 640, colW, 96 * aw / 640, 6,
                           26, 30, 40, 220);
        if (Screens.CheckRow(r, mouseX, mouseY, colX + 12 * aw / 640, dy + 206 * aw / 640,
                             "快速游戏", shell.ShortGame())) { used = 1; }
        if (clicked && Draw.PointIn(mouseX, mouseY, colX + 12 * aw / 640,
                                    dy + 206 * aw / 640, colW - 24 * aw / 640, 22 * aw / 640)) {
            shell.ToggleShortGame(); used = 1;
        }
        if (Screens.CheckRow(r, mouseX, mouseY, colX + 12 * aw / 640, dy + 228 * aw / 640,
                             "基地重新部署", shell.McvRedeploy())) { used = 1; }
        if (clicked && Draw.PointIn(mouseX, mouseY, colX + 12 * aw / 640,
                                    dy + 228 * aw / 640, colW - 24 * aw / 640, 22 * aw / 640)) {
            shell.ToggleMcvRedeploy(); used = 1;
        }
        if (Screens.CheckRow(r, mouseX, mouseY, colX + 12 * aw / 640, dy + 250 * aw / 640,
                             "升级工具箱", shell.Crates())) { used = 1; }
        if (clicked && Draw.PointIn(mouseX, mouseY, colX + 12 * aw / 640,
                                    dy + 250 * aw / 640, colW - 24 * aw / 640, 22 * aw / 640)) {
            shell.ToggleCrates(); used = 1;
        }
        if (Screens.CheckRow(r, mouseX, mouseY, colX + 12 * aw / 640, dy + 272 * aw / 640,
                             ui.Or("GUI:Superweapons", "超级武器"),
                             shell.Superweapons())) { used = 1; }
        if (clicked && Draw.PointIn(mouseX, mouseY, colX + 12 * aw / 640,
                                    dy + 272 * aw / 640, colW - 24 * aw / 640, 22 * aw / 640)) {
            shell.ToggleSuperweapons(); used = 1;
        }

        // ---- actions ------------------------------------------------------
        // The original's skirmish buttons are the same red MNBTTN plates the
        // main menu carries, so they go through MenuButton -- the RA2 red,
        // not the kit's green.
        int action = 0;
        bool hovGo = Screens.MenuButton(r, art, mouseX, mouseY, colX,
                                        dy + 304 * aw / 640, colW,
                                        42 * aw / 640,
                                        ui.Or("GUI:StartGame", "开始游戏"),
                                        true, false, clicked);
        bool hovBack = Screens.MenuButton(r, art, mouseX, mouseY, colX,
                                          dy + 352 * aw / 640, colW,
                                          36 * aw / 640,
                                          ui.Or("GUI:Back", "上一页"),
                                          true, false, clicked);
        if (clicked) {
            if (hovGo) { action = 1; used = 1; }
            if (hovBack) { action = 2; used = 1; }
        }

        // ---- country dropdown, over everything ---------------------------
        if (shell.CountryListOpen()) {
            Draw.RoundRectFill(r, dropX, dropY, dropW, dropH, 4,
                               34, 38, 50, 250);
            Draw.RoundRectStroke(r, dropX, dropY, dropW, dropH, 4, 2,
236, 208, 120, 255);
            bool took = false;
            for (int i = 0; i < Shell.FlatCount(); i = i + 1) {
                int idx = i + 1;
                int iy = dropY + (4 + i * 24) * aw / 640;
                string nm = Shell.FlatName(idx);
                bool hov = Draw.PointIn(mouseX, mouseY, dropX + 4 * aw / 640, iy,
                                        dropW - 8 * aw / 640, 22 * aw / 640);
                if (idx == shell.FlatIndex()) {
                    Draw.RoundRectFill(r, dropX + 4 * aw / 640, iy, dropW - 8 * aw / 640,
                                       22 * aw / 640, 3, 224, 176, 66, 235);
                } else if (hov) {
                    Draw.RoundRectFill(r, dropX + 4 * aw / 640, iy, dropW - 8 * aw / 640,
                                       22 * aw / 640, 3, 62, 70, 88, 220);
                }
                int tr = idx == shell.FlatIndex() ? 32 : 224;
                Text.DrawCentered(r, nm, dropX + dropW / 2, iy + 3 * aw / 640, 2,
                                  tr, tr, tr, 255);
                if (hov && clicked) {
                    shell.SetFlatCountry(idx);
                    shell.SetCountryListOpen(false);
                    used = 1;
                    took = true;
                }
            }
            if (clicked && !took) { used = 1; }   // click inside closes nothing
        }
        if (clicked && used == 0 && shell.CountryListOpen()) {
            shell.SetCountryListOpen(false);      // click elsewhere dismisses
        }

        // Clicking the preview cycles the map, like paging the original's
        // map box; the arrows on the keyboard do the same.
        if (clicked && hovPrev && used == 0) {
            shell.SelectMap(1);
            used = 1;
        }
        return action;
    }

    /// <summary>One options-panel stepper: gold label, then ‹ value ›. The
    /// arrows highlight under the cursor. Returns -1 minus clicked, +1 plus
    /// clicked, 0 otherwise.</summary>
    static int Stepper(SdlRenderer r, int mx, int my, int x, int y,
                       string label, string value) {
        Text.Draw(r, label, x, y + 8, 1, 236, 208, 120, 255);
        Draw.RoundRectFill(r, x + 96, y, 26, 26, 4, 40, 44, 58, 255);
        Draw.RoundRectFill(r, x + 184, y, 26, 26, 4, 40, 44, 58, 255);
        Text.DrawCentered(r, "<", x + 109, y + 6, 2, 236, 208, 120, 255);
        Text.DrawCentered(r, ">", x + 197, y + 6, 2, 236, 208, 120, 255);
        Text.DrawCentered(r, value, x + 153, y + 6, 2, 224, 228, 238, 255);
        bool lm = Draw.PointIn(mx, my, x + 96, y, 26, 26);
        bool rm = Draw.PointIn(mx, my, x + 184, y, 26, 26);
        if (lm) {
            Draw.RoundRectStroke(r, x + 96, y, 26, 26, 4, 236, 2, 208, 120, 255);
        }
        if (rm) {
            Draw.RoundRectStroke(r, x + 184, y, 26, 26, 4, 236, 2, 208, 120, 255);
        }
        int act = 0;
        if (lm) { act = 0 - 1; }
        if (rm) { act = 1; }
        return act;
    }

    /// <summary>One checkbox row: the square, a gold tick fill when on, the
    /// label. Returns true when the click landed on the row.</summary>
    /// <summary>The setup screen's per-slot enemy colour, matching the
    /// minimap dots: slot i wears hue i so every AI is distinguishable.</summary>
    static void EnemySwatch(int slot, List<int> rgb) {
        int r = 196; int g = 32; int b = 32;
        if (slot == 2) { r = 230; g = 130; b = 40; }      // orange
        else if (slot == 3) { r = 60; g = 140; b = 232; } // blue
        else if (slot == 4) { r = 220; g = 80; b = 200; } // magenta
        else if (slot == 5) { r = 230; g = 200; b = 50; } // yellow
        else if (slot == 6) { r = 60; g = 210; b = 200; } // cyan
        else if (slot == 7) { r = 240; g = 240; b = 240; } // white
        Ra2AppLikeSet(rgb, r, g, b);
    }

    static void Ra2AppLikeSet(List<int> rgb, int r, int g, int b) {
        while (rgb.Count < 3) { rgb.Add(0); }
        rgb[0] = r;
        rgb[1] = g;
        rgb[2] = b;
    }

    static bool CheckRow(SdlRenderer r, int mx, int my, int x, int y,
                         string label, bool on) {
        bool hov = Draw.PointIn(mx, my, x, y, 200, 20);
        Draw.RoundRectFill(r, x, y + 2, 14, 14, 3, 30, 34, 44, 255);
        Draw.RoundRectStroke(r, x, y + 2, 14, 14, 3, 2, 120, 128, 142, 255);
        if (on) {
            Draw.RoundRectFill(r, x + 3, y + 5, 8, 8, 2, 236, 208, 120, 255);
        }
        int tr = 210;
        int tg = 214;
        int tb = 224;
        if (hov) { tr = 236; tg = 208; tb = 120; }
        Text.Draw(r, label, x + 22, y + 3, 1, tr, tg, tb, 255);
        return hov;
    }

    /// <summary>The in-game overlay: which map is loaded and the controls.
    /// The sidebar, minimap and build menu are not implemented yet, so this
    /// deliberately shows only what exists.</summary>
    static void DrawHud(SdlRenderer r, string mapName, string sideName,
                        int cells, int drawn, int viewW, int viewH) {
        KitUi.Panel(r, 12, 12, 520, 76, 18, 22, 32, 190);
        Text.Draw(r, mapName + "   " + sideName, 28, 24, 2, 236, 208, 120, 255);
        Text.Draw(r, "单元 " + Convert.ToString(cells)
                  + "   本帧绘制 " + Convert.ToString(drawn),
                  28, 54, 2, 170, 178, 192, 255);

        Text.Draw(r, "方向键平移  +/- 缩放  Esc 返回",
                  12, viewH - 34, 2, 150, 158, 172, 255);
    }
}
