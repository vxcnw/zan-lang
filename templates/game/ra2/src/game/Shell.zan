using System;
using System.Collections.Generic;

namespace Ra2.Game;

/// <summary>Which screen the shell is showing.</summary>
class Scene {
    static int MainMenu() { return 0; }
    static int SkirmishSetup() { return 1; }
    static int Playing() { return 2; }
}

/// <summary>The three RA2 sides a player can pick.</summary>
class Side {
    static int Allied() { return 0; }
    static int Soviet() { return 1; }
    static int Yuri() { return 2; }

    static string NameOf(int side) {
        if (side == Side.Soviet()) { return "苏联"; }
        if (side == Side.Yuri()) { return "尤里"; }
        return "盟军";
    }
}

/// <summary>The sub-factions each side fields, in the order the original's
/// skirmish country list shows them. The index is what the shell stores; the
/// rules' Side- and Country-specific behaviour keys off the reg name.</summary>
class Country {
    static string NameOf(int side, int i) {
        if (side == Side.Allied()) {
            if (i == 1) { return "韩国"; }
            if (i == 2) { return "法国"; }
            if (i == 3) { return "德国"; }
            if (i == 4) { return "英国"; }
            return "美国";
        }
        if (side == Side.Soviet()) {
            if (i == 1) { return "古巴"; }
            if (i == 2) { return "利比亚"; }
            if (i == 3) { return "伊拉克"; }
            return "苏俄";
        }
        return "尤里";
    }

    /// <summary>The rules' country token: the load screen's sub-faction tag
    /// and the same token rulesmd.ini keys special-case sections on.</summary>
    static string RegOf(int side, int i) {
        if (side == Side.Allied()) {
            if (i == 1) { return "KOREA"; }
            if (i == 2) { return "FRANCE"; }
            if (i == 3) { return "GERMANY"; }
            if (i == 4) { return "ENGLAND"; }
            return "AMERICAN";
        }
        if (side == Side.Soviet()) {
            if (i == 1) { return "CUBA"; }
            if (i == 2) { return "LIBYA"; }
            if (i == 3) { return "IRAQ"; }
            return "RUSSIA";
        }
        return "YURI";
    }

    static int Count(int side) {
        if (side == Side.Allied()) { return 5; }
        if (side == Side.Soviet()) { return 4; }
        return 1;
    }
}

/// <summary>AI skill levels, the words the original's enemy slots cycle
/// through: 简单的敌人, 普通的敌人, 冷酷的敌人.</summary>
class Difficulty {
    static int Easy() { return 0; }
    static int Normal() { return 1; }
    static int Brutal() { return 2; }

    static string NameOf(int d) {
        if (d == Difficulty.Easy()) { return "简单的敌人"; }
        if (d == Difficulty.Brutal()) { return "冷酷的敌人"; }
        return "普通的敌人";
    }

    /// <summary>How much harder the AI fights: its income and its build pace
    /// both scale by this.</summary>
    static double Multiplier(int d) {
        if (d == Difficulty.Easy()) { return 0.6; }
        if (d == Difficulty.Brutal()) { return 1.6; }
        return 1.0;
    }
}

/// <summary>Shell state: which screen is up, and what the player has chosen
/// on the skirmish setup screen -- map, side, country, colour, start spot,
/// the enemy slots' difficulty, and the game options (credits, speed, unit
/// count, superweapons and friends).</summary>
///
/// Kept apart from rendering so the flow -- menu to setup to game, and back --
/// can be tested without a window. The screens themselves only read this and
/// call the transitions.
class Shell {
    int scene;
    int mapIndex;
    int side;
    int country;
    int color;
    int startPos;      // 0 = random, else waypoint startPos
    int mapCount;
    int startCredits;
    int gameSpeed;     // 0..6, 6 fastest -- the original's slider
    int unitCount;     // starting units per side, 0..10
    bool superweapons;
    bool shortGame;
    bool mcvRedeploy;
    bool crates;
    int[] enemyDiff;   // difficulty per enemy slot, up to seven AIs
    bool[] enemyOpen;  // which enemy slots are in the game (slot 0 always on)
    bool countryOpen;  // the skirmish screen's country dropdown is down
    bool quit;

    static Shell Create(int mapCount) {
        Shell s = new Shell();
        s.scene = Scene.MainMenu();
        s.mapIndex = 0;
        s.side = Side.Allied();
        s.country = 0;
        s.color = 0;
        s.startPos = 0;
        s.mapCount = mapCount;
        s.startCredits = 10000;
        s.gameSpeed = 6;
        s.unitCount = 10;
        s.superweapons = true;
        s.shortGame = false;
        s.mcvRedeploy = true;
        s.crates = false;
        s.enemyDiff = new int[7];
        s.enemyOpen = new bool[7];
        for (int i = 0; i < 7; i = i + 1) {
            s.enemyDiff[i] = Difficulty.Brutal();
            // The classic 1v1: one AI. More open from the setup screen.
            s.enemyOpen[i] = i == 0;
        }
        s.quit = false;
        return s;
    }

    int CurrentScene() { return this.scene; }
    int MapIndex() { return this.mapIndex; }
    int SideIndex() { return this.side; }
    int CountryIndex() { return this.country; }
    int ColorIndex() { return this.color; }
    int StartPosIndex() { return this.startPos; }
    int MapCount() { return this.mapCount; }
    int StartCredits() { return this.startCredits; }
    int GameSpeed() { return this.gameSpeed; }
    int UnitCount() { return this.unitCount; }
    bool Superweapons() { return this.superweapons; }
    bool ShortGame() { return this.shortGame; }
    bool McvRedeploy() { return this.mcvRedeploy; }
    bool Crates() { return this.crates; }
    bool WantsQuit() { return this.quit; }

    int EnemyDifficulty(int slot) {
        if (slot < 0 || slot >= 7) { return Difficulty.Normal(); }
        return this.enemyDiff[slot];
    }

    void CycleEnemyDifficulty(int slot) {
        if (slot < 0 || slot >= 7) { return; }
        this.enemyDiff[slot] = (this.enemyDiff[slot] + 1) % 3;
    }

    bool EnemyOpen(int slot) {
        if (slot < 0 || slot >= 7) { return false; }
        return this.enemyOpen[slot];
    }

    void ToggleEnemyOpen(int slot) {
        if (slot < 1 || slot >= 7) { return; }   // slot 0 stays in the game
        this.enemyOpen[slot] = !this.enemyOpen[slot];
    }

    // How many enemy slots are open -- the load path's AI count.
    int EnemySlotsOpen() {
        int n = 0;
        for (int i = 0; i < 7; i = i + 1) {
            if (this.enemyOpen[i]) { n = n + 1; }
        }
        return n;
    }

    string CountryName() {
        return Country.NameOf(this.side, this.country);
    }

    string CountryReg() {
        return Country.RegOf(this.side, this.country);
    }

    void Quit() { this.quit = true; }

    /// <summary>Main menu -> skirmish setup.</summary>
    void OpenSkirmish() {
        if (this.mapCount > 0) { this.scene = Scene.SkirmishSetup(); }
    }

    /// <summary>Setup -> playing. Refused when the install has no maps, so the
    /// shell cannot enter a game with nothing to load.</summary>
    bool StartGame() {
        if (this.mapCount == 0) { return false; }
        this.scene = Scene.Playing();
        return true;
    }

    /// <summary>Back out one screen. From the game that means the setup
    /// screen, from setup the main menu; the main menu has nowhere to go.</summary>
    void Back() {
        if (this.scene == Scene.Playing()) {
            this.scene = Scene.SkirmishSetup();
            return;
        }
        if (this.scene == Scene.SkirmishSetup()) {
            this.scene = Scene.MainMenu();
        }
    }

    /// <summary>Moves the map selection, wrapping at both ends so the arrow
    /// keys cycle rather than sticking.</summary>
    void SelectMap(int delta) {
        if (this.mapCount <= 0) { return; }
        int n = this.mapIndex + delta;
        while (n < 0) { n = n + this.mapCount; }
        this.mapIndex = n % this.mapCount;
    }

    void SelectMapAt(int index) {
        if (index < 0 || index >= this.mapCount) { return; }
        this.mapIndex = index;
    }

    void SetSide(int side) {
        if (side == Side.Allied() || side == Side.Soviet()
         || side == Side.Yuri()) {
            if (side != this.side) {
                this.side = side;
                this.country = 0;   // the country list belongs to the side
            }
        }
    }

    void SetCountry(int index) {
        if (index >= 0 && index < Country.Count(this.side)) {
            this.country = index;
        }
    }

    /// <summary>The player colours, the eight the original offers, as the
    /// RGB the UI paints the swatch with and the RGB the world's remap uses.
    /// Index order matches the original's colour dropdown.</summary>
    static void ColorRgb(int i, List<int> rgb) {
        if (i == 1) { RgbSet(rgb, 196, 32, 32); }             // 红
        else if (i == 2) { RgbSet(rgb, 32, 168, 32); }        // 绿
        else if (i == 3) { RgbSet(rgb, 232, 144, 32); }       // 橙
        else if (i == 4) { RgbSet(rgb, 140, 64, 216); }       // 紫
        else if (i == 5) { RgbSet(rgb, 32, 188, 188); }       // 青
        else if (i == 6) { RgbSet(rgb, 232, 96, 176); }       // 粉
        else if (i == 7) { RgbSet(rgb, 216, 184, 64); }       // 金
        else { RgbSet(rgb, 48, 88, 232); }                    // 蓝
    }

    static void RgbSet(List<int> rgb, int r, int g, int b) {
        if (rgb.Count < 3) { rgb.Add(0); rgb.Add(0); rgb.Add(0); }
        rgb[0] = r;
        rgb[1] = g;
        rgb[2] = b;
    }

    void SetColor(int index) {
        if (index >= 0 && index <= 7) { this.color = index; }
    }

    void SetStartPos(int index) {
        // 0 = random; 1..8 name a waypoint. Validation against the map's own
        // count happens at game start, which knows the map.
        if (index >= 0 && index <= 8) { this.startPos = index; }
    }

    void AdjustCredits(int delta) {
        int v = this.startCredits + delta;
        if (v < 500) { v = 500; }
        if (v > 100000) { v = 100000; }
        this.startCredits = v;
    }

    void AdjustSpeed(int delta) {
        int v = this.gameSpeed + delta;
        if (v < 0) { v = 0; }
        if (v > 6) { v = 6; }
        this.gameSpeed = v;
    }

    void AdjustUnits(int delta) {
        int v = this.unitCount + delta;
        if (v < 0) { v = 0; }
        if (v > 10) { v = 10; }
        this.unitCount = v;
    }

    void ToggleSuperweapons() { this.superweapons = !this.superweapons; }
    void ToggleShortGame() { this.shortGame = !this.shortGame; }
    void ToggleMcvRedeploy() { this.mcvRedeploy = !this.mcvRedeploy; }
    void ToggleCrates() { this.crates = !this.crates; }

    bool CountryListOpen() { return this.countryOpen; }
    void SetCountryListOpen(bool open) { this.countryOpen = open; }

    // The skirmish country dropdown is one flat list across the sides, the
    // way the original presented it: picking 苏俄 moves the player to the
    // Soviet side without a separate side toggle. Index 0 is not used -- the
    // player always fields a concrete country; only the AI plays 随机.
    static int FlatCount() { return 10; }

    static string FlatName(int i) {
        if (i >= 1 && i <= 5) { return Country.NameOf(Side.Allied(), i - 1); }
        if (i >= 6 && i <= 9) { return Country.NameOf(Side.Soviet(), i - 6); }
        if (i == 10) { return Country.NameOf(Side.Yuri(), 0); }
        return "随机(???)";
    }

    int FlatIndex() {
        if (this.side == Side.Allied()) { return 1 + this.country; }
        if (this.side == Side.Soviet()) { return 6 + this.country; }
        if (this.side == Side.Yuri()) { return 10; }
        return 1;
    }

    void SetFlatCountry(int i) {
        if (i >= 1 && i <= 5) {
            this.SetSide(Side.Allied());
            this.SetCountry(i - 1);
        } else if (i >= 6 && i <= 9) {
            this.SetSide(Side.Soviet());
            this.SetCountry(i - 6);
        } else if (i == 10) {
            this.SetSide(Side.Yuri());
            this.SetCountry(0);
        }
    }
}
