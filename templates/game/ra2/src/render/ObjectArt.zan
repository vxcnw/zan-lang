using System;
using System.Collections.Generic;
using Ra2.Assets;
using Ra2.Formats;
using Ra2.Game;

namespace Ra2.Render;

/// <summary>Converts object art -- an SHP frame plus a palette -- to the RGBA
/// textures the renderer blits. Units use the temperate unit palette when the
/// install carries it (unit.pal and unitsno.pal share its 256-slot layout and
/// serve as fallbacks); buildings use the theater palette.</summary>
class ObjectArt {
    Vfs vfs;
    AssetDb db;
    Palette unitPal;
    // The allied unit palette: unitPal with the remap slots recoloured from
    // soviet red to the allied player colour. Built on first use.
    Palette alliedPal;
    // The Soviet unit palette: remap slots recoloured to the shipped Red
    // house colour. Built on first use.
    Palette sovietPal;
    // The Yuri unit palette: remap slots recoloured to the third side's
    // shipped Purple house colour. Built on first use.
    Palette yuriPal;
    Palette theaterPal;
    // The theater palette with the remap slots recoloured per faction --
    // Remapable building art paints its owner-coloured areas from palette
    // entries 16-31, which ship as a bright magenta ramp. Built on first
    // use, one variant per side; neutral structures keep the raw palette.
    Palette theaterAllied;
    Palette theaterSoviet;
    Palette theaterYuri;
    // The loaded map's theater name ("TEMPERATE", "SNOW", ...): NewTheater
    // art files swap their name's second letter against it.
    string theaterName;

    // Per-building art.ini facts, cached by reg: whether the SHP's tail is
    // shadow frames (half the image count is never drawn as art) and the
    // image the Buildup= key names (the real construction animation).
    List<string> bldRegNames;
    List<int> bldShadow;
    List<string> bldBuildup;

    // SHP name + frame + palette -> decoded texture. The palette is part of
    // the key: unit sprites decode under a per-side palette (the remap
    // slots differ), so two sides share a name and frame but not the pixels.
    // Frame 0 of a building's SHP is the complete structure; the later
    // frames are the construction animation. A missing name is cached as
    // null, which is distinct from "not looked up".
    List<string> shpNames;
    List<int> shpFrames;
    List<Palette> shpPals;
    List<Texture> shpCache;

    // SHP name -> frame count, for the construction-stage mapping.
    List<string> countNames;
    List<int> countVals;

    // Vehicle voxel art: the parsed models, then one baked texture per
    // (model, facing). A bake is a few thousand voxel projections, so the
    // eight facings a vehicle uses are rendered once and reused.
    List<string> vxlNames;
    List<VxlImage> vxlCache;
    List<string> vehNames;
    List<int> vehFacings;
    List<int> vehSides;
    List<Texture> vehTex;

    // Sidebar cameos: <ART>ICON.SHP decoded under SIDEBAR.PAL (the archive
    // the portraits ship with), cached by name. A missing name caches as
    // null so an absent portrait falls back to field art once.
    Palette cameoPal;
    List<string> cameoNames;
    List<Texture> cameoTex;

    static ObjectArt Create(Vfs vfs, AssetDb db, string theaterName) {
        ObjectArt a = new ObjectArt();
        a.vfs = vfs;
        a.db = db;
        a.theaterName = theaterName == null || theaterName.Length == 0
            ? "TEMPERATE" : theaterName.ToUpper();
        a.shpNames = new List<string>();
        a.shpFrames = new List<int>();
        a.shpPals = new List<Palette>();
        a.shpCache = new List<Texture>();
        a.countNames = new List<string>();
        a.countVals = new List<int>();
        a.vxlNames = new List<string>();
        a.vxlCache = new List<VxlImage>();
        a.vehNames = new List<string>();
        a.vehFacings = new List<int>();
        a.vehSides = new List<int>();
        a.vehTex = new List<Texture>();
        a.cameoPal = null;
        a.cameoNames = new List<string>();
        a.cameoTex = new List<Texture>();
        // Unit palettes, best fit first: unittem.pal is the temperate unit
        // palette the merged art expects; unit.pal and unitsno.pal share the
        // same 256-slot layout, so either works as a fallback when the
        // install is stripped.
        a.unitPal = db.PaletteNamed("unittem.pal");
        if (a.unitPal == null) { a.unitPal = db.PaletteNamed("unit.pal"); }
        if (a.unitPal == null) { a.unitPal = db.PaletteNamed("unitsno.pal"); }
        a.alliedPal = null;
        a.sovietPal = null;
        a.yuriPal = null;
        a.theaterAllied = null;
        a.theaterSoviet = null;
        a.theaterYuri = null;
        a.bldRegNames = new List<string>();
        a.bldShadow = new List<int>();
        a.bldBuildup = new List<string>();
        // Buildings use the temperate theater palette. Using the unit palette
        // made every structure render with wrong colours -- the yard's olive
        // green came out as bright white.
        a.theaterPal = db.PaletteNamed("isotem.pal");
        if (a.theaterPal == null) { a.theaterPal = db.PaletteNamed("isosno.pal"); }
        return a;
    }

    /// <summary>The texture for a structure at a construction progress. The
    /// construction skeleton lives in the art's Buildup= image (a separate
    /// SHP whose frames play from bare site to full building), so a partially
    /// built structure shows that animation and the finished one the main
    /// sprite's frame 0. The main sprite's own tail frames are the shadow
    /// masks and damage states, never construction stages.</summary>
    Texture StructureTexture(int faction, int buildId, StructureCatalog catalog,
                             int progress, int buildTime) {
        return this.StructureTextureOf(catalog.TypeFor(null, faction, buildId),
                                       faction, progress, buildTime,
                                       1, 1);
    }

    /// <summary>The archetype-driven form of StructureTexture: the renderer
    /// resolves the type itself (civ buildings live in the civ catalog), so
    /// it hands the type in directly. hp/maxHp pick the damage frame once
    /// the structure is up; the owner's side picks the remapped palette.</summary>
    Texture StructureTextureOf(StructureType t, int side, int progress,
                               int buildTime, int hp, int maxHp) {
        if (t == null) { return null; }
        string name = t.ShpName();
        if (t.NewTheater()) { name = this.NewTheaterName(name); }
        int visible = this.VisibleFrameCount(t.Reg(), name);
        Palette pal = this.TheaterPalFor(side);
        if (buildTime > 0 && progress < buildTime) {
            // The Buildup= image carries the rising skeleton. Its frames
            // play forward: the earliest progress shows frame 0, and the
            // last frame sits just before the real building takes over.
            string mk = this.BuildupImage(t.Reg());
            if (mk.Length > 0) {
                int mn = this.ShapeFrameCount(mk);
                if (mn > 0) {
                    int stage = progress * mn / buildTime;
                    if (stage >= mn) { stage = mn - 1; }
                    return this.ShapeTextureFrame(mk, stage, pal);
                }
            }
            // No buildup art shipped: hold the finished sprite dim for the
            // wait rather than guess at unrelated frames.
            return this.ShapeTextureFrame(name, 0, pal);
        }
        // Finished: frame 0 healthy, then the sprite's own damaged states.
        // A sprite with three visible frames ships healthy/damaged/critical;
        // with two, healthy and one damaged state.
        int frame = 0;
        if (maxHp > 0 && visible >= 2) {
            int pct = hp * 100 / maxHp;
            if (pct < 0) { pct = 0; }
            if (visible >= 3) {
                frame = pct <= 33 ? 2 : (pct <= 66 ? 1 : 0);
            } else {
                frame = pct <= 50 ? 1 : 0;
            }
            if (frame >= visible) { frame = visible - 1; }
        }
        return this.ShapeTextureFrame(name, frame, pal);
    }

    /// <summary>How many frames of the structure's sprite are real art. TS/RA2
    /// building sprites pack a shadow mask block behind the image frames, so
    /// a Shadow=yes art section (the default for these sprites) halves the
    /// count; the masks must never be drawn as the building.</summary>
    int VisibleFrameCount(string reg, string shpName) {
        int n = this.ShapeFrameCount(shpName);
        if (n < 2) { return n; }
        int slot = -1;
        for (int i = 0; i < this.bldRegNames.Count; i = i + 1) {
            if (this.bldRegNames[i] == reg) { slot = i; break; }
        }
        if (slot < 0) {
            slot = this.bldRegNames.Count;
            this.bldRegNames.Add(reg);
            bool shadow = true;
            IniSection s = this.db.Art().Section(reg);
            if (s != null && s.Contains("Shadow")) {
                string v = s.GetOr("Shadow", "yes").Trim().ToLower();
                shadow = v != "no" && v != "false";
            }
            this.bldShadow.Add(shadow ? 1 : 0);
            this.bldBuildup.Add(this.LoadBuildupName(reg, s));
            return this.bldShadow[slot] == 1 ? n / 2 : n;
        }
        return this.bldShadow[slot] == 1 ? n / 2 : n;
    }

    /// <summary>The cached Buildup= image name for a reg, resolved to a file
    /// the install actually carries ("" when none). Callers read the art
    /// facts through VisibleFrameCount first, which fills the cache.</summary>
    string BuildupImage(string reg) {
        for (int i = 0; i < this.bldRegNames.Count; i = i + 1) {
            if (this.bldRegNames[i] == reg) {
                return this.bldBuildup[i];
            }
        }
        return "";
    }

    /// <summary>Resolves a building's art Buildup= key to a file name:
    /// the theater spelling first, the plain one second, "" when the install
    /// carries neither.</summary>
    string LoadBuildupName(string reg, IniSection art) {
        if (art == null) { return ""; }
        string img = art.GetOr("Buildup", "");
        if (img.Length < 2) { return ""; }
        string file = img.ToUpper() + ".SHP";
        string theater = this.NewTheaterName(file);
        if (theater != file && this.vfs.Contains(theater)) { return theater; }
        if (this.vfs.Contains(file)) { return file; }
        return "";
    }

    /// <summary>Resolves the file a structure's art really ships as.
    /// NewTheater=yes buildings carry one sprite per theater -- the file
    /// name's second letter is the theater's own (temperate "t", snow "a",
    /// urban "u", lunar "l", desert "d"), so GACNST.SHP on a temperate map
    /// reads GAtcnst.shp -- with the plain name as the fallback when that
    /// theater's file is absent. Mirrors the reference engine's
    /// new_theater_shp_name.</summary>
    string NewTheaterName(string shpName) {
        int dot = shpName.Length - 4;
        if (dot < 2) { return shpName; }
        string letter = "t";
        string th = this.theaterName;
        if (th == "SNOW") { letter = "a"; }
        else if (th == "URBAN" || th == "NEWURBAN") { letter = "u"; }
        else if (th == "LUNAR") { letter = "l"; }
        else if (th == "DESERT") { letter = "d"; }
        byte[] one = new byte[1];
        one[0] = (byte)(letter[0] & 0xFF);
        string name = shpName.Substring(0, 1)
            + one.ToStr(0, 1) + shpName.Substring(2, dot - 2) + ".SHP";
        if (this.vfs.Contains(name)) { return name; }
        return shpName;
    }

    /// <summary>A unit's art. The stripped install carries a few unit sprites
    /// (dog, spy, sniper); units whose SHP name is empty get a side-coloured
    /// placeholder drawn by the renderer instead.
    ///
    /// Infantry SHPs lay their frames out as the art ini's Sequence= section
    /// describes: a ring of stand poses (one per facing, Ready=0 for GI),
    /// then the walk cycle as one block of frames per facing (Walk=8,6,6 --
    /// start 8, six frames a block). The sprite ring runs counter-clockwise
    /// from north -- N, NW, W, SW, S, SE, E, NE, read off the shipped GI.SHP
    /// -- while the engine's facing ring runs clockwise, so the block a
    /// facing lands on is its mirror (8 - facing). Vehicles are voxels and
    /// bake per facing below.</summary>
    Texture UnitTexture(UnitType ut, bool moving, int animFrame, int facing,
                        int side) {
        if (ut == null) { return null; }
        string name = ut.ShpName();
        if (name == null || name.Length == 0) { return null; }
        if (ObjectArt.IsVxlName(name)) {
            return this.VehicleTexture(name, facing, side);
        }
        int ring = (8 - (facing % 8)) % 8;
        int count = this.ShapeFrameCount(name);
        if (ut.HasSeq()) {
            if (moving) {
                int per = ut.WalkFrames();
                int frame = ut.WalkStart() + ring * per + (animFrame % per);
                if (frame >= count) { return this.ShapeTextureFrame(name,
                    ut.ReadyStart() + ring, this.UnitPalFor(side)); }
                return this.ShapeTextureFrame(name, frame,
                                              this.UnitPalFor(side));
            }
            int stand = ut.ReadyStart() + ring;
            if (stand < count) {
                return this.ShapeTextureFrame(name, stand,
                                              this.UnitPalFor(side));
            }
            return this.ShapeTextureFrame(name, 0, this.UnitPalFor(side));
        }
        // No sequence known for this sprite: it is not troop art (the old
        // guard tower crew, civilians), so a single still frame serves.
        return this.ShapeTextureFrame(name, 0, this.UnitPalFor(side));
    }

    /// <summary>Whether a unit art name names a voxel model rather than an
    /// SHP sprite. Case folded, so Image= overrides of any case match.</summary>
    static bool IsVxlName(string name) {
        int dot = name.Length - 4;
        if (dot < 0) { return false; }
        string want = ".VXL";
        for (int i = 0; i < 4; i = i + 1) {
            if ((name[dot + i] & 0xDF) != (want[i] & 0xDF)) { return false; }
        }
        return true;
    }

    /// <summary>The sidebar icon for a trainable unit. The original draws the
    /// unit's cameo portrait, a separate <c>*ICON.SHP</c> per object, but this
    /// trimmed install carries none of them -- every <c>*ICON.SHP</c> is
    /// absent from its mixes while the palettes survived. The button therefore
    /// shows the unit's own field art: the voxel hull baked at the
    /// south-west facing (the cameo viewpoint) for vehicles, the still pose
    /// for infantry.</summary>
    Texture UnitIconTexture(UnitType ut, int side) {
        if (ut == null) { return null; }
        string name = ut.ShpName();
        if (name == null || name.Length == 0) { return null; }
        if (ObjectArt.IsVxlName(name)) {
            return this.VehicleTexture(name, 5, side);
        }
        if (this.ShapeFrameCount(name) <= 0) { return null; }
        return this.ShapeTextureFrame(name, 0, this.UnitPalFor(side));
    }

    /// <summary>The sidebar portrait for a trainable unit: the shipped cameo
    /// the original build menu shows. Cameos are named after the art image,
    /// not the rules reg ([E1] draws GIICON, [FLAKT] FLAKICON), so the map
    /// below carries the install's own Image= overrides for the regs whose
    /// reg name and art name disagree; regs not listed (and every building)
    /// resolve to <reg>ICON.SHP, whose misses fall back to field art. The
    /// portraits decode under SIDEBAR.PAL, the palette shipped alongside
    /// them in the SIDEC mixes.</summary>
    Texture CameoTexture(UnitType ut) {
        if (ut == null) { return null; }
        string key = ut.ArtKey() != null && ut.ArtKey().Length > 0
            ? ut.ArtKey() : ut.Reg();
        // Art-key overrides where the reg name and the shipped cameo name
        // disagree, transcribed from the install's rules Image= keys and
        // the RA2 cameo naming the shipped art uses.
        if (key == "GI") { key = "GI"; }
        else if (ut.Reg() == "E2") { key = "E2"; }
        else if (ut.Reg() == "ADOG") { key = "ADOG"; }
        else if (ut.Reg() == "ENGINEER") { key = "WEED"; }
        else if (ut.Reg() == "SNIPE") { key = "SNIP"; }
        else if (ut.Reg() == "FLAKT") { key = "FLAK"; }
        else if (ut.Reg() == "SHK") { key = "SHK"; }
        else if (ut.Reg() == "GGI") { key = "PARA"; }
        else if (ut.Reg() == "CMIN") { key = "SMIN"; }
        else if (ut.Reg() == "BRUTE") { key = "BRUT"; }
        else if (ut.Reg() == "INIT") { key = "INIT"; }
        else if (ut.Reg() == "PCV") { key = "MCV"; }
        string name = key + "ICON.SHP";
        for (int i = 0; i < this.cameoNames.Count; i = i + 1) {
            if (this.cameoNames[i] == name) { return this.cameoTex[i]; }
        }
        Texture tex = null;
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = this.vfs.Read(name, len);
        if (len[0] > 0) {
            if (this.cameoPal == null) {
                this.cameoPal = this.db.PaletteNamed("SIDEBAR.PAL");
            }
            if (this.cameoPal != null) {
                ShpImage shp = ShpImage.Parse(raw, len[0]);
                if (shp.FrameCount() > 0) {
                    byte[] idx = shp.DecodeFrameCanvas(0);
                    tex = Texture.FromIndexedShp(idx, shp.Width(),
                                                 shp.Height(), this.cameoPal);
                }
            }
        }
        this.cameoNames.Add(name);
        this.cameoTex.Add(tex);
        return tex;
    }

    /// <summary>The build-menu portrait for a structure: the original draws
    /// the art section's Cameo= image -- a dedicated 60x48 ICON.SHP decoded
    /// under CAMEO.PAL -- not a scaled-down field sprite. The name comes
    /// from the rules pipeline (BuildingDef.Cameo, the art Cameo= stem);
    /// installs without the key fall back to the reg's own
    /// <reg>ICON.SHP, with the generic CNSTICON for the two yards whose art
    /// ships no cameo, and the world sprite as the last resort.</summary>
    Texture StructureCameoTexture(StructureType t) {
        if (t == null) { return null; }
        string reg = t.Reg();
        // The art Cameo= key carries the full shipped stem -- "POWRICON",
        // "gwepicon" -- not a prefix to concatenate on, so it is used
        // verbatim (uppercased for the VFS) unless it lacks the ICON tail.
        string stem = t.Cameo() != null ? t.Cameo().ToUpper() : "";
        string primary;
        if (stem.Length > 0) {
            bool endsIcon = stem.Length >= 4
                && stem.Substring(stem.Length - 4) == "ICON";
            primary = endsIcon ? stem + ".SHP" : stem + "ICON.SHP";
        } else if (reg == "GACNST" || reg == "NACNST") {
            primary = "CNSTICON.SHP";
        } else {
            primary = reg + "ICON.SHP";
        }
        // Same-name cache the unit cameos share: a miss is stored as null
        // so a missing portrait costs one lookup and then falls back.
        for (int i = 0; i < this.cameoNames.Count; i = i + 1) {
            if (this.cameoNames[i] == primary) { return this.cameoTex[i]; }
        }
        string fallback;
        if (reg == "GACNST" || reg == "NACNST") {
            fallback = "CNSTICON.SHP";
        } else {
            fallback = reg + "ICON.SHP";
        }
        Texture tex = this.LoadCameoShp(primary);
        if (tex == null && fallback != primary) {
            tex = this.LoadCameoShp(fallback);
        }
        if (tex == null) {
            tex = this.StructureTextureOf(t, 0, 1, 1, t.Hp(), t.Hp());
        }
        this.cameoNames.Add(primary);
        this.cameoTex.Add(tex);
        return tex;
    }

    /// <summary>One ICON.SHP decoded under CAMEO.PAL (the portrait palette
    /// the originals ship in CAMEO.MIX), SIDEBAR.PAL as the stand-in when
    /// the install carries only the sidebar palette. Null when absent.</summary>
    Texture LoadCameoShp(string name) {
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = this.vfs.Read(name, len);
        if (len[0] <= 0) { return null; }
        if (this.cameoPal == null) {
            this.cameoPal = this.db.PaletteNamed("CAMEO.PAL");
            if (this.cameoPal == null) {
                this.cameoPal = this.db.PaletteNamed("SIDEBAR.PAL");
            }
        }
        if (this.cameoPal == null) { return null; }
        ShpImage shp = ShpImage.Parse(raw, len[0]);
        if (shp.FrameCount() <= 0) { return null; }
        byte[] idx = shp.DecodeFrameCanvas(0);
        return Texture.FromIndexedShp(idx, shp.Width(), shp.Height(),
                                      this.cameoPal);
    }

    /// <summary>The unit palette for a side. Remappable art stores its
    /// player-colour pixels in palette slots 16..31, and the raw palette
    /// carries the soviet red ramp there; the allied side gets those slots
    /// recoloured to its player colour (the rules [Colors] Gold entry, the
    /// first skirmish slot's default) so friend and foe read apart on the
    /// field. Yuri's slots recolour to its shipped DarkRed house colour --
    /// the purple the third side wears. The soviet palette is the file as
    /// shipped.</summary>
    Palette UnitPalFor(int side) {
        if (side == Side2.Allied()) {
            if (this.unitPal == null) { return null; }
            if (this.alliedPal == null) {
                this.alliedPal = this.RemappedFromColors("Gold");
            }
            return this.alliedPal;
        }
        if (side == Side2.Yuri()) {
            if (this.unitPal == null) { return null; }
            if (this.yuriPal == null) {
                this.yuriPal = this.RemappedFromColors("Purple");
            }
            return this.yuriPal;
        }
        if (side == Side2.Soviet()) {
            if (this.unitPal == null) { return null; }
            if (this.sovietPal == null) {
                this.sovietPal = this.RemappedFromColors("Red");
            }
            return this.sovietPal;
        }
        return this.unitPal;
    }

    /// <summary>The theater palette variant a structure draws under: the
    /// Remapable art's owner-coloured areas come from palette entries 16-31,
    /// which only read as the right colours once remapped to the owner's
    /// house colour. Neutral structures keep the shipped palette.</summary>
    Palette TheaterPalFor(int side) {
        if (this.theaterPal == null) { return null; }
        if (side == Side2.Allied()) {
            if (this.theaterAllied == null) {
                this.theaterAllied = this.RemapTheaterFromColors("Gold");
            }
            return this.theaterAllied;
        }
        if (side == Side2.Soviet()) {
            if (this.theaterSoviet == null) {
                this.theaterSoviet = this.RemapTheaterFromColors("Red");
            }
            return this.theaterSoviet;
        }
        if (side == Side2.Yuri()) {
            if (this.theaterYuri == null) {
                this.theaterYuri = this.RemapTheaterFromColors("Purple");
            }
            return this.theaterYuri;
        }
        return this.theaterPal;
    }

    /// <summary>The unit palette with its remap slots recoloured to the
    /// named [Colors] entry, built once.</summary>
    Palette RemappedFromColors(string colorName) {
        int hue = 30;
        int sat = 100;
        IniSection colors = this.db.Rules().Section("Colors");
        if (colors != null) {
            List<int> hsv = ObjectArt.ParseHsvTriple(colors.Get(colorName));
            if (hsv.Count == 3) {
                hue = hsv[0];
                sat = hsv[1];
            }
        }
        return this.unitPal.Remapped(hue, sat);
    }

    /// <summary>The theater palette with its remap slots recoloured to the
    /// named [Colors] entry, built once.</summary>
    Palette RemapTheaterFromColors(string colorName) {
        int hue = 30;
        int sat = 100;
        IniSection colors = this.db.Rules().Section("Colors");
        if (colors != null) {
            List<int> hsv = ObjectArt.ParseHsvTriple(colors.Get(colorName));
            if (hsv.Count == 3) {
                hue = hsv[0];
                sat = hsv[1];
            }
        }
        return this.theaterPal.Remapped(hue, sat);
    }

    /// <summary>"32,100,255" -> 32,100,255. Stops at an inline ';' comment;
    /// returns whatever numbers were found, so a malformed value degrades to
    /// the caller's fallback.</summary>
    static List<int> ParseHsvTriple(string s) {
        List<int> vals = new List<int>();
        if (s == null) { return vals; }
        int cur = 0;
        bool any = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 0xFF;
            if (c >= 48 && c <= 57) {
                cur = cur * 10 + (c - 48);
                any = true;
            } else if (c == 59) {
                break;
            } else if (any) {
                vals.Add(cur);
                cur = 0;
                any = false;
            }
        }
        if (any) { vals.Add(cur); }
        return vals;
    }

    /// <summary>The baked texture for a vehicle at one of the eight compass
    /// facings, rendered on first use and cached. The side picks the unit
    /// palette, so the remappable voxels bake in their owner's colour.</summary>
    Texture VehicleTexture(string name, int facing, int side) {
        for (int i = 0; i < this.vehNames.Count; i = i + 1) {
            if (this.vehNames[i] == name && this.vehFacings[i] == facing
             && this.vehSides[i] == side) {
                return this.vehTex[i];
            }
        }
        Texture tex = null;
        VxlImage img = this.VxlNamed(name);
        if (img != null && this.UnitPalFor(side) != null) {
            tex = ObjectArt.BakeFacing(img, this.UnitPalFor(side), facing);
        }
        this.vehNames.Add(name);
        this.vehFacings.Add(facing);
        this.vehSides.Add(side);
        this.vehTex.Add(tex);
        return tex;
    }

    /// <summary>The baked turret texture for a turreted vehicle: the same
    /// voxel bake as the hull, from the turret model, at the turret's own
    /// facing. Cached under a "TUR:" key in the vehicle cache, so the same
    /// list serves both; the prefix keeps turret and hull entries apart even
    /// when a model shares its name with its hull.</summary>
    Texture TurretTexture(string turretVxl, int facing, int side) {
        string key = "TUR:" + turretVxl;
        for (int i = 0; i < this.vehNames.Count; i = i + 1) {
            if (this.vehNames[i] == key && this.vehFacings[i] == facing
             && this.vehSides[i] == side) {
                return this.vehTex[i];
            }
        }
        Texture tex = null;
        VxlImage img = this.VxlNamed(turretVxl);
        if (img != null && this.UnitPalFor(side) != null) {
            tex = ObjectArt.BakeFacing(img, this.UnitPalFor(side), facing);
        }
        this.vehNames.Add(key);
        this.vehFacings.Add(facing);
        this.vehSides.Add(side);
        this.vehTex.Add(tex);
        return tex;
    }

    /// <summary>The parsed voxel model for an art name, cached; null when the
    /// install does not carry the file or it is not a VXL.</summary>
    VxlImage VxlNamed(string name) {
        for (int i = 0; i < this.vxlNames.Count; i = i + 1) {
            if (this.vxlNames[i] == name) { return this.vxlCache[i]; }
        }
        VxlImage img = null;
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = this.vfs.Read(name, len);
        if (len[0] > 0) {
            img = VxlImage.Parse(raw, len[0]);
            if (img.LimbCount() == 0) { img = null; }
        }
        this.vxlNames.Add(name);
        this.vxlCache.Add(img);
        return img;
    }

    /// <summary>Bakes one compass facing of a voxel model with the map's 2:1
    /// dimetric projection. Facings follow the TS/RA2 ring (0=N, 1=NE, 2=E,
    /// 3=SE, 4=S, 5=SW, 6=W, 7=NW, clockwise); each facing turns the model
    /// 45 degrees counter-clockwise on screen from north. Voxel depth orders
    /// the draw, and each voxel is lit from its empty neighbours -- a hull
    /// face pointing at open sky catches the screen light, shaded faces fall
    /// dark. The original stores a normal table per voxel for its own
    /// lighting; the occupancy gradient reproduces the same read without
    /// shipping that table through the render path.</summary>
    static Texture BakeFacing(VxlImage img, Palette pal, int facing) {
        VxlLimb l = img.Main();
        if (l == null) { return null; }
        int sx = l.SizeX();
        int sy = l.SizeY();
        int sz = l.SizeZ();
        double yaw = (6.0 - (double)facing) * 3.14159265358979 / 4.0;
        double cos = Math.Cos(yaw);
        double sin = Math.Sin(yaw);

        // Project every filled voxel once; the extents size the canvas and
        // the depth key orders the painter sort.
        int n = 0;
        int total = sx * sy * sz;
        int[] gx = new int[total];
        int[] gy = new int[total];
        int[] gz = new int[total];
        int[] keys = new int[total];
        double minPx = 0.0; double maxPx = 0.0;
        double minPy = 0.0; double maxPy = 0.0;
        bool any = false;
        for (int y = 0; y < sy; y = y + 1) {
            for (int x = 0; x < sx; x = x + 1) {
                for (int z = 0; z < sz; z = z + 1) {
                    if (l.VoxelAt(x, y, z) < 0) { continue; }
                    double cx = (double)(x - sx / 2);
                    double cy = (double)(y - sy / 2);
                    double rx = cx * cos - cy * sin;
                    double ry = cx * sin + cy * cos;
                    double px = (rx - ry) * 0.866;
                    double py = (rx + ry) * 0.5 - (double)z * 0.86;
                    if (!any) {
                        minPx = px; maxPx = px; minPy = py; maxPy = py;
                        any = true;
                    } else {
                        if (px < minPx) { minPx = px; }
                        if (px > maxPx) { maxPx = px; }
                        if (py < minPy) { minPy = py; }
                        if (py > maxPy) { maxPy = py; }
                    }
                    gx[n] = x; gy[n] = y; gz[n] = z;
                    // Painter key: rx+ry, quantised to sixteenths of a voxel.
                    keys[n] = (int)((rx + ry) * 16.0);
                    n = n + 1;
                }
            }
        }
        if (n == 0) { return null; }

        int pad = 4;
        int w = (int)((maxPx - minPx) * 2.0) + pad * 2 + 1;
        int h = (int)((maxPy - minPy) * 2.0) + pad * 2 + 1;
        Texture tex = Texture.Create(w, h);

        // Counting sort by depth key, ascending: farthest drawn first.
        int kmin = 1 << 30;
        int kmax = -(1 << 30);
        for (int i = 0; i < n; i = i + 1) {
            if (keys[i] < kmin) { kmin = keys[i]; }
            if (keys[i] > kmax) { kmax = keys[i]; }
        }
        int span = kmax - kmin + 1;
        int[] counts = new int[span + 1];
        for (int i = 0; i < n; i = i + 1) {
            counts[keys[i] - kmin] = counts[keys[i] - kmin] + 1;
        }
        int acc = 0;
        for (int i = 0; i < span; i = i + 1) {
            int c = counts[i];
            counts[i] = acc;
            acc = acc + c;
        }
        int[] order = new int[n];
        for (int i = 0; i < n; i = i + 1) {
            order[counts[keys[i] - kmin]] = i;
            counts[keys[i] - kmin] = counts[keys[i] - kmin] + 1;
        }

        // Stamp far-to-near. Lighting from the occupancy gradient, smoothed
        // over the voxel's neighbourhood so a hull side is one continuous
        // shade rather than six discrete steps, lit from the upper left the
        // way the original's fixed light vector reads on screen.
        double lx = -0.35; double ly = -0.35; double lz = 0.87;
        for (int i = 0; i < n; i = i + 1) {
            int vi = order[i];
            int x = gx[vi]; int y = gy[vi]; int z = gz[vi];
            // Sum the axis gradients over a 3x3x3 block: a flat wall keeps
            // its axis normal, an edge or rib bends the shade across it.
            int nx = 0; int ny = 0; int nz = 0;
            for (int by = -1; by <= 1; by = by + 1) {
                for (int bx = -1; bx <= 1; bx = bx + 1) {
                    for (int bz = -1; bz <= 1; bz = bz + 1) {
                        nx = nx + ObjectArt.Face(l, x + bx - 1, y + by,
                                                 z + bz)
                           - ObjectArt.Face(l, x + bx + 1, y + by, z + bz);
                        ny = ny + ObjectArt.Face(l, x + bx, y + by - 1,
                                                 z + bz)
                           - ObjectArt.Face(l, x + bx, y + by + 1, z + bz);
                        nz = nz + ObjectArt.Face(l, x + bx, y + by,
                                                 z + bz - 1)
                           - ObjectArt.Face(l, x + bx, y + by, z + bz + 1);
                    }
                }
            }
            int n2 = nx * nx + ny * ny + nz * nz;
            if (n2 == 0) { nx = 0; ny = 0; nz = 1; n2 = 1; }
            double nl = Math.Sqrt((double)n2);
            double dot = ((double)nx * lx + (double)ny * ly
                        + (double)nz * lz) / nl;
            double shade = 0.58 + 0.42 * dot;
            if (shade < 0.25) { shade = 0.25; }
            if (shade > 1.0) { shade = 1.0; }
            int color = l.VoxelAt(x, y, z);
            int r = (int)((double)pal.R8(color) * shade);
            int g = (int)((double)pal.G8(color) * shade);
            int b = (int)((double)pal.B8(color) * shade);
            double cx = (double)(x - sx / 2);
            double cy = (double)(y - sy / 2);
            double rx = cx * cos - cy * sin;
            double ry = cx * sin + cy * cos;
            int px = (int)(((rx - ry) * 0.866 - minPx) * 2.0) + pad;
            int py = (int)(((rx + ry) * 0.5 - (double)z * 0.86 - minPy) * 2.0)
                   + pad;
            // Diamond stamp, two screen pixels per voxel unit, so a voxel
            // covers its projected footprint without scanline gaps.
            for (int dy = -2; dy <= 2; dy = dy + 1) {
                int half = 2 - (dy < 0 ? 0 - dy : dy);
                for (int dx = 0 - half; dx <= half; dx = dx + 1) {
                    int tx = px + dx;
                    int ty = py + dy;
                    if (tx >= 0 && ty >= 0 && tx < w && ty < h) {
                        tex.SetPixel(ty * w + tx, r, g, b, 255);
                    }
                }
            }
        }
        return tex;
    }

    /// <summary>1 when a voxel is filled, 0 for empty or out of bounds --
    /// the occupancy sample the lighting gradient differentiates.</summary>
    static int Face(VxlLimb l, int x, int y, int z) {
        return l.VoxelAt(x, y, z) >= 0 ? 1 : 0;
    }

    /// <summary>How many frames a shape carries, 0 when absent. Drives the
    /// construction animation mapping. Kept in its own cache: the texture
    /// cache's "frame" slot holds a frame index, not a count, so a name-only
    /// lookup there could hand back a frame number as a count.</summary>
    int ShapeFrameCount(string shpName) {
        for (int i = 0; i < this.countNames.Count; i = i + 1) {
            if (this.countNames[i] == shpName) { return this.countVals[i]; }
        }
        int n = 0;
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = this.vfs.Read(shpName, len);
        if (len[0] > 0) {
            ShpImage shp = ShpImage.Parse(raw, len[0]);
            n = shp.FrameCount();
        }
        this.countNames.Add(shpName);
        this.countVals.Add(n);
        return n;
    }

    Texture ShapeTextureFrame(string shpName, int frame, Palette pal) {
        for (int i = 0; i < this.shpNames.Count; i = i + 1) {
            if (this.shpNames[i] == shpName && this.shpFrames[i] == frame
             && this.shpPals[i] == pal) {
                return this.shpCache[i];
            }
        }
        Texture tex = null;
        if (pal != null) {
            List<int> len = new List<int>();
            len.Add(0);
            byte[] raw = this.vfs.Read(shpName, len);
            if (len[0] > 0) {
                ShpImage shp = ShpImage.Parse(raw, len[0]);
                ShpFrame f = shp.FrameAt(frame);
                if (f != null && !f.IsEmpty()) {
                    byte[] idx = shp.DecodeFrame(frame);
                    // Troop frames sit at their own offset inside the
                    // sprite's bounding box, and the box is what aligns the
                    // frames of a cycle -- a walk sprite's feet stay planted
                    // only if every frame lands at its shipped offset.
                    // Buildings fill their box exactly, so this composes to
                    // the plain decode for them.
                    if (shp.Width() > f.Width() || shp.Height() > f.Height()
                     || f.X() != 0 || f.Y() != 0) {
                        Texture full = Texture.Create(shp.Width(),
                                                      shp.Height());
                        Texture part = Texture.FromIndexedShp(idx, f.Width(),
                                                           f.Height(), pal);
                        full.Blit(part, f.X(), f.Y());
                        part.Close();
                        tex = full;
                    } else {
                        tex = Texture.FromIndexedShp(idx, f.Width(), f.Height(),
                                                  pal);
                    }
                }
            }
        }
        this.shpNames.Add(shpName);
        this.shpFrames.Add(frame);
        this.shpPals.Add(pal);
        this.shpCache.Add(tex);
        return tex;
    }

    int IndexOfName(List<string> names, string name) {
        for (int i = 0; i < names.Count; i = i + 1) {
            if (names[i] == name) { return i; }
        }
        return -1;
    }

    void Close() {
        for (int i = 0; i < this.shpCache.Count; i = i + 1) {
            if (this.shpCache[i] != null) { this.shpCache[i].Close(); }
        }
        this.shpCache = new List<Texture>();
        for (int i = 0; i < this.vehTex.Count; i = i + 1) {
            if (this.vehTex[i] != null) { this.vehTex[i].Close(); }
        }
        this.vehTex = new List<Texture>();
        for (int i = 0; i < this.cameoTex.Count; i = i + 1) {
            if (this.cameoTex[i] != null) { this.cameoTex[i].Close(); }
        }
        this.cameoTex = new List<Texture>();
    }
}

/// <summary>Draws the world's objects into a terrain canvas in painter's
/// order, plus a selection ring and the placeholder unit sprite. Pure drawing:
/// where an object sits comes from World, how it looks from ObjectArt.</summary>
class ObjectRenderer {
    /// <summary>The placeholder glyph for objects whose SHP the install does
    /// not carry: a diamond of the owner's colour with a darker outline.
    /// Specialists (engineers, spies) draw small, regular soldiers at the
    /// default size, and structures without art as neutral blocks; the two
    /// side colours keep friend and foe apart on the terrain.</summary>
    static Texture Placeholder(int side, UnitType u) {
        int w = 24;
        if (u != null && u.Role() != UnitRole.None()) { w = 18; }
        int h = w;
        Texture tex = Texture.Create(w, h);
        int r = 46;
        int g = 128;
        int b = 214;
        if (side == Side2.Soviet()) { r = 224; g = 52; b = 48; }
        else if (side == Side2.Yuri()) { r = 154; g = 60; b = 200; }
        else if (side == Side2.Neutral()) { r = 128; g = 128; b = 136; }
        for (int y = 0; y < h; y = y + 1) {
            for (int x = 0; x < w; x = x + 1) {
                bool outline = ((x + y) & 3) < 2;
                if (!outline) { continue; }
                tex.SetPixel(y * w + x, r, g, b, 255);
            }
        }
        return tex;
    }

    /// <summary>Draws every object into the canvas. Returns the number drawn,
    /// mirroring MapRenderer.RenderInto's contract for the caller to report.</summary>
    static int Render(World world, ObjectArt art, Texture canvas, int camX,
                      int camY, int originX, int originY, int playerSide) {
        int drawn = 0;
        List<WorldObject> vis = new List<WorldObject>();
        for (int i = 0; i < world.ObjectCount(); i = i + 1) {
            vis.Add(world.ObjectAt(i));
        }
        ObjectRenderer.SortByDepth(vis);
        for (int i = 0; i < vis.Count; i = i + 1) {
            if (ObjectRenderer.DrawOne(world, art, vis[i], canvas, camX, camY,
                                       originX, originY, playerSide)) {
                drawn = drawn + 1;
            }
        }
        // Combat effects (muzzle flashes, explosions) draw on top so a shot or
        // kill is visible over the sprites involved.
        ObjectRenderer.DrawEffects(world, canvas, camX, camY, originX, originY);
        return drawn;
    }

    /// <summary>Draws live combat effects: flashes are bright dots, explosions
    /// are expanding rings whose size and fade track the remaining life.</summary>
    static void DrawEffects(World world, Texture canvas, int camX, int camY,
                            int originX, int originY) {
        for (int i = 0; i < world.EffectCount(); i = i + 1) {
            int kind = world.EffectKind(i);
            int x = world.EffectX(i);
            int y = world.EffectY(i);
            int life = world.EffectLife(i);
            int wx = IsoProjection.ScreenX(x, y) - originX - camX;
            int wy = IsoProjection.ScreenY(x, y, 0) - originY - camY;
            if (wx < -64 || wy < -64 || wx > canvas.Width() + 64
             || wy > canvas.Height() + 64) { continue; }
            if (kind == 0) {
                // Muzzle flash: a bright yellow dot at the cell apex.
                ObjectRenderer.DrawDot(canvas, wx, wy, 2, 255, 236, 120, 220);
            } else {
                // Explosion: a ring whose radius grows as life fades, plus a
                // hot core in the first few ticks.
                int radius = 18 - life * 2;
                if (radius < 2) { radius = 2; }
                int alpha = 120 + life * 8;
                if (alpha > 240) { alpha = 240; }
                ObjectRenderer.DrawRing2(canvas, wx, wy, radius,
                                         232, 120 + life * 6, 40, alpha);
                if (life > 8) {
                    ObjectRenderer.DrawDot(canvas, wx, wy, 4, 255, 200, 60, 200);
                }
            }
        }
    }

    /// <summary>Fills a filled disc of radius r centred at (cx,cy).</summary>
    static void DrawDot(Texture canvas, int cx, int cy, int r, int cr, int cg,
                        int cb, int ca) {
        for (int dy = 0 - r; dy <= r; dy = dy + 1) {
            int half = ObjectRenderer.Isqrt(r * r - dy * dy);
            for (int dx = 0 - half; dx <= half; dx = dx + 1) {
                int px = cx + dx;
                int py = cy + dy;
                if (px >= 0 && py >= 0 && px < canvas.Width()
                 && py < canvas.Height()) {
                    canvas.SetPixel(py * canvas.Width() + px, cr, cg, cb, ca);
                }
            }
        }
    }

    /// <summary>Integer square root.</summary>
    static int Isqrt(int n) {
        if (n <= 0) { return 0; }
        int x = n;
        int y = (x + 1) / 2;
        while (y < x) {
            x = y;
            y = (x + n / x) / 2;
        }
        return x;
    }

    /// <summary>Draws a diamond ring of radius r (matching the tile shape)
    /// centred at (cx,cy), in the four cardinal points.</summary>
    static void DrawRing2(Texture canvas, int cx, int cy, int r, int cr, int cg,
                          int cb, int ca) {
        for (int i = 0; i <= r; i = i + 1) {
            ObjectRenderer.SetPx(canvas, cx + i, cy + (r - i) / 2, cr, cg, cb, ca);
            ObjectRenderer.SetPx(canvas, cx - i, cy + (r - i) / 2, cr, cg, cb, ca);
            ObjectRenderer.SetPx(canvas, cx + i, cy - (r - i) / 2, cr, cg, cb, ca);
            ObjectRenderer.SetPx(canvas, cx - i, cy - (r - i) / 2, cr, cg, cb, ca);
        }
    }

    static void SetPx(Texture canvas, int x, int y, int cr, int cg, int cb,
                      int ca) {
        if (x >= 0 && y >= 0 && x < canvas.Width() && y < canvas.Height()) {
            canvas.SetPixel(y * canvas.Width() + x, cr, cg, cb, ca);
        }
    }

    /// <summary>Sorts objects back-to-front by x+y so a nearer object covers
    /// the ones behind it, matching the terrain's painter order.</summary>
    static void SortByDepth(List<WorldObject> objs) {
        int n = objs.Count;
        // Selection sort; object counts are tens, not thousands.
        for (int i = 0; i < n - 1; i = i + 1) {
            int best = i;
            for (int j = i + 1; j < n; j = j + 1) {
                if (ObjectRenderer.Depth(objs[j]) < ObjectRenderer.Depth(objs[best])) {
                    best = j;
                }
            }
            if (best != i) {
                WorldObject tmp = objs[i];
                objs[i] = objs[best];
                objs[best] = tmp;
            }
        }
    }

    static int Depth(WorldObject o) { return o.X() + o.Y(); }

    static bool DrawOne(World world, ObjectArt art, WorldObject o, Texture canvas,
                        int camX, int camY, int originX, int originY,
                        int playerSide) {
        int wx = IsoProjection.ScreenX(o.X(), o.Y()) - originX - camX;
        int wy = IsoProjection.ScreenY(o.X(), o.Y(), 0) - originY - camY;
        if (wx > canvas.Width() + 128 || wx < -128
         || wy > canvas.Height() + 128 || wy < -128) {
            return false;
        }

        Texture tex = null;
        UnitType u = null;
        if (o.Kind() == ObjKind.Structure()) {
            // TypeOf routes civilian structures to the civ catalog; a plain
            // side lookup would miss them and drop the sprite.
            StructureType t = world.TypeOf(o);
            if (t != null) {
                tex = art.StructureTextureOf(t, o.Side(), o.BuiltTicks(),
                                                t.BuildTime(), o.Hp(),
                                                t.Hp());
            }
        } else {
            // Units draw their real sprite when the install has the art,
            // otherwise the side-coloured placeholder.
            u = o.UnitType();
            tex = art.UnitTexture(u, o.HasRoute(), o.AnimFrame(), o.Facing(),
                                  o.Side());
        }
        if (tex != null) {
            // The sprite's box is drawn around the cell apex; the building's
            // visual ground is the bottom of the sprite, which the frame's y
            // places below the apex.
            canvas.Blit(tex, wx + (0 - tex.Width() / 2),
                        wy + (0 - tex.Height()));
        }
        // A turreted vehicle's gun mounts over the hull: bake the turret
        // model at its own facing and stamp it on the same anchor, so the
        // gun slews independently of the body. A turret the install lacks
        // falls back to the hull sprite alone, like the original without art.
        if (u != null && tex != null && u.TurretVxl() != null) {
            Texture tur = art.TurretTexture(u.TurretVxl(), o.TurretFacing(),
                                            o.Side());
            if (tur != null) {
                // The turret model is smaller than the hull and sits toward
                // its rear; the hull centre reads as the right mount point.
                canvas.Blit(tur, wx + (0 - tur.Width() / 2),
                            wy + (0 - tur.Height() / 2));
            }
        }
        if (tex == null) {
            Texture ph = ObjectRenderer.Placeholder(o.Side(), u);
            int pw = ph.Width();
            canvas.Blit(ph, wx - pw / 2, wy - pw);
            ph.Close();
        }

        if (o.IsSelected()) {
            // Own units get a green ring, enemy units a red one, so the
            // player can tell at a glance whose selection this is.
            if (o.Side() == playerSide) {
                ObjectRenderer.DrawRing(canvas, wx, wy, 30, 255, 80);
            } else {
                ObjectRenderer.DrawRing(canvas, wx, wy, 232, 60, 60);
            }
        }
        // A health bar above every damaged thing: a dark backing strip and a
        // fill that shrinks as hit points fall. The fill goes green, then
        // yellow, then red as health drops, so danger reads at a glance.
        // Full-health objects get no bar, so the terrain stays clean until a
        // fight breaks out.
        if (o.Hp() < o.MaxHp() && o.MaxHp() > 0) {
            int bw = 30;
            int bx = wx - bw / 2;
            int by = wy - 34;
            canvas.SetPixel((by + 1) * canvas.Width() + (bx - 1), 0, 0, 0, 160);
            canvas.SetPixel((by + 1) * canvas.Width() + (bx + bw), 0, 0, 0, 160);
            int fill = bw * o.Hp() / o.MaxHp();
            for (int i = 0; i <= bw + 1; i = i + 1) {
                canvas.SetPixel(by * canvas.Width() + (bx - 1 + i), 0, 0, 0, 160);
                canvas.SetPixel((by + 2) * canvas.Width() + (bx - 1 + i), 0, 0, 0, 160);
            }
            int hr = 62;
            int hg = 224;
            int hb = 74;
            if (fill < bw / 2) { hr = 232; hg = 60; hb = 60; }
            else if (fill < bw * 3 / 4) { hr = 236; hg = 200; hb = 60; }
            for (int i = 0; i < fill; i = i + 1) {
                canvas.SetPixel((by + 1) * canvas.Width() + (bx + i), hr, hg, hb, 255);
            }
            if (fill < bw) {
                canvas.SetPixel((by + 1) * canvas.Width() + (bx + fill), 160, 0, 0, 255);
            }
        }
        return true;
    }

    /// <summary>A diamond outline around a unit or building's anchor, so the
    /// selection is visible against any ground. Four edges closing at the four
    /// apexes, matching the isometric tile shape.</summary>
    static void DrawRing(Texture canvas, int cx, int cy, int cr, int cg,
                         int cb) {
        int a = 255;
        // Top -> right, right -> bottom, bottom -> left, left -> top. Each edge
        // runs r steps from one apex to the next.
        for (int i = 0; i <= 15; i = i + 1) {
            canvas.SetPixel((cy - 15 + i) * canvas.Width() + (cx + i), cr, cg, cb, a);
            canvas.SetPixel((cy + i) * canvas.Width() + (cx + 15 - i), cr, cg, cb, a);
            canvas.SetPixel((cy + 15 - i) * canvas.Width() + (cx - i), cr, cg, cb, a);
            canvas.SetPixel((cy - i) * canvas.Width() + (cx - 15 + i), cr, cg, cb, a);
        }
    }
}
