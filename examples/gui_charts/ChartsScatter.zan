    /// example/scatter2 标准气泡图：100 点 ×2 系列的 [x, y, z=|rand|]，
    /// 气泡直径 = round(z/5)（原版 symbolSize:function(value) 回调，这里
    /// 落成逐点 size），双 value 轴 scale:true + splitNumber:4；图例
    /// scatter1/scatter2，无标题。原版 Math.random 不可复现：符号跟随
    /// 自身奇偶（r 偶正奇负）照抄，数值走二次 mod 确定性流形，
    /// 两系列系数不同（同 i 空间不重合，防点对点重叠）。
    static void Scatter2(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of("", null, new List<ChartSeries>());
        for (int r = 0; r < 2; r = r + 1) {
            List<ChartPoint> pts = new List<ChartPoint>();
            for (int i = 0; i < 100; i = i + 1) {
                int xr;
                int yr;
                int zr;
                if (r == 0) {
                    xr = (i * i * 3 + i * 73 + 19) % 101;
                    yr = (i * i * 5 + i * 151 + 53) % 101;
                    zr = (i * i * 7 + i * 37 + 97) % 101;
                } else {
                    xr = (i * i * 11 + i * 149 + 71) % 101;
                    yr = (i * i * 13 + i * 101 + 37) % 101;
                    zr = (i * i * 17 + i * 59 + 5) % 101;
                }
                pts.Add(ChartPoint.Sized(
                    xr % 2 == 0 ? xr : 0 - xr,
                    yr % 2 == 0 ? yr : 0 - yr,
                    (2 * zr + 5) / 10));
            }
            o.Add(ChartSeries.OfPoints(
                Charts.T("scatter" + (r + 1), "scatter" + (r + 1)), pts));
        }
        o.X(ChartAxis.Value());
        o.xAxes[0].ticks = 4;
        o.Y(ChartAxis.Value());
        o.yAxes[0].ticks = 4;
        Charts.Show(app, o, x, y, w, h);
    }

    /// example/scatter3 大规模散点图：sin/cos 各 10000 点，large:true。
    /// x=(rand*10).toFixed(3)，y=(sin/cos(x)−x·(len 奇偶 ∓0.1)·rand)
    /// .toFixed(3)。小数坐标 ×1000 定点入 points（series.pointG=1000，
    /// 引擎渲染/量程/命中/tooltip 统一除回）；密集点云用小号
    /// symbolSize 4。原版 Math.random 不可复现：二次 mod 确定性流形，
    /// 两系列系数不同（同 b 空间不重合）。
    static void Scatter3(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of("", null, new List<ChartSeries>());
        for (int r = 0; r < 2; r = r + 1) {
            List<ChartPoint> pts = new List<ChartPoint>();
            for (int i = 0; i < 10000; i = i + 1) {
                int xi;
                int rnd;
                if (r == 0) {
                    xi = (i * i * 11 + i * 197 + 3) % 10000;
                    rnd = (i * i * 13 + i * 89 + 41) % 1001;
                } else {
                    xi = (i * i * 17 + i * 397 + 701) % 10000;
                    rnd = (i * i * 19 + i * 149 + 887) % 1001;
                }
                int deg = (xi * 57296 + 500000) / 1000000;
                int yv = r == 0 ? ChartView.SinDeg(deg) : ChartView.CosDeg(deg);
                int w1000 = xi * rnd / 10000;
                yv = i % 2 == 0 ? yv - w1000 : yv + w1000;
                pts.Add(ChartPoint.Of(xi, yv));
            }
            ChartSeries s = ChartSeries.OfPoints(
                r == 0 ? Charts.T("sin", "sin") : Charts.T("cos", "cos"), pts);
            s.pointG = 1000;
            s.symbolSize = 4;
            o.Add(s);
        }
        o.X(ChartAxis.Value());
        o.Y(ChartAxis.Value());
        Charts.Show(app, o, x, y, w, h);
    }

    /// ECharts2 scatter5「类目坐标散点图」：500 个类目 × 2 系列，
    /// 每点 [类目序号, y=0..30.00, z=0..100.00]，气泡直径
    /// round(z/10)、颜色按 z 走 lightgreen→orange 渐变；dataZoom
    /// 初始窗口 30%..70%。随机量用逐系列二次 mod 流形替代。
    static void Scatter4(App app, int x, int y, int w, int h) {
        List<int> ramp = new List<int>{
            Chart.Rgb(173, 255, 47), Chart.Rgb(255, 165, 0) };
        ChartSeries s1 = ChartSeries.OfPoints(Charts.T("series1", "series1"),
            new List<ChartPoint>());
        ChartSeries s2 = ChartSeries.OfPoints(Charts.T("series2", "series2"),
            new List<ChartPoint>());
        s1.pointG = 100;
        s2.pointG = 100;
        for (int i = 0; i < 500; i = i + 1) {
            int y1 = (i * i * 7 + i * 61 + 13) % 3001;
            int z1 = (i * i * 11 + i * 89 + 29) % 10001;
            ChartPoint p1 = ChartPoint.Sized((i + 1) * 100, y1, (z1 + 500) / 1000);
            p1.color = Chart.RampAt(ramp, z1 / 10);
            s1.points.Add(p1);
            int y2 = (i * i * 13 + i * 97 + 511) % 3001;
            int z2 = (i * i * 17 + i * 43 + 733) % 10001;
            ChartPoint p2 = ChartPoint.Sized((i + 1) * 100, y2, (z2 + 500) / 1000);
            p2.color = Chart.RampAt(ramp, z2 / 10);
            s2.points.Add(p2);
        }
        ChartOption o = ChartOption.Of(Charts.T("Category scatter", "类目坐标散点图"),
            null, new List<ChartSeries>{ s1, s2 });
        o.titleSub = Charts.T("dataZoom support", "dataZoom支持");
        ChartAxis xa = ChartAxis.Value();
        xa.labelFormatter = Charts.T("Category {value}", "类目{value}");
        o.X(xa);
        o.zoom = true;
        o.zoomStart = 30;
        o.zoomEnd = 70;
        Charts.Show(app, o, x, y, w, h);
    }

    /// ECharts2 scatter6「时间坐标散点图」：1500 点 [2014-10-01 起
    /// 0..10000 分钟, y=0..30.00, z=0..100.00]，气泡直径 round(z/10)、
    /// 颜色按 z 走 lightgreen→orange 渐变；X 轴时间刻度（整数天数
    /// ×1000 定点），dataZoom 初始窗口 30%..70%。随机量用二次 mod
    /// 流形替代。
    static void Scatter5(App app, int x, int y, int w, int h) {
        List<int> ramp = new List<int>{
            Chart.Rgb(173, 255, 47), Chart.Rgb(255, 165, 0) };
        List<ChartPoint> pts = new List<ChartPoint>();
        for (int i = 0; i < 1500; i = i + 1) {
            int m = (i * i * 13 + i * 271 + 97) % 10001;
            int y1000 = (i * i * 7 + i * 89 + 41) % 30001;
            int z100 = (i * i * 11 + i * 23 + 617) % 10001;
            ChartPoint p = ChartPoint.Sized(16333000 + m * 1000 / 1440, y1000,
                (z100 + 500) / 1000);
            p.color = Chart.RampAt(ramp, z100 / 10);
            pts.Add(p);
        }
        ChartSeries s1 = ChartSeries.OfPoints(Charts.T("series1", "series1"), pts);
        s1.pointG = 1000;
        ChartOption o = ChartOption.Of(Charts.T("Time scatter", "时间坐标散点图"),
            null, new List<ChartSeries>{ s1 });
        o.titleSub = Charts.T("dataZoom support", "dataZoom支持");
        o.X(ChartAxis.Time());
        o.zoom = true;
        o.zoomStart = 30;
        o.zoomEnd = 70;
        Charts.Show(app, o, x, y, w, h);
    }

    /// ECharts2 scatter4「搭配时间轴」：2002..2011 全国宏观经济
    /// 关联分析（x=房地产投资 亿元，y=GDP 亿元，各 31 省份，逐点
    /// 省名标签 + x/y 均值红线），ChartTimeline 播放器条逐帧切换，
    /// 数据为原例国家统计局真实值（亿元×100 定点，pointG=100）。
    static void Scatter6(App app, int x, int y, int w, int h) {
        List<string> provs = ChartsMacroData.Provinces();
        ChartTimeline tl = ChartTimeline.Of();
        List<string> labels = new List<string>();
        ChartOption first = null;
        for (int yi = 0; yi < 10; yi = yi + 1) {
            List<ChartPoint> pts = new List<ChartPoint>();
            List<int> es = ChartsMacroData.EstateYear(yi);
            List<int> gs = ChartsMacroData.GdpYear(yi);
            for (int i = 0; i < 31; i = i + 1) {
                ChartPoint p = ChartPoint.Of(es[i], gs[i]);
                p.name = provs[i];
                pts.Add(p);
            }
            ChartSeries s1 = ChartSeries.OfPoints(Charts.T("GDP", "GDP"), pts);
            s1.pointG = 100;
            s1.symbolSize = 5;
            s1.labelShow = true;
            ChartMarkLine ya = ChartMarkLine.Average(Charts.T("y average", "y平均值"));
            ya.color = Chart.Rgb(255, 0, 0);
            s1.MarkLine(ya);
            ChartMarkLine xa = ChartMarkLine.Average(Charts.T("x average", "x平均值"));
            xa.valueIndex = 0;
            xa.color = Chart.Rgb(255, 0, 0);
            s1.MarkLine(xa);
            ChartOption fr = ChartOption.Of(Charts.T(
                    Convert.ToString(2002 + yi) + " National economy (GDP vs real estate)",
                    Convert.ToString(2002 + yi) + "全国宏观经济关联分析（GDP vs 房地产）"),
                null, new List<ChartSeries>{ s1 });
            if (yi == 0) {
                fr.titleSub = Charts.T("Data from NBS", "数据来自国家统计局");
            }
            ChartAxis xax = ChartAxis.ValueRange(0, 3400);
            xax.title = Charts.T("Real estate (100M CNY)", "房地产（亿元）");
            fr.X(xax);
            ChartAxis yax = ChartAxis.ValueRange(0, 53500);
            yax.title = Charts.T("GDP (100M CNY)", "GDP（亿元）");
            fr.Y(yax);
            tl = tl.Frame(fr);
            labels.Add(Convert.ToString(2002 + yi));
            if (yi == 0) { first = fr; }
        }
        tl = tl.Labels(labels).AutoPlay(1000);
        // 布局：图表占上部，播放器条贴底（同 pie7）。
        int key = Charts.KeyOf(Charts.selected.Get(), 0);
        int barH = ChartTimeline.Height(app);
        int idx = ChartTimeline.TimelineIdxOf(app, key, tl.FrameCount());
        ChartView.KeyedStatic(ChartTimeline.Merge(first, tl.Current(idx)),
            key).Render(app, x, y, w, h - barH);
        tl.Draw(app, key, x, y + h - barH, w);
    }

    /// ECharts2 dataRange1「搭配值域漫游」：500 点 [x=v+rand·v,
    /// y=rand·v, z=v]（×100 定点 pointG=100），dataRange 竖条
    /// lightgreen→yellow calculable 按第三维 z 着色/筛选，y 轴挂
    /// 右侧（ECharts yAxis.position:'right'）。二次 mod 流形替代
    /// Math.random，无标题无图例同原例。
    static void Scatter7(App app, int x, int y, int w, int h) {
        List<ChartPoint> pts = new List<ChartPoint>();
        for (int i = 0; i < 500; i = i + 1) {
            int v = (i * i * 11 + i * 271 + 97) % 10001;
            int rx = (i * i * 7 + i * 89 + 41) % 10001;
            int ry = (i * i * 13 + i * 23 + 617) % 10001;
            ChartPoint p = ChartPoint.Of(v + rx * v / 10000, ry * v / 10000);
            p.z = v;
            pts.Add(p);
        }
        ChartSeries s1 = ChartSeries.OfPoints(Charts.T("scatter1", "scatter1"), pts);
        s1.pointG = 100;
        s1.symbolSize = 5;
        ChartOption o = ChartOption.Of(Charts.T("", ""),
            null, new List<ChartSeries>{ s1 });
        o.showLegend = false;
        ChartAxis xa = ChartAxis.Value();
        ChartAxis ya = ChartAxis.Value();
        ya.position = "right";
        o.X(xa);
        o.Y(ya);
        o.VisualRange(0, 100, new List<int>{
            Chart.Rgb(173, 255, 47), Chart.Rgb(255, 255, 0) });
        o.dataRangeShow = true;
        o.dataRangeCalculable = true;
        o.dataRangeSplit = 5;
        Charts.Show(app, o, x, y, w, h);
    }

    static void Scatter8(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Styled scatter", "散点图个性化"),
            null, new List<ChartSeries>{
                ChartSeries.OfPoints(Charts.T("A", "A 组"), Charts.HeightMale())
            });
        o.X(ChartAxis.ValueRange(140, 200));
        o.Y(ChartAxis.ValueRange(40, 90));
        o.showValues = true;
        Charts.Show(app, o, x, y, w, h);
    }

    /// symbol 形状族演示（ECharts series.symbol/symbolSize/
    /// showSymbol + 逐点颜色）：四组散点各用一种形状，
    /// 第四组叠加逐点尺寸与逐点颜色。
    static void Scatter9(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Symbol shapes", "散点形状族"),
            null, new List<ChartSeries>());
        List<ChartPoint> circle = new List<ChartPoint>();
        List<ChartPoint> diamond = new List<ChartPoint>();
        List<ChartPoint> tri = new List<ChartPoint>();
        List<ChartPoint> mix = new List<ChartPoint>();
        for (int i = 0; i < 14; i = i + 1) {
            circle.Add(ChartPoint.Of(150 + i * 3, 50 + (i * i) % 23));
            diamond.Add(ChartPoint.Of(150 + i * 3, 60 + (i * i) % 17));
            tri.Add(ChartPoint.Of(150 + i * 3, 42 + (i * 7) % 19));
            ChartPoint m = ChartPoint.Sized(152 + i * 3, 74 + (i * 11) % 13, 8 + (i % 3) * 3);
            m.color = i % 3 == 0 ? Chart.Rgb(238, 102, 102) : 0;
            mix.Add(m);
        }
        ChartSeries s1 = ChartSeries.OfPoints(Charts.T("Circle", "圆点"), circle);
        ChartSeries s2 = ChartSeries.OfPoints(Charts.T("Diamond", "菱形"), diamond);
        s2.symbol = "diamond";
        ChartSeries s3 = ChartSeries.OfPoints(Charts.T("Triangle", "三角"), tri);
        s3.symbol = "triangle";
        s3.symbolSize = 12;
        ChartSeries s4 = ChartSeries.OfPoints(Charts.T("Empty + sized", "空心圆 + 逐点尺寸"), mix);
        s4.symbol = "emptyCircle";
        o.Add(s1);
        o.Add(s2);
        o.Add(s3);
        o.Add(s4);
        o.X(ChartAxis.ValueRange(148, 200));
        o.Y(ChartAxis.ValueRange(35, 95));
        Charts.Show(app, o, x, y, w, h);
    }

    /// dataRange 连续值域筛选（ECharts 2.x dataRange + calculable）：
    /// 散点按 Y 值走冷→暖色带，色带下方双把手窗口外的点灰显；
    /// 拖两端把手即时过滤（0..1000 量化状态，同 dataZoom 约定）。
    static void Scatter10(App app, int x, int y, int w, int h) {
        List<ChartPoint> pts = new List<ChartPoint>();
        for (int i = 0; i < 60; i = i + 1) {
            pts.Add(ChartPoint.Of((i * 29 + 13) % 100, 5 + (i * 17) % 90));
        }
        ChartOption o = ChartOption.Of(Charts.T("dataRange slider", "值域筛选散点"),
            null, new List<ChartSeries>{ ChartSeries.OfPoints(Charts.T("S", "样本"), pts) });
        o.X(ChartAxis.ValueRange(0, 100));
        o.Y(ChartAxis.ValueRange(0, 100));
        o.VisualRange(0, 100, new List<int>{
            Chart.Rgb(42, 145, 221), Chart.Rgb(255, 215, 80), Chart.Rgb(223, 69, 55) });
        o.dataRangeShow = true;
        o.dataRangeCalculable = true;
        o.dataRangeSplit = 6;
        o.dataRangeLo = 0;
        o.dataRangeHi = 100;
        Charts.Show(app, o, x, y, w, h);
    }

    /// dataRange splitList 形态（ECharts 2.x dataRange.data）：
    /// 命名区间逐段点选，点掉的段整段灰掉（不再上色）。
    static void Scatter11(App app, int x, int y, int w, int h) {
        List<ChartPoint> pts = new List<ChartPoint>();
        for (int i = 0; i < 60; i = i + 1) {
            pts.Add(ChartPoint.Of((i * 31 + 7) % 100, 5 + (i * 23) % 90));
        }
        ChartOption o = ChartOption.Of(Charts.T("dataRange splitList", "值域分段筛选"),
            null, new List<ChartSeries>{ ChartSeries.OfPoints(Charts.T("S", "样本"), pts) });
        o.X(ChartAxis.ValueRange(0, 100));
        o.Y(ChartAxis.ValueRange(0, 100));
        o.VisualRange(0, 100, new List<int>{
            Chart.Rgb(42, 145, 221), Chart.Rgb(255, 215, 80), Chart.Rgb(223, 69, 55) });
        o.dataRangeShow = true;
        o.dataRangeList.Add(ChartRangeSplit.Of(Charts.T("Low", "低"), 0, 30));
        o.dataRangeList.Add(ChartRangeSplit.Of(Charts.T("Mid", "中"), 30, 60));
        o.dataRangeList.Add(ChartRangeSplit.Of(Charts.T("High", "高"), 60, 100));
        Charts.Show(app, o, x, y, w, h);
    }

