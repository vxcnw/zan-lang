    /// example/scatter2 标准气泡图：100 点 ×2 系列的 [x, y, z=|rand|]，
    /// 气泡直径 = round(z/5)（原版 symbolSize:function(value) 回调，这里
    /// 落成逐点 size），双 value 轴 scale:true + splitNumber:4；图例
    /// scatter1/scatter2，无标题。原版 Math.random 不可复现：符号跟随
    /// 自身奇偶（r 偶正奇负）照抄，数值走二次 mod 确定性流形，
    /// 两系列系数不同（同 i 空间不重合，防点对点重叠）。
    static void Scatter2(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of("", null, new List<ChartSeries>());
        for (int r = 0; r < 2; r = r + 1) {
            List<ChartPoint> pts = new List<ChartPoint>();
            for (int i = 0; i < 100; i = i + 1) {
                int xr;
                int yr;
                int zr;
                if (r == 0) {
                    xr = (i * i * 3 + i * 73 + 19) % 101;
                    yr = (i * i * 5 + i * 151 + 53) % 101;
                    zr = (i * i * 7 + i * 37 + 97) % 101;
                } else {
                    xr = (i * i * 11 + i * 149 + 71) % 101;
                    yr = (i * i * 13 + i * 101 + 37) % 101;
                    zr = (i * i * 17 + i * 59 + 5) % 101;
                }
                pts.Add(ChartPoint.Sized(
                    xr % 2 == 0 ? xr : 0 - xr,
                    yr % 2 == 0 ? yr : 0 - yr,
                    (2 * zr + 5) / 10));
            }
            o.Add(ChartSeries.OfPoints(
                Charts.T("scatter" + (r + 1), "scatter" + (r + 1)), pts));
        }
        o.X(ChartAxis.Value());
        o.xAxes[0].ticks = 4;
        o.Y(ChartAxis.Value());
        o.yAxes[0].ticks = 4;
        Charts.Show(app, o, x, y, w, h);
    }

    /// example/scatter3 大规模散点图：sin/cos 各 10000 点，large:true。
    /// x=(rand*10).toFixed(3)，y=(sin/cos(x)−x·(len 奇偶 ∓0.1)·rand)
    /// .toFixed(3)。小数坐标 ×1000 定点入 points（series.pointG=1000，
    /// 引擎渲染/量程/命中/tooltip 统一除回）；密集点云用小号
    /// symbolSize 4。原版 Math.random 不可复现：二次 mod 确定性流形，
    /// 两系列系数不同（同 b 空间不重合）。
    static void Scatter3(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of("", null, new List<ChartSeries>());
        for (int r = 0; r < 2; r = r + 1) {
            List<ChartPoint> pts = new List<ChartPoint>();
            for (int i = 0; i < 10000; i = i + 1) {
                int xi;
                int rnd;
                if (r == 0) {
                    xi = (i * i * 11 + i * 197 + 3) % 10000;
                    rnd = (i * i * 13 + i * 89 + 41) % 1001;
                } else {
                    xi = (i * i * 17 + i * 397 + 701) % 10000;
                    rnd = (i * i * 19 + i * 149 + 887) % 1001;
                }
                int deg = (xi * 57296 + 500000) / 1000000;
                int yv = r == 0 ? ChartView.SinDeg(deg) : ChartView.CosDeg(deg);
                int w1000 = xi * rnd / 10000;
                yv = i % 2 == 0 ? yv - w1000 : yv + w1000;
                pts.Add(ChartPoint.Of(xi, yv));
            }
            ChartSeries s = ChartSeries.OfPoints(
                r == 0 ? Charts.T("sin", "sin") : Charts.T("cos", "cos"), pts);
            s.pointG = 1000;
            s.symbolSize = 4;
            o.Add(s);
        }
        o.X(ChartAxis.Value());
        o.Y(ChartAxis.Value());
        Charts.Show(app, o, x, y, w, h);
    }

    static void Scatter4(App app, int x, int y, int w, int h) {
        List<ChartPoint> pts = new List<ChartPoint>();
        for (int i = 0; i < 40; i = i + 1) {
            pts.Add(ChartPoint.Of(i, 20 + (i * 13) % 50));
        }
        ChartOption o = ChartOption.Of(Charts.T("Category scatter", "类目散点图"),
            Charts.Week(), new List<ChartSeries>{
                ChartSeries.OfPoints(Charts.T("Samples", "样本"), pts)
            });
        o.zoom = true;
        Charts.Show(app, o, x, y, w, h);
    }

    static void Scatter5(App app, int x, int y, int w, int h) {
        List<ChartPoint> pts = new List<ChartPoint>();
        for (int i = 0; i < 24; i = i + 1) {
            pts.Add(ChartPoint.Of(i, 40 + ChartView.SinDeg(i * 15) * 20 / 1000));
        }
        ChartOption o = ChartOption.Of(Charts.T("Hourly samples", "时间坐标散点"),
            null, new List<ChartSeries>{
                ChartSeries.OfPoints(Charts.T("Temp", "气温"), pts)
            });
        o.X(ChartAxis.ValueRange(0, 23));
        Charts.Show(app, o, x, y, w, h);
    }

    static void Scatter6(App app, int x, int y, int w, int h) {
        List<Bubble> y2000 = new List<Bubble>{
            Bubble.Of(40, 70, 20), Bubble.Of(55, 65, 35), Bubble.Of(70, 80, 50),
            Bubble.Of(30, 50, 12), Bubble.Of(85, 90, 60) };
        List<Bubble> y2010 = new List<Bubble>{
            Bubble.Of(48, 75, 24), Bubble.Of(62, 72, 40), Bubble.Of(78, 85, 55),
            Bubble.Of(38, 58, 16), Bubble.Of(90, 92, 70) };
        ChartOption a = ChartOption.Of("2000", null,
            new List<ChartSeries>{ ChartSeries.OfBubbles("2000", y2000) });
        a.X(ChartAxis.ValueRange(0, 100));
        a.Y(ChartAxis.ValueRange(0, 100));
        ChartOption b = ChartOption.Of("2010", null,
            new List<ChartSeries>{ ChartSeries.OfBubbles("2010", y2010) });
        b.X(ChartAxis.ValueRange(0, 100));
        b.Y(ChartAxis.ValueRange(0, 100));
        Charts.Split2(app, a, b, x, y, w, h);
    }

    static void Scatter7(App app, int x, int y, int w, int h) {
        List<Bubble> bs = new List<Bubble>();
        for (int i = 0; i < 40; i = i + 1) {
            bs.Add(Bubble.Of((i * 17 + 3) % 95, (i * 23 + 9) % 90, 4 + (i * 7) % 30));
        }
        ChartOption o = ChartOption.Of(Charts.T("Range roam", "值域漫游散点"),
            null, new List<ChartSeries>{ ChartSeries.OfBubbles(Charts.T("GDP", "GDP"), bs) });
        o.X(ChartAxis.ValueRange(0, 100));
        o.Y(ChartAxis.ValueRange(0, 100));
        Charts.Show(app, o, x, y, w, h);
    }

    static void Scatter8(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Styled scatter", "散点图个性化"),
            null, new List<ChartSeries>{
                ChartSeries.OfPoints(Charts.T("A", "A 组"), Charts.HeightMale())
            });
        o.X(ChartAxis.ValueRange(140, 200));
        o.Y(ChartAxis.ValueRange(40, 90));
        o.showValues = true;
        Charts.Show(app, o, x, y, w, h);
    }

    /// symbol 形状族演示（ECharts series.symbol/symbolSize/
    /// showSymbol + 逐点颜色）：四组散点各用一种形状，
    /// 第四组叠加逐点尺寸与逐点颜色。
    static void Scatter9(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Symbol shapes", "散点形状族"),
            null, new List<ChartSeries>());
        List<ChartPoint> circle = new List<ChartPoint>();
        List<ChartPoint> diamond = new List<ChartPoint>();
        List<ChartPoint> tri = new List<ChartPoint>();
        List<ChartPoint> mix = new List<ChartPoint>();
        for (int i = 0; i < 14; i = i + 1) {
            circle.Add(ChartPoint.Of(150 + i * 3, 50 + (i * i) % 23));
            diamond.Add(ChartPoint.Of(150 + i * 3, 60 + (i * i) % 17));
            tri.Add(ChartPoint.Of(150 + i * 3, 42 + (i * 7) % 19));
            ChartPoint m = ChartPoint.Sized(152 + i * 3, 74 + (i * 11) % 13, 8 + (i % 3) * 3);
            m.color = i % 3 == 0 ? Chart.Rgb(238, 102, 102) : 0;
            mix.Add(m);
        }
        ChartSeries s1 = ChartSeries.OfPoints(Charts.T("Circle", "圆点"), circle);
        ChartSeries s2 = ChartSeries.OfPoints(Charts.T("Diamond", "菱形"), diamond);
        s2.symbol = "diamond";
        ChartSeries s3 = ChartSeries.OfPoints(Charts.T("Triangle", "三角"), tri);
        s3.symbol = "triangle";
        s3.symbolSize = 12;
        ChartSeries s4 = ChartSeries.OfPoints(Charts.T("Empty + sized", "空心圆 + 逐点尺寸"), mix);
        s4.symbol = "emptyCircle";
        o.Add(s1);
        o.Add(s2);
        o.Add(s3);
        o.Add(s4);
        o.X(ChartAxis.ValueRange(148, 200));
        o.Y(ChartAxis.ValueRange(35, 95));
        Charts.Show(app, o, x, y, w, h);
    }

    /// dataRange 连续值域筛选（ECharts 2.x dataRange + calculable）：
    /// 散点按 Y 值走冷→暖色带，色带下方双把手窗口外的点灰显；
    /// 拖两端把手即时过滤（0..1000 量化状态，同 dataZoom 约定）。
    static void Scatter10(App app, int x, int y, int w, int h) {
        List<ChartPoint> pts = new List<ChartPoint>();
        for (int i = 0; i < 60; i = i + 1) {
            pts.Add(ChartPoint.Of((i * 29 + 13) % 100, 5 + (i * 17) % 90));
        }
        ChartOption o = ChartOption.Of(Charts.T("dataRange slider", "值域筛选散点"),
            null, new List<ChartSeries>{ ChartSeries.OfPoints(Charts.T("S", "样本"), pts) });
        o.X(ChartAxis.ValueRange(0, 100));
        o.Y(ChartAxis.ValueRange(0, 100));
        o.VisualRange(0, 100, new List<int>{
            Chart.Rgb(42, 145, 221), Chart.Rgb(255, 215, 80), Chart.Rgb(223, 69, 55) });
        o.dataRangeShow = true;
        o.dataRangeCalculable = true;
        o.dataRangeSplit = 6;
        o.dataRangeLo = 0;
        o.dataRangeHi = 100;
        Charts.Show(app, o, x, y, w, h);
    }

    /// dataRange splitList 形态（ECharts 2.x dataRange.data）：
    /// 命名区间逐段点选，点掉的段整段灰掉（不再上色）。
    static void Scatter11(App app, int x, int y, int w, int h) {
        List<ChartPoint> pts = new List<ChartPoint>();
        for (int i = 0; i < 60; i = i + 1) {
            pts.Add(ChartPoint.Of((i * 31 + 7) % 100, 5 + (i * 23) % 90));
        }
        ChartOption o = ChartOption.Of(Charts.T("dataRange splitList", "值域分段筛选"),
            null, new List<ChartSeries>{ ChartSeries.OfPoints(Charts.T("S", "样本"), pts) });
        o.X(ChartAxis.ValueRange(0, 100));
        o.Y(ChartAxis.ValueRange(0, 100));
        o.VisualRange(0, 100, new List<int>{
            Chart.Rgb(42, 145, 221), Chart.Rgb(255, 215, 80), Chart.Rgb(223, 69, 55) });
        o.dataRangeShow = true;
        o.dataRangeList.Add(ChartRangeSplit.Of(Charts.T("Low", "低"), 0, 30));
        o.dataRangeList.Add(ChartRangeSplit.Of(Charts.T("Mid", "中"), 30, 60));
        o.dataRangeList.Add(ChartRangeSplit.Of(Charts.T("High", "高"), 60, 100));
        Charts.Show(app, o, x, y, w, h);
    }

