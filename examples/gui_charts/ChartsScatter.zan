    static void K1(App app, int x, int y, int w, int h) {
        List<Candle> cs = Charts.K1Data();
        Candle first = cs[0];
        first.itemStyle = ChartItemStyle.Create();
        first.itemStyle.normal.color0 = Chart.Rgb(0, 0, 255);
        first.itemStyle.normal.lineStyle.width = 3;
        first.itemStyle.normal.lineStyle.color0 = Chart.Rgb(0, 0, 255);
        ChartMarkPoint mp = ChartMarkPoint.Max();
        mp.name = Charts.T("High", "最高");
        mp.label = "2444.8";
        mp.color = Chart.Rgb(46, 199, 201);
        ChartSeries k = ChartSeries.OfCandles(
            Charts.T("Shanghai Composite", "上证指数"), cs);
        k.color = Chart.Rgb(255, 0, 0);   // 图例色块随 ECharts 取系列主色
        k.itemStyle.normal.color = Chart.Rgb(255, 0, 0);
        k.itemStyle.normal.color0 = Chart.Rgb(144, 238, 144);
        k.itemStyle.normal.lineStyle.color = Chart.Rgb(255, 128, 0);
        k.itemStyle.normal.lineStyle.color0 = Chart.Rgb(0, 128, 0);
        k.itemStyle.normal.lineStyle.width = 2;
        k.MarkPoint(mp);
        // ref k1 无 title，顶部只有居中图例「上证指数」。
        ChartOption o = ChartOption.Of(Charts.T("", ""),
            new List<string>{
                "2013/1/24", "2013/1/25", "2013/1/28", "2013/1/29", "2013/1/30", "2013/1/31",
                "2013/2/1", "2013/2/4", "2013/2/5", "2013/2/6", "2013/2/7", "2013/2/8",
