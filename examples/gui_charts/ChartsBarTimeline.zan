    /// bar11 每帧的完整系列快照（ChartTimeline.Merge 整系列
    /// 替换，markLine/hidden/axisIndex 必须逐帧重带）。
    static List<ChartSeries> Bar11Series(int yi) {
        List<List<int>> gdp = Charts.Bar11Gdp();
        List<List<int>> fin = Charts.Bar11Financial();
        List<List<int>> est = Charts.Bar11Estate();
        List<List<int>> pi = Charts.Bar11Pi();
        List<List<int>> si = Charts.Bar11Si();
        List<List<int>> ti = Charts.Bar11Ti();
        ChartSeries g = ChartSeries.Bar("GDP", gdp[yi]);
        g.MarkLine(ChartMarkLine.Average());
        g.markLines[0].color = Chart.Rgb(255, 165, 0);
        ChartSeries f2 = ChartSeries.Bar(Charts.T("Finance", "金融"), fin[yi]);
        f2.axisIndex = 1;
        f2.hidden = true;
        ChartSeries e = ChartSeries.Bar(Charts.T("Estate", "房地产"), est[yi]);
        e.axisIndex = 1;
        ChartSeries p = ChartSeries.Bar(Charts.T("Primary industry", "第一产业"), pi[yi]);
        p.axisIndex = 1;
        p.hidden = true;
        ChartSeries s2 = ChartSeries.Bar(Charts.T("Secondary industry", "第二产业"), si[yi]);
        s2.axisIndex = 1;
        s2.hidden = true;
        ChartSeries t2 = ChartSeries.Bar(Charts.T("Tertiary industry", "第三产业"), ti[yi]);
        t2.axisIndex = 1;
        t2.hidden = true;
        return new List<ChartSeries>{ g, f2, e, p, s2, t2 };
    }
}
