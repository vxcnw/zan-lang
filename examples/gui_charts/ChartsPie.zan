using System;
using Gui;
using Gui.Component.Chart;

partial class Charts {
    static List<ChartData> PieTraffic() {
        return new List<ChartData>{
            ChartData.Named(335, Charts.T("Direct", "直接访问")),
            ChartData.Named(310, Charts.T("Mail", "邮件营销")),
            ChartData.Named(234, Charts.T("Affiliate", "联盟广告")),
            ChartData.Named(135, Charts.T("Video", "视频广告")),
            ChartData.Named(1548, Charts.T("Search", "搜索引擎"))
        };
    }

    /// pie1（ECharts2 pie.opt.js）1:1：同一 option 三个 pie 系列
    /// ——35% 处小实心饼（radius 80px，内标百分比）+ 大环形
    ///（radius [110,140]px，8 项外标）+ 75% 处环形（radius
    /// [80,120]px，无标签）。半径沿用官方绝对像素：尺寸不随窗口
    /// 缩放，多饼圆心按百分比相对面板——窗口变化只动位置不动
    /// 大小，图形间关系（同心/间距/搭接）保持稳定。
    /// 百度径向渐变以单色近似；calculable/逐 data 隐藏标签、
    /// star 徽标未支持（偏差）。
    static void Pie1(App app, int x, int y, int w, int h) {
        List<ChartData> small = new List<ChartData>{
            ChartData.Named(335, Charts.T("Direct", "直达")),
            ChartData.Named(679, Charts.T("Marketing", "营销广告")),
            ChartData.Named(1548, Charts.T("Search Engine", "搜索引擎")) };
        List<ChartData> ring = new List<ChartData>{
            ChartData.Named(335, Charts.T("Direct", "直达")),
            ChartData.Named(310, Charts.T("Mail", "邮件营销")),
            ChartData.Named(234, Charts.T("Affiliate", "联盟广告")),
            ChartData.Named(135, Charts.T("Video", "视频广告")),
            ChartData.Named(1048, Charts.T("Baidu", "百度")),
            ChartData.Named(251, Charts.T("Google", "谷歌")),
            ChartData.Named(102, Charts.T("Bing", "必应")),
            ChartData.Named(147, Charts.T("Other", "其他")) };
        ring[4].color = Chart.Rgb(30, 144, 250);
        List<ChartData> right = new List<ChartData>{
            ChartData.Named(335, Charts.T("Direct", "直达")),
            ChartData.Named(310, Charts.T("Mail", "邮件营销")),
            ChartData.Named(234, Charts.T("Affiliate", "联盟广告")),
            ChartData.Named(135, Charts.T("Video", "视频广告")),
            ChartData.Named(1548, Charts.T("Search Engine", "搜索引擎")) };
        ChartSeries p1 = ChartSeries.Named(Charts.T("Source", "访问来源"),
            ChartType.Pie, small);
        p1.center = ChartPosition.Of(ChartScalar.Pct(35), ChartScalar.Pct(57));
        p1.radius = ChartScalar.Px(80);
        p1.pieLabels = true;
        ChartSeries p2 = ChartSeries.Named(Charts.T("Source", "访问来源"),
            ChartType.Pie, ring);
        p2.center = ChartPosition.Of(ChartScalar.Pct(35), ChartScalar.Pct(57));
        p2.radius = ChartScalar.Px(140);
        p2.radiusInner = ChartScalar.Px(110);
        p2.labelShow = true;
        ChartSeries p3 = ChartSeries.Named(Charts.T("Source", "访问来源"),
            ChartType.Pie, right);
        p3.center = ChartPosition.Of(ChartScalar.Pct(75), ChartScalar.Pct(57));
        p3.radius = ChartScalar.Px(120);
        p3.radiusInner = ChartScalar.Px(80);
        ChartOption o = ChartOption.Of(Charts.T("Traffic sources", "访问来源"),
            null, new List<ChartSeries>{ p1, p2, p3 });
        o.pieLabels = false;
        o.titleSub = Charts.T("", "纯属虚构");
        o.titleAlign = "center";
        o.legendOrient = "vertical";
        o.legendX = "left";
        o.legendData = new List<string>{
            Charts.T("Direct", "直达"), Charts.T("Marketing", "营销广告"),
            Charts.T("Search Engine", "搜索引擎"), Charts.T("Mail", "邮件营销"),
            Charts.T("Affiliate", "联盟广告"), Charts.T("Video", "视频广告"),
            Charts.T("Baidu", "百度"), Charts.T("Google", "谷歌"),
            Charts.T("Bing", "必应"), Charts.T("Other", "其他") };
        Charts.Show(app, o, x, y, w, h);
    }

    /// pie2（ECharts2 pie2.opt.js 1:1）：环形 radius [50%,70%]
    ///（内孔 50%，外径缺省 72%≈70%），标签关闭（官方 emphasis
    /// 悬停才在中心显示项名），图例左侧竖排，无标题。
    static void Pie2(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("", ""),
            null, new List<ChartSeries>{
                ChartSeries.Named(Charts.T("Source", "访问来源"), ChartType.Pie, Charts.PieTraffic())
            });
        o.donutPct = 50;
        o.legendOrient = "vertical";
        o.legendX = "left";
        Charts.Show(app, o, x, y, w, h);
    }

    /// pie3（ECharts2 pie3.opt.js 1:1）：嵌套双环同圆心——内环实心
    ///（radius [0,40%]，3 项内标项名 labelFmt={b}，搜索引擎默认
    /// 选中）+ 外环（radius [57%,80%]，8 项）。图例左侧竖排 10 项
    /// 白名单；同名同色按名字全 option 首现序。
    static void Pie3(App app, int x, int y, int w, int h) {
        List<ChartData> inner = new List<ChartData>{
            ChartData.Named(335, Charts.T("Direct", "直达")),
            ChartData.Named(679, Charts.T("Marketing", "营销广告")),
            ChartData.Named(1548, Charts.T("Search Engine", "搜索引擎")) };
        inner[2].selected = true;
        List<ChartData> outer = new List<ChartData>{
            ChartData.Named(335, Charts.T("Direct", "直达")),
            ChartData.Named(310, Charts.T("Mail", "邮件营销")),
            ChartData.Named(234, Charts.T("Affiliate", "联盟广告")),
            ChartData.Named(135, Charts.T("Video", "视频广告")),
            ChartData.Named(1048, Charts.T("Baidu", "百度")),
            ChartData.Named(251, Charts.T("Google", "谷歌")),
            ChartData.Named(147, Charts.T("Bing", "必应")),
            ChartData.Named(102, Charts.T("Other", "其他"))
        };
        ChartSeries pIn = ChartSeries.Named(Charts.T("Source", "访问来源"),
            ChartType.Pie, inner);
        pIn.innerPct = 0;
        pIn.radius = ChartScalar.Pct(40);
        pIn.pieLabels = true;
        pIn.labelFmt = "{b}";
        ChartSeries pOut = ChartSeries.Named(Charts.T("Detail", "访问来源"),
            ChartType.Pie, outer);
        pOut.radius = ChartScalar.Pct(80);
        pOut.radiusInner = ChartScalar.Pct(57);
        ChartOption o = ChartOption.OfRings(Charts.T("", ""),
            new List<ChartSeries>{ pIn, pOut });
        o.legendOrient = "vertical";
        o.legendX = "left";
        o.legendData = new List<string>{
            Charts.T("Direct", "直达"), Charts.T("Marketing", "营销广告"),
            Charts.T("Search Engine", "搜索引擎"), Charts.T("Mail", "邮件营销"),
            Charts.T("Affiliate", "联盟广告"), Charts.T("Video", "视频广告"),
            Charts.T("Baidu", "百度"), Charts.T("Google", "谷歌"),
            Charts.T("Bing", "必应"), Charts.T("Other", "其他") };
        Charts.Show(app, o, x, y, w, h);
    }

    static List<ChartData> PieRose() {
        return new List<ChartData>{
            ChartData.Named(10, "rose1"), ChartData.Named(5, "rose2"),
            ChartData.Named(15, "rose3"), ChartData.Named(25, "rose4"),
            ChartData.Named(20, "rose5"), ChartData.Named(35, "rose6"),
            ChartData.Named(30, "rose7"), ChartData.Named(40, "rose8")
        };
    }

    /// pie4 南丁格尔玫瑰图（ECharts2 pie4）：同一 option 两个 pie
    /// 系列——半径模式（radius [20,110]，center ['25%',200]）与面积
    /// 模式（radius [30,110]，center ['75%',200]，sort ascending）。
    /// ref 的 px 半径/圆心按其 350px 容器折算成百分比
    /// （110/175≈63%，y 200/350≈57%）。
    static void Pie4(App app, int x, int y, int w, int h) {
        ChartSeries r1 = ChartSeries.Named(Charts.T("Radius mode", "半径模式"),
            ChartType.Pie, Charts.PieRose());
        r1.roseType = "radius";
        r1.center = ChartPosition.Of(ChartScalar.Pct(25), ChartScalar.Pct(57));
        r1.radius = ChartScalar.Pct(63);
        r1.radiusInner = ChartScalar.Pct(11);
        ChartSeries r2 = ChartSeries.Named(Charts.T("Area mode", "面积模式"),
            ChartType.Pie, Charts.PieRose());
        r2.roseType = "area";
        r2.sort = "ascending";
        r2.center = ChartPosition.Of(ChartScalar.Pct(75), ChartScalar.Pct(57));
        r2.radius = ChartScalar.Pct(63);
        r2.radiusInner = ChartScalar.Pct(17);
        ChartOption o = ChartOption.Of(Charts.T("Nightingale rose", "南丁格尔玫瑰图"),
            null, new List<ChartSeries>{ r1, r2 });
        o.pieLabels = false;
        Charts.Show(app, o, x, y, w, h);
    }

    /// pie5 The App World（ECharts2 pie5）：一个 option 十个 pie 系列
    /// 的迷你环阵，逐系列 center（5 列 × 2 行）+ radius [40,55] 覆盖；
    /// 每系列两片：值片（调色板）+ 浅灰 other 占位（ref #ccc）。
    static void Pie5(App app, int x, int y, int w, int h) {
        string[] names = new string[]{
            "GoogleMaps", "Facebook", "Youtube", "Google+", "Weixin",
            "Twitter", "Skype", "Messenger", "Whatsapp", "Instagram" };
        int[] vals = new int[]{ 54, 44, 35, 30, 27, 22, 22, 22, 17, 11 };
        int restCol = Chart.Rgb(204, 204, 204);
        List<ChartSeries> ss = new List<ChartSeries>();
        for (int i = 0; i < 10; i = i + 1) {
            ChartData hi = ChartData.Named(vals[i], names[i]);
            hi.color = Chart.Palette(app.theme, i);
            ChartData rest = ChartData.Named(100 - vals[i], "");
            rest.color = restCol;
            ChartSeries s = ChartSeries.Named(names[i], ChartType.Pie,
                new List<ChartData>{ hi, rest });
            int col = i % 5;
            int row = i / 5;
            s.center = ChartPosition.Of(ChartScalar.Pct(10 + col * 20),
                ChartScalar.Pct(row == 0 ? 34 : 74));
            s.radius = ChartScalar.Pct(20);
            s.radiusInner = ChartScalar.Pct(15);
            ss.Add(s);
        }
        ChartOption o = ChartOption.Of(Charts.T("The App World", "The App World"),
            null, ss);
        o.pieLabels = false;
        o.showLegend = false;
        Charts.Show(app, o, x, y, w, h);
    }

    /// pie6 你幸福吗（ECharts2 pie6）：三个 pie 系列各一层同心环，
    /// clockWise=false 逆时针铺；占位片以面板底色近似 ref 的
    /// rgba(0,0,0,0) 真透明（内核 color 0 是"未设"哨兵）。ref 的
    /// px 半径 [125,150]/[100,125]/[75,100] 按 175px 半径折算为
    /// 86/71、71/57、57/43 百分比。
    static void Pie6(App app, int x, int y, int w, int h) {
        string[] names = new string[]{
            Charts.T("68% feel fine", "68%的人表示过的不错"),
            Charts.T("29% under pressure", "29%的人表示生活压力很大"),
            Charts.T("3% surname Zeng", "3%的人表示“我姓曾”") };
        int[] vals = new int[]{ 68, 29, 3 };
        int[] outs = new int[]{ 86, 71, 57 };
        int[] ins = new int[]{ 71, 57, 43 };
        int restCol = Chart.Rgb(240, 241, 243);
        List<ChartSeries> ss = new List<ChartSeries>();
        for (int i = 0; i < 3; i = i + 1) {
            ChartData hi = ChartData.Named(vals[i], names[i]);
            hi.color = Chart.Palette(app.theme, i);
            ChartData rest = ChartData.Named(100 - vals[i], "");
            rest.color = restCol;
            ChartSeries s = ChartSeries.Named(names[i], ChartType.Pie,
                new List<ChartData>{ hi, rest });
            s.clockWise = false;
            s.radius = ChartScalar.Pct(outs[i]);
            s.radiusInner = ChartScalar.Pct(ins[i]);
            ss.Add(s);
        }
        ChartOption o = ChartOption.Of(Charts.T("Are you happy?", "你幸福吗？"),
            null, ss);
        o.pieLabels = false;
        Charts.Show(app, o, x, y, w, h);
    }

    /// ECharts pie7（timeline）：同一张饼按年份帧切换——ChartTimeline
    /// 播放器条（播放/暂停 + 前后帧 + 帧点 + 自动播放）驱动的多帧 option。
    static void Pie7(App app, int x, int y, int w, int h) {
        ChartOption a = ChartOption.Of(Charts.T("2011", "2011 年"),
            null, new List<ChartSeries>{
                ChartSeries.Named("2011", ChartType.Pie, new List<ChartData>{
                    ChartData.Named(335, Charts.T("Direct", "直接")),
                    ChartData.Named(310, Charts.T("Mail", "邮件")),
                    ChartData.Named(234, Charts.T("Affiliate", "联盟")),
                    ChartData.Named(135, Charts.T("Video", "视频"))
                }) });
        a.donutPct = 0;
        a.pieLabels = true;
        a.showLegend = false;
        a.toolboxShow = false;
        ChartOption b = ChartOption.Of(Charts.T("2012", "2012 年"),
            null, new List<ChartSeries>{
                ChartSeries.Named("2012", ChartType.Pie, new List<ChartData>{
                    ChartData.Named(410, Charts.T("Direct", "直接")),
                    ChartData.Named(280, Charts.T("Mail", "邮件")),
                    ChartData.Named(190, Charts.T("Affiliate", "联盟")),
                    ChartData.Named(220, Charts.T("Video", "视频"))
                }) });
        b.donutPct = 0;
        b.pieLabels = true;
        b.showLegend = false;
        b.toolboxShow = false;
        List<string> years = new List<string>{ Charts.T("2011", "2011 年"),
            Charts.T("2012", "2012 年") };
        ChartTimeline tl = ChartTimeline.Of()
            .Frame(a)
            .Frame(b)
            .Labels(years)
            .AutoPlay(1600);
        // 布局：图表占上部，播放器条贴底。当前帧号由播放器条
        // 维护在 App 状态（键 = 该 demo 的稳定交互键）。
        int key = Charts.KeyOf(Charts.selected.Get(), 0);
        int barH = ChartTimeline.Height(app);
        int idx = ChartTimeline.TimelineIdxOf(app, key, tl.FrameCount());
        ChartView.KeyedStatic(ChartTimeline.Merge(a, tl.Current(idx)),
            key).Render(app, x, y, w, h - barH);
        tl.Draw(app, key, x, y + h - barH, w);
    }

    static void Pie8(App app, int x, int y, int w, int h) {
        ChartSeries outer = ChartSeries.Named(Charts.T("Region", "区域"), ChartType.Pie,
            new List<ChartData>{
                ChartData.Named(435, Charts.T("East", "东区")),
                ChartData.Named(310, Charts.T("West", "西区")),
                ChartData.Named(235, Charts.T("North", "北区")) });
        ChartSeries mid = ChartSeries.Named(Charts.T("Channel", "渠道"), ChartType.Pie,
            new List<ChartData>{
                ChartData.Named(235, Charts.T("Online", "线上")),
                ChartData.Named(200, Charts.T("Retail", "门店")),
                ChartData.Named(190, Charts.T("Partner", "渠道商")),
                ChartData.Named(350, Charts.T("Direct", "直销")) });
        ChartSeries inner = ChartSeries.Named(Charts.T("Product", "产品"), ChartType.Pie,
            new List<ChartData>{
                ChartData.Named(335, Charts.T("Hardware", "硬件")),
                ChartData.Named(310, Charts.T("Software", "软件")),
                ChartData.Named(330, Charts.T("Service", "服务")) });
        // ECharts 嵌套饼系列按内→外排列：内环孔径显式给 55
        // （多环布局不再回落全局 donutPct）。
        inner.innerPct = 55;
        ChartOption o = ChartOption.OfRings(Charts.T("Sales lasagna", "销售千层饼"),
            new List<ChartSeries>{ inner, mid, outer });
        o.showLegend = false;
        Charts.Show(app, o, x, y, w, h);
    }

    static void Pie9(App app, int x, int y, int w, int h) {
        ChartSeries s = ChartSeries.Named(Charts.T("Source", "访问来源"), ChartType.Pie,
            Charts.PieTraffic());
        s.labelShow = true;
        s.selectedOffset = 12;
        s.data[4].selected = true;
        ChartOption o = ChartOption.Of(Charts.T("Styled pie", "饼图多级控制"),
            null, new List<ChartSeries>{ s });
        o.donutPct = 0;
        o.pieLabels = true;
        Charts.Show(app, o, x, y, w, h);
    }
}
