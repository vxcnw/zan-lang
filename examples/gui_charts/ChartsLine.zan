    /// example/line6 面积图（反向数值轴）「雨量流量关系图」：3079 个
    /// 小时点的实测流量与降雨量（原始小数值），ECharts 把降雨量取负
    /// 画在零线下方，配第二条 Y 轴。
    static void Line6(App app, int x, int y, int w, int h) {
        ChartSeries flow = ChartSeries.Named(Charts.T("Flow", "流量"),
            ChartType.Line, FlowData());
        flow.areaStyle = true;
        ChartSeries rain = ChartSeries.Named(Charts.T("Rainfall", "降雨量"),
            ChartType.Line, RainData());
        rain.areaStyle = true;
        rain.axisIndex = 1;
        ChartOption o = ChartOption.Of(
            Charts.T("Rainfall vs flow", "雨量流量关系图"),
            HourCats(), new List<ChartSeries>{ flow, rain });
        o.Y(ChartAxis.Value());
        o.zoom = true;
        Charts.Show(app, o, x, y, w, h);
    }

