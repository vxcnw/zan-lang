using System;
using Gui;
using Gui.Component.Chart;

partial class Charts {
    // ===== ECharts 2.2.4 doc/example.html 折线（面积）类 1:1 还原 =====
    // 类目/系列/数据逐项取自 gallery 对应页面 option 源码（line1..line9、
    // line），引擎不支持的特性在各自方法里注明偏差，不再使用自造数据。

    /// example/line1 标准折线图「未来一周气温变化」：最高/最低
    /// 气温两条线，markPoint(max/min/周最低) + markLine(平均值)。
    static void Line1(App app, int x, int y, int w, int h) {
        ChartSeries hi = ChartSeries.Line(Charts.T("Highest temp", "最高气温"),
            new List<int>{ 11, 11, 15, 13, 12, 13, 10 });
        hi.MarkPoint(ChartMarkPoint.Max());
        hi.MarkPoint(ChartMarkPoint.Min());
        hi.MarkLine(ChartMarkLine.Average());
        ChartSeries lo = ChartSeries.Line(Charts.T("Lowest temp", "最低气温"),
            new List<int>{ 1, 0 - 2, 2, 5, 3, 2, 0 });
        // ECharts: {name:'周最低', value:-2, xAxis:1}——按数据项下标 1 定位。
        ChartMarkPoint wk = ChartMarkPoint.Point(1, 0 - 2,
            Charts.T("Week low", "周最低"));
        wk.dataIndex = 1;
        lo.MarkPoint(wk);
        lo.MarkLine(ChartMarkLine.Average());
        ChartOption o = ChartOption.Of(
            Charts.T("Weekly temperature - fiction", "未来一周气温变化 - 纯属虚构"),
            Charts.Week(), new List<ChartSeries>{ hi, lo });
        Charts.Show(app, o, x, y, w, h);
    }

    /// example/line2 堆积折线图：五条流量来源 stack「总量」，
    /// 直线（ECharts 默认不 smoothing）。
    static void Line2(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Stacked line", "堆积折线图"),
            Charts.Week(), new List<ChartSeries>{
                ChartSeries.StackedLine(Charts.T("Mail", "邮件营销"),
                    new List<int>{ 120, 132, 101, 134, 90, 230, 210 }),
                ChartSeries.StackedLine(Charts.T("Affiliate", "联盟广告"),
                    new List<int>{ 220, 182, 191, 234, 290, 330, 310 }),
                ChartSeries.StackedLine(Charts.T("Video", "视频广告"),
                    new List<int>{ 150, 232, 201, 154, 190, 330, 410 }),
                ChartSeries.StackedLine(Charts.T("Direct", "直接访问"),
                    new List<int>{ 320, 332, 301, 334, 390, 330, 320 }),
                ChartSeries.StackedLine(Charts.T("Search", "搜索引擎"),
                    new List<int>{ 820, 932, 901, 934, 1290, 1330, 1320 })
            });
        Charts.Show(app, o, x, y, w, h);
    }

    /// example/line5「高度(km)与气温(°C)变化关系」：ECharts 把类目
    /// 轴放在 Y、数值轴放在 X（轴互换 + 平滑）。直角系引擎目前只
    /// 支持类目在 X（y 类目轴折线待支持，记 TASKS），数据保持一致，
    /// 方向为互换前的镜像：气温 [15,-50,-56.5,...] 的 .5 按整数画布
    /// 四舍五入。
    static void Line5(App app, int x, int y, int w, int h) {
        // ECharts line5：类目（高度 km）在 Y 轴且 boundaryGap=false
        // （曲线贴刻度线），气温 °C 是 X 值轴，axisLabel formatter
        // 模板 "{value} °C"，smooth 曲线。数据用原始小数。
        List<string> km = new List<string>{
            "0", "10", "20", "30", "40", "50", "60", "70", "80" };
        List<double> temps = new List<double>{
            15.0, 0 - 50.0, 0 - 56.5, 0 - 46.5, 0 - 22.1,
            0 - 2.5, 0 - 27.7, 0 - 55.7, 0 - 76.5 };
        List<ChartData> data = new List<ChartData>();
        for (int i = 0; i < temps.Count; i = i + 1) {
            data.Add(ChartData.Numeric(temps[i]));
        }
        ChartOption o = ChartOption.Of(
            Charts.T("Altitude vs temperature", "高度(km)与气温(°C)变化关系"),
            null, new List<ChartSeries>{
                ChartSeries.Named(Charts.T("Alt vs temp", "高度与气温"),
                    ChartType.Line, data)
            });
        o.Y(ChartAxis.CategoryTitled(km, Charts.T("km", "km")));
        o.yAxes[0].boundaryGap = false;
        o.X(ChartAxis.Value());
        ChartAxis xa = o.xAxes[0];
        xa.labelFormatter = "{value} °C";
        o.smooth = true;
        Charts.Show(app, o, x, y, w, h);
    }

    /// example/line3 标准面积图「某楼盘销售情况」：成交/预购/意向
    /// 三系列 smooth + areaStyle 填充（非堆叠，各自贴零线），
    /// 类目轴 boundaryGap=false。参考站 subtext「纯属虚构」。
    static void Line3(App app, int x, int y, int w, int h) {
        ChartSeries deal = ChartSeries.Line(Charts.T("Deal", "成交"),
            new List<int>{ 10, 12, 21, 54, 260, 830, 710 });
        ChartSeries book = ChartSeries.Line(Charts.T("Booking", "预购"),
            new List<int>{ 30, 182, 434, 791, 390, 30, 10 });
        ChartSeries intent = ChartSeries.Line(Charts.T("Intent", "意向"),
            new List<int>{ 1320, 1132, 601, 234, 120, 90, 20 });
        deal.smooth = 1; book.smooth = 1; intent.smooth = 1;
        deal.areaStyle = true; book.areaStyle = true; intent.areaStyle = true;
        ChartOption o = ChartOption.Of(
            Charts.T("Real estate sales", "某楼盘销售情况"),
            Charts.Week(), new List<ChartSeries>{ deal, book, intent });
        o.xAxes[0].boundaryGap = false;
        Charts.Show(app, o, x, y, w, h);
    }

    /// example/line4 堆积面积图：与 line2 同一套五系列数据，
    /// stack「总量」+ areaStyle 填充，直线。
    static void Line4(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Stacked area", "堆积面积图"),
            Charts.Week(), new List<ChartSeries>{
                ChartSeries.StackedArea(Charts.T("Mail", "邮件营销"),
                    new List<int>{ 120, 132, 101, 134, 90, 230, 210 }),
                ChartSeries.StackedArea(Charts.T("Affiliate", "联盟广告"),
                    new List<int>{ 220, 182, 191, 234, 290, 330, 310 }),
                ChartSeries.StackedArea(Charts.T("Video", "视频广告"),
                    new List<int>{ 150, 232, 201, 154, 190, 330, 410 }),
                ChartSeries.StackedArea(Charts.T("Direct", "直接访问"),
                    new List<int>{ 320, 332, 301, 334, 390, 330, 320 }),
                ChartSeries.StackedArea(Charts.T("Search", "搜索引擎"),
                    new List<int>{ 820, 932, 901, 934, 1290, 1330, 1320 })
            });
        Charts.Show(app, o, x, y, w, h);
    }

    /// example/line7 不等距折线图（双数值轴）「双数值轴折线」：
    /// 数据1/数据2 两组 [x,y] 点连折线。ECharts 另有 6 条
    /// markPoint/markLine（两轴各 max/min/average）；引擎的系列标注
    /// 按类目下标定位，这里保留 y 轴三条水平线（crimson #dc143c），
    /// x 轴竖线待引擎支持。
    static void Line7(App app, int x, int y, int w, int h) {
        List<ChartPoint> d1 = new List<ChartPoint>{
            ChartPoint.Of(2, 10), ChartPoint.Of(5, 7), ChartPoint.Of(8, 8),
            ChartPoint.Of(12, 6), ChartPoint.Of(11, 12), ChartPoint.Of(16, 9),
            ChartPoint.Of(14, 6), ChartPoint.Of(17, 4), ChartPoint.Of(19, 9) };
        List<ChartPoint> d2 = new List<ChartPoint>{
            ChartPoint.Of(1, 2), ChartPoint.Of(2, 3), ChartPoint.Of(4, 2),
            ChartPoint.Of(7, 5), ChartPoint.Of(11, 2), ChartPoint.Of(18, 3) };
        ChartSeries s1 = ChartSeries.OfLinePoints(Charts.T("Data 1", "数据1"), d1);
        // ECharts 原值 [1.5,10]，整数画布四舍五入为 2。
        ChartSeries s2 = ChartSeries.OfLinePoints(Charts.T("Data 2", "数据2"), d2);
        int crimson = Chart.Rgb(220, 20, 60);
        ChartMarkLine mx = ChartMarkLine.Max();
        ChartMarkLine mn = ChartMarkLine.Min();
        ChartMarkLine av = ChartMarkLine.Average();
        mx.color = crimson; mn.color = crimson; av.color = crimson;
        s1.MarkLine(mx); s1.MarkLine(mn); s1.MarkLine(av);
        ChartOption o = ChartOption.Of(
            Charts.T("Dual value axis - fiction", "双数值轴折线 - 纯属虚构"),
            null, new List<ChartSeries>{ s1, s2 });
        o.X(ChartAxis.ValueRange(0, 20));
        o.Y(ChartAxis.Value());
        Charts.Show(app, o, x, y, w, h);
    }

    /// example/line8 时间坐标轴折线图：200 个随机点 + dataZoom
    /// （初始窗口 70%..100%）。ECharts 用 Math.random()，这里用固定
    /// 种子伪随机（同点数同分布，截图可复现）；时间刻度取自
    /// new Date(2014,9,1,0,len*10000) 的真实进位结果。
    static void Line8(App app, int x, int y, int w, int h) {
        int seed = 20141001;
        List<int> ys = new List<int>();
        for (int i = 0; i < 200; i = i + 1) {
            seed = (int)((seed * 1103515245L + 12345L) % 2147483648L);
            ys.Add((seed % 3000) / 100);
        }
        ChartSeries s = ChartSeries.Line("series1", ys);
        s.symbol = "emptyCircle";
        s.symbolSize = 5;
        ChartOption o = ChartOption.Of(
            Charts.T("Time axis - dataZoom", "时间坐标折线图 - dataZoom支持"),
            TimeCats(), new List<ChartSeries>{ s });
        o.X(ChartAxis.Time());
        o.zoom = true;
        o.zoomStart = 70;
        o.zoomEnd = 100;
        Charts.Show(app, o, x, y, w, h);
    }

