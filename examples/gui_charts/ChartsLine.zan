    /// example/line 折线图（多级控制）：四系列堆叠「总量」，逐系列
    /// 个性化——邮件营销纵向渐变面积填充；联盟广告平滑；直接访问
    /// 三角拐点（ECharts arrow，引擎最接近形状）；搜索引擎空心圆
    /// 且不堆叠。ECharts 的逐点换图形（star/droplet/emptypin）、
    /// 图片拐点与数据级标签待引擎支持。
    /// example/line 折线图（多级控制）：ECharts 2.2.4 门面示例。
    /// 三条 stack「总量」系列 + 一条不堆叠的搜索引擎线（绝对坐标）。
    /// 邮件营销 symbol:'none' 但第 5 点数据级 droplet 仍画（ECharts
    /// 逐项覆盖语义）；联盟广告平滑 + 数据级 star/none/emptypin，
    /// 系列级 image:// 图标引擎按族默认圆点近似；直接访问箭头符号 +
    /// 红色 dashed 线 + '-' 断线；搜索引擎横向渐变描边
    /// （zrColor.getLinearGradient 红→黄）。symbolRotate 暂不生效，
    /// 数据级 label 留待 option 管线批次。
    static void LineMulti(App app, int x, int y, int w, int h) {
        // 邮件营销：areaStyle 渐变填充 + symbol:'none'（showSymbol=0）
        ChartData m90 = ChartData.Of(90);
        m90.symbol = "droplet";
        m90.size = 5;
        m90.sizeSet = true;
        ChartSeries mail = ChartSeries.Named(Charts.T("Mail", "邮件营销"),
            ChartType.Line, new List<ChartData>{
                ChartData.Of(120), ChartData.Of(132), ChartData.Of(301),
                ChartData.Of(134), m90, ChartData.Of(230), ChartData.Of(210) });
        mail.stack = 1;
        mail.areaStyle = true;
        mail.showSymbol = 0;
        // 联盟广告：smooth + symbolSize 8；第 3 点 star(15)、第 4 点
        // symbol:'none'、第 6 点 emptypin(8)
        ChartData a201 = ChartData.Of(201);
        a201.symbol = "star";
        a201.size = 15;
        a201.sizeSet = true;
        ChartData a134 = ChartData.Of(134);
        a134.symbol = "none";
        ChartData a230 = ChartData.Of(230);
        a230.symbol = "emptypin";
        a230.size = 8;
        a230.sizeSet = true;
        ChartSeries aff = ChartSeries.Named(Charts.T("Affiliate", "联盟广告"),
            ChartType.Line, new List<ChartData>{
                ChartData.Of(120), ChartData.Of(82), a201, a134,
                ChartData.Of(190), a230, ChartData.Of(110) });
        aff.stack = 1;
        aff.smooth = 1;
        aff.symbolSize = 8;
        // 直接访问：arrow 符号 + 红色 dashed width2 + 第 3 点 '-' 断线
        // + 第 5 点 star6(20, yellowgreen)
        ChartData d390 = ChartData.Of(390);
        d390.symbol = "star6";
        d390.size = 20;
        d390.sizeSet = true;
        d390.color = Chart.Rgb(154, 205, 50);
        ChartSeries dir = ChartSeries.Named(Charts.T("Direct", "直接访问"),
            ChartType.Line, new List<ChartData>{
                ChartData.Of(320), ChartData.Of(332), ChartData.Gap(),
                ChartData.Of(334), d390, ChartData.Of(330), ChartData.Of(320) });
        dir.stack = 1;
        dir.symbol = "arrow";
        dir.symbolSize = 6;
        dir.color = Chart.Rgb(255, 0, 0);
        dir.itemStyle.normal.lineStyle.width = 2;
        dir.itemStyle.normal.lineStyle.type = "dashed";
        // 搜索引擎：不堆叠 + emptyCircle + 横向渐变描边（红→黄），
        // 系列色走 ECharts 2 默认调色板（参考站未显式指定 color）。
        ChartSeries search = ChartSeries.Line(Charts.T("Search", "搜索引擎"),
            new List<int>{ 620, 732, 791, 734, 890, 930, 820 });
        search.symbol = "emptyCircle";
        search.itemStyle.normal.lineStyle.width = 2;
        search.itemStyle.normal.lineStyle.gradStops = new List<int>{
            Chart.Rgb(255, 0, 0), Chart.Rgb(255, 255, 0) };
        ChartOption o = ChartOption.Of(
            Charts.T("Multi-level line", "折线图（多级控制）"),
            Charts.Week(), new List<ChartSeries>{ mail, aff, dir, search });
        o.xAxes[0].boundaryGap = false;
        o.gradient = true;
        Charts.Show(app, o, x, y, w, h);
    }

    /// example/line9 对数轴：3 的指数与 2 的指数（0..8 次幂），
    /// 类目 一..九。
    static void Line9(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Log axis", "对数轴"),
            new List<string>{ "一", "二", "三", "四", "五", "六", "七", "八", "九" },
            new List<ChartSeries>{
                ChartSeries.Line(Charts.T("3 power n", "3的指数"),
                    new List<int>{ 1, 3, 9, 27, 81, 247, 741, 2223, 6669 }),
                ChartSeries.Line(Charts.T("2 power n", "2的指数"),
                    new List<int>{ 1, 2, 4, 8, 16, 32, 64, 128, 256 })
            });
        o.Y(ChartAxis.Log());
        Charts.Show(app, o, x, y, w, h);
    }
}
