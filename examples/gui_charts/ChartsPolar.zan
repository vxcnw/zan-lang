using System;
using Gui;
using Gui.Component.Chart;

partial class Charts {
    static List<string> RadarDims() {
        return new List<string>{
            Charts.T("Sales", "销售"), Charts.T("Admin", "管理"),
            Charts.T("IT", "信息技术"), Charts.T("Support", "客服"),
            Charts.T("Dev", "研发"), Charts.T("Market", "市场") };
    }

    /// radar2（ECharts2 罗纳尔多 vs 舍普琴科）：六维球员数据，
    /// 每项 max 100，两系列带面积填充。
    static void Radar1(App app, int x, int y, int w, int h) {
        List<string> dims = new List<string>{
            Charts.T("Attack", "进攻"), Charts.T("Defense", "防守"),
            Charts.T("Stamina", "体能"), Charts.T("Speed", "速度"),
            Charts.T("Strength", "力量"), Charts.T("Skill", "技巧") };
        ChartSeries shev = ChartSeries.Polar(Charts.T("Shevchenko", "舍普琴科"),
            new List<int>{ 97, 42, 88, 94, 90, 86 });
        shev.areaStyle = true;
        ChartSeries ron = ChartSeries.Polar(Charts.T("Ronaldo", "罗纳尔多"),
            new List<int>{ 97, 32, 74, 95, 88, 92 });
        ron.areaStyle = true;
        ChartOption o = ChartOption.Of(
            Charts.T("Ronaldo vs Shevchenko", "罗纳尔多 vs 舍普琴科"),
            dims, new List<ChartSeries>{ shev, ron });
        o.RadarMax(new List<int>{ 100, 100, 100, 100, 100, 100 });
        Charts.Show(app, o, x, y, w, h);
    }

    /// radar（ECharts2 radar.html 成绩单侧）：六科成绩各带 max
    ///（150/150/150/120/108/72），张三填充 + 李四虚线（此处静态
    /// 近似为普通线）。ref 的动态渐变/【指标】formatter/markPoint
    /// 花活不进静态 demo。
    static void Radar2(App app, int x, int y, int w, int h) {
        List<string> dims = new List<string>{
            Charts.T("Chinese", "语文"), Charts.T("Math", "数学"),
            Charts.T("English", "英语"), Charts.T("Physics", "物理"),
            Charts.T("Chemistry", "化学"), Charts.T("Biology", "生物") };
        ChartSeries zhang = ChartSeries.Polar(Charts.T("Zhang San", "张三"),
            new List<int>{ 120, 118, 130, 100, 99, 70 });
        zhang.areaStyle = true;
        ChartSeries li = ChartSeries.Polar(Charts.T("Li Si", "李四"),
            new List<int>{ 90, 113, 140, 30, 70, 60 });
        ChartOption o = ChartOption.Of(Charts.T("Report card", "成绩单"),
            dims, new List<ChartSeries>{ zhang, li });
        o.RadarMax(new List<int>{ 150, 150, 150, 120, 108, 72 });
        Charts.Show(app, o, x, y, w, h);
    }

    static void Radar3(App app, int x, int y, int w, int h) {
        ChartOption q1 = ChartOption.Of("Q1", Charts.RadarDims(),
            new List<ChartSeries>{ ChartSeries.Polar("Q1",
                new List<int>{ 4300, 10000, 28000, 35000, 50000, 19000 }) });
        q1.RadarMax(new List<int>{ 6500, 16000, 30000, 38000, 52000, 25000 });
        ChartOption q2 = ChartOption.Of("Q2", Charts.RadarDims(),
            new List<ChartSeries>{ ChartSeries.Polar("Q2",
                new List<int>{ 5000, 14000, 28000, 31000, 42000, 21000 }) });
        q2.RadarMax(new List<int>{ 6500, 16000, 30000, 38000, 52000, 25000 });
        Charts.Split2(app, q1, q2, x, y, w, h);
    }

    static void Radar4(App app, int x, int y, int w, int h) {
        ChartSeries a = ChartSeries.Polar("A", new List<int>{ 80, 60, 90, 70, 50, 40 });
        a.areaStyle = true;
        ChartSeries b = ChartSeries.Polar("B", new List<int>{ 50, 80, 60, 90, 70, 55 });
        b.areaStyle = true;
        ChartSeries c = ChartSeries.Polar("C", new List<int>{ 30, 40, 50, 40, 60, 80 });
        c.areaStyle = true;
        ChartOption o = ChartOption.Of(Charts.T("Wormhole", "虫洞雷达"),
            Charts.RadarDims(), new List<ChartSeries>{ a, b, c });
        o.RadarMax(new List<int>{ 100, 100, 100, 100, 100, 100 });
        Charts.Show(app, o, x, y, w, h);
    }

    static void Radar5(App app, int x, int y, int w, int h) {
        ChartSeries s = ChartSeries.Polar(Charts.T("Team", "团队"),
            new List<int>{ 82, 60, 95, 74, 42, 68 });
        s.areaStyle = true;
        s.labelShow = true;
        ChartOption o = ChartOption.Of(Charts.T("Styled radar", "雷达图个性化"),
            Charts.RadarDims(), new List<ChartSeries>{ s });
        o.RadarMax(new List<int>{ 100, 80, 120, 100, 60, 90 });
        Charts.Show(app, o, x, y, w, h);
    }

    /// 多边形网格 + 交替色环带（ECharts radar.shape=polygon / splitArea）。
    static void Radar6(App app, int x, int y, int w, int h) {
        ChartSeries a = ChartSeries.Polar(Charts.T("Product A", "甲产品"),
            new List<int>{ 65, 80, 70, 60, 90, 75 });
        a.areaStyle = true;
        ChartSeries b = ChartSeries.Polar(Charts.T("Product B", "乙产品"),
            new List<int>{ 80, 45, 60, 85, 55, 70 });
        b.areaStyle = true;
        ChartOption o = ChartOption.Of(Charts.T("Polygon radar", "多边形雷达"),
            Charts.RadarDims(), new List<ChartSeries>{ a, b });
        o.radarShape = "polygon";
        o.radarSplitArea = true;
        Charts.Show(app, o, x, y, w, h);
    }

    static void Gauge1(App app, int x, int y, int w, int h) {
        ChartSeries g = ChartSeries.Gauge(Charts.T("Completion", "完成率"), 90);
        g.gauge.detail.formatter = "{value}%";
        ChartOption o = ChartOption.Of(Charts.T("Business KPI", "业务指标"),
            null, new List<ChartSeries>{ g });
        Charts.Show(app, o, x, y, w, h);
    }

    static void Gauge2(App app, int x, int y, int w, int h) {
        ChartSeries g = ChartSeries.Gauge(Charts.T("km/h", "km/h"), 80);
        g.GaugeRange(0, 220);
        g.GaugeArc(225, 0 - 45);
        ChartOption o = ChartOption.Of(Charts.T("Speed", "车速仪表盘"),
            null, new List<ChartSeries>{ g });
        Charts.Show(app, o, x, y, w, h);
    }

    static void Gauge3(App app, int x, int y, int w, int h) {
        ChartSeries g = ChartSeries.Gauge(Charts.T("Progress", "进度"), 72);
        g.GaugeColors(20, Chart.Rgb(99, 190, 123), 50, Chart.Rgb(250, 200, 88),
            80, Chart.Rgb(238, 102, 102), 100, Chart.Rgb(180, 40, 40));
        ChartOption o = ChartOption.Of(Charts.T("Progress gauge", "进度仪表盘"),
            null, new List<ChartSeries>{ g });
        Charts.Show(app, o, x, y, w, h);
    }

    static void Gauge4(App app, int x, int y, int w, int h) {
        ChartOption a = ChartOption.Of("CPU", null,
            new List<ChartSeries>{ ChartSeries.Gauge("CPU", 72) });
        ChartOption b = ChartOption.Of("RAM", null,
            new List<ChartSeries>{ ChartSeries.Gauge("RAM", 48) });
        Charts.Split2(app, a, b, x, y, w, h);
    }

    static void Gauge5(App app, int x, int y, int w, int h) {
        // ECharts 多仪表盘：每个 gauge 系列自带 center/radius，
        // 两个表盘左右并排（不设 center 会叠在同一圆心）。
        ChartSeries speed = ChartSeries.Gauge(Charts.T("Speed", "转速"), 72);
        speed.GaugeLayout(28, 55, 45);
        ChartSeries fuel = ChartSeries.Gauge(Charts.T("Fuel", "油量"), 38);
        fuel.GaugeLayout(72, 55, 45);
        ChartOption o = ChartOption.Of(Charts.T("Cluster", "多仪表盘"),
            null, new List<ChartSeries>{ speed, fuel });
        Charts.Show(app, o, x, y, w, h);
    }

    static void Gauge6(App app, int x, int y, int w, int h) {
        ChartSeries g = ChartSeries.Gauge(Charts.T("Score", "得分"), 64);
        g.GaugeArc(180, 0);
        ChartOption o = ChartOption.Of(Charts.T("Half gauge", "半圆仪表盘"),
            null, new List<ChartSeries>{ g });
        Charts.Show(app, o, x, y, w, h);
    }

    static List<ChartSeries> FunnelStages() {
        return new List<ChartSeries>{
            ChartSeries.Funnel(Charts.T("Show", "展现"), new List<int>{ 100 }),
            ChartSeries.Funnel(Charts.T("Click", "点击"), new List<int>{ 80 }),
            ChartSeries.Funnel(Charts.T("Visit", "访问"), new List<int>{ 60 }),
            ChartSeries.Funnel(Charts.T("Consult", "咨询"), new List<int>{ 40 }),
            ChartSeries.Funnel(Charts.T("Order", "订单"), new List<int>{ 20 })
        };
    }

    static void Funnel1(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Conversion", "漏斗图"),
            null, Charts.FunnelStages());
        Charts.Show(app, o, x, y, w, h);
    }

    static void Funnel2(App app, int x, int y, int w, int h) {
        ChartOption a = ChartOption.Of(Charts.T("Expected", "预期"),
            null, Charts.FunnelStages());
        List<ChartSeries> actual = new List<ChartSeries>{
            ChartSeries.Funnel(Charts.T("Show", "展现"), new List<int>{ 100 }),
            ChartSeries.Funnel(Charts.T("Click", "点击"), new List<int>{ 70 }),
            ChartSeries.Funnel(Charts.T("Visit", "访问"), new List<int>{ 48 }),
            ChartSeries.Funnel(Charts.T("Consult", "咨询"), new List<int>{ 28 }),
            ChartSeries.Funnel(Charts.T("Order", "订单"), new List<int>{ 12 })
        };
        ChartOption b = ChartOption.Of(Charts.T("Actual", "实际"), null, actual);
        Charts.Split2(app, a, b, x, y, w, h);
    }

    static void Funnel3(App app, int x, int y, int w, int h) {
        ChartOption down = ChartOption.Of(Charts.T("Descending", "降序漏斗"),
            null, Charts.FunnelStages());
        List<ChartSeries> up = new List<ChartSeries>{
            ChartSeries.Pyramid(Charts.T("Show", "展现"), new List<int>{ 100 }),
            ChartSeries.Pyramid(Charts.T("Click", "点击"), new List<int>{ 80 }),
            ChartSeries.Pyramid(Charts.T("Visit", "访问"), new List<int>{ 60 }),
            ChartSeries.Pyramid(Charts.T("Consult", "咨询"), new List<int>{ 40 }),
            ChartSeries.Pyramid(Charts.T("Order", "订单"), new List<int>{ 20 })
        };
        ChartOption pyr = ChartOption.Of(Charts.T("Ascending", "升序金字塔"), null, up);
        Charts.Split2(app, down, pyr, x, y, w, h);
    }

    static void Funnel4(App app, int x, int y, int w, int h) {
        List<ChartSeries> up = new List<ChartSeries>{
            ChartSeries.Pyramid(Charts.T("Show", "展现"), new List<int>{ 100 }),
            ChartSeries.Pyramid(Charts.T("Click", "点击"), new List<int>{ 80 }),
            ChartSeries.Pyramid(Charts.T("Visit", "访问"), new List<int>{ 60 }),
            ChartSeries.Pyramid(Charts.T("Consult", "咨询"), new List<int>{ 40 }),
            ChartSeries.Pyramid(Charts.T("Order", "订单"), new List<int>{ 20 })
        };
        ChartOption o = ChartOption.Of(Charts.T("Pyramid", "金字塔"), null, up);
        Charts.Show(app, o, x, y, w, h);
    }

    static void Funnel5(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Styled funnel", "漏斗图个性化"),
            null, Charts.FunnelStages());
        o.showValues = true;
        Charts.Show(app, o, x, y, w, h);
    }

    static void Funnel6(App app, int x, int y, int w, int h) {
        // 批 6：funnelAlign 三态 + 层间隙 + 转化率标签/tooltip。
        ChartOption o = ChartOption.Of(Charts.T("Left funnel", "左对齐漏斗（含转化率）"),
            null, Charts.FunnelStages());
        ChartSeries s = o.series[0];
        s.funnelAlign = "left";         // ECharts funnel.funnelAlign
        s.funnelGap = 6;                // 层间隙 px（-1 = 默认）
        s.funnelPercent = true;         // label/tooltip 追加相对上层转化率
        o.showValues = true;
        Charts.Show(app, o, x, y, w, h);
    }
}
