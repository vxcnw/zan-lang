    static void Chord1(App app, int x, int y, int w, int h) {
        // ECharts 2.2.7 chord1.html：矩阵和弦 + sort ascending /
        // sortSub descending / label.show=false。差异记录：节点名
        // 标签当前总是绘制（label.show=false 未消费）；showScale
        // 刻度尺未实现。
        List<string> groups = new List<string>{
            "group1", "group2", "group3", "group4" };
        List<List<int>> mx = new List<List<int>>{
            new List<int>{ 11975, 5871, 8916, 2868 },
            new List<int>{ 1951, 10048, 2060, 6171 },
            new List<int>{ 8010, 16145, 8090, 8045 },
            new List<int>{ 1013, 990, 940, 6907 } };
        ChartSeries c = ChartSeries.ChordMatrix(
            Charts.T("Chord", "测试数据"), groups, mx);
        c.chordSort = 2;
        c.chordSortSub = true;
        ChartOption o = ChartOption.Of(Charts.T("Standard chord", "标准和弦图"),
            null, new List<ChartSeries>{ c });
        Charts.Show(app, o, x, y, w, h);
    }

