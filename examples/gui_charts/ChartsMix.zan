    static void Dyn1(App app, int x, int y, int w, int h) {
        int tick = Window.GetTickMs() / 200;
        List<int> line = new List<int>();
        List<int> bars = new List<int>();
        List<string> cats = new List<string>();
        for (int i = 0; i < 12; i = i + 1) {
            int v = 40 + ChartView.SinDeg((i * 30 + tick * 8) % 360) * 30 / 1000;
            line.Add(v + 20);
            bars.Add(v);
            cats.Add(Convert.ToString(i + 1));
        }
        ChartOption o = ChartOption.Of(Charts.T("Live line / bar", "动态数据（折线柱状）"),
            cats, new List<ChartSeries>{
                ChartSeries.Bar(Charts.T("Load", "负载"), bars),
                ChartSeries.Line(Charts.T("Trend", "趋势"), line)
            });
        o.animate = false;
        Charts.Show(app, o, x, y, w, h);
        app.RequestAnimationFrame(80);
    }

    static void Dyn2(App app, int x, int y, int w, int h) {
        // 导航名叫「散点K线」，两块都得在：左动态散点 + 右滚动 K 线
        // （此前只有散点，K 线半边一直缺席）。
        int tick = Window.GetTickMs() / 80;
        List<ChartPoint> pts = new List<ChartPoint>();
        for (int i = 0; i < 40; i = i + 1) {
            pts.Add(ChartPoint.Of((i * 9 + tick) % 100, (i * 13 + tick / 2) % 90));
        }
        ChartOption sc = ChartOption.Of(Charts.T("Live scatter", "动态散点"),
            null, new List<ChartSeries>{ ChartSeries.OfPoints("p", pts) });
        sc.animate = false;

        List<Candle> ks = new List<Candle>();
        List<string> times = new List<string>();
        for (int i = 0; i < 12; i = i + 1) {
            int step = tick + i * 7;
            int open = 2400 + ChartView.SinDeg((step * 11) % 360) * 40 / 1000;
            int close = 2400 + ChartView.SinDeg((step * 11 + 40) % 360) * 40 / 1000;
            int hi = open > close ? open : close;
            int lo = open < close ? open : close;
            ks.Add(Candle.Of(open, hi + 6 + step % 5, lo - 6 - (step + 3) % 4, close));
            times.Add(Convert.ToString((tick / 6 + i) % 60));
        }
        ChartOption k = ChartOption.Of(Charts.T("Live K", "动态K线"),
            times, new List<ChartSeries>{ ChartSeries.OfCandles("K", ks) });
        k.animate = false;

        Charts.Split2(app, sc, k, x, y, w, h);
        app.RequestAnimationFrame(80);
    }

