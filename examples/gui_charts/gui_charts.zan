    static string T(string en, string zh) {
        if (Charts.lang.Get() == 1) { return zh; }
        return en;
    }

    static string NameOf(ChartsDemo d) { return Charts.T(d.en, d.zh); }

    static string CatLabel(string cat) {
        // 类目名取自参考站 example.html 的 h3 原文。
        if (cat == "line") { return Charts.T("Line", "折线图"); }
        if (cat == "bar") { return Charts.T("Bar", "柱状图"); }
        if (cat == "scatter") { return Charts.T("Scatter", "散点图"); }
        if (cat == "k") { return Charts.T("Candlestick", "K线图"); }
        if (cat == "pie") { return Charts.T("Pie", "饼图"); }
        if (cat == "radar") { return Charts.T("Radar", "雷达图"); }
        if (cat == "chord") { return Charts.T("Chord", "和弦图"); }
        if (cat == "force") { return Charts.T("Force", "力导向布局图"); }
        if (cat == "map") { return Charts.T("Map", "地图"); }
        if (cat == "gauge") { return Charts.T("Gauge", "仪表盘"); }
        if (cat == "funnel") { return Charts.T("Funnel", "漏斗图"); }
        if (cat == "eventRiver") { return Charts.T("Event river", "事件河流图"); }
        if (cat == "venn") { return Charts.T("Venn", "韦恩图"); }
        if (cat == "treemap") { return Charts.T("Treemap", "矩形树图"); }
        if (cat == "tree") { return Charts.T("Tree", "树图"); }
        if (cat == "wordCloud") { return Charts.T("Word cloud", "字符云"); }
        if (cat == "mix") { return Charts.T("Mix", "混搭"); }
        if (cat == "component") { return Charts.T("Component", "组件"); }
        return Charts.T("Other", "其他");
    }

    static int KeyOf(int demo, int sub) { return 700100 + demo * 16 + sub; }

    /// 截图/回归模式（--nomouse）：悬停 tooltip、轴指示器随宿主
    /// 光标进画面，整体关掉，截图只含图表本体。
    static bool nomouse;

    /// 图表皮肤（ChartSkin）选择器：nav 侧栏的单选按钮组，
    /// 一行四档；skinLang 记录建组时的语言（换语言重建选项）。
    static RadioGroup skinGroup;
    static int skinLang = 0 - 1;

    static void Show(App app, ChartOption o, int x, int y, int w, int h) {
        o.toolboxShow = true;
        if (Charts.nomouse) { o.showTooltip = false; }
        ChartView.Keyed(o, Charts.KeyOf(Charts.selected.Get(), 0)).Render(app, x, y, w, h);
    }

    static void ShowN(App app, ChartOption o, int sub, int x, int y, int w, int h) {
        o.toolboxShow = true;
        if (Charts.nomouse) { o.showTooltip = false; }
        ChartView.Keyed(o, Charts.KeyOf(Charts.selected.Get(), sub)).Render(app, x, y, w, h);
    }

    static void ShowQuiet(App app, ChartOption o, int sub, int x, int y, int w, int h) {
        o.toolboxShow = false;
        ChartView.Keyed(o, Charts.KeyOf(Charts.selected.Get(), sub)).Render(app, x, y, w, h);
    }

    static void Split2(App app, ChartOption a, ChartOption b, int x, int y, int w, int h) {
        int gap = app.Scale(12);
        int hw = (w - gap) / 2;
        Charts.ShowN(app, a, 0, x, y, hw, h);
        Charts.ShowN(app, b, 1, x + hw + gap, y, hw, h);
    }

    static void SplitV(App app, ChartOption a, ChartOption b, int x, int y, int w, int h) {
        int gap = app.Scale(12);
        int hh = (h - gap) / 2;
        Charts.ShowN(app, a, 0, x, y, w, hh);
        Charts.ShowN(app, b, 1, x, y + hh + gap, w, hh);
    }

    /// 2×2 四联（ECharts funnel3.html 四系列象限布局的近似：
    /// 官方在单面板内以系列 x/y/width/height 定位，此处以四子图
    /// 分栏还原——同数据、降序/升序交替）。
    static void Split4(App app, ChartOption a, ChartOption b,
                       ChartOption cc, ChartOption d, int x, int y, int w, int h) {
        int gap = app.Scale(12);
        int hw = (w - gap) / 2;
        int hh = (h - gap) / 2;
        Charts.ShowN(app, a, 0, x, y, hw, hh);
        Charts.ShowN(app, b, 1, x + hw + gap, y, hw, hh);
        Charts.ShowN(app, cc, 2, x, y + hh + gap, hw, hh);
        Charts.ShowN(app, d, 3, x + hw + gap, y + hh + gap, hw, hh);
    }

    static List<string> Week() {
        return new List<string>{
            Charts.T("Mon", "周一"), Charts.T("Tue", "周二"),
            Charts.T("Wed", "周三"), Charts.T("Thu", "周四"),
            Charts.T("Fri", "周五"), Charts.T("Sat", "周六"),
            Charts.T("Sun", "周日") };
    }

    static List<string> Months() {
        return new List<string>{
            "1月", "2月", "3月", "4月", "5月", "6月",
            "7月", "8月", "9月", "10月", "11月", "12月" };
    }

    static void Render(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int top = app.titlebarH;
        int w = c.Width();
        int h = c.Height();
        app.RenderBackground(0, top, w, h - top, 0);

        int sw = app.Scale(260);
        Rect area = new Rect(0, top, w, h - top);
        Charts.RenderNav(app, c, t, area, sw);
        Charts.RenderPreview(app, c, t, area, sw);
    }

    static void RenderNav(App app, Canvas c, Theme t, Rect area, int sw) {
        c.FillRect(area.x, area.y, sw, area.height, t.bgSecondary);
        c.FillRect(area.x + sw - 1, area.y, 1, area.height, t.divider);

        int pad = app.Scale(14);
        c.DrawText(area.x + pad, area.y + app.Scale(20),
            "CHARTS", t.textTertiary, t.fontSizeSmall);

        // EN/中 切换：两个真实 Button，当前语言挂 primary 类。
        int lgH = app.Scale(20);
        int lgW = app.Scale(36);
        int lgY = area.y + app.Scale(15);
        if (Charts.langEn == null) {
            Charts.langEn = new Button("EN");
            Charts.langEn.Prefer(lgW, lgH);
            Charts.langEn.OnClick(() => {
                Charts.lang.Set(0);
                Charts.app.RequestRedraw();
            });
            Charts.langZh = new Button("中");
            Charts.langZh.Prefer(lgW, lgH);
            Charts.langZh.OnClick(() => {
                Charts.lang.Set(1);
                Charts.app.RequestRedraw();
            });
        }
        bool zh = Charts.lang.Get() == 1;
        Charts.langEn.Class = zh ? "" : "primary";
        Charts.langZh.Class = zh ? "primary" : "";
        int lgTotal = lgW * 2 + app.Scale(4);
        Panel.Row().Gap(app.Scale(4))
            .With(Charts.langEn).With(Charts.langZh)
            .RenderInside(app, new Rect(area.x + sw - pad - lgTotal, lgY,
                lgTotal, lgH));

        // 行文本随语言切换重建；列表本体（行、悬停、选中、滚动、
        // 滚动条）全部是 ListView 的职责，这里只喂矩形。
        if (Charts.lang.Get() != Charts.navLang) {
            Charts.navLang = Charts.lang.Get();
            Charts.RebuildNavRows();
            Charts.nav.Bind(Charts.navRows);
        }
        int listTop = area.y + app.Scale(52);
        int listBottom = area.y + area.height - app.Scale(8);
        Charts.nav.RenderInside(app, new Rect(area.x, listTop, sw,
            listBottom - listTop));
    }

    /// 建列表、灌行、接选中事件。只调一次。
    static void InitNav() {
        Charts.nav = new ListView<ChartsNavRow>(r => Charts.NavRowView(r));
        Charts.nav.Class = "flat";
        Charts.RebuildNavRows();
        Charts.nav.Bind(Charts.navRows);
        Charts.nav.OnSelect(Charts.NavPicked);
    }

    /// 按当前语言重建行数据（类目表头 + 示例条目交错）。
    static void RebuildNavRows() {
        Charts.navRows = new List<ChartsNavRow>();
        string lastCat = "";
        for (int i = 0; i < Charts.demos.Count; i = i + 1) {
            ChartsDemo d = Charts.demos[i];
            if (d.cat != lastCat) {
                Charts.navRows.Add(ChartsNavRow.Header(Charts.CatLabel(d.cat)));
                lastCat = d.cat;
            }
            Charts.navRows.Add(ChartsNavRow.Entry(i, Charts.NameOf(d),
                Charts.T(d.den, d.zhd)));
        }
    }

    /// 行模板：两行行的视觉（对称留白、字号、选中配色、省略号）
    /// 都在 stdlib 的 ListItem 里，这里只做数据到控件的映射。
    static Control NavRowView(ChartsNavRow r) {
        if (r.header) { return ListItem.Header(r.text); }
        ListItem it = new ListItem(r.text, r.desc);
        it.Selected = Charts.selected.Get() == r.demoIndex;
        return it;
    }

    /// 列表选中回调：映射回示例下标；类目行不可选中，弹回
    /// 当前示例行。重建行让标题/副标题换上选中配色。
    static void NavPicked() {
        int r = Charts.nav.SelectedIndex();
        if (r < 0 || r >= Charts.navRows.Count) { return; }
        ChartsNavRow row = Charts.navRows[r];
        if (row.header) {
            Charts.nav.SelectIndex(Charts.navSelRow);
            return;
        }
        Charts.navSelRow = r;
        Charts.selected.Set(row.demoIndex);
        Charts.nav.Refresh();
        Charts.app.RequestRedraw();
    }

    /// 按示例下标选中导航行（深链入口）。
    static void SelectDemo(int demoIdx) {
        Charts.selected.Set(demoIdx);
        for (int i = 0; i < Charts.navRows.Count; i = i + 1) {
            ChartsNavRow r = Charts.navRows[i];
            if (!r.header && r.demoIndex == demoIdx) {
                Charts.navSelRow = i;
                Charts.nav.SelectIndex(i);
                break;
            }
        }
    }

    static void RenderPreview(App app, Canvas c, Theme t, Rect area, int sw) {
        int x = area.x + sw;
        int w = area.width - sw;
        int pad = app.Scale(14);
        int sel = Charts.selected.Get();
        if (sel < 0 || sel >= Charts.demos.Count) { sel = 0; }
        ChartsDemo d = Charts.demos[sel];
        string head = Charts.CatLabel(d.cat) + "  /  " + Charts.NameOf(d)
            + "   ·   " + d.id;
        c.DrawText(x + pad, area.y + app.Scale(14), head,
            t.textSecondary, t.fontSizeSmall);

        // 图表皮肤（ChartSkin）选择：图表配色是独立板块，与全局
        // 皮肤主题无关。连体单选按钮组一行四档，随嵌入的图表显示
        // 在预览头，换肤全窗生效。
        int skW = app.Scale(64);
        c.DrawText(x + w - pad - app.Scale(380), area.y + app.Scale(18),
            Charts.T("CHART SKIN", "图表皮肤"), t.textTertiary, t.fontSizeSmall);
        if (Charts.skinLang != Charts.lang.Get()) {
            Charts.skinLang = Charts.lang.Get();
            bool skEn = Charts.skinLang == 0;
            RadioGroup skG = new RadioGroup();
            skG.Buttons = true;
            skG.Size = "small";
            for (int si = 0; si < ChartSkin.Count(); si = si + 1) {
                skG.AddOption(ChartSkin.Label(si, skEn), si);
            }
            int skCur = ChartSkin.IndexOf(ChartSkin.Current());
            skG.SetSelectedValue(skCur >= 0 ? skCur : 0);
            skG.OnChange(() => {
                int v = Charts.skinGroup.SelectedValue();
                if (v >= 0 && v < ChartSkin.Count()) {
                    ChartSkin.SetCurrent(ChartSkin.Name(v));
                }
                Charts.app.RequestRedraw();
            });
            Charts.skinGroup = skG;
        }
        Charts.skinGroup.RenderInside(app, new Rect(
            x + w - pad - app.Scale(380) + skW + app.Scale(8),
            area.y + app.Scale(10), app.Scale(310), app.Scale(24)));

        int top = area.y + app.Scale(40);
        Charts.Draw(app, d.id, x + pad, top,
            w - pad * 2, area.y + area.height - pad - top);
    }

    static void Draw(App app, string id, int x, int y, int w, int h) {
        // 折线类 10 例已是参考 option 1:1。其余类目先映射到语义
        // 最近的现有实现占位，随批次 2-5 逐个换成参考站原始 option
        // （届时未再引用的旧方法一并清理）。
        if (id == "line1") { Charts.Line1(app, x, y, w, h); }
        else if (id == "line2") { Charts.Line2(app, x, y, w, h); }
        else if (id == "line5") { Charts.Line5(app, x, y, w, h); }
        else if (id == "line3") { Charts.Line3(app, x, y, w, h); }
        else if (id == "line4") { Charts.Line4(app, x, y, w, h); }
        else if (id == "line7") { Charts.Line7(app, x, y, w, h); }
        else if (id == "line8") { Charts.Line8(app, x, y, w, h); }
        else if (id == "line6") { Charts.Line6(app, x, y, w, h); }
        else if (id == "line") { Charts.LineMulti(app, x, y, w, h); }
        else if (id == "line9") { Charts.Line9(app, x, y, w, h); }
        // 柱状图：参考 id → 现有实现（内容批 2 重写）。
        else if (id == "bar1") { Charts.Bar1(app, x, y, w, h); }
        else if (id == "bar2") { Charts.Bar2(app, x, y, w, h); }
        else if (id == "bar10") { Charts.Bar3(app, x, y, w, h); }
        else if (id == "bar7") { Charts.Bar4(app, x, y, w, h); }
        else if (id == "bar6") { Charts.Bar5(app, x, y, w, h); }
        else if (id == "bar12") { Charts.Bar6(app, x, y, w, h); }
        else if (id == "bar3") { Charts.Bar7(app, x, y, w, h); }
        else if (id == "bar4") { Charts.Bar8(app, x, y, w, h); }
        else if (id == "bar9") { Charts.Bar9(app, x, y, w, h); }
        else if (id == "bar5") { Charts.Bar10(app, x, y, w, h); }
        else if (id == "bar8") { Charts.Bar11(app, x, y, w, h); }
        else if (id == "bar13") { Charts.Bar12(app, x, y, w, h); }
        else if (id == "bar11") { Charts.Bar13(app, x, y, w, h); }
        else if (id == "bar14") { Charts.Bar14(app, x, y, w, h); }
        else if (id == "bar15") { Charts.Bar15(app, x, y, w, h); }
        else if (id == "bar") { Charts.Bar16(app, x, y, w, h); }
        // 散点图。
        else if (id == "scatter1") { Charts.Scatter1(app, x, y, w, h); }
        else if (id == "scatter2") { Charts.Scatter2(app, x, y, w, h); }
        else if (id == "scatter3") { Charts.Scatter3(app, x, y, w, h); }
        else if (id == "scatter5") { Charts.Scatter4(app, x, y, w, h); }
        else if (id == "scatter6") { Charts.Scatter5(app, x, y, w, h); }
        else if (id == "scatter4") { Charts.Scatter6(app, x, y, w, h); }
        else if (id == "dataRange1") { Charts.Scatter7(app, x, y, w, h); }
        else if (id == "scatter") { Charts.Scatter8(app, x, y, w, h); }
        // K 线。
        else if (id == "k1") { Charts.K1(app, x, y, w, h); }
        else if (id == "k") { Charts.K2(app, x, y, w, h); }
        // 饼图。
        else if (id == "pie1") { Charts.Pie1(app, x, y, w, h); }
        else if (id == "pie2") { Charts.Pie2(app, x, y, w, h); }
        else if (id == "pie3") { Charts.Pie3(app, x, y, w, h); }
        else if (id == "pie4") { Charts.Pie4(app, x, y, w, h); }
        else if (id == "pie5") { Charts.Pie5(app, x, y, w, h); }
        else if (id == "pie6") { Charts.Pie6(app, x, y, w, h); }
        else if (id == "pie7") { Charts.Pie7(app, x, y, w, h); }
        else if (id == "lasagna") { Charts.Pie8(app, x, y, w, h); }
        else if (id == "pie") { Charts.Pie9(app, x, y, w, h); }
        // 雷达。
        else if (id == "radar1") { Charts.Radar1(app, x, y, w, h); }
        else if (id == "radar2") { Charts.Radar2(app, x, y, w, h); }
        else if (id == "radar3") { Charts.Radar3(app, x, y, w, h); }
        else if (id == "wormhole") { Charts.Radar4(app, x, y, w, h); }
        else if (id == "radar") { Charts.Radar5(app, x, y, w, h); }
        // 和弦（webkit-dep2 = WebKit 复杂网络）。
        else if (id == "chord1") { Charts.Chord1(app, x, y, w, h); }
        else if (id == "chord2") { Charts.Chord2(app, x, y, w, h); }
        else if (id == "chord3") { Charts.Chord6(app, x, y, w, h); }
        else if (id == "chord4") { Charts.Chord3(app, x, y, w, h); }
        else if (id == "webkit-dep2") { Charts.Chord4(app, x, y, w, h); }
        else if (id == "chord") { Charts.Chord5(app, x, y, w, h); }
        // 力导向（webkit-dep = WebKit 复杂网络）。
        else if (id == "force1") { Charts.Force1(app, x, y, w, h); }
        else if (id == "force2") { Charts.Force2(app, x, y, w, h); }
        else if (id == "force3") { Charts.Force7(app, x, y, w, h); }
        else if (id == "force4") { Charts.Force3(app, x, y, w, h); }
        else if (id == "webkit-dep") { Charts.Force4(app, x, y, w, h); }
