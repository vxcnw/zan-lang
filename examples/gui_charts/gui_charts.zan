/// Zan Charts — gallery rebuilt 1:1 from the ECharts 5 official examples
/// (echarts.apache.org/examples): nav id/title 取官方注册表原文，option 与
/// 数据逐字取 _scratch/ref5/<id>.js；引擎缺口进账本，不做变通数据。
using System;
using Gui;
using Gui.Widget;
using Gui.Component.Chart;

/// One navigation entry: ECharts gallery id + bilingual title and
/// description（参考站每例的副标题，用来区分同名示例）。
class ChartsDemo {
    string cat;
    string id;
    string en;
    string zh;
    string den;
    string zhd;
}

class ChartsNavRow {
    bool header;
    int demoIndex;
    string text;
    string desc;

    static ChartsNavRow Header(string text) {
        ChartsNavRow row = new ChartsNavRow();
        row.header = true;
        row.demoIndex = 0 - 1;
        row.text = text;
        row.desc = "";
        return row;
    }

    static ChartsNavRow Entry(int demoIndex, string text, string desc) {
        ChartsNavRow row = new ChartsNavRow();
        row.header = false;
        row.demoIndex = demoIndex;
        row.text = text;
        row.desc = desc;
        return row;
    }
}

partial class Charts {
    static App app;
    static SignalInt lang;
    static SignalInt selected;
    static ListView<ChartsNavRow> nav;
    static List<ChartsNavRow> navRows;
    static int navLang = 0 - 1;
    static int navSelRow;
    static Button langEn;
    static Button langZh;
    static List<ChartsDemo> demos;

    static void Main() {
        // ECharts 示例页是白底亮色，画廊默认亮色主题（标题栏内置
        // 皮肤选择器，EnableSkins(1) 预选 Light）。
        App app = new App("Zan Charts", 1160, 760);
        Charts.app = app;
        Charts.lang = new SignalInt(1);
        Charts.selected = new SignalInt(0);
        Charts.BuildCatalog();
        Charts.InitNav();
        // 列表选中与示例选中从第一帧起就是一回事（否则首例只
        // 有反色文字、没有主色带）。
        Charts.SelectDemo(Charts.selected.Get());

        // 选中行用主色带（默认皮肤只给灰底）；带子加深到主色
        // 的应用需自己把行内文字换成反色——ListItem 默认不换字，
        // 两种皮肤下灰底 + 正常文字都可读。颜色全部走 token。
        app.UseAppCss("listrow:selected { background: var(--primary); }"
            + "listrow:hover { background: var(--bg-hover); }"
            + "listitem::title:selected, listitem::desc:selected"
            + " { color: var(--text-inverse); }");

        if (Environment.ArgCount() > 0) {
            string want = Environment.ArgAt(0);
            bool hit = false;
            // id 优先：demo id "line" 与类目名 "line" 同名，不能让
            // 类目匹配把同名词的第一项抢过去。
            for (int i = 0; i < Charts.demos.Count; i = i + 1) {
                if (want == Charts.demos[i].id) {
                    Charts.SelectDemo(i);
                    hit = true;
                    break;
                }
            }
            if (!hit) {
                for (int i = 0; i < Charts.demos.Count; i = i + 1) {
                    ChartsDemo d = Charts.demos[i];
                    if (want == d.en || want == d.zh || want == d.cat) {
                        Charts.SelectDemo(i);
                        break;
                    }
                }
            }
        }

        app.Show();
        // --nomouse：截图/回归模式——鼠标由自动化宿主管理，帧内
        // 把鼠标钉到窗口外并整体关闭 tooltip，悬停覆盖层不进画面。
        // --skin <name>：启动即选图表皮肤（ChartSkin 名），截图
        // 回归按皮肤取样。
        bool pin = false;
        string skinArg = "";
        for (int ai = 0; ai < Environment.ArgCount(); ai = ai + 1) {
            if (Environment.ArgAt(ai) == "--nomouse") { pin = true; }
            if (Environment.ArgAt(ai) == "--skin"
                && ai + 1 < Environment.ArgCount()) {
                skinArg = Environment.ArgAt(ai + 1);
            }
        }
        if (skinArg != "") { ChartSkin.SetCurrent(skinArg); }
        Charts.nomouse = pin;
        app.SetFrameBody(() => {
            WidgetId.ResetFrame();
            if (pin) { app.mouseX = 0 - 9999; app.mouseY = 0 - 9999; }
            Charts.Render(app);
            app.RenderChrome("Zan Charts");
        });
        WidgetId.Mark();

        while (app.isRunning) {
            int r;
            if (app.needsRedraw) {
                int since = Window.GetTickMs() - app.lastPresentMs;
                if (app.lastPresentMs > 0 && since < 16) {
                    Window.SleepMs(16 - since);
                }
                r = app.window.PollEvent();
            } else if (app.animNextMs >= 0 || app.fxNextMs >= 0) {
                r = 1;
                bool waiting = true;
                while (waiting) {
                    int now = Window.GetTickMs();
                    int deadline = app.animNextMs;
                    if (deadline < 0
                        || (app.fxNextMs >= 0 && app.fxNextMs < deadline)) {
                        deadline = app.fxNextMs;
                    }
                    if (deadline < 0) { waiting = false; }
                    else if (now >= deadline) {
                        bool fxOnly = app.animNextMs < 0 || now < app.animNextMs;
                        if (!(fxOnly && app.FxPresent())) {
                            app.RequestRedraw();
                            waiting = false;
                        }
                    } else {
                        r = app.window.WaitEventTimeout(deadline - now);
                        if (r != 1) { waiting = false; }
                    }
                }
            } else {
                r = app.window.WaitEvent();
            }
            if (r < 0) { break; }
            app.DrainPosts();

            nint evh = Window.EventHwnd();
            int kind = app.window.EventKind();
            if (kind == 8) { break; }

            bool inputEv = kind == 2 || kind == 3 || kind == 13
                || kind == 4 || kind == 6 || kind == 1;
            bool doFrame = true;
            if (!app.needsRedraw && !inputEv) {
                doFrame = false;
            }
            app.ApplyEvent(evh);
            if (doFrame) {
                app.BeginFrame();
                WidgetId.ResetFrame();
                Charts.Render(app);
                app.RenderChrome("Zan Charts");
                app.PresentFrame();
            }
        }
    }

    static void Add(string cat, string id, string en, string zh,
                    string den, string zhd) {
        ChartsDemo d = new ChartsDemo();
        d.cat = cat;
        d.id = id;
        d.en = en;
        d.zh = zh;
        d.den = den;
        d.zhd = zhd;
        Charts.demos.Add(d);
    }

    static void BuildCatalog() {
        Charts.demos = new List<ChartsDemo>();
        // 目录对齐 ECharts 5 官方示例站（echarts.apache.org/examples）：
        // 类目、条目顺序、id、标题均取官方注册表原文，逐批重建。
        // 折线图 — 官方 line 段已直迁 13 例（ChartsLine5.zan，option
        // 逐项取 ref5 源码）；visualMap/dataset/graphic/多轴等缺口例
        // 与引擎账本项绑定，随批按官方位置补入。
        Charts.Add("line", "line-simple", "Basic Line Chart", "基础折线图", "", "");
        Charts.Add("line", "line-smooth", "Smoothed Line Chart", "基础平滑折线图", "", "");
        Charts.Add("line", "area-basic", "Basic area chart", "基础面积图", "", "");
        Charts.Add("line", "line-stack", "Stacked Line Chart", "堆叠折线图", "", "");
        Charts.Add("line", "area-stack", "Stacked Area Chart", "堆叠面积图", "", "");
        Charts.Add("line", "line-marker", "Temperature Change in the Coming Week", "未来一周气温变化", "", "");
        // 标题 = 官方注册表 title/titleCN 原文（chart-list-data.js），
        // 不是示例 option 内部的 title.text（如 area-time-axis 图题
        // 'Large Ara Chart' 是官网源码原文，列表名以注册表为准）。
        Charts.Add("line", "area-simple", "Large scale area chart", "大数据量面积图", "", "");
        Charts.Add("line", "area-rainfall", "Rainfall", "雨量流量关系图", "", "");
        Charts.Add("line", "area-time-axis", "Area Chart with Time Axis", "时间轴折线图", "", "");
        Charts.Add("line", "line-style", "Line Style and Item Style", "自定义折线图样式", "", "");
        Charts.Add("line", "line-in-cartesian-coordinate-system",
            "Line Chart in Cartesian Coordinate System", "双数值轴折线图", "", "");
        Charts.Add("line", "line-step", "Step Line", "阶梯折线图", "", "");
        Charts.Add("line", "line-y-category", "Line Y Category", "垂直折线图（Y轴为类目轴）", "", "");
        // ===== bar 段（官方注册表顺序，实现见 ChartsBar5.zan）=====
        Charts.Add("bar", "bar-simple", "Basic Bar", "基础柱状图", "", "");
        Charts.Add("bar", "bar-tick-align", "Axis Align with Tick", "坐标轴刻度与标签对齐", "", "");
        Charts.Add("bar", "bar-background", "Bar with Background", "带背景色的柱状图", "", "");
        Charts.Add("bar", "bar-data-color", "Set Style of Single Bar.", "自定义单个柱子颜色", "", "");
        Charts.Add("bar", "bar-waterfall", "Waterfall Chart", "瀑布图（柱状图模拟）", "", "");
        Charts.Add("bar", "bar-negative2", "Bar Chart with Negative Value", "交错正负轴标签", "", "");
        Charts.Add("bar", "bar-y-category", "World Population", "世界人口总量 - 条形图", "", "");
        Charts.Add("bar", "bar-label-rotation", "Bar Label Rotation", "柱状图标签旋转", "", "");
        Charts.Add("bar", "bar-stack", "Stacked Column Chart", "堆叠柱状图", "", "");
        Charts.Add("bar", "bar-stack-borderRadius", "Stacked Bar with borderRadius", "带圆角的堆积柱状图", "", "");
        Charts.Add("bar", "bar-stack-normalization", "Stacked Bar Normalization", "堆叠柱状图的归一化", "", "");
        Charts.Add("bar", "bar-waterfall2", "Waterfall Chart", "阶梯瀑布图（柱状图模拟）", "", "");
        Charts.Add("bar", "bar-y-category-stack", "Stacked Horizontal Bar", "堆叠条形图", "", "");
        Charts.Add("bar", "bar-negative", "Bar Chart with Negative Value", "正负条形图", "", "");
        Charts.Add("bar", "bar1", "Rainfall and Evaporation", "某地区蒸发量和降水量", "", "");
        Charts.Add("bar", "mix-line-bar", "Mixed Line and Bar", "折柱混合", "", "");
    }

    static string T(string en, string zh) {
        if (Charts.lang.Get() == 1) { return zh; }
        return en;
    }

    static string NameOf(ChartsDemo d) { return Charts.T(d.en, d.zh); }

    static string CatLabel(string cat) {
        // 类目名取自参考站 example.html 的 h3 原文。
        if (cat == "line") { return Charts.T("Line", "折线图"); }
        if (cat == "bar") { return Charts.T("Bar", "柱状图"); }
        if (cat == "scatter") { return Charts.T("Scatter", "散点图"); }
        if (cat == "k") { return Charts.T("Candlestick", "K线图"); }
        if (cat == "pie") { return Charts.T("Pie", "饼图"); }
        if (cat == "radar") { return Charts.T("Radar", "雷达图"); }
        if (cat == "chord") { return Charts.T("Chord", "和弦图"); }
        if (cat == "force") { return Charts.T("Force", "力导向布局图"); }
        if (cat == "map") { return Charts.T("Map", "地图"); }
        if (cat == "gauge") { return Charts.T("Gauge", "仪表盘"); }
        if (cat == "funnel") { return Charts.T("Funnel", "漏斗图"); }
        if (cat == "eventRiver") { return Charts.T("Event river", "事件河流图"); }
        if (cat == "venn") { return Charts.T("Venn", "韦恩图"); }
        if (cat == "treemap") { return Charts.T("Treemap", "矩形树图"); }
        if (cat == "tree") { return Charts.T("Tree", "树图"); }
        if (cat == "wordCloud") { return Charts.T("Word cloud", "字符云"); }
        if (cat == "mix") { return Charts.T("Mix", "混搭"); }
        if (cat == "component") { return Charts.T("Component", "组件"); }
        return Charts.T("Other", "其他");
    }

    static int KeyOf(int demo, int sub) { return 700100 + demo * 16 + sub; }

    /// 截图/回归模式（--nomouse）：悬停 tooltip、轴指示器随宿主
    /// 光标进画面，整体关掉，截图只含图表本体。
    static bool nomouse;

    /// 图表皮肤（ChartSkin）选择器：nav 侧栏的单选按钮组，
    /// 一行四档；skinLang 记录建组时的语言（换语言重建选项）。
    static RadioGroup skinGroup;
    static int skinLang = 0 - 1;

    static void Show(App app, ChartOption o, int x, int y, int w, int h) {
        o.toolboxShow = true;
        if (Charts.nomouse) { o.showTooltip = false; }
        ChartView.Keyed(o, Charts.KeyOf(Charts.selected.Get(), 0)).Render(app, x, y, w, h);
    }

    static List<string> Week() {
        return new List<string>{
            Charts.T("Mon", "周一"), Charts.T("Tue", "周二"),
            Charts.T("Wed", "周三"), Charts.T("Thu", "周四"),
            Charts.T("Fri", "周五"), Charts.T("Sat", "周六"),
            Charts.T("Sun", "周日") };
    }


    static void Render(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int top = app.titlebarH;
        int w = c.Width();
        int h = c.Height();
        app.RenderBackground(0, top, w, h - top, 0);

        int sw = app.Scale(260);
        Rect area = new Rect(0, top, w, h - top);
        Charts.RenderNav(app, c, t, area, sw);
        Charts.RenderPreview(app, c, t, area, sw);
    }

    static void RenderNav(App app, Canvas c, Theme t, Rect area, int sw) {
        c.FillRect(area.x, area.y, sw, area.height, t.bgSecondary);
        c.FillRect(area.x + sw - 1, area.y, 1, area.height, t.divider);

        int pad = app.Scale(14);
        c.DrawText(area.x + pad, area.y + app.Scale(20),
            "CHARTS", t.textTertiary, t.fontSizeSmall);

        // EN/中 切换：两个真实 Button，当前语言挂 primary 类。
        int lgH = app.Scale(20);
        int lgW = app.Scale(36);
        int lgY = area.y + app.Scale(15);
        if (Charts.langEn == null) {
            Charts.langEn = new Button("EN");
            Charts.langEn.Prefer(lgW, lgH);
            Charts.langEn.OnClick(() => {
                Charts.lang.Set(0);
                Charts.app.RequestRedraw();
            });
            Charts.langZh = new Button("中");
            Charts.langZh.Prefer(lgW, lgH);
            Charts.langZh.OnClick(() => {
                Charts.lang.Set(1);
                Charts.app.RequestRedraw();
            });
        }
        bool zh = Charts.lang.Get() == 1;
        Charts.langEn.Class = zh ? "" : "primary";
        Charts.langZh.Class = zh ? "primary" : "";
        int lgTotal = lgW * 2 + app.Scale(4);
        Panel.Row().Gap(app.Scale(4))
            .With(Charts.langEn).With(Charts.langZh)
            .RenderInside(app, new Rect(area.x + sw - pad - lgTotal, lgY,
                lgTotal, lgH));

        // 行文本随语言切换重建；列表本体（行、悬停、选中、滚动、
        // 滚动条）全部是 ListView 的职责，这里只喂矩形。
        if (Charts.lang.Get() != Charts.navLang) {
            Charts.navLang = Charts.lang.Get();
            Charts.RebuildNavRows();
            Charts.nav.Bind(Charts.navRows);
        }
        int listTop = area.y + app.Scale(52);
        int listBottom = area.y + area.height - app.Scale(8);
        Charts.nav.RenderInside(app, new Rect(area.x, listTop, sw,
            listBottom - listTop));
    }

    /// 建列表、灌行、接选中事件。只调一次。
    static void InitNav() {
        Charts.nav = new ListView<ChartsNavRow>(r => Charts.NavRowView(r));
        Charts.nav.Class = "flat";
        Charts.RebuildNavRows();
        Charts.nav.Bind(Charts.navRows);
        Charts.nav.OnSelect(Charts.NavPicked);
    }

    /// 按当前语言重建行数据（类目表头 + 示例条目交错）。
    static void RebuildNavRows() {
        Charts.navRows = new List<ChartsNavRow>();
        string lastCat = "";
        for (int i = 0; i < Charts.demos.Count; i = i + 1) {
            ChartsDemo d = Charts.demos[i];
            if (d.cat != lastCat) {
                Charts.navRows.Add(ChartsNavRow.Header(Charts.CatLabel(d.cat)));
                lastCat = d.cat;
            }
            Charts.navRows.Add(ChartsNavRow.Entry(i, Charts.NameOf(d),
                Charts.T(d.den, d.zhd)));
        }
    }

    /// 行模板：两行行的视觉（对称留白、字号、选中配色、省略号）
    /// 都在 stdlib 的 ListItem 里，这里只做数据到控件的映射。
    static Control NavRowView(ChartsNavRow r) {
        if (r.header) { return ListItem.Header(r.text); }
        ListItem it = new ListItem(r.text, r.desc);
        it.Selected = Charts.selected.Get() == r.demoIndex;
        return it;
    }

    /// 列表选中回调：映射回示例下标；类目行不可选中，弹回
    /// 当前示例行。重建行让标题/副标题换上选中配色。
    static void NavPicked() {
        int r = Charts.nav.SelectedIndex();
        if (r < 0 || r >= Charts.navRows.Count) { return; }
        ChartsNavRow row = Charts.navRows[r];
        if (row.header) {
            Charts.nav.SelectIndex(Charts.navSelRow);
            return;
        }
        Charts.navSelRow = r;
        Charts.selected.Set(row.demoIndex);
        Charts.nav.Refresh();
        Charts.app.RequestRedraw();
    }

    /// 按示例下标选中导航行（深链入口）。
    static void SelectDemo(int demoIdx) {
        Charts.selected.Set(demoIdx);
        for (int i = 0; i < Charts.navRows.Count; i = i + 1) {
            ChartsNavRow r = Charts.navRows[i];
            if (!r.header && r.demoIndex == demoIdx) {
                Charts.navSelRow = i;
                Charts.nav.SelectIndex(i);
                break;
            }
        }
    }

    static void RenderPreview(App app, Canvas c, Theme t, Rect area, int sw) {
        int x = area.x + sw;
        int w = area.width - sw;
        int pad = app.Scale(14);
        int sel = Charts.selected.Get();
        if (sel < 0 || sel >= Charts.demos.Count) { sel = 0; }
        ChartsDemo d = Charts.demos[sel];
        string head = Charts.CatLabel(d.cat) + "  /  " + Charts.NameOf(d)
            + "   ·   " + d.id;
        c.DrawText(x + pad, area.y + app.Scale(14), head,
            t.textSecondary, t.fontSizeSmall);

        // 图表皮肤（ChartSkin）选择：图表配色是独立板块，与全局
        // 皮肤主题无关。连体单选按钮组一行四档，随嵌入的图表显示
        // 在预览头，换肤全窗生效。
        int skW = app.Scale(64);
        c.DrawText(x + w - pad - app.Scale(380), area.y + app.Scale(18),
            Charts.T("CHART SKIN", "图表皮肤"), t.textTertiary, t.fontSizeSmall);
        if (Charts.skinLang != Charts.lang.Get()) {
            Charts.skinLang = Charts.lang.Get();
            bool skEn = Charts.skinLang == 0;
            RadioGroup skG = new RadioGroup();
            skG.Buttons = true;
            skG.Size = "small";
            for (int si = 0; si < ChartSkin.Count(); si = si + 1) {
                skG.AddOption(ChartSkin.Label(si, skEn), si);
            }
            int skCur = ChartSkin.IndexOf(ChartSkin.Current());
            skG.SetSelectedValue(skCur >= 0 ? skCur : 0);
            skG.OnChange(() => {
                int v = Charts.skinGroup.SelectedValue();
                if (v >= 0 && v < ChartSkin.Count()) {
                    ChartSkin.SetCurrent(ChartSkin.Name(v));
                }
                Charts.app.RequestRedraw();
            });
            Charts.skinGroup = skG;
        }
        Charts.skinGroup.RenderInside(app, new Rect(
            x + w - pad - app.Scale(380) + skW + app.Scale(8),
            area.y + app.Scale(10), app.Scale(310), app.Scale(24)));

        int top = area.y + app.Scale(40);
        Charts.Draw(app, d.id, x + pad, top,
            w - pad * 2, area.y + area.height - pad - top);
    }

    static void Draw(App app, string id, int x, int y, int w, int h) {
        // ECharts 5 官方示例分发：id = 官方注册表 id，实现见
        // ChartsLine5.zan（每例 option 逐项取 ref5 源码）。
        if (id == "line-simple") { Charts.E5LineSimple(app, x, y, w, h); }
        else if (id == "line-smooth") { Charts.E5LineSmooth(app, x, y, w, h); }
        else if (id == "area-basic") { Charts.E5AreaBasic(app, x, y, w, h); }
        else if (id == "line-stack") { Charts.E5LineStack(app, x, y, w, h); }
        else if (id == "area-stack") { Charts.E5AreaStack(app, x, y, w, h); }
        else if (id == "line-marker") { Charts.E5LineMarker(app, x, y, w, h); }
        else if (id == "area-simple") { Charts.E5AreaSimple(app, x, y, w, h); }
        else if (id == "area-rainfall") { Charts.E5AreaRainfall(app, x, y, w, h); }
        else if (id == "area-time-axis") { Charts.E5AreaTimeAxis(app, x, y, w, h); }
        else if (id == "line-style") { Charts.E5LineStyle(app, x, y, w, h); }
        else if (id == "line-in-cartesian-coordinate-system") { Charts.E5LineInCartesian(app, x, y, w, h); }
        else if (id == "line-step") { Charts.E5LineStep(app, x, y, w, h); }
        else if (id == "line-y-category") { Charts.E5LineYCategory(app, x, y, w, h); }
        // ECharts 5 官方示例 bar 段（ChartsBar5.zan）。
        else if (id == "bar-simple") { Charts.E5BarSimple(app, x, y, w, h); }
        else if (id == "bar-tick-align") { Charts.E5BarTickAlign(app, x, y, w, h); }
        else if (id == "bar-background") { Charts.E5BarBackground(app, x, y, w, h); }
        else if (id == "bar-data-color") { Charts.E5BarDataColor(app, x, y, w, h); }
        else if (id == "bar-waterfall") { Charts.E5BarWaterfall(app, x, y, w, h); }
        else if (id == "bar-negative2") { Charts.E5BarNegative2(app, x, y, w, h); }
        else if (id == "bar-y-category") { Charts.E5BarYCategory(app, x, y, w, h); }
        else if (id == "bar-label-rotation") { Charts.E5BarLabelRotation(app, x, y, w, h); }
        else if (id == "bar-stack") { Charts.E5BarStack(app, x, y, w, h); }
        else if (id == "bar-stack-borderRadius") { Charts.E5BarStackBorderRadius(app, x, y, w, h); }
        else if (id == "bar-stack-normalization") { Charts.E5BarStackNormalization(app, x, y, w, h); }
        else if (id == "bar-waterfall2") { Charts.E5BarWaterfall2(app, x, y, w, h); }
        else if (id == "bar-y-category-stack") { Charts.E5BarYCategoryStack(app, x, y, w, h); }
        else if (id == "bar-negative") { Charts.E5BarNegative(app, x, y, w, h); }
        else if (id == "bar1") { Charts.E5Bar1(app, x, y, w, h); }
        else if (id == "mix-line-bar") { Charts.E5MixLineBar(app, x, y, w, h); }
    }
}
