using System.Data.Orm;

namespace ZanWeb.Model.Mall;

/* 商业插件使用账本：zanc 在安装/构建命中带 plugin_id 的包时打
 * ZANPKG_USAGE 行，IDE 侧 PluginUsage 按天去重后批量 ingest 到这里。
 *
 * 隐私边界（设计原则）：只收 plugin_id + 当天日期 + 机器指纹哈希
 * （16 hex，不落原始主机名/用户名），账本允许有洞（离线/失败静默）。
 * 平台只做聚合与异常比对（同一 plugin_id 的设备数/构建数、未购授权
 * 的指纹出现），不做任何用户侧行为记录。 */
[Table(Name = "plugin_usage_ledger")]
class PluginUsageLedger {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string pluginId;

    /* install / build */
    [Column(StringLength = 24, IsNullable = false)]
    string action;

    /* 机器指纹哈希（SHA-256 前 16 hex），不含原始主机/用户信息。 */
    [Column(StringLength = 32, IsNullable = false)]
    string machineFp;

    /* 上报方本地日期（yyyyMMdd，客户端时区，仅用于按天聚合）。 */
    [Column(StringLength = 8, IsNullable = false)]
    string day;

    /* 上报端 IDE 版本（可空）。 */
    [Column(StringLength = 32)]
    string ideVersion;

    /* 命中的包名（可空，plugin_id 的冗余便于人工排查）。 */
    [Column(StringLength = 128)]
    string packageName;

    long createdAt;
}
