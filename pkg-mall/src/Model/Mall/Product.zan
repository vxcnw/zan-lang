using System.Data.Orm;

namespace ZanWeb.Model.Mall;

/* 商品：product_type 区分两类受众与交付物——
 * extension（库，stdlib 布局，IDE 内安全安装）与
 * app（成品程序，可执行文件 + 许可证，C 端渠道交付）。 */
[Table(Name = "products")]
class Product {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int developerId;

    [Column(IsNullable = false)]
    int categoryId;

    [Column(StringLength = 128, IsNullable = false)]
    string slug;

    [Column(StringLength = 160, IsNullable = false)]
    string name;

    [Column(StringLength = 4096)]
    string description;

    /* extension / app / plugin */
    [Column(StringLength = 24, IsNullable = false)]
    string productType;

    /* 商业插件身份，写进包内 zan.pkg 并钉进商城目录；非 plugin 商品为空。 */
    [Column(StringLength = 64)]
    string pluginId;

    /* 商城钉住的插件公钥指纹（SHA-256，64 hex），装前校验防公钥调包。 */
    [Column(StringLength = 64)]
    string pubkeyFp;

    /* draft / pending / approved / rejected */
    [Column(StringLength = 24, IsNullable = false)]
    string status;

    long createdAt;
}
