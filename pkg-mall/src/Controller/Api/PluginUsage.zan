using System;
using ZanWeb;
using System.Web;
using System.Json;
using ZanWeb.Model.Mall;

namespace ZanWeb.Api;

/* 商业插件使用账目 ingest（匿名、批量、追加写即返回）：
 *   POST /api/pluginusage/ingest  body: {"events":[{plugin_id, action,
 *     machine_fp, day, ide_version, package}, ...]}
 *
 * 设计纪律（对应"平台只记开发账目、不给服务器压力"）：无鉴权不等于
 * 开放写——每请求封顶 64 条、逐条截断校验、失败的单条跳过不回滚；
 * 无查询端点（分析走库内聚合），无用户侧信息，纯账本。 */
[Route("api/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("插件使用账目")]
class PluginUsage : ApiController {
    [HttpPost]
    async void Ingest() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        JsonValue body = this.ctx.JsonBody();
        if (body == null || !body.IsObject()) { this.Fail(400, "0003", "bad body"); }
        JsonValue events = body.Get("events");
        if (events == null || !events.IsArray()) { this.Fail(400, "0003", "bad events"); }
        int count = events.Count();
        if (count > 64) { count = 64; }
        int accepted = 0;
        for (int i = 0; i < count; i = i + 1) {
            JsonValue ev = events.At(i);
            if (ev == null || !ev.IsObject()) { continue; }
            string pluginId = ev.Str("plugin_id", "");
            if (pluginId.Length == 0 || pluginId.Length > 64) { continue; }
            PluginUsageLedger row = new PluginUsageLedger();
            row.pluginId = pluginId;
            row.action = Clamp(ev.Str("action", "build"), 24);
            row.machineFp = Clamp(ev.Str("machine_fp", ""), 32);
            if (row.machineFp.Length == 0) { continue; }
            row.day = Clamp(ev.Str("day", ""), 8);
            if (row.day.Length == 0) { continue; }
            row.ideVersion = Clamp(ev.Str("ide_version", ""), 32);
            row.packageName = Clamp(ev.Str("package", ""), 128);
            row.createdAt = WebApp.NowSeconds();
            int _id = await this.Held().Insert<PluginUsageLedger>(row).ExecuteIdentityAsync();
            if (_id > 0) { accepted = accepted + 1; }
        }
        JsonValue o = JsonValue.NewObject();
        o.Put("accepted", JsonValue.NewNum(Convert.ToString(accepted)));
        this.Ok(o.ToJson());
    }

    static string Clamp(string s, int max) {
        if (s.Length > max) { return s.Substring(0, max); }
        return s;
    }
}
